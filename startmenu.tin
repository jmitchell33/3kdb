#NOP -- Arrow-key character menu. Start it from the repo folder with: tt++ startmenu.tin;
#NOP -- Up/down picks a character, left/right picks its guild, Enter logs in. Number keys still log in directly, unless the list is scrolling.;
#NOP -- The list and logo fit themselves to the screen, so a phone or a long list scrolls instead of losing the top.;
#NOP -- The button row under the list adds, edits or removes characters, or logs in as a guest. Names, guild arrows and buttons can be clicked.;
#NOP -- The character list, guild lists and last highlighted character are saved in chars/startmenu_data.tin.;
#NOP -- The first time it runs, the list is built from $player1, $player2, ... if those are set.;
#NOP -- Each character's current guild is saved in chars/<name>/guild.tin, which their character file reads.;
#NOP -- Characters left linkdead show how long until the game boots them (see menu_ld_hours below), and the next;
#NOP -- reboot is shown once a character has logged in. q quits;

#NOP -- 3kdb opens common_config in this startup session and only closes it in the game session, so after a;
#NOP -- login it's still open here. Close any open class first, or the menu and PASSWORD land in it and get;
#NOP -- deleted when the next character loads common/config.tin;
#alias {menu_close_classes} {
    #info classes save;
    #foreach *info[CLASSES][] menu_i {
        #if {"$info[CLASSES][$menu_i][arg3]" != "0"} {#class {$info[CLASSES][$menu_i][arg1]} close};
    };
};
menu_close_classes;

#class startmenu kill;
#class startmenu open;

#var menu[file] {chars/startmenu_data.tin};

#NOP -- Git doesn't keep these folders, so a fresh clone is missing them. Chat logs go to logs/<system user>/chatlogs;
#NOP -- (Discord post files to logs/<system user>/discord);
#NOP -- and the reboot times to vars/boot.tin, and neither can be written without its folder;
#alias {menu_make_folders}
{
    #NOP -- Only from the repo folder, so starting tt++ somewhere else doesn't leave these folders there;
    #script {menu_tmp} {test -f startmenu.tin && mkdir -p "logs/$(whoami)/chatlogs" "logs/$(whoami)/discord" vars};
};

#NOP -- Load the saved list, or build it from $player1, $player2, ... the first time;
#alias {menu_load} {
    menu_make_folders;
    #script {menu_tmp} {test -f $menu[file] && echo yes};
    #if {"$menu_tmp[1]" == "yes"} {
        #read $menu[file];
    } {
        #class startmenu_data kill;
        #class startmenu_data open;
        #var menu_chars {};
        #var menu_guilds {};
        #var menu_sel 1;
        #class startmenu_data close;
        #loop 1 99 i {
            #if {"${player$i}" == ""} {#break};
            #list menu_chars add {${player$i}};
            menu_read_guild ${player$i};
            #var menu_guilds[${player$i}] {{1}{$menu[guild][${player$i}]}};
        };
        menu_save;
    };
    #var menu[count] &menu_chars[];
    #NOP -- #loop 1 0 would count down, so skip the loops when the list is empty;
    #if {$menu[count] > 0} {#loop 1 $menu[count] i {menu_read_guild $menu_chars[$i]}};
    #if {$menu_sel < 1 || $menu_sel > $menu[count]} {#var menu_sel 1};
    #var menu[row] $menu_sel;
    #if {$menu[count] == 0} {#var menu[row] 1};
    #var menu[btn] 1;
    #var menu[top] 1;
    #var menu[prompt] {};
    #var menu[msg] {};
    menu_ld_load;
};

#NOP -- menu_ld_at[<name>]: when each character went linkdead, xlinkdead_at in chars/<name>/vars.tin.;
#NOP -- menu_linkd[<name>]: characters whose file sets vaf[linkd], so only a reboot boots them.;
#NOP -- menu_boot: when this boot started and the next is due, xboot_start and xboot_next in vars/boot.tin;
#NOP -- (common/status.tin saves them from uptime at each login).;
#NOP -- A timer from before the last reboot or past the limit is left out, since the game has booted that character;
#alias {menu_ld_load} {
    #var menu_ld_at {};
    #var menu_linkd {};
    #var menu_boot {};
    #format menu_ld_now {%T};
    #NOP -- tr drops the braces of the #VARIABLE lines, which TinTin would turn into \x7B text;
    #script {menu_tmp} {grep -E 'xboot_(start|next)' vars/boot.tin 2>/dev/null | tr -d '\173\175'};
    #foreach {$menu_tmp[%*]} menu_l {
        #regex {$menu_l} {xboot_{start|next} {[0-9]+}} {#var menu_boot[&1] &2};
    };
    #var menu_reboot 0;
    #if {"$menu_boot[start]" != ""} {#var menu_reboot $menu_boot[start]};
    #NOP -- Once the next reboot is due, count it as done. A character still on at the reboot is cut off a;
    #NOP -- little after the planned time, so allow 10 minutes;
    #if {"$menu_boot[next]" != "" && $menu_boot[next] <= $menu_ld_now} {#math menu_reboot {$menu_boot[next] + 600}};
    #script {menu_tmp} {grep -lF '#var vaf[linkd] 1' chars/*/*.tin 2>/dev/null};
    #foreach {$menu_tmp[%*]} menu_l {
        #regex {$menu_l} {^chars/{[a-z]+}/} {#var menu_linkd[&1] 1};
    };
    #script {menu_tmp} {grep -H xlinkdead_at chars/*/vars.tin 2>/dev/null | tr -d '\173\175'};
    #foreach {$menu_tmp[%*]} menu_l {
        #regex {$menu_l} {^chars/{[a-z]+}/vars.tin:#VARIABLE xlinkdead_at {[0-9]+}} {
            #math menu_left {&2 + $menu_ld_hours * 3600 - $menu_ld_now};
            #if {"$menu_linkd[&1]" == "1"} {#var menu_left 1};
            #NOP -- A guest isn't saved, so it has no linkdead character to keep a timer for;
            #if {$menu_left > 0 && &2 > $menu_reboot && "&1" != "guest"} {#var menu_ld_at[&1] &2};
        };
    };
};

#NOP -- menu_dur <seconds>: menu_dur set to e.g. "3d13h" or "23h05m";
#alias {menu_dur} {
    #math menu_h {%1 / 3600};
    #math menu_m {(%1 % 3600) / 60};
    #if {$menu_h >= 24} {
        #math menu_d {$menu_h / 24};
        #math menu_h {$menu_h % 24};
        #var menu_dur {${menu_d}d${menu_h}h};
        #return;
    };
    #NOP -- TinTin's #format has no %02d, so pad the minutes by hand;
    #if {$menu_m < 10} {#var menu_m {0$menu_m}};
    #var menu_dur {${menu_h}h${menu_m}m};
};

#NOP -- menu_ld_text <name>: menu_ld set to e.g. "linkdead, 23h05m left", or empty.;
#NOP -- Whichever comes first, the limit or the next reboot;
#alias {menu_ld_text} {
    #var menu_ld {};
    #if {"$menu_ld_at[%1]" == ""} {#return};
    #format menu_ld_now {%T};
    #var menu_next 0;
    #if {"$menu_boot[next]" != "" && $menu_boot[next] > $menu_ld_now} {#math menu_next {$menu_boot[next] - $menu_ld_now}};
    #if {"$menu_linkd[%1]" == "1"} {
        #var menu_ld {linkdead until reboot};
        #if {$menu_next > 0} {
            menu_dur $menu_next;
            #var menu_ld {linkdead until reboot, $menu_dur left};
        };
        #return;
    };
    #math menu_left {$menu_ld_at[%1] + $menu_ld_hours * 3600 - $menu_ld_now};
    #if {$menu_left <= 0} {#return};
    #if {$menu_next > 0 && $menu_next < $menu_left} {
        menu_dur $menu_next;
        #var menu_ld {linkdead, $menu_dur left (reboot)};
        #return;
    };
    menu_dur $menu_left;
    #var menu_ld {linkdead, $menu_dur left};
};

#NOP -- menu_boot_text: menu_boot_line set to when the next reboot is, or empty if no login has saved it;
#alias {menu_boot_text} {
    #var menu_boot_line {};
    #if {"$menu_boot[next]" == ""} {#return};
    #format menu_ld_now {%T};
    #if {$menu_boot[next] <= $menu_ld_now} {
        #var menu_boot_line {Next reboot: unknown until a character logs in};
        #return;
    };
    #math menu_l {$menu_boot[next] - $menu_ld_now};
    menu_dur $menu_l;
    #format menu_l {%t} {{%a %b %d %I:%M %p}{$menu_boot[next]}};
    #var menu_boot_line {Next reboot in $menu_dur ($menu_l)};
};

#NOP -- Keep the countdowns current while the menu is up, but not while a question is being answered;
#ticker {menu_ld_tick} {
    #if {(&menu_ld_at[] > 0 || "$menu_boot[next]" != "") && "$menu[prompt]" == ""} {
        menu_ld_load;
        menu_draw;
    };
} {60};

#NOP -- menu_read_guild <name>: the saved guild, or the character file's default;
#alias {menu_read_guild} {
    #script {menu_tmp} {cat chars/%1/guild.tin 2>/dev/null || grep -h '^#var guild' chars/%1/%1.tin 2>/dev/null};
    #regex {$menu_tmp[1]} {guild %w} {#var menu[guild][%1] &1} {#var menu[guild][%1] ?};
};

#alias {menu_save} {#class startmenu_data write $menu[file]};
#alias {menu_save_guild} {#script {menu_tmp} {printf '#var guild %s;\n' '$menu[guild][%1]' > chars/%1/guild.tin}};

#NOP -- menu_link <command> <text>: menu_link set to the text, made to run the command when clicked.;
#NOP -- Secure links (OSC 68, mode 2) can't be faked by text from the game;
#alias {menu_link} {#var menu_link {\e]68;2;MENU;%1\a\e[4;24m%2\e[24m}};

#event {PRESSED SECURE LINK MENU MOUSE BUTTON ONE} {
    #if {"$menu[prompt]" != ""} {#return};
    menu_num_cancel;
    #var menu[msg] {};
    %4;
};

#NOP -- Clicking a character highlights it, and clicking it again logs in;
#alias {menu_click_char} {
    #if {$menu[row] == %1} {
        menu_login %1;
        #return;
    };
    #var menu[row] %1;
    #var menu_sel %1;
    menu_save;
    menu_draw;
};

#NOP -- menu_click_guild <row> <-1 or 1>: the arrows around a guild;
#alias {menu_click_guild} {
    #var menu[row] %1;
    #var menu_sel %1;
    menu_save;
    menu_side %2;
};

#alias {menu_click_button} {
    #var menu[row] {$menu[count] + 1};
    #math menu[row] {$menu[row]};
    #var menu[btn] %1;
    menu_button;
};

#NOP -- The buttons shown on the button row (row count+1);
#alias {menu_buttons} {
    #var menu[buttons] {{1}{Add}};
    #if {$menu[count] > 0} {
        #list menu[buttons] add {{Edit $menu_chars[$menu_sel]}};
        #list menu[buttons] add {{Remove $menu_chars[$menu_sel]}};
    };
    #list menu[buttons] add {{Log in as guest}};
    #list menu[buttons] add {Quit};
};

#NOP -- menu_layout works out what fits. Every row is counted, because anything extra scrolls the top of the menu away;
#NOP -- menu[overflow]: the list doesn't all fit, so it shows menu[top] to menu[bot] and a row saying what's hidden;
#NOP -- menu[tight]: so little room that the gaps, reboot line and long help go, to leave more for characters;
#NOP -- menu_lay_big: there's room for the big logo;
#alias {menu_layout}
{
    #screen get rows menu_lay_rows;
    #screen get cols menu_lay_cols;
    #if {$menu_lay_cols < 1}
    {
        #var menu_lay_cols 80;
    };
    #if {$menu_lay_rows < 1}
    {
        #var menu_lay_rows 24;
    };
    menu_lay_measure_list;
    #NOP -- The button row is two spaces, then each button with its brackets and two spaces after;
    #var menu_lay_len 2;
    #foreach {$menu[buttons][%*]} menu_lay_b
    {
        #format menu_lay_w {%L} {$menu_lay_b};
        #math menu_lay_len {$menu_lay_len + $menu_lay_w + 6};
    };
    menu_lay_wrap $menu_lay_len;
    #var menu_lay_btn_rows $menu_lay_wrapped;
    #var menu_lay_msg_rows 0;
    #if {"$menu[msg]" != ""}
    {
        #format menu_lay_w {%L} {$menu[msg]};
        #math menu_lay_w {$menu_lay_w + 2};
        menu_lay_wrap $menu_lay_w;
        #var menu_lay_msg_rows $menu_lay_wrapped;
    };
    menu_boot_text;
    #var menu_lay_boot_rows 0;
    #if {"$menu_boot_line" != ""}
    {
        #format menu_lay_w {%L} {$menu_boot_line};
        #math menu_lay_w {$menu_lay_w + 2};
        menu_lay_wrap $menu_lay_w;
        #var menu_lay_boot_rows $menu_lay_wrapped;
    };
    #var menu[tight] 0;
    #var menu[overflow] 0;
    #var menu_lay_big 0;
    menu_lay_help;
    #NOP -- Top row, title, reboot, a gap, the list, a gap, buttons, a gap, message, help, and the input line;
    #math menu_lay_fixed {6 + $menu_lay_boot_rows + $menu_lay_btn_rows + $menu_lay_msg_rows + $menu_lay_help_rows};
    #math menu_lay_free {$menu_lay_rows - $menu_lay_fixed};
    #if {$menu_lay_total <= $menu_lay_free}
    {
        #var menu_lay_avail $menu_lay_total;
        #if {$menu_lay_free - $menu_lay_total >= 8 && $menu_lay_cols >= 36}
        {
            #var menu_lay_big 1;
        };
    };
    #else
    {
        #var menu[overflow] 1;
        #math menu_lay_avail {$menu_lay_free - 1};
        #var menu_lay_want 8;
        #if {$menu[count] < 8}
        {
            #var menu_lay_want $menu[count];
        };
        #if {$menu_lay_avail < $menu_lay_want}
        {
            #var menu[tight] 1;
            menu_lay_help;
            #math menu_lay_free {$menu_lay_rows - 2 - $menu_lay_btn_rows - $menu_lay_msg_rows - $menu_lay_help_rows};
            #if {$menu_lay_total <= $menu_lay_free}
            {
                #var menu[overflow] 0;
                #var menu_lay_avail $menu_lay_total;
            };
            #else
            {
                #math menu_lay_avail {$menu_lay_free - 1};
            };
        };
    };
    #if {$menu_lay_avail < 1}
    {
        #var menu_lay_avail 1;
    };
    menu_lay_window;
};

#NOP -- menu_lay_wrap <length>: menu_lay_wrapped set to the rows that text takes. Filling a row exactly counts as two;
#alias {menu_lay_wrap}
{
    #math menu_lay_wrapped {(%1 + $menu_lay_cols) / $menu_lay_cols};
};

#NOP -- Sets the rows each character takes, as a linkdead timer can wrap on a phone, and whether its guild is padded;
#alias {menu_lay_measure_list}
{
    #var menu_lay_row {};
    #var menu_lay_pad {};
    #var menu_lay_total 0;
    #if {$menu[count] == 0}
    {
        #var menu_lay_total 1;
        #return;
    };
    #loop 1 $menu[count] menu_lay_i
    {
        #var menu_c $menu_chars[$menu_lay_i];
        menu_ld_text $menu_c;
        #format menu_lay_name {%L} {$menu_c};
        #if {$menu_lay_name < 10}
        {
            #var menu_lay_name 10;
        };
        #var menu_g $menu[guild][$menu_c];
        #if {&menu_guilds[$menu_c][] > 1}
        {
            #var menu_g {< $menu_g >};
        };
        #format menu_lay_guild {%L} {$menu_g};
        #var menu_lay_padded $menu_lay_guild;
        #if {$menu_lay_padded < 16}
        {
            #var menu_lay_padded 16;
        };
        #format menu_lay_num {%L} {$menu[count]};
        #math menu_lay_base {2 + $menu_lay_num + 2 + $menu_lay_name + 1};
        #var menu_lay_pad[$menu_lay_i] 1;
        #if {"$menu_ld" != ""}
        {
            #format menu_lay_w {%L} {$menu_ld};
            #math menu_lay_len {$menu_lay_base + $menu_lay_padded + 1 + $menu_lay_w};
        };
        #else
        {
            #math menu_lay_len {$menu_lay_base + $menu_lay_padded};
            #if {$menu_lay_len >= $menu_lay_cols}
            {
                #var menu_lay_pad[$menu_lay_i] 0;
                #math menu_lay_len {$menu_lay_base + $menu_lay_guild};
            };
        };
        menu_lay_wrap $menu_lay_len;
        #var menu_lay_row[$menu_lay_i] $menu_lay_wrapped;
        #math menu_lay_total {$menu_lay_total + $menu_lay_wrapped};
    };
};

#NOP -- menu_lay_help sets the help text for where the player is, and the rows it takes;
#alias {menu_lay_help}
{
    #if {"$menu[prompt]" != ""}
    {
        #var menu_lay_hint {Type your answer and press Enter. An empty Enter cancels.};
        #if {$menu[tight]}
        {
            #var menu_lay_hint {Empty Enter cancels};
        };
    };
    #elseif {$menu[row] > $menu[count]}
    {
        #var menu_lay_hint {Left/right: pick a button   Enter: choose   Tab or up: back to $menu_chars[$menu_sel]   q: quit   or click};
        #if {$menu[tight]}
        {
            #var menu_lay_hint {Left/right, Enter   Up: back};
        };
    };
    #else
    {
        #var menu_lay_n {1-$menu[count]: log in directly};
        #if {$menu[count] > 9 || $menu[overflow]}
        {
            #var menu_lay_n {1-$menu[count] then Enter: log in};
        };
        #var menu_lay_p {};
        #if {$menu[overflow]}
        {
            #var menu_lay_p {PgUp/PgDn: page   };
        };
        #var menu_lay_hint {Up/down: character   ${menu_lay_p}Left/right: guild   Enter: log in   Tab: edit/remove   $menu_lay_n   q: quit   or click};
        #if {$menu[tight]}
        {
            #var menu_lay_hint {Up/down, Enter   Tab: buttons};
        };
    };
    #format menu_lay_w {%L} {$menu_lay_hint};
    #math menu_lay_w {$menu_lay_w + 2};
    menu_lay_wrap $menu_lay_w;
    #var menu_lay_help_rows $menu_lay_wrapped;
};

#NOP -- menu_lay_window moves the list only as far as it takes to keep the highlighted character on screen;
#alias {menu_lay_window}
{
    #if {$menu[count] == 0}
    {
        #var menu[top] 1;
        #var menu[bot] 0;
        #return;
    };
    #if {!$menu[overflow]}
    {
        #var menu[top] 1;
        #var menu[bot] $menu[count];
        #return;
    };
    #if {$menu[top] < 1}
    {
        #var menu[top] 1;
    };
    #if {$menu[top] > $menu_sel}
    {
        #var menu[top] $menu_sel;
    };
    #NOP -- Down past the end: drop rows from the top until the highlighted character fits;
    #var menu_lay_sum 0;
    #loop $menu[top] $menu_sel menu_lay_i
    {
        #math menu_lay_sum {$menu_lay_sum + $menu_lay_row[$menu_lay_i]};
    };
    #while {$menu_lay_sum > $menu_lay_avail && $menu[top] < $menu_sel}
    {
        #math menu_lay_sum {$menu_lay_sum - $menu_lay_row[$menu[top]]};
        #math menu[top] {$menu[top] + 1};
    };
    #NOP -- Show as many as fit from there;
    #var menu[bot] $menu[top];
    #var menu_lay_sum $menu_lay_row[$menu[top]];
    #while {$menu[bot] < $menu[count]}
    {
        #math menu_lay_i {$menu[bot] + 1};
        #math menu_lay_w {$menu_lay_sum + $menu_lay_row[$menu_lay_i]};
        #if {$menu_lay_w > $menu_lay_avail}
        {
            #break;
        };
        #var menu_lay_sum $menu_lay_w;
        #var menu[bot] $menu_lay_i;
    };
    #NOP -- Room left at the end, such as after turning a phone sideways: bring earlier characters back;
    #while {$menu[bot] == $menu[count] && $menu[top] > 1}
    {
        #math menu_lay_i {$menu[top] - 1};
        #math menu_lay_w {$menu_lay_sum + $menu_lay_row[$menu_lay_i]};
        #if {$menu_lay_w > $menu_lay_avail}
        {
            #break;
        };
        #var menu_lay_sum $menu_lay_w;
        #var menu[top] $menu_lay_i;
    };
};

#alias {menu_logo}
{
    #if {$menu_lay_big}
    {
        #showme {};
        #showme {<adf><188>  ██████╗ ██╗  ██╗██████╗ ██████╗ <088>};
        #showme {<aef><188>  ╚════██╗██║ ██╔╝██╔══██╗██╔══██╗<088>};
        #showme {<aff><188>   █████╔╝█████╔╝ ██║  ██║██████╔╝<088>};
        #showme {<afe><188>   ╚═══██╗██╔═██╗ ██║  ██║██╔══██╗<088>};
        #showme {<afd><188>  ██████╔╝██║  ██╗██████╔╝██████╔╝<088>};
        #showme {<afc><188>  ╚═════╝ ╚═╝  ╚═╝╚═════╝ ╚═════╝ <088>};
        #if {$menu_lay_cols >= 62}
        {
            #showme {<ddd>  A community project, built by many players of 3Kingdoms.<088>};
        };
        #else
        {
            #showme {<ddd>  Built by the 3k community.<088>};
        };
        #showme {};
        #return;
    };
    #if {$menu[tight]}
    {
        #return;
    };
    #if {$menu_lay_cols >= 36}
    {
        #showme {<aff><188>  3kdb<088>  <ddd>Built by the 3k community<088>};
    };
    #else
    {
        #showme {<aff><188>  3kdb<088>};
    };
};

#NOP -- The row under a scrolled list. Each side can be clicked to page that way;
#alias {menu_draw_more}
{
    #var menu_line {  };
    #if {$menu[top] > 1}
    {
        #math menu_lay_i {$menu[top] - 1};
        menu_link {menu_page -1} {▲ $menu_lay_i above};
        #cat menu_line {<aff>$menu_link<088>   };
    };
    #if {$menu[bot] < $menu[count]}
    {
        #math menu_lay_i {$menu[count] - $menu[bot]};
        menu_link {menu_page 1} {▼ $menu_lay_i below};
        #cat menu_line {<aff>$menu_link<088>};
    };
    #showme {$menu_line};
};

#alias {menu_draw}
{
    menu_buttons;
    menu_layout;
    #screen clear all;
    menu_logo;
    #if {$menu[tight]}
    {
        #showme {<aff><188>  3kdb<088>  <ffa>Choose a character<088>};
    };
    #else
    {
        #showme {<ffa>  Choose a character<088>};
        #if {"$menu_boot_line" != ""}
        {
            #showme {<ddd>  $menu_boot_line<088>};
        };
        #showme {};
    };
    #if {$menu[count] > 0}
    {
        #loop $menu[top] $menu[bot] i
        {
            #var menu_c $menu_chars[$i];
            #var menu_g $menu[guild][$menu_c];
            #if {&menu_guilds[$menu_c][] > 1}
            {
                #var menu_g {< $menu_g >};
            };
            #var menu_n $i;
            #if {$menu[count] > 9 && $i < 10}
            {
                #var menu_n { $i};
            };
            menu_ld_text $menu_c;
            #format menu_line {  %s: %-10s} {$menu_n} {$menu_c};
            menu_link {menu_click_char $i} {$menu_line};
            #var menu_line $menu_link;
            #NOP -- Pad the guild before adding the links, which would count toward the width;
            #if {$menu_lay_pad[$i]}
            {
                #format menu_g {%-16s} {$menu_g};
            };
            #if {&menu_guilds[$menu_c][] > 1}
            {
                menu_link {menu_click_guild $i -1} {<};
                #replace menu_g {<} {$menu_link};
                menu_link {menu_click_guild $i 1} {>};
                #replace menu_g {>} {$menu_link};
            };
            #var menu_line {$menu_line $menu_g};
            #if {"$menu_ld" != ""}
            {
                #var menu_line {$menu_line $menu_ld};
            };
            #if {$i == $menu[row]}
            {
                #showme {<AAE><fff>$menu_line<088>};
            };
            #else
            {
                #showme {<ddd>$menu_line<088>};
            };
        };
    };
    #else
    {
        #showme {<ddd>  No characters yet<088>};
    };
    #if {$menu[overflow]}
    {
        menu_draw_more;
    };
    #if {!$menu[tight]}
    {
        #showme {};
    };
    #var menu_line {  };
    #loop 1 &menu[buttons][] i
    {
        menu_link {menu_click_button $i} {[ $menu[buttons][$i] ]};
        #if {$menu[row] == $menu[count] + 1 && $i == $menu[btn]}
        {
            #cat menu_line {<AAE><fff>$menu_link<088>  };
        };
        #else
        {
            #cat menu_line {<ddd>$menu_link<088>  };
        };
    };
    #showme {$menu_line};
    #if {!$menu[tight]}
    {
        #showme {};
    };
    #if {"$menu[msg]" != ""}
    {
        #showme {  $menu[msg]};
    };
    #showme {<ddd>  $menu_lay_hint<088>};
};

#NOP -- menu_page <-1 or 1>: move a screenful through the list, for PgUp/PgDn and clicking the row under it;
#alias {menu_page}
{
    #if {"$menu[prompt]" != "" || $menu[count] == 0}
    {
        #return;
    };
    menu_num_cancel;
    #var menu[msg] {};
    #math menu_lay_w {$menu_sel + %1 * $menu_lay_avail};
    menu_jump $menu_lay_w;
};

#NOP -- menu_wheel <-1 or 1>: one character at a time. Unlike the arrows it stops at the ends instead of wrapping;
#alias {menu_wheel}
{
    #if {"$menu[prompt]" != "" || $menu[count] == 0 || $menu[row] > $menu[count]}
    {
        #return;
    };
    menu_num_cancel;
    #var menu[msg] {};
    #math menu_lay_w {$menu_sel + %1};
    menu_jump $menu_lay_w;
};

#alias {menu_jump}
{
    #var menu_sel %1;
    #if {$menu_sel < 1}
    {
        #var menu_sel 1;
    };
    #if {$menu_sel > $menu[count]}
    {
        #var menu_sel $menu[count];
    };
    #var menu[row] $menu_sel;
    menu_save;
    menu_draw;
};

#alias {menu_move} {
    #if {"$menu[prompt]" != ""} {#return};
    menu_num_cancel;
    #var menu[msg] {};
    #NOP -- Up from the buttons goes back to the character they're for;
    #if {$menu[row] > $menu[count] && %1 < 0 && $menu[count] > 0} {
        #var menu[row] $menu_sel;
        menu_draw;
        #return;
    };
    #math menu[row] {$menu[row] + %1};
    #if {$menu[row] < 1} {#var menu[row] {$menu[count] + 1}};
    #if {$menu[row] > $menu[count] + 1} {#var menu[row] 1};
    #math menu[row] {$menu[row]};
    #if {$menu[row] <= $menu[count]} {
        #var menu_sel $menu[row];
        menu_save;
    };
    menu_draw;
};

#NOP -- Tab jumps between the highlighted character and its Edit/Remove buttons;
#alias {menu_tab} {
    #if {"$menu[prompt]" != ""} {#return};
    menu_num_cancel;
    #var menu[msg] {};
    #if {$menu[row] > $menu[count]} {
        #if {$menu[count] > 0} {#var menu[row] $menu_sel};
    } {
        #var menu[row] {$menu[count] + 1};
        #math menu[row] {$menu[row]};
        #var menu[btn] 2;
    };
    menu_draw;
};

#NOP -- Left/right: change the guild on a character row, the button on the button row, or move the cursor while typing;
#alias {menu_side} {
    #if {"$menu[prompt]" != ""} {
        #if {%1 > 0} {#cursor forward} {#cursor backward};
        #return;
    };
    menu_num_cancel;
    #if {$menu[row] > $menu[count]} {
        #math menu[btn] {$menu[btn] + %1};
        #if {$menu[btn] < 1} {#var menu[btn] &menu[buttons][]};
        #if {$menu[btn] > &menu[buttons][]} {#var menu[btn] 1};
        menu_draw;
        #return;
    };
    #var menu_c $menu_chars[$menu[row]];
    #if {&menu_guilds[$menu_c][] < 2} {#return};
    #list menu_guilds[$menu_c] find {$menu[guild][$menu_c]} menu_i;
    #math menu_i {$menu_i + %1};
    #if {$menu_i < 1} {#var menu_i &menu_guilds[$menu_c][]};
    #if {$menu_i > &menu_guilds[$menu_c][]} {#var menu_i 1};
    #var menu[guild][$menu_c] $menu_guilds[$menu_c][$menu_i];
    menu_save_guild $menu_c;
    menu_draw;
};

#NOP -- Number keys log in directly, or type the digit while answering a question.;
#NOP -- With 10 or more characters the digits only pick, adding up (1 then 2 is 12), and Enter logs in;
#var menu_num {};
#alias {menu_digit} {
    #if {"$menu[prompt]" != ""} {
        #cursor set {%1};
        #return;
    };
    #if {%1 == 0 && "${menu_num}" == ""} {
        #if {"${menu_zero}" == "1"} {
            #unvar menu_zero;
            #undelay {menu_zero};
            menu_refresh_ld;
        } {
            #var menu_zero 1;
            #delay {menu_zero} {#unvar menu_zero} {1.5};
        };
        #return;
    };
    #NOP -- With the list scrolling, a character might be off screen, so don't log in without showing it first;
    #if {$menu[count] < 10 && !$menu[overflow]} {
        #if {%1 <= $menu[count]} {menu_login %1};
        #return;
    };
    #math menu_num {${menu_num}%1};
    #NOP -- Too big: start over from this digit;
    #if {$menu_num > $menu[count]} {#math menu_num {%1}};
    #if {$menu_num < 1} {
        #var menu_num {};
        #return;
    };
    #var menu_sel $menu_num;
    #var menu[row] $menu_num;
    #var menu[msg] {<ffa>Enter: log in to $menu_chars[$menu_num], or type the next digit<088>};
    menu_draw;
};

#alias {menu_refresh_ld} {
    #var menu_refresh_q {};
    #var menu_refresh_n 0;
    #foreach {$menu_chars[%*]} {menu_c} {
        #if {"$menu_ld_at[$menu_c]" != "" && "$menu_linkd[$menu_c]" != "1"} {
            #list menu_refresh_q add {$menu_c};
            #math menu_refresh_n {$menu_refresh_n + 1};
        };
    };
    #if {$menu_refresh_n == 0} {
        #var menu[msg] {<ffa>No linkdead characters to refresh<088>};
        menu_draw;
        #return;
    };
    #var menu_refresh_done {};
    #var menu_refresh_on 1;
    menu_refresh_next;
};

#alias {menu_refresh_next} {
    #undelay {menu_refresh_wd};
    #if {$menu_refresh_n == 0} {
        #unvar menu_refresh_on;
        #var menu[msg] {<ffa>Linkdead timers refreshed:$menu_refresh_done<088>};
        menu_draw;
        #return;
    };
    #var menu_refresh_c $menu_refresh_q[1];
    #list menu_refresh_q delete 1;
    #math menu_refresh_n {$menu_refresh_n - 1};
    #var menu_refresh_done {$menu_refresh_done $menu_refresh_c};
    #delay {menu_refresh_wd} {
        #unvar menu_refresh_on;
        #showme {<faa>Linkdead refresh stopped: $menu_refresh_c did not finish in 2 minutes<088>};
    } {120};
    #loop 1 $menu[count] i {
        #if {"$menu_chars[$i]" == "$menu_refresh_c"} {menu_login $i};
    };
};

#NOP -- Arrows and Tab drop a number being typed;
#alias {menu_num_cancel} {#var menu_num {}};

#alias {menu_login} {
    #if {"%1" != ""} {#var menu_sel %1};
    #var menu_char $menu_chars[$menu_sel];
    #if {"$menu_char" == ""} {#return};
    menu_save;
    menu_save_guild $menu_char;
    #var menu_guild_pick $menu[guild][$menu_char];
    menu_start_connect;
};

#NOP -- Remove the menu keys before connecting so they aren't copied into the game session.;
#NOP -- The mouse goes back off, as 3kdb has it in game until you turn it on with qq;
#alias {menu_start_connect}
{
    #delay {0} {#class startmenu kill;#config mouse off;menu_connect};
};

#NOP -- Guests have no password and aren't saved by the game, so this stays off the character list;
#NOP -- and its folder (ignored by git) is made the first time it's needed;
#alias {menu_login_guest}
{
    #script {menu_tmp} {test -f chars/guest/guest.tin && echo yes};
    #if {"$menu_tmp[1]" != "yes"}
    {
        menu_create_files guest adventurer;
    };
    menu_save;
    #var menu_char guest;
    #var menu[guild][guest] adventurer;
    menu_save_guild guest;
    #var menu_guild_pick adventurer;
    menu_start_connect;
};

#NOP -- Every line typed while the menu is up comes here first;
#alias {menu_input} {
    #if {"$menu[prompt]" != ""} {
        menu_answer {%1};
        #return;
    };
    #if {"%1" == ""} {
        #if {$menu[row] <= $menu[count]} {
            menu_login;
        } {
            menu_button;
        };
        #return;
    };
    #NOP -- Anything else typed is run as a normal command;
    %1;
};

#alias {menu_button} {
    #var menu_b $menu[buttons][$menu[btn]];
    #var menu_c $menu_chars[$menu_sel];
    #if {"$menu_b" == "Add"} {
        menu_ask add_name {New character name:} {};
    };
    #if {"$menu_b" == "Edit $menu_c"} {
        #var menu[edit] $menu_c;
        #var menu_tmp {};
        #foreach {$menu_guilds[$menu_c][%*]} menu_g {#var menu_tmp {$menu_tmp $menu_g}};
        #format menu_tmp {%p} {$menu_tmp};
        menu_ask edit_guilds {Guilds for $menu_c, separated by spaces (the first is the default):} {$menu_tmp};
    };
    #if {"$menu_b" == "Log in as guest"} {menu_login_guest};
    #if {"$menu_b" == "Quit"} {menu_quit};
    #if {"$menu_b" == "Remove $menu_c"} {
        #var menu[edit] $menu_c;
        menu_ask remove {Type yes to remove $menu_c from the menu (its files are kept):} {};
    };
};

#NOP -- menu_ask <step> <question> <prefilled answer>;
#NOP -- The prefill waits a tick: menu_ask runs while Enter is still being handled, and TinTin clears;
#NOP -- the input line after that, so text set now shows on screen but Enter would send it empty;
#alias {menu_ask} {
    #var menu[prompt] {%1};
    #var menu[msg] {<ffa>%2<088>};
    menu_draw;
    #if {"%3" != ""} {#delay {menu_prefill} {#cursor set {%3}} {0}};
};

#alias {menu_done} {
    #var menu[prompt] {};
    #var menu[msg] {%1};
    menu_draw;
};

#NOP -- menu_check_guilds <answer>: sets menu_ok and menu_new (the guild list) or menu_bad;
#alias {menu_check_guilds} {
    #var menu_ok 0;
    #var menu_new {};
    #var menu_bad {};
    #regex {%1} {^{[a-z ]+}$} {#NOP} {#var menu_bad { %1}; #return};
    #NOP -- Guilds with a common/guilds/<guild> folder, in order without repeats, then the ones without;
    #script {menu_tmp} {for _mg in %1; do [ -f common/guilds/$_mg/index.tin ] && echo $_mg; done | awk '!s[$0]++'};
    #if {"$menu_tmp[1]" != ""} {#var menu_new $menu_tmp};
    #script {menu_tmp} {for _mg in %1; do [ -f common/guilds/$_mg/index.tin ] || printf ' %s' $_mg; done};
    #var menu_bad {$menu_tmp[1]};
    #if {"$menu_bad" == "" && &menu_new[] > 0} {#var menu_ok 1};
};

#alias {menu_answer} {
    #format menu_in {%l} {%1};
    #format menu_in {%p} {$menu_in};
    #if {"$menu_in" == "" && "$menu[prompt]" != "add_password"} {
        menu_done {<ddd>Cancelled<088>};
        #return;
    };
    #switch {"$menu[prompt]"} {
        #case {"add_name"} {
            #regex {$menu_in} {^{[a-z]+}$} {
                #list menu_chars find {$menu_in} menu_i;
                #if {$menu_i > 0} {
                    menu_ask add_name {<faa>$menu_in is already in the menu.<ffa> New character name:} {};
                } {
                    #var menu[edit] $menu_in;
                    menu_read_guild $menu_in;
                    #if {"$menu[guild][$menu_in]" == "?"} {#var menu_tmp {}} {#var menu_tmp $menu[guild][$menu_in]};
                    menu_ask add_guilds {Guilds for $menu_in, separated by spaces (the first is the default):} {$menu_tmp};
                };
            } {
                menu_ask add_name {<faa>Names are letters only.<ffa> New character name:} {};
            };
        };
        #case {"add_guilds"} {
            menu_check_guilds {$menu_in};
            #if {!$menu_ok} {
                menu_ask add_guilds {<faa>3kdb has no scripts for:$menu_bad.<ffa> Guilds for $menu[edit]:} {$menu_in};
                #return;
            };
            #var menu[newguilds] $menu_new;
            #script {menu_tmp} {test -f chars/$menu[edit]/$menu[edit].tin && echo yes};
            #if {"$menu_tmp[1]" == "yes"} {
                menu_add_finish;
            } {
                menu_ask add_password {Password for $menu[edit], saved in chars/$menu[edit]/private.tin. It shows while you type. Leave it empty to type it at each login:} {};
            };
        };
        #case {"add_password"} {
            menu_create_files $menu[edit] {$menu_new[1]};
            #if {"%1" != ""} {#line log {chars/$menu[edit]/private.tin} {#var PASSWORD {%1};}};
            menu_add_finish;
        };
        #case {"edit_guilds"} {
            menu_check_guilds {$menu_in};
            #if {!$menu_ok} {
                menu_ask edit_guilds {<faa>3kdb has no scripts for:$menu_bad.<ffa> Guilds for $menu[edit]:} {$menu_in};
                #return;
            };
            #var menu_guilds[$menu[edit]] $menu_new;
            #list menu_new find {$menu[guild][$menu[edit]]} menu_i;
            #if {$menu_i == 0} {
                #var menu[guild][$menu[edit]] $menu_new[1];
                menu_save_guild $menu[edit];
            };
            menu_save;
            menu_done {<afa>Saved guilds for $menu[edit]<088>};
        };
        #case {"remove"} {
            #if {"$menu_in" == "yes"} {
                #list menu_chars find {$menu[edit]} menu_i;
                #if {$menu_i > 0} {#list menu_chars delete $menu_i};
                #unvar menu_guilds[$menu[edit]];
                #var menu[count] &menu_chars[];
                #if {$menu_sel > $menu[count]} {#var menu_sel $menu[count]};
                #if {$menu_sel < 1} {#var menu_sel 1};
                #var menu[btn] 1;
                menu_save;
                menu_done {<afa>Removed $menu[edit] from the menu<088>};
            } {
                menu_done {<ddd>Cancelled<088>};
            };
        };
    };
};

#NOP -- New character: copy chars/template and write a character file that reads private.tin and guild.tin;
#alias {menu_create_files} {
    #script {menu_tmp} {mkdir -p chars/%1 && cp -n chars/template/*.tin chars/%1/ && rm -f chars/%1/playername.tin && printf 'private.tin\n' > chars/%1/.gitignore && echo ok};
    #line log {chars/%1/%1.tin} {#NOP -- Set Player specific variables;};
    #line log {chars/%1/%1.tin} {#var user %1;};
    #line log {chars/%1/%1.tin} {#read chars/\$user/private.tin;};
    #line log {chars/%1/%1.tin} {#NOP -- Clear the last character's saved variables so they don't carry over to this one;};
    #line log {chars/%1/%1.tin} {#class global kill;};
    #line log {chars/%1/%1.tin} {#read chars/\$user/vars.tin;};
    #line log {chars/%1/%1.tin} {#var guild %2;};
    #line log {chars/%1/%1.tin} {#NOP -- The startup menu and gswap save the current guild here;};
    #line log {chars/%1/%1.tin} {#read chars/\$user/guild.tin;};
    #line log {chars/%1/%1.tin} {#NOP -- Load Common files;};
    #line log {chars/%1/%1.tin} {#NOP -- _load_3kdb_common is located in common/config.tin;};
    #line log {chars/%1/%1.tin} {#read common/index.tin;};
};

#alias {menu_add_finish} {
    #var menu_c $menu[edit];
    #list menu_chars add {$menu_c};
    #var menu_guilds[$menu_c] $menu[newguilds];
    #var menu[count] &menu_chars[];
    #NOP -- Existing character files from before the menu need to read guild.tin;
    #script {menu_tmp} {grep -q 'guild.tin' chars/$menu_c/$menu_c.tin || sed -i '/^#var guild /a #read chars/\$user/guild.tin;' chars/$menu_c/$menu_c.tin};
    #list menu_guilds[$menu_c] find {$menu[guild][$menu_c]} menu_i;
    #if {$menu_i == 0} {#var menu[guild][$menu_c] $menu_guilds[$menu_c][1]};
    menu_save_guild $menu_c;
    #var menu_sel $menu[count];
    #var menu[row] $menu[count];
    menu_save;
    menu_done {<afa>Added $menu_c<088>};
};

#NOP -- q quits TinTin, unless it's being typed into a question or a command;
#alias {menu_q} {
    #cursor get {menu_cur};
    #if {"$menu[prompt]" != "" || "$menu_cur" != ""} {
        #cursor set {q};
        #return;
    };
    menu_quit;
};

#alias {menu_quit} {
    #showme {};
    #if {&menu_ld_at[] > 0} {
        #var menu_l {};
        #foreach *menu_ld_at[] menu_c {#var menu_l {$menu_l $menu_c}};
        #showme {<ffa>  Still linkdead:$menu_l<088>};
    };
    #end;
};

#macro {\e[A} {menu_move -1};
#macro {\e[B} {menu_move 1};
#macro {\e[C} {menu_side 1};
#macro {\e[D} {menu_side -1};
#macro {\eOA} {menu_move -1};
#macro {\eOB} {menu_move 1};
#macro {\eOC} {menu_side 1};
#macro {\eOD} {menu_side -1};
#macro {1} {menu_digit 1};
#macro {2} {menu_digit 2};
#macro {3} {menu_digit 3};
#macro {4} {menu_digit 4};
#macro {5} {menu_digit 5};
#macro {6} {menu_digit 6};
#macro {7} {menu_digit 7};
#macro {8} {menu_digit 8};
#macro {9} {menu_digit 9};
#macro {0} {menu_digit 0};
#macro {\t} {menu_tab};
#macro {q} {menu_q};
#event {CATCH RECEIVED INPUT} {menu_input {%0}};
#macro {\e[5~} {menu_page -1};
#macro {\e[6~} {menu_page 1};
#event {SCROLLED MOUSE WHEEL UP}
{
    menu_wheel -1;
};
#event {SCROLLED MOUSE WHEEL DOWN}
{
    menu_wheel 1;
};
#NOP -- Rotating a phone or resizing the window changes how much fits;
#event {SCREEN RESIZE}
{
    menu_draw;
};

#class startmenu close;

#NOP -- Everything below stays loaded after login, so it's copied into the game sessions;

#NOP -- Read the password, load the character (which connects), then send the name.;
#NOP -- 3k drops anything sent before its Password: prompt, so the password waits for the prompt.;
#NOP -- Without a saved password only the name is sent, so you can type the password yourself;
#alias {menu_connect} {
    menu_close_classes;
    #unvar PASSWORD;
    #script {menu_tmp} {test -f chars/$menu_char/private.tin && echo yes};
    #if {"$menu_tmp[1]" == "yes"} {#read chars/$menu_char/private.tin};
    #NOP -- Git ignores a new character's vars.tin, so a folder from the project can arrive without one;
    #script {menu_tmp} {cp -n chars/template/vars.tin chars/$menu_char/vars.tin};
    #read chars/$menu_char/$menu_char.tin;
    #NOP -- The guild scripts load when the game welcomes you, so the menu's pick can still replace the file's default;
    #if {"$menu_guild_pick" != "" && "$menu_guild_pick" != "?"} {#var guild $menu_guild_pick};
    #if {"$PASSWORD" != "" && "$PASSWORD" != "\$PASSWORD"} {
        #NOP -- Not anchored: the prompt can share a line with the name prompt before it;
        #line oneshot #action {Password:} {#send {$PASSWORD}};
    };
    #line oneshot #action {^Would you like to create this character}
    {
        menu_new_char_prompt;
    };
    #line oneshot #action {^Are you the owner of that character}
    {
        menu_name_in_use_prompt;
    };
    $menu_char;
};

#NOP -- 3k asks this for a name that's in use but not saved yet, like a new level 1. y asks for its password, then;
#NOP -- creates the character again and disconnects the old one. That never gets a Password: prompt, so that;
#NOP -- action goes, or later game text could set it off. The new ones only listen once 3k has asked;
#alias {menu_name_in_use_prompt}
{
    #showme {<ffa>$user is already in use, by a character that isn't saved yet. If it's yours, type y. If not, type n and pick another name.<088>};
    #if {"$PASSWORD" != "" && "$PASSWORD" != "\$PASSWORD"}
    {
        #unaction {Password:};
        #line oneshot #action {^Enter any valid password used with this name:}
        {
            #send {$PASSWORD};
        };
        menu_listen_new_char_passwords;
    };
};

#NOP -- 3k doesn't know this name yet. The player answers y or n, since a typo would make a real character.;
#NOP -- The saved password is used for the two new prompts, and they only listen once 3k has asked.;
#NOP -- This login never gets a Password: prompt, so that action goes, or later game text could set it off;
#alias {menu_new_char_prompt}
{
    #showme {<ffa>$user isn't on 3k yet. Type y to create this character, or n to cancel. Check the spelling first.<088>};
    #if {"$PASSWORD" != "" && "$PASSWORD" != "\$PASSWORD"}
    {
        #unaction {Password:};
        menu_listen_new_char_passwords;
    };
};

#alias {menu_listen_new_char_passwords}
{
    #line oneshot #action {^Enter the password you wish to use:}
    {
        #send {$PASSWORD};
    };
    #line oneshot #action {^Please type the password again for confirmation:}
    {
        #send {$PASSWORD};
    };
};

#NOP -- In game: gswap <guild> swaps guilds. Once the game confirms with "You feel... different.",;
#NOP -- it reloads 3kdb's scripts for the new guild and saves it for next login;
#alias {gswap %1} {
    #send {gswap %1};
    #script {menu_tmp} {test -f common/guilds/%1/index.tin && echo ok};
    #if {"$menu_tmp[1]" != "ok"} {
        #echo {<eaa>3kdb has no scripts for guild %1, so only the game guild will swap<088>};
        #return;
    };
    #var gswap_pending %1;
    #unaction {^You feel... different.$};
    #line oneshot #action {^You feel... different.$} {
        #undelay gswap_wait;
        #script {menu_tmp} {printf '#var guild %s;\n' '$gswap_pending' > chars/$user/guild.tin};
        #NOP -- Give the game a moment to finish logging you back in before reloading;
        #delay {gswap_reload} {.gswap $gswap_pending} {2};
    };
    #delay {gswap_wait} {
        #unaction {^You feel... different.$};
        #echo {<eaa>No swap confirmation from the game, so 3kdb is still set up for $guild<088>};
    } {20};
};

#NOP -- Linkdeath timers. Without the linkd VAF the game boots a linkdead character after this many hours.;
#NOP -- With it (#var vaf[linkd] 1 in the character file) only a reboot does;
#var menu_ld_hours 24;

#NOP -- 3kdb's welcome actions set sessionActive when the game has logged you in, linkdead or not, so the old;
#NOP -- timer no longer applies. Only the first time per session, so a repeated welcome line can't undo a takeover;
#event {VARIABLE UPDATED sessionActive} {
    #if {"$sessionActive" == "1" && "$user" != "" && "$menu_ld_in" != "1"} {
        #var menu_ld_in 1;
        #var menu_ld_skip 0;
        #unvar xlinkdead_at;
        #if {"$menu_refresh_on" == "1"} {#delay {menu_refresh_zap} {#zap} {0.1}};
    };
};

#NOP -- Quitting isn't going linkdead. The game prints this on every quit, before "Saving <name>." and the;
#NOP -- disconnect, whatever alias sent the quit (again, anecdote and ser in our logs). A quit that fails prints nothing;
#action {^There was this one time, at band camp...$} {#var menu_ld_skip 1} {2};

#NOP -- Someone logging in to the character from elsewhere takes it over, so it isn't left linkdead.;
#NOP -- The takeover flag wears off in case that login failed;
#action {^Game Driver tells you: Someone is attempting to login to your character.} {
    #var menu_ld_skip 1;
    #delay {menu_ld_skip} {#var menu_ld_skip 0} {60};
} {1};

#NOP -- Any other disconnect of a logged-in character (#zap, #end, idling out, a dropped connection) leaves it;
#NOP -- linkdead, so save the time in its vars.tin (xlinkdead_at) for the menu. A quit or takeover clears it;
#event {SESSION DISCONNECTED} {
    #if {"$user" != "" && "$sessionActive" == "1"} {
        #class global open;
        #if {"$menu_ld_skip" == "1"} {#unvar xlinkdead_at} {#format xlinkdead_at {%T}};
        #class global close;
        _variable_export;
    };
};

#NOP -- Bring the menu back once every game session has closed (the startup session itself counts as one).;
#NOP -- The event runs in the closing session, so the check is scheduled in the startup session;
#alias {_menu_back_check} {
    #info sessions save;
    #if {&info[SESSIONS][] <= 1} {
        #read startmenu.tin;
    } {
        #if {"$menu_refresh_on" == "1"} {#delay {menu_back} {_menu_back_check} {0.05}};
    };
};
#event {SESSION DEACTIVATED} {
    #gts {
        #if {"$menu_refresh_on" == "1"} {
            #delay {menu_back} {_menu_back_check} {0.02};
        } {
            #delay {menu_back} {_menu_back_check} {0.5};
        };
    };
};

#NOP -- The mouse makes the menu clickable. Hold shift to select text while it's on;
#config mouse on;
menu_load;
#if {"$menu_refresh_on" == "1"} {menu_refresh_next} {menu_draw};
