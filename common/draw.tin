#CLASS draw {kill};
#CLASS draw {open};

#unvar draw[index];
#var draw[initiated] 0;
#var draw[index][caption] 1;
#var draw[chat][active] on;
#var draw[chat][size] .2;
#var draw[map][active] on;
#NOP -- hidemap is saved with the other toggles, and this file reloads at every login;
#if {"$toggles[hidemap]" == "1"}
{
    #var draw[map][active] off;
};
#var draw[map][position] top;
#var draw[map][size] .3;
#var draw[hpbar][active] on;
#var draw[room][active] on;
#var draw[ticker][active] on;
#var draw[caption][active] on;
#NOP -- hidecaption is saved the same way as hidemap;
#if {"$toggles[hidecaption]" == "1"}
{
    #var draw[caption][active] off;
};
#var draw[mobile][active] 0;
#var draw[status][active] on;
#var draw[strategy][active] on;

#list bot_data clear;
#list caption_data clear;
#list strategy_data clear;

#if {"${caption[tab]}" === ""} {#var caption[tab] general};

#var caption_toggle[corpses][active] 1;
#var caption_toggle[eternal][active] 1;
#var caption_toggle[strategy][active] 1;
#var caption_toggle[bot][active] 1;
#var caption_toggle[xp][active] 1;
#var caption_toggle[bot_cycle][active] 1;
#var caption_toggle[map][active] 1;

#var caption_toggle[corpses][order] 1;
#var caption_toggle[eternal][order] 2;
#var caption_toggle[bot][order] 3;
#var caption_toggle[xp][order] 4;
#var caption_toggle[strategy][order] 5;
#var caption_toggle[bot_cycle][order] 6;
#var caption_toggle[map][order] 7;
#format caption_title_string {%+9sGeneral    Bot    Map%-9s};

#NOP -- Mouse press events;
#EVENT {SHORT-CLICKED MOUSE BUTTON ONE} {
    #line strip {#var {tmpClickItem} {%4}};
    #format tmpClickItem {%p} {$tmpClickItem};
    #if {"$tmpClickItem" == "General"} {
       caption_view general; 
    };
    #if {"$tmpClickItem" == "Bot"} {
       caption_view bot; 
    };
    #if {"$tmpClickItem" == "Map"} {
       caption_view map;
    };
};


#alias caption_view {
    #format {tmpItem} {%p} {%0};
    #if {"$tmpItem" == ""} {#NOP} {
        #if {"$tmpItem" == "general"} {
            #format caption_title_string {%+9s<cfc>General<088>    <cde>Bot<088>    <cde>Map<088>%-9s};
            #var caption[tab] general;
            _update_caption_data;
        };
        #if {"$tmpItem" == "bot"} {
            #format caption_title_string {%+9s<cde>General<088>    <cfc>Bot<088>    <cde>Map<088>%-9s};
            #var caption[tab] bot;
            _update_caption_data;
        };
        #if {"$tmpItem" == "map"} {
            #format caption_title_string {%+9s<cde>General<088>    <cde>Bot<088>    <cfc>Map<088>%-9s};
            #var caption[tab] map;
            _update_caption_data;
        };
    };
};

#NOP Pass 0-100 percentage number to split the current screen at.;
#alias {setsplit} {
    #math _perc {%1 * .01}; 
    #var map[widthperc] $_perc;
    #show \nSplit width percentage set to: %1\%;
    init_screen;
};

#NOP -- @draw_ticker_rows{}: the ticker's lines, 3 at least. At login the ticker has no lines yet and;
#NOP -- &ticker_data[] stays as text, which made halfchat and bigchat come back the normal size after ld;
#function {draw_ticker_rows} {
    #var result 3;
    #if {&{ticker_data}} {
        #if {&ticker_data[] > 3} {
            #var result &ticker_data[];
        };
    };
};

#NOP Calculate various area dimensions, called on start and SCREEN RESIZE;
#alias init_screen {
    #screen get rows screen[height];
    #screen get cols screen[width];

    #NOP -- Phone detection: readable play and gauges on phones, targeting iPhone 17 Pro;
    #NOP -- in portrait/landscape terminals over SSH/tmux. Detect terminal cells,;
    #NOP -- not device identity or pixel size: font, keyboard and tmux affect these.;
    #NOP -- Width <= 75 selects portrait first, otherwise height <= 20 selects;
    #NOP -- landscape, otherwise desktop. Detection always runs, but nothing changes;
    #NOP -- unless toggle phone or phone_layout is on. phone_layout is on by default.;
    #NOP -- Human/AI maintainers: keep detection here and reset both values on resize.;
    #NOP -- Extend using measured rows/cols and check 75/76 cols and 20/21 rows,;
    #NOP -- rotation, desktop reattach, pane toggles and mapFull entry/exit.;
    #if {$screen[width] <= 75} {
        #var draw[mobile][active] 1;
        #var draw[mobile][mode] portrait;
    } {
        #if {$screen[height] <= 20} {
            #var draw[mobile][active] 1;
            #var draw[mobile][mode] landscape;
        } {
            #var draw[mobile][active] 0;
            #var draw[mobile][mode] desktop;
        };
    };

    #NOP -- phone_layout is the portrait phone layout: 5 chat rows and no side column. It's on by default, and;
    #NOP -- the first draw at login comes before the saved defaults are filled in, so only a 0 turns it off;
    #var draw[mobile][layout] 0;
    #if {"$toggles[phone_layout]" != "0" && "$draw[mobile][mode]" == "portrait"} {
        #var draw[mobile][layout] 1;
    };

    #NOP -- The side column (map and caption) goes when nothing should be in it. Toggle phone;
    #NOP -- drops it on any phone screen, phone_layout in portrait, and hidemap with hidecaption;
    #NOP -- drops it everywhere. The pane settings themselves never change here, so going back;
    #NOP -- to a PC shows whatever panes were showing there before.;
    #var draw[side][hidden] 0;
    #if {$draw[mobile][layout]} {
        #var draw[side][hidden] 1;
    };
    #if {"$toggles[phone]" == "1" && $draw[mobile][active]} {
        #var draw[side][hidden] 1;
    };
    #if {"$draw[map][active]" == "off" && "$draw[caption][active]" == "off"} {
        #var draw[side][hidden] 1;
    };

    #NOP -- bigchat and halfchat need the map in its top spot, there's no room for it under the chat;
    #var draw[map][istop] 0;
    #if {"$draw[map][position]" == "top" || "$toggles[bigchat]" == "1" || "$toggles[halfchat]" == "1"} {
        #var draw[map][istop] 1;
    };

    #if {$draw[mobile][layout]} {
        #var chat[rows] 5;
        #math chat[height] {$chat[rows] + 2};
    } {
        #format chat[rows] {%d} {$screen[height] * $draw[chat][size]};
        #math chat[height] {$chat[rows] + 1};
        #math chat[rows] {$chat[rows] - 1};
    };

    #NOP -- If map width isn't set, make it 33%;
    #if {$map[widthperc] > 0} {#NOP} {#var map[widthperc] .33};
    #format map[width] {%d} {$map[widthperc] * $screen[width]};
    #math map[left] {$screen[width] - $map[width]};

    #format map[height] {%d} {$draw[map][size] * $screen[height]};

    #if {"$draw[map][active]" == "on" && !$draw[side][hidden]} {
        #if {$draw[map][istop]} {
            #var map[top] 2;
        } {
            #math map[top] {$chat[height] + 2};
        };
        #if {"$draw[room][active]" == "on"} {
            #math map[bottom] {$map[top] + $map[height] + 2};
        } {
            #math map[bottom] {$map[top] + $map[height]};
        };
    } {
        #var map[top] 0;
        #var map[bottom] 0;
        #NOP -- caption[top] comes from map[bottom]. With the map on the side chat is full width, so stay under it;
        #if {!$draw[map][istop]} {
            #var map[bottom] $chat[height];
        };
    };

    #if {"$draw[hpbar][active]" == "on"} {
        #list {hpbar[prompt]} {size} {hpbar[height]};
    } {
        #var hpbar[height] 0;
    };

    #NOP -- With the caption hidden, the map stretches down the whole right side. Its box ends on the row;
    #NOP -- the caption panel would have ended on, just above the line over the hpbar;
    #if {"$draw[map][active]" == "on" && "$draw[caption][active]" == "off" && !$draw[side][hidden] && $draw[map][istop]} {
        #math tmpMapLast {$screen[height] - $hpbar[height] - 2};
        #if {"$draw[room][active]" == "on"} {
            #math tmpMapLast {$tmpMapLast - 1};
        };
        #if {$tmpMapLast > $map[bottom]} {
            #var map[bottom] $tmpMapLast;
        };
    };

    #NOP -- halfchat gives the chat and the Idle/Deadman box the top half of the space above the hpbar,;
    #NOP -- and game text the bottom half. The toggles turn each other off, bigchat wins if both are set.;
    #NOP -- A screen too short for it keeps the normal size;
    #if {"$toggles[halfchat]" == "1" && "$draw[chat][active]" == "on"} {
        #math tmpHalfBottom {$hpbar[height] + 1};
        #if {$tmpHalfBottom < 2} {
            #var tmpHalfBottom 2;
        };
        #math tmpHalfRows {($screen[height] - $tmpHalfBottom) / 2 - 1};
        #format tmpHalfRows {%d} {$tmpHalfRows};
        #if {"$draw[ticker][active]" == "on"} {
            #math tmpHalfRows {$tmpHalfRows - @draw_ticker_rows{} - 1};
        };
        #if {$tmpHalfRows > $chat[rows]} {
            #var chat[rows] $tmpHalfRows;
        };
    };

    #NOP -- bigchat stretches the chat and the Idle/Deadman box down to the hpbar. tt++ always needs one;
    #NOP -- row for game text, so the box's bottom border sits on that row, and .bigchat_hold keeps it;
    #NOP -- hidden. Without the Idle/Deadman box there's no border to cover it, so it stays one row up;
    #NOP -- with game text showing. A screen too short for any of it keeps the normal size;
    #var draw[bigchat][cover] 0;
    #if {"$toggles[bigchat]" == "1" && "$draw[chat][active]" == "on"} {
        #math tmpBigBottom {$hpbar[height] + 1};
        #if {$tmpBigBottom < 2} {
            #var tmpBigBottom 2;
        };
        #if {"$draw[ticker][active]" == "on"} {
            #math tmpBigRows {$screen[height] - $tmpBigBottom - 1};
            #math tmpBigRows {$tmpBigRows - @draw_ticker_rows{} - 1};
        } {
            #math tmpBigRows {$screen[height] - $tmpBigBottom - 2};
        };
        #if {$tmpBigRows > $chat[rows]} {
            #var chat[rows] $tmpBigRows;
            #if {"$draw[ticker][active]" == "on"} {
                #var draw[bigchat][cover] 1;
            };
        };
    };

    #NOP -- Ticker goes right under the chatlog;
    #if {"$draw[chat][active]" == "on"} {
        #math chat[height] {$chat[rows] + 1};
        #math ticker[top] {$chat[height]};
        #math ticker[bottom] {$ticker[top] + @draw_ticker_rows{} + 1};
        #NOP -- Hiding the map keeps this column for the caption, so chat stays out of it;
        #if {$draw[map][istop] && !$draw[side][hidden]} {
            #math {chat[right]} {-$map[width]-1};
            #var ticker[right] $chat[right];
        } {
            #var chat[right] -1;
            #var ticker[right] -1;
        };
    } {
        #var ticker[top] 1;
        #math ticker[bottom] {$ticker[top] + @draw_ticker_rows{} + 1};
        #var chat[height] 0;
    };

    #NOP -- The caption goes right below the map;
    #if {"$draw[caption][active]" == "on" && !$draw[side][hidden]} {
        #math caption[top] {$map[bottom] + 2};
        #math caption[bottom] {-3 - $hpbar[height]};
        #var caption[left] $map[left];
    } {
        #var caption[top] 0;
        #var caption[bottom] 0;
    };

    #NOP -- Clear any previous drawings;
    #screen clear all;
    #buffer end;

    #NOP -- If there is the chat window, split the # of rows required to display it;
    #if {"$draw[chat][active]" == "on"} {
        #math split[top] {$chat[height]};
    } {
        #var split[top] 0;
    };

    #NOP -- If there is a ticker, then adjust the split;
    #if {"$draw[ticker][active]" == "on"} {#math split[top] {$split[top] + @draw_ticker_rows{} + 1}};

    #NOP -- bigchat's game text row is the box's bottom border row;
    #if {"$draw[bigchat][cover]" == "1"} {
        #math split[top] {$split[top] - 1};
    };

    #math split[bottom] {$hpbar[height] + 1};
    #var split[bottom] {@max{2;$split[bottom]}};

    #var split[left] 0;

    #NOP -- With no side column, game output and input get the full width;
    #if {$draw[side][hidden]} {
        #var split[right] 0;
    } {
        #math split[right] {$map[width] + 1};
    };

    #NOP -- The map room details goes right inside the map area;
    #math draw_room[top] {$map[bottom] - 1};
    #var draw_room[bottom] {$map[bottom]};
    #math draw_room[left] {$map[left] + 2};

    #split $split[top] $split[bottom] $split[left] $split[right];

    init_map;
    init_hpbar;
    #var draw[initiated] 1;
    draw_all;
    .bigchat_hold;
};

#NOP -- .bigchat_hold hides game text under bigchat's box. It scrolls the scrollback up one line, and tt++;
#NOP -- doesn't draw new game text while it's scrolled up. The text still gets logged, saved to the;
#NOP -- scrollback and seen by actions as normal. Pressing enter jumps back to the end, so the deadman;
#NOP -- input event (modules/deadman/deadman.tin) runs this again right after. The jump redraws the game;
#NOP -- text row and blanks the hpbar line under it, so both get drawn again. Turning bigchat off runs;
#NOP -- init_screen, whose #buffer end shows everything that came in;
#alias {.bigchat_hold} {
    #if {"$draw[bigchat][cover]" == "1"} {
        #buffer up 1;
        draw_ticker;
        #if {"$draw[hpbar][active]" == "on"} {
            draw_hpbar;
        };
    };
};

#alias caption-help {
    #echo {    <cde>=============================================<088>};
    #echo {             <ced>${userCap}'s 3kDB Data Panel<088>};
    #echo {    <cde>=============================================<088>};
    #echo {\n <dee>The data panel is the information listed on the right side<088>};
    #echo { <dee>of the screen (typically).  These currently include the<088>};
    #echo { <dee><cfd>General<dee> and <cfd>Bot<dee> tabs.<088>};
     
    #echo {\n <dee>To navigate between tabs, you can either: <088>};
    #echo {   <ddd>(1) Press 'qq' to enable the mouse and click an option, or<088>};
    #echo {   <ddd>(2) Type <dfc>caption_view general <ddd>or <dfc>caption_view bot <ddd><088>};
    #echo {\n <dee>To update the data displayed, you can:};
    #format tmpItem {%-15s %-50s} {    <bfc>caption+} {<ddd>Add an item<088>};
    #echo {$tmpItem};
    #format tmpItem {%-15s %-50s} {    <bfc>caption++} {<ddd>Move an item up on the display. (soon-TH)<088>};
    #echo {$tmpItem};
    #format tmpItem {%-15s %-50s} {    <fbc>caption-} {<ddd>Remove an item<088>};
    #echo {$tmpItem};
    #format tmpItem {%-15s %-50s} {    <fbc>caption--} {<ddd>Lower an item up on the display. (soon-TH)<088>};
    #echo {$tmpItem};

    #echo {    <cde>=============================================<088>};
};

#alias caption {
    #var tmpList {};

    #echo {    <ced>=======================================<088>};
    #echo {    <ced>======= <cac>CAPTION DATA POR FLAVOR<ced> =======<088>};
    #echo {    <ced>=======================================<088>};
    #echo {\n<ddd>Current caption data includes:<088>};
    #foreach *caption_toggle[] key {
        #if $caption_toggle[$key][active] {
            #var tmpList[${caption_toggle[$key][order]}] $key;
        };
    };
    #foreach *tmpList[] item {
        #echo {  <efc>[$item]<088> : <bfb>$tmpList[$item]<088>};
    };

    #echo {\n<ddd>Available caption data to add with <afc>caption+<088>};
    #var tmpList {};
    #var tmpCount 0;
    #foreach *caption_toggle[] key {
        #if !$caption_toggle[$key][active] {
            #var tmpList[${caption_toggle[$key][order]}] $key;
            #math tmpCount {$tmpCount + 1};
        };
    };
    #if {"$tmpCount" == "0"} {
        #echo {\n<fbb>You have added all available captions. Remove them with <afc>caption-<088>};
    } {
        #foreach *tmpList[] item {
            #echo {  <efc>[$item]<088> : <bfb>$tmpList[$item]<088>};
        };
    };

    #echo {\n<ddd>Type <cfd>caption-help <ddd>to see all available commands.<088>};
    #echo {    <ced>=======================================<088>};
};

#alias caption+ {
    #format tmpLookup {%p} {%0};
    #if {"$caption_toggle[$tmpLookup]" == ""} {
        #echo {   <ffc>  $tmpLookup <eab> was not found in the caption data. Check spelling and try again.<088>};
    } {
        #if {$caption_toggle[$tmpLookup][active]} {
            #echo {   <ffc>  $tmpLookup <ded> is already active in the caption data.<088>};
        } {
            #var caption_toggle[$tmpLookup][active] 1;
            #echo {   <ffc>  $tmpLookup <bfc> has been added to the caption data.<088>};
        };
    };
} {3};

#alias caption- {
    #format tmpLookup {%p} {%0};
    #if {"$caption_toggle[$tmpLookup]" == ""} {
        #echo {   <ffc>  $tmpLookup <eab> was not found in the caption data. Check spelling and try again.<088>};
    } {
        #if {$caption_toggle[$tmpLookup][active]} {
            #var caption_toggle[$tmpLookup][active] 0;
            #echo {   <ffc>  $tmpLookup <dbb> has been removed from the caption data.<088>};
        } {
            #echo {   <ffc>  $tmpLookup <ded> has already been removed from the caption data.<088>};
        };
    };
} {3};


#NOP -- Placeholder for the caption ++ and and -- when I have a moment;
#NOP    #alias caption++ {        ;
#NOP        #format tmpLookup {%p} {%0};        ;
#NOP        #if {"$caption_toggle[$tmpLookup]" == ""} {        ;
#NOP            #echo {   <ffc>  $tmpLookup <eab> was not found in the caption data. Check spelling and try again.<088>};        ;
#NOP        } {        ;
#NOP            #if {$caption_toggle[$tmpLookup][order] > 1} {        ;
#NOP                #var oldIndexA $caption_toggle[$tmpLookup][order];
#NOP                #math newIndexA {$oldIndexA - 1};        ;
#NOP                #var oldIndexB_key $caption_order[$newIndexA];
#NOP                        ;
#NOP                #math newIndexA {$oldIndexA - 1};        ;
#NOP                #var caption_toggle[$tmpLookup][active] 0;
#NOP                #echo {   <ffc>  $tmpLookup <dbb> has been removed from the caption data.<088>};        ;
#NOP            } {        ;
#NOP                #echo {   <ffc>  $tmpLookup <ded> is already at the top of the order.<088>};        ;
#NOP            };
#NOP        };
#NOP    } {2};


#alias {mapFull} {
    #NOP -- Full-screen map owns a separate port session and its own vtmap layout.;
    #NOP -- Preserve upstream seeding/sender setup below. Portrait sidebar suppression;
    #NOP -- applies to the game session, not this optional map viewer.;
    #NOP -- Working copy of mapFull, see common/draw_mapFull.tin;
    #echo {<ffc>------------------ INITIALIZING FULL MAP 2 ------------------<088>};
    #info session save;
    #math map[fullLower] {$screen[height] - 2};
    #map get roomvnum map[full][startVnum];

    #port {init} {port_mapFull} {0};
    #delay 1 {
        #{port_mapFull} {#var parentSession $info[SESSION][NAME]};

        #NOP -- Seed the child session explicitly.  A port session does;
        #NOP -- not inherit parent variables, which is what the undefined;
        #NOP -- @gts calls in the original file were reaching for.;
        #NOP -- A session name in the selector is resolved before variables;
        #NOP -- are substituted, so #{$parentSession} never reaches this;
        #NOP -- session.  Bake the real name into a sender alias here,;
        #NOP -- where the expansion happens parent side, exactly the way;
        #NOP -- area and startVnum below are passed across.;
        #{port_mapFull} {#alias {.mapFullSend} {#{$info[SESSION][NAME]} {%0}}};

        #{port_mapFull} {#var area {$area}};
        #{port_mapFull} {#var map[full][startVnum] {$map[full][startVnum]}};

        #{port_mapFull} {#read common/draw_mapFull.tin};
        #{port_mapFull} {#alias mapFull {#ses -;#zap port_mapFull;}};
        #{port_mapFull} {_init_mapFull};
        #delay 1 {#ses {port_mapFull}};
    };
};

#alias _update_caption_data {
    _caption_data_bot;
    _caption_data_bot_cycle;
    _caption_data_corpses;
    _caption_data_eternal;
    _caption_data_strategy;
};

#alias draw_all {
    #NOP -- Chat and HP gauges always draw, the side column only when it's showing;
    #if {"$draw[hpbar][active]" == "on"} { draw_hpbar };
    #if {"$draw[chat][active]" == "on"} { draw_chat };

    #if {!$draw[side][hidden]} {
        #if {"$draw[caption][active]" == "on"} { _update_caption_data;draw_caption};
        #if {"$draw[room][active]" == "on"} { draw_room };
    };
};

#NOP calculate hpbar size and draws initial line above hpbar area;
#alias {init_hpbar} {
    #if {"$draw[hpbar][active]" == "on"} {
        #math hpbar[top] {$screen[height] - $hpbar[height]};
        #math hpbar[bottom] {$hpbar[top] + $hpbar[height] - 1};
        #math hpbar[right] {$screen[width]}; 
    	#draw {line} -$hpbar[height]-2 1 -$hpbar[height]-2 -1;
    } {
        #var hpbar[height] 0;
    };
    tickhp;
};

#alias draw_hpbar {
    #loop 1 $hpbar[height] index {
        #var prompt $hpbar[prompt][+$index];
        #math hpbar_line {$hpbar[top] + $index - 1};
        #draw {<eeb>} {tile} $hpbar_line 1 $hpbar_line -1 ${prompt};
    };
};


#alias _caption_data_corpses {
    #var caption_toggle[corpses][string] $corpse_string;
    draw_caption;
};

#alias _caption_data_eternal {
    #var caption_toggle[eternal][string] $eternal_string;
    draw_caption;
};

#alias _caption_data_strategy {
    #var strategy_string {<bef>Strategy:<088>};

    #foreach $strategyActive[%*] index {
        #format strat_name {%n} {$index[name]};
        #cat strategy_string { <afa>$strat_name<088>};
    };

    #var caption_toggle[strategy][string] $strategy_string;
    draw_caption;
};

#var theme[caption] <cde>;

#alias .bot_xp_string {
    .xp_rate {$bot[stats][xp]} {$bot[start-time]};
    #var bot[stats][xp_rate_str] $xp_rate_str;
    #var bot[stats][xp_time_str] $xp_time_str;
};


#function setMapIconSize {
    #format tmpIcon {%.5s} {%0};
    #format tmpItemLength %L {$tmpIcon};
    #switch {"$tmpItemLength"} {
        #case {"1"} {
            #var result {  $tmpIcon  };
        };
        #case {"2"} {
            #var result {  $tmpIcon };
        };
        #case {"3"} {
            #var result { $tmpIcon };
        };
        #case {"4"} {
            #var result { $tmpIcon};
        };
        #case {"5"} {
            #var result {$tmpIcon};
        };
    };
};

#NOP -- CAPTION (Corpses, Eternal, Strategies, Bot Status, general data) --;
#alias draw_caption {
    #NOP -- Data callbacks also call this directly, so draw_all alone cannot guard it.;
    #if {$draw[side][hidden] || "$draw[caption][active]" != "on"} {
        #return;
    };
    #NOP -- A short screen, or one just resized, can leave no room for the box. Skip it instead of a draw error;
    #screen get rows tmpCapRows;
    #math tmpCapLast {$tmpCapRows + $caption[bottom] + 1};
    #if {$caption[top] + 2 > $tmpCapLast} {
        #return;
    };
    #list caption_data clear;
    #unvar caption_order;

    #foreach *caption_toggle[] key {
        #var caption_order[$caption_toggle[$key][order]] $key;
    };

    #if {"$caption[tab]" == "bot"} {
        #list botlist_alias find {$bot[alias]} tmpIndex;
        #var tmpName $botlist_desc[$tmpIndex];
        #if {"${tmpName}" == ""} {
            #list caption_data add {<cde>Current Bot: <fbc>N/A<088>};
        } {
            #list caption_data add {<cde>Current Bot: <fbc>$tmpName<088>};
            #list caption_data add {<dee>Path: $bot_current_room/$bot_total_rooms ($bot_progress% in $xp_time_str)};
            .bot_xp_string;
            #list caption_data add {<dee>Kills: $bot[stats][mobs] XP: @thousandsFormatNumber{$bot[stats][xp]} ($bot[stats][xp_rate_str]/hr)};
            #list caption_data add {\n $caption_toggle[bot][string]<088>};

            #variable bot_loop_xp $bot[stats][loop][xp];
            #variable bot_xp $bot[stats][xp];
            #variable bot_loop_coins $bot[stats][loop][coins];
            #variable bot_coins $bot[stats][coins];
            #var tmpLoopKills <dee>Mobs Killed: $bot[stats][loop][mobs];
            #var tmpLoopXp <dee>XP Gained: @thousandsFormatNumber{$bot_loop_xp};
            #var tmpLoopCoins <dee>Coins Earned: @thousandsFormatNumber{$bot_loop_coins};
            #var tmpTotalKills <dee>Mobs Killed: $bot[stats][mobs];
            #var tmpTotalXp <dee>XP Gained: @thousandsFormatNumber{$bot_xp};
            #var tmpTotalCoins <dee>Coins Earned: @thousandsFormatNumber{$bot_coins};
            #var currentLoop {
                \n<cde>Current Loop<088>
                \n$tmpLoopKills
                \n$tmpLoopXp
                \n$tmpLoopCoins
            };
            #var totalLoop {
                \n<cde>Bot Total<088>
                \n$tmpTotalKills
                \n$tmpTotalXp
                \n$tmpTotalCoins
            };

            #list caption_data add {$currentLoop};
            #list caption_data add {$totalLoop};
            #list caption_data add {$caption_toggle[bot_cycle][string]};
        };
    };
    
    #if {"$caption[tab]" == "general"} {
        #var tmpFirst 1;
        #foreach $caption_order[] key {
            #NOP -- A running bot shows its own xp, so the xp tracker steps aside;
            #if {"$key" == "xp" && "$bot[active]" == "1"} {#continue};
            #NOP -- Not an eternal, or no eternal status yet, so there is no eternal line to show;
            #if {"$key" == "eternal"} {
                #if {"$eternal" != "1"} {#continue};
                #if {&eternal_string} {
                    #NOP -- has a status line, show it;
                } {
                    #continue;
                };
            };
            #if $caption_toggle[$key][active] {
                #if $tmpFirst {
                    #list caption_data add {$caption_toggle[$key][string]};
                    #var tmpFirst 0;
                } {
                    #list caption_data add {\n $caption_toggle[$key][string]};
                };
            };
        };
    };

    #if {"$caption[tab]" == "map"} {
        #NOP -- These aliases are stored in map/mapnotes.tin;
        #NOP -- Loop up to 15 lines, we'll use a MOD to see if it's even to insert a line;
        #LIST {caption_data} add {<dad>-== <efd>Map Legend <dad>==-<088>};
        #loop 1 30 tmpNote {
            #if {"${notes_l[$tmpNote]}" === ""} {
                #break
            } {
                #math testEven {$tmpNote % 2};
                #if {$testEven} {
                    #var tmpArr $notes_l[$tmpNote];
                    #list tmpArr explode {:};
                    
                    #format tmpItemLength %L {$tmpArr[1]};
                    #switch {"$tmpItemLength"} {
                        #case {"1"} {
                            #var tmpLine2 {$tmpArr[1]  : $tmpArr[1]};
                        };
                        #case {"2"} {
                            #var tmpLine2 {${tmpArr[1]} : ${tmpArr[2]}};
                        };
                        #case {"3"} {
                            #var tmpLine2 {${tmpArr[1]} : ${tmpArr[2]}};
                        };
                        #case {"4"} {
                            #var tmpLine2 {${tmpArr[1]}: ${tmpArr[2]}};
                        };
                        #case {"5"} {
                            #var tmpLine2 {${tmpArr[1]}: ${tmpArr[2]}};
                        };
                    };
                    #format tmpLine {%-20s   %+20s} {$tmpLine1} {$tmpLine2};
                    #list caption_data add {$tmpLine}; 
                } {
                    #var tmpArr $notes_l[$tmpNote];
                    #list tmpArr explode {:};
                    
                    #format tmpItemLength %L {$tmpArr[1]};
                    #switch {"$tmpItemLength"} {
                        #case {"1"} {
                            #var tmpLine1 {$tmpArr[1]  : $tmpArr[1]};
                        };
                        #case {"2"} {
                            #var tmpLine1 {${tmpArr[1]} : ${tmpArr[2]}};
                        };
                        #case {"3"} {
                            #var tmpLine1 {${tmpArr[1]} : ${tmpArr[2]}};
                        };
                        #case {"4"} {
                            #var tmpLine1 {${tmpArr[1]}: ${tmpArr[2]}};
                        };
                        #case {"5"} {
                            #var tmpLine1 {${tmpArr[1]}: ${tmpArr[2]}};
                        };
                    };
                };
            };
        };
    };

    #if {$idle_sec > $deadmanIdleTimeout} {
        #draw calign grid table $caption[top] $caption[left]+1 $caption[bottom] -1 $caption_data[];
    } {
		#draw $theme[caption] calign jeweled filled line $caption[top]+1 $caption[left]+1 $caption[top]+1 -1 {$caption_title_string};
        #draw calign talign blanked box $caption[top]+2 $caption[left]+1 $caption[bottom] -1 $caption_data[];
    };
};

#NOP -- TICKER (Idle timer, Deadman, Current Round etc) --;
#alias draw_ticker {
    #if {&ticker_data[]} {
        #list ticker_data set 1 {<fba>Idle: $idle_cap  <fba>Deadman: $deadManTimeLeft_cap};
    } {
        #list ticker_data create {<aed>Idle: $idle_cap  <fba>Deadman: $deadManTimeLeft_cap};
    };

    #if {&ticker_data[] == 1} {
        #list ticker_data add {$server_string};
    } {
        #list ticker_data set 2 {$server_string};
    };

    #if {&ticker_data[] == 2} {
        #list ticker_data add {$fight_string};
    } {
        #list ticker_data set 3 {$fight_string};
    };

    #if {$idle_sec > $deadmanIdleTimeout} {
        #draw calign grid red jeweled box $ticker[top] 1 $ticker[bottom] $ticker[right] $ticker_data[];
    } {
        #draw calign grid $theme[chatbox] jeweled box $ticker[top] 1 $ticker[bottom] $ticker[right] $ticker_data[];
    };
};


#NOP -- Bot status --;
#alias _caption_data_bot {
    #if $bot[active] {
        #var bot_total_rooms &bot[steps][];
        #var bot_current_room $bot[step];

        #math bot_current_room {$bot_current_room - 1};
        #math bot_progress {100 * $bot_current_room / $bot_total_rooms};

        .xp_rate {$bot[stats][xp]} {$bot[start-time]};
        #var temp_xp @thousandsFormatNumber{$bot[stats][xp]};

        #if {"$caption[tab]" == "bot"} {
            #if $bot[paused] {
                #var bot_string {<088>Bot Status:<DAA><aaa> ⏸ PAUSED ⏸ <088>};
            } {
                #var bot_string {<cde>Bot Status: <dfc> ✔ ACTIVE <088>};
            };

            #if $bot[playercheck] {
                #cat bot_string {\n<cde>Playercheck:<dfc> ✔ ACTIVE <088>};
            } {
                #cat bot_string {\n<cde>Playercheck:<eab> ✔ OFF   <088>};
            };

        };
        #if {"$caption[tab]" == "general"} {
            #if $bot[paused] {
                #var bot_string {<088>Bot Status:<DAA><aaa> ⏸ <088>};
            } {
                #var bot_string {Bot Status:<ACA><fff> ▶ <088>};
            };

            #if $bot[playercheck] {
                #cat bot_string {<ACA><fff> ✔ <088>};
            } {
                #cat bot_string {<DAA><aaa> ✔ <088>};
            };

            #cat bot_string {\n Path: $bot_current_room/$bot_total_rooms ($bot_progress% in $xp_time_str)};
            #cat bot_string {\n Kills: $bot[stats][mobs] XP: $temp_xp ($xp_rate_str/hr)};
        };
        #if {"$caption[tab]" == "map"} {
            #if $bot[paused] {
                #var bot_string {<088>Bot Status:<DAA><aaa> ⏸ <088>};
            } {
                #var bot_string {Bot Status:<ACA><fff> ▶ <088>};
            };

            #if $bot[playercheck] {
                #cat bot_string {<ACA><fff> ✔ <088>};
            } {
                #cat bot_string {<DAA><aaa> ✔ <088>};
            };

            #cat bot_string {\n Path: $bot_current_room/$bot_total_rooms ($bot_progress% in $xp_time_str)};
            #cat bot_string {\n Kills: $bot[stats][mobs] XP: $temp_xp ($xp_rate_str/hr)};
        };

    } {
        #var bot_string {<ccc>Bot: <fff>OFF<088>};
        .xp_caption;
    };

    #var caption_toggle[bot][string] $bot_string;
    draw_caption;
};

#alias _caption_data_bot_cycle {
    #var bot_cycle_string {<cde>Bot Cycler:<088>};

    #if {&{botcycle[]} > 0} {
        #loop 1 &botcycle[] index {
            #list botlist_alias find {$botcycle[$index]} {tmpIndex};
            #format bot_cycle_name {%n} {${botlist_desc[$tmpIndex]}};
            #format strat_name {%n} {$index[name]};
            #if {"$index" == "1"} {
                #cat bot_cycle_string { <afa>$bot_cycle_name<088>};
            } {
                #cat bot_cycle_string { -> <afa>$bot_cycle_name<088>};
            };
        };
    } {
        #var bot_cycle_string {<cde>Bot Cycler: <fac>N/A<088>};
    };

    #var caption_toggle[bot_cycle][string] $bot_cycle_string;
    draw_caption;
};

#alias _caption_data_map {
    .loopnotes;
};


#NOP -- MAP --;
#alias init_map {
    #NOP -- vtmap paints automatically: hiding the border alone leaves map output;
    #NOP -- over game text. Disable it while the side column is hidden and restore it;
    #NOP -- only when the map preference is on. Keep mapFull's child session separate.;
    #if {"$draw[map][active]" == "on" && !$draw[side][hidden]} {
        #draw {tile} $map[top]-1 -$map[width] $map[bottom]+1 -1 {};
        #map offset $map[top] -$map[width]+2 $map[bottom]-2 -2;
        #map flag vtmap on;
        #if {"$draw[room][active]" == "on"} {
            #draw <ccc> tubed box $map[top]-1 -$map[width] $map[bottom]+1 -1;
        } {
            #draw <ccc> tubed box $map[top]-1 -$map[width] $map[bottom] -1;
        };
        .map_vnum_draw;
    } {
        #map flag vtmap off;
    };
};

#alias {.map_vnum_draw} {
    #if {"$toggles[map_vnum]" == "1" && "$draw[map][active]" == "on" && !$draw[side][hidden] && "$map[bottom]" != "0"} {
        #if {"$draw[room][active]" == "on"} {#math map_vnum_row {$map[bottom] + 1}} {#var map_vnum_row $map[bottom]};
        #draw <ccc> tubed box $map[top]-1 -$map[width] $map_vnum_row -1;
        #map get roomvnum map_vnum;
        #format map_vnum_str { %s } {$map_vnum};
        #format map_vnum_len {%L} {$map_vnum_str};
        #math map_vnum_left {-2 - $map_vnum_len};
        #draw <ccc> tile $map_vnum_row $map_vnum_left $map_vnum_row -3 {$map_vnum_str};
    };
};

#NOP -- ROOM --;
#alias draw_room {
    #NOP -- Direct room updates must obey the same side column guard as draw_all.;
    #if {$draw[side][hidden]} {
        #return;
    };
    #NOP -- The room strip sits inside the map box, so it goes when the map does;
    #if {"$draw[map][active]" == "off"}
    {
        #return;
    };
    #NOP Notes from mapper;
    #map get roomname roomMapNameStr;
    #map get roomnote roomMapNoteStr;

    #if $draw[initiated] {
        #nop -- Clear any old drawings;
        #draw {<dda>} {tile} $draw_room[top] $draw_room[left] $draw_room[bottom] -2 {};
        #draw {<dda>} {tile} $draw_room[top] $draw_room[left] $draw_room[bottom] -2 { Room : ${roomMapNameStr} \n Notes: ${roomMapNoteStr}};
    };
};

#alias draw-map-side {
    #var draw[map][position] side;
    init_screen;
    draw_all;
};

#alias draw-map-top {
    #var draw[map][position] top;
    init_screen;
    draw_all;
};

#NOP -- hidemap gives the map's space to the caption panel. Only the drawing goes, the map itself;
#NOP -- keeps tracking you, so go, findhere and bots still work. The choice is saved per character;
#alias {.map_visibility}
{
    #if {"$toggles[hidemap]" == "1"}
    {
        #var draw[map][active] off;
    };
    #else
    {
        #var draw[map][active] on;
    };
    init_screen;
};

#alias {hidemap}
{
    #var toggles[hidemap] 1;
    .toggleChanged {hidemap};
    #echo {<cfb>   -----  Map hidden. Type showmap to bring it back.  -----<088>};
};

#alias {showmap}
{
    #var toggles[hidemap] 0;
    .toggleChanged {hidemap};
    #echo {<cfb>   -----  Map is showing again.  -----<088>};
};

#NOP -- hidecaption works like hidemap for the caption panel. With both hidden the side column goes;
#NOP -- and chat and game text get the full width;
#alias {.caption_visibility}
{
    #if {"$toggles[hidecaption]" == "1"}
    {
        #var draw[caption][active] off;
    };
    #else
    {
        #var draw[caption][active] on;
    };
    init_screen;
};

#alias {hidecaption}
{
    #var toggles[hidecaption] 1;
    .toggleChanged {hidecaption};
    #echo {<cfb>   -----  Caption panel hidden. Type showcaption to bring it back.  -----<088>};
};

#alias {showcaption}
{
    #var toggles[hidecaption] 0;
    .toggleChanged {hidecaption};
    #echo {<cfb>   -----  Caption panel is showing again.  -----<088>};
};

#NOP -- Rotation/SSH/tmux size changes reuse initialization after the existing delay.;
#NOP -- Future layouts must guard direct draws and validate box bounds on short screens.;
#EVENT {SCREEN RESIZE} {#delay 3 {init_screen};};


#CLASS draw {close};
