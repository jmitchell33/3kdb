#class {dungeon_data} {kill};
#class {dungeon_data} {open};

#NOP ---------------------------------------------------------------------------;
#NOP -- Dungeon class size reference, queried with 3kdb_dungeon_data or ddata;
#NOP -- Data graciously gathered by Locrian and Elmo on wemudtogether.com/dungeons;

#NOP -- dungeonInfo fields;
#NOP --   key      short single word handle used on the command line;
#NOP --   name     full area name as the site lists it;
#NOP --   town     town the dungeon runs out of;
#NOP --   low      lowest class in the area at any scaler;
#NOP --   high     highest class in the area at any scaler;
#NOP --   scaling  1 when the scaler moves mob class, 0 for a fixed area;
#NOP --   fixed    class text for a fixed area, empty otherwise;
#NOP --   note     anything worth knowing before you walk in;

#NOP -- dungeonScaler fields;
#NOP --   key      matches dungeonInfo key;
#NOP --   sc       scaler as printed, usually a number;
#NOP --   scn      scaler low as an integer, for filtering;
#NOP --   scnhi    scaler high as an integer, same as scn unless sc is a range;
#NOP --   cls      class range as printed;
#NOP --   lo       class low as an integer, 0 when undocumented;
#NOP --   hi       class high as an integer, 0 when undocumented;
#NOP --   tier     1 through 7 order of magnitude of hi, drives the row color;

#NOP -- To add data, append with .dd_step in scaler order under its dungeon;
#NOP ---------------------------------------------------------------------------;

#NOP -- Tier colors run green -> red for low -> high;
#var ddTierColor[0] {<ccc>};
#var ddTierColor[1] {<aca>};
#var ddTierColor[2] {<bfb>};
#var ddTierColor[3] {<dfd>};
#var ddTierColor[4] {<ffd>};
#var ddTierColor[5] {<fea>};
#var ddTierColor[6] {<fca>};
#var ddTierColor[7] {<faa>};

#list dungeonInfo clear;
#list dungeonScaler clear;

#NOP -- key name town low high scaling fixed_text note;
#alias .dd_area {
    #list dungeonInfo add {{{key}{%1}{name}{%2}{town}{%3}{low}{%4}{high}{%5}{scaling}{%6}{fixed}{%7}{note}{%8}}};
} {2};

#NOP -- key sc scn scnhi cls lo hi tier;
#alias .dd_step {
    #list dungeonScaler add {{{key}{%1}{sc}{%2}{scn}{%3}{scnhi}{%4}{cls}{%5}{lo}{%6}{hi}{%7}{tier}{%8}}};
} {2};

#NOP -------------------------- Scaling dungeons ----------------------------;

