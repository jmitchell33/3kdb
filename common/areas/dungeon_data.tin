#NOP ---------------------------------------------------------------------------;
#NOP -------------------------- Formatting helpers ---------------------------;
#NOP ---------------------------------------------------------------------------;

#alias .dd_rule {
    #echo {<bce>  ---------------------------------------------------------------------------<088>};
} {2};

#alias .dd_title {
    .dd_rule;
    #format {ddLine} {  <ffa>%-40s<eaf>%s<088>} {%1} {%2};
    #echo {$ddLine};
    .dd_rule;
} {2};

#NOP -- Index row. name town low high steps;
#alias .dd_idx_row {
    #format {ddLine} {  <cff>%-28s <eaf>%-14s <fff>%+9s <ccc>to <fff>%-9s <ceb>%+5s<088>} {%1} {%2} {%3} {%4} {%5};
    #echo {$ddLine};
} {2};

#NOP -- Step row inside one dungeon. scaler class tier marker;
#alias .dd_step_row {
    #format {ddLine} {  <ceb>%+7s <ccc>:  $ddTierColor[%3]%-24s <fbb>%s<088>} {%1} {%2} {%4};
    #echo {$ddLine};
} {2};

#NOP -- Cross dungeon row. name scaler class marker;
#alias .dd_cross_row {
    #format {ddLine} {  <cff>%-28s <ceb>%+10s <ccc>:  $ddTierColor[%4]%-24s <fbb>%s<088>} {%1} {%2} {%3} {%5};
    #echo {$ddLine};
} {2};

#NOP -- Reads a class size the way a person types it and leaves the integer in;
#NOP -- ddArgN. Takes 5m 5M 5.2m 620k or a bare 5200000;
#alias .dd_parse {
    #var ddQ {%1};
    #format {ddQ} {%l} {$ddQ};
    #var ddArgN 0;
    #regex {$ddQ} {^%*b$} {#math ddArgN {&1 * 1000000000}};
    #regex {$ddQ} {^%*m$} {#math ddArgN {&1 * 1000000}};
    #regex {$ddQ} {^%*k$} {#math ddArgN {&1 * 1000}};
    #if {$ddArgN == 0} {
        #regex {$ddQ} {^%d$} {#math ddArgN {$ddQ}};
    };
} {2};

#NOP -- Collects dungeonInfo indexes whose key or name contains the needle into;
#NOP -- ddHits. Matching on the name too means chess and board both find Chess Board;
#alias .dd_match {
    #list ddHits clear;
    #var ddNeedle {%1};
    #format {ddNeedle} {%l} {$ddNeedle};
    #loop 1 &dungeonInfo[] {ddI} {
        #format {ddHay} {%l} {$dungeonInfo[$ddI][key] $dungeonInfo[$ddI][name]};
        #regex {$ddHay} {$ddNeedle} {#list ddHits add {$ddI}};
    };
} {2};

#NOP -- Prints the header block for one dungeon, given its dungeonInfo index;
#alias .dd_area_head {
    .dd_rule;
    #format {ddLine} {  <ffa>%-30s <eaf>[%s]<088>} {$dungeonInfo[%1][name]} {$dungeonInfo[%1][town]};
    #echo {$ddLine};
    #format {ddLine} {  <ccc>class <fff>%s <ccc>to <fff>%s<088>} {$dungeonInfo[%1][low]} {$dungeonInfo[%1][high]};
    #echo {$ddLine};
    #if {"$dungeonInfo[%1][note]" != ""} {
        #echo {  <ceb>note  <def>$dungeonInfo[%1][note]<088>};
    };
    .dd_rule;
} {2};


#NOP ---------------------------------------------------------------------------;
#NOP -------------------------- Reports -------------------------------------;
#NOP ---------------------------------------------------------------------------;

#NOP -- Default view. Every area with its overall class span and how many;
#NOP -- scaler steps we actually hold data for;
#alias .dd_index {
    .dd_title {DUNGEON CLASS DATA} {&dungeonInfo[] areas};
    .dd_idx_row {Dungeon} {Town} {Low} {High} {Steps};
    #loop 1 &dungeonInfo[] {ddI} {
        #var ddCount 0;
        #loop 1 &dungeonScaler[] {ddJ} {
            #if {"$dungeonScaler[$ddJ][key]" == "$dungeonInfo[$ddI][key]" && "$dungeonScaler[$ddJ][cls]" != ""} {
                #math ddCount {$ddCount + 1};
            };
        };
        #if {$dungeonInfo[$ddI][scaling]} {
            #if {$ddCount == 0} {#var ddCount {none}};
        } {
            #var ddCount {fixed};
        };
        .dd_idx_row {$dungeonInfo[$ddI][name]} {$dungeonInfo[$ddI][town]} {$dungeonInfo[$ddI][low]} {$dungeonInfo[$ddI][high]} {$ddCount};
    };
    .dd_rule;
    #echo {  <cfc>ddata <fff><dungeon><cfc> for one area, <fff>ddata help<cfc> for every filter<088>};
};

#alias .dd_help_row {
    #format {ddLine} {  <cff>%-26s <def>%s<088>} {%1} {%2};
    #echo {$ddLine};
} {2};

#alias .dd_help {
    .dd_title {DUNGEON CLASS DATA} {filters};
    .dd_help_row {ddata} {every area with its class span};
    .dd_help_row {ddata <dungeon>} {full scaler table for that area};
    .dd_help_row {ddata <dungeon> <scaler>} {class you will face there at that scaler};
    .dd_help_row {ddata scaler <n>} {every area at scaler n, side by side};
    .dd_help_row {ddata class <size>} {areas and scalers that field mobs that size};
    .dd_help_row {ddata town <town>} {areas that run out of that town};
    .dd_help_row {ddata jumps [dungeon]} {scalers where class at least doubles};
    .dd_help_row {ddata fixed} {areas the scaler does nothing to};
    .dd_rule;
    .dd_help_row {dungeon} {matches key or name, so hotel and transylvania both work};
    .dd_help_row {size} {takes 5m 5.2m 620k or a bare 5200000};
    .dd_help_row {scaler} {falls back to the highest documented step at or below n};
    .dd_rule;
    #echo {  <cfc>keys:<088> <eaf>&dungeonInfo[] areas<088>};
    #var ddLine {};
    #loop 1 &dungeonInfo[] {ddI} {
        #var ddLine {$ddLine $dungeonInfo[$ddI][key]};
    };
    #echo {   <def>$ddLine<088>};
    .dd_rule;
};

#NOP -- Full scaler table for every area matching the needle. Rows where class;
#NOP -- at least doubles off the previous step get a JUMP marker, which is the;
#NOP -- wall you want to know about before you set a scaler;
#alias .dd_show {
    .dd_match {%1};
    #if {&ddHits[] == 0} {
        #echo {  <fab>No dungeon matches <efc>%1<fab>. Try <fff>ddata<fab> for the list<088>};
    } {
        #loop 1 &ddHits[] {ddH} {
            #var ddIx {$ddHits[$ddH]};
            .dd_area_head {$ddIx};
            #if {$dungeonInfo[$ddIx][scaling]} {
                #var ddPrev 0;
                #var ddPrevLo 0;
                #var ddPrevScn 0;
                #var ddAny 0;
                #loop 1 &dungeonScaler[] {ddJ} {
                    #if {"$dungeonScaler[$ddJ][key]" == "$dungeonInfo[$ddIx][key]"} {
                        #var ddAny 1;
                        #var ddMark {};
                        .dd_is_jump {$ddPrev} {$ddPrevLo} {$dungeonScaler[$ddJ][hi]} {$dungeonScaler[$ddJ][lo]} {$ddPrevScn} {$dungeonScaler[$ddJ][scn]};
                        #if {$ddJump} {#var ddMark {** JUMP}};
                        #if {"$dungeonScaler[$ddJ][cls]" == ""} {
                            .dd_step_row {$dungeonScaler[$ddJ][sc]} {no data yet} {0} {};
                        } {
                            .dd_step_row {$dungeonScaler[$ddJ][sc]} {$dungeonScaler[$ddJ][cls]} {$dungeonScaler[$ddJ][tier]} {$ddMark};
                            #var ddPrev {$dungeonScaler[$ddJ][hi]};
                            #var ddPrevLo {$dungeonScaler[$ddJ][lo]};
                            #var ddPrevScn {$dungeonScaler[$ddJ][scn]};
                        };
                    };
                };
                #if {!$ddAny} {
                    #echo {  <fab>No per scaler table published for this one<088>};
                };
            } {
                #echo {  <ceb>fixed <088>$dungeonInfo[$ddIx][fixed]};
            };
            .dd_rule;
        };
    };
} {2};

#NOP -- What one area throws at a given scaler. Exact when we hold that step,;
#NOP -- otherwise the nearest documented step at or below it plus the next one up;
#alias .dd_show_at {
    .dd_match {%1};
    #if {&ddHits[] == 0} {
        #echo {  <fab>No dungeon matches <efc>%1<fab>. Try <fff>ddata<fab> for the list<088>};
    } {
        #loop 1 &ddHits[] {ddH} {
            #var ddIx {$ddHits[$ddH]};
            #var ddBest 0;
            #var ddNext 0;
            #loop 1 &dungeonScaler[] {ddJ} {
                #if {"$dungeonScaler[$ddJ][key]" == "$dungeonInfo[$ddIx][key]" && "$dungeonScaler[$ddJ][cls]" != ""} {
                    #if {$dungeonScaler[$ddJ][scn] <= %2} {
                        #var ddBest {$ddJ};
                    } {
                        #if {!$ddNext} {#var ddNext {$ddJ}};
                    };
                };
            };
            .dd_area_head {$ddIx};
            #if {!$dungeonInfo[$ddIx][scaling]} {
                #echo {  <ceb>fixed <088>$dungeonInfo[$ddIx][fixed]};
            } {
                #if {!$ddBest} {
                    #if {$ddNext} {
                        #echo {  <fab>Nothing documented at or below scaler <efc>%2<fab>. Lowest we hold is <fff>$dungeonScaler[$ddNext][sc]<088>};
                        .dd_step_row {$dungeonScaler[$ddNext][sc]} {$dungeonScaler[$ddNext][cls]} {$dungeonScaler[$ddNext][tier]} {next up};
                    } {
                        #echo {  <fab>No per scaler table published for this one<088>};
                    };
                } {
                    #var ddMark {};
                    #if {$dungeonScaler[$ddBest][scnhi] < %2} {#var ddMark {** nearest at or below %2}};
                    .dd_step_row {$dungeonScaler[$ddBest][sc]} {$dungeonScaler[$ddBest][cls]} {$dungeonScaler[$ddBest][tier]} {$ddMark};
                    #if {$ddNext} {
                        .dd_step_row {$dungeonScaler[$ddNext][sc]} {$dungeonScaler[$ddNext][cls]} {$dungeonScaler[$ddNext][tier]} {next step up};
                    };
                };
            };
            .dd_rule;
        };
    };
} {2};

#NOP -- Every area at one scaler, so you can pick where to spend the evening;
#alias .dd_at_scaler {
    #if {"%1" == ""} {
        #echo {  <fab>Give a scaler. <fff>ddata scaler 100<088>};
    } {
        .dd_title {AT SCALER %1} {nearest documented step at or below};
        .dd_cross_row {Dungeon} {Scaler} {Class} {0} {};
        #loop 1 &dungeonInfo[] {ddI} {
            #if {$dungeonInfo[$ddI][scaling]} {
                #var ddBest 0;
                #loop 1 &dungeonScaler[] {ddJ} {
                    #if {"$dungeonScaler[$ddJ][key]" == "$dungeonInfo[$ddI][key]" && "$dungeonScaler[$ddJ][cls]" != ""} {
                        #if {$dungeonScaler[$ddJ][scn] <= %1} {#var ddBest {$ddJ}};
                    };
                };
                #if {$ddBest} {
                    #var ddMark {};
                    #if {$dungeonScaler[$ddBest][scnhi] < %1} {#var ddMark {approx}};
                    .dd_cross_row {$dungeonInfo[$ddI][name]} {$dungeonScaler[$ddBest][sc]} {$dungeonScaler[$ddBest][cls]} {$dungeonScaler[$ddBest][tier]} {$ddMark};
                };
            };
        };
        .dd_rule;
        #echo {  <ceb>approx<088> means that step is the closest below <fff>%1<088> and not %1 itself};
        #echo {  <ceb>fixed class areas are left out, see <fff>ddata fixed<088>};
        .dd_rule;
    };
} {2};

#NOP -- Reverse lookup. Name the class you want to fight and get told where and;
#NOP -- at what scaler. Falls back to a half to double window when nothing brackets it;
#alias .dd_by_class {
    #if {"%1" == ""} {
        #echo {  <fab>Give a class size. <fff>ddata class 5m<088>};
    } {
        .dd_parse {%1};
        #if {$ddArgN == 0} {
            #echo {  <fab>Could not read <efc>%1<fab> as a class size. Try <fff>5m<fab> <fff>620k<fab> or <fff>5200000<088>};
        } {
            .dd_title {MOBS AROUND %1} {$ddArgN};
            .dd_cross_row {Dungeon} {Scaler} {Class} {0} {};
            #var ddFound 0;
            #loop 1 &dungeonScaler[] {ddJ} {
                #if {$dungeonScaler[$ddJ][lo] <= $ddArgN && $dungeonScaler[$ddJ][hi] >= $ddArgN && $dungeonScaler[$ddJ][hi] > 0} {
                    #math ddFound {$ddFound + 1};
                    .dd_key_name {$dungeonScaler[$ddJ][key]};
                    .dd_cross_row {$ddName} {$dungeonScaler[$ddJ][sc]} {$dungeonScaler[$ddJ][cls]} {$dungeonScaler[$ddJ][tier]} {};
                };
            };
            #if {!$ddFound} {
                #math ddLoW {$ddArgN / 2};
                #math ddHiW {$ddArgN * 2};
                #echo {  <fab>Nothing brackets it exactly, widening to half up to double<088>};
                #loop 1 &dungeonScaler[] {ddJ} {
                    #if {$dungeonScaler[$ddJ][hi] >= $ddLoW && $dungeonScaler[$ddJ][lo] <= $ddHiW && $dungeonScaler[$ddJ][hi] > 0} {
                        #math ddFound {$ddFound + 1};
                        .dd_key_name {$dungeonScaler[$ddJ][key]};
                        .dd_cross_row {$ddName} {$dungeonScaler[$ddJ][sc]} {$dungeonScaler[$ddJ][cls]} {$dungeonScaler[$ddJ][tier]} {near};
                    };
                };
            };
            .dd_rule;
            #echo {  <cfc>$ddFound rows. A wide range means the area mixes trash with bosses<088>};
            .dd_rule;
        };
    };
} {2};

#NOP -- Areas that run out of one town, for when you are already standing there;
#alias .dd_town {
    #if {"%1" == ""} {
        #echo {  <fab>Give a town. <fff>ddata town turnhold<088>};
    } {
        #var ddNeedle {%1};
        #format {ddNeedle} {%l} {$ddNeedle};
        .dd_title {DUNGEONS OUT OF %1} {};
        .dd_idx_row {Dungeon} {Town} {Low} {High} {Steps};
        #var ddFound 0;
        #loop 1 &dungeonInfo[] {ddI} {
            #format {ddHay} {%l} {$dungeonInfo[$ddI][town]};
            #regex {$ddHay} {$ddNeedle} {
                #math ddFound {$ddFound + 1};
                #var ddCount 0;
                #loop 1 &dungeonScaler[] {ddJ} {
                    #if {"$dungeonScaler[$ddJ][key]" == "$dungeonInfo[$ddI][key]" && "$dungeonScaler[$ddJ][cls]" != ""} {
                        #math ddCount {$ddCount + 1};
                    };
                };
                #if {$dungeonInfo[$ddI][scaling]} {
                    #if {$ddCount == 0} {#var ddCount {none}};
                } {
                    #var ddCount {fixed};
                };
                .dd_idx_row {$dungeonInfo[$ddI][name]} {$dungeonInfo[$ddI][town]} {$dungeonInfo[$ddI][low]} {$dungeonInfo[$ddI][high]} {$ddCount};
            };
        };
        #if {!$ddFound} {
            #echo {  <fab>No dungeon runs out of <efc>%1<088>};
        };
        .dd_rule;
    };
} {2};

#NOP -- Where class at least doubles in one documented step, on either end of;
#NOP -- the range. These are the walls worth knowing before you commit to a;
#NOP -- scaler. ddJumpFloor keeps the sparse low scaler rows from firing, where;
#NOP -- a gap of a few thousand class reads as a huge multiple but is not a wall;
#alias .dd_jumps {
    #if {"%1" == ""} {
        .dd_title {SCALER JUMP POINTS} {class at least doubles};
    } {
        .dd_title {SCALER JUMP POINTS} {%1};
    };
    .dd_cross_row {Dungeon} {Scaler} {Class} {0} {};
    #var ddFound 0;
    #loop 1 &dungeonInfo[] {ddI} {
        #var ddSkip 0;
        #if {"%1" != ""} {
            #var ddSkip 1;
            #var ddNeedle {%1};
            #format {ddNeedle} {%l} {$ddNeedle};
            #format {ddHay} {%l} {$dungeonInfo[$ddI][key] $dungeonInfo[$ddI][name]};
            #regex {$ddHay} {$ddNeedle} {#var ddSkip 0};
        };
        #if {!$ddSkip && $dungeonInfo[$ddI][scaling]} {
            #var ddPrev 0;
            #var ddPrevLo 0;
            #var ddPrevScn 0;
            #var ddPrevSc {};
            #loop 1 &dungeonScaler[] {ddJ} {
                #if {"$dungeonScaler[$ddJ][key]" == "$dungeonInfo[$ddI][key]" && $dungeonScaler[$ddJ][hi] > 0} {
                    .dd_is_jump {$ddPrev} {$ddPrevLo} {$dungeonScaler[$ddJ][hi]} {$dungeonScaler[$ddJ][lo]} {$ddPrevScn} {$dungeonScaler[$ddJ][scn]};
                    #if {$ddJump} {
                        #math ddFound {$ddFound + 1};
                        #format {ddSpan} {%s to %s} {$ddPrevSc} {$dungeonScaler[$ddJ][sc]};
                        .dd_cross_row {$dungeonInfo[$ddI][name]} {$ddSpan} {$dungeonScaler[$ddJ][cls]} {$dungeonScaler[$ddJ][tier]} {};
                    };
                    #var ddPrev {$dungeonScaler[$ddJ][hi]};
                    #var ddPrevLo {$dungeonScaler[$ddJ][lo]};
                    #var ddPrevSc {$dungeonScaler[$ddJ][sc]};
                    #var ddPrevScn {$dungeonScaler[$ddJ][scn]};
                };
            };
        };
    };
    #if {!$ddFound} {
        #echo {  <fab>No jump points found<088>};
    };
    .dd_rule;
    #echo {  <ceb>Scaler column is the step you cross, class is what waits on the far side<088>};
    #echo {  <ceb>Only steps within $ddJumpGap scaler levels of each other count, so a wide<088>};
    #echo {  <ceb>hole in the data cannot fake a wall. Read the full table before you trust one<088>};
    .dd_rule;
} {2};

#alias .dd_fixed {
    .dd_title {FIXED CLASS DUNGEONS} {the scaler does nothing here};
    #loop 1 &dungeonInfo[] {ddI} {
        #if {!$dungeonInfo[$ddI][scaling]} {
            #format {ddLine} {  <cff>%-22s <eaf>%-13s <fff>%s<088>} {$dungeonInfo[$ddI][name]} {$dungeonInfo[$ddI][town]} {$dungeonInfo[$ddI][fixed]};
            #echo {$ddLine};
            #if {"$dungeonInfo[$ddI][note]" != ""} {
                #echo {                         <ceb>$dungeonInfo[$ddI][note]<088>};
            };
        };
    };
    .dd_rule;
};

#NOP -- Sets ddJump when a step at least doubles either end of the previous;
#NOP -- range. prev_hi prev_lo hi lo prev_scaler scaler;
#NOP -- ddJumpFloor keeps the sparse low scaler rows quiet, where a few thousand;
#NOP -- class of drift reads as a huge multiple without being a wall;
#NOP -- ddJumpGap requires the two steps to sit close together, since doubling;
#NOP -- across a fifty scaler hole in the data says nothing about a wall;
#var ddJumpFloor {10000};
#var ddJumpGap {5};
#alias .dd_is_jump {
    #var ddJump 0;
    #math ddJumpSpan {%6 - %5};
    #if {%1 > 0 && %3 > 0 && %1 >= $ddJumpFloor && $ddJumpSpan <= $ddJumpGap} {
        #if {%3 >= %1 * 2} {#var ddJump 1};
        #if {%2 > 0 && %4 > 0} {
            #if {%4 >= %2 * 2} {#var ddJump 1};
        };
    };
} {2};

#NOP -- Leaves the full name for a key in ddName. Cross dungeon reports walk;
#NOP -- the step list and only carry the key, so they need this to print;
#alias .dd_key_name {
    #var ddName {%1};
    #loop 1 &dungeonInfo[] {ddN} {
        #if {"$dungeonInfo[$ddN][key]" == "%1"} {#var ddName {$dungeonInfo[$ddN][name]}};
    };
} {2};


#NOP ---------------------------------------------------------------------------;
#NOP -------------------------- Entry point ---------------------------------;
#NOP ---------------------------------------------------------------------------;

#alias {3kdb_dungeon_data} {
    #var ddArg1 {%1};
    #var ddArg2 {%2};
    #format {ddArg1} {%l} {$ddArg1};
    #if {"$ddArg1" == ""} {
        .dd_index;
    } {
        #if {"$ddArg1" == "help"} {
            .dd_help;
        } {
            #if {"$ddArg1" == "fixed"} {
                .dd_fixed;
            } {
                #if {"$ddArg1" == "jumps"} {
                    .dd_jumps {$ddArg2};
                } {
                    #if {"$ddArg1" == "scaler"} {
                        .dd_at_scaler {$ddArg2};
                    } {
                        #if {"$ddArg1" == "class"} {
                            .dd_by_class {$ddArg2};
                        } {
                            #if {"$ddArg1" == "town"} {
                                .dd_town {$ddArg2};
                            } {
                                #if {"$ddArg2" == ""} {
                                    .dd_show {$ddArg1};
                                } {
                                    .dd_show_at {$ddArg1} {$ddArg2};
                                };
                            };
                        };
                    };
                };
            };
        };
    };
};

#alias {ddata} {3kdb_dungeon_data %0};

.add_library {3kdb_dungeon_data} {misc} {dungeon mob class sizes by scaler with filters} {3kdb_dungeon_data <dungeon|scaler n|class size|town name|jumps|fixed|help>} {common/areas/dungeon_data.tin};
.add_library {ddata} {misc} {short form of 3kdb_dungeon_data} {ddata help} {common/areas/dungeon_data.tin};

#class {dungeon_data} {close};
