#class eq_general kill;
#class eq_general open;

#action {Your Eternal instincts sense %* %* connected to this item.} {#var numbersRoman @roman_to_number{%1}} {2};

#action {^The mask emits a dull glow.$} {#var mask[active] 0;} {2};
#action {^The mask shines brightly.$} {#var mask[active] 1;} {2};

#action {^You wield %*.} {#var wielded %1} {2};
#action {^Wielded: %*} {#format wielded {%p} {%1}} {2};
#NOP -- A disarm prints "You unwield Soul Drinker." just before "... disarms you!", so the weapon is kept in;
#NOP -- wielded_last for .rewield;
#action {^You unwield %*.} {#var wielded_last {%1};#var wielded {}} {2};

#NOP -- wield remembers the word you wielded with in my[rewield], saved with the character (knights-zorb uses;
#NOP -- my[wielded] for its own weapon swap), so .rewield sends the same word. #send so it doesn't call itself. A;
#NOP -- word the game doesn't know ("Wield which weapon?") is forgotten;
#alias {wield} {
    #if {"%0" != ""} {#var my[rewield] {%0}};
    #send {wield %0};
};
#action {^Wield which weapon?$} {#unvar my[rewield]} {2};

#NOP -- Disarmed: wield the same weapon again with that word. Without one (nothing wielded through the alias yet),;
#NOP -- eq_data (data.tin) gives the word for $wielded: "You wield" shows a short name (Soul Drinker) and eq the long;
#NOP -- one (The Soul Drinker Blade), so a row matches if its long name contains it. rolm.tin sets rod for the Rod of;
#NOP -- Lordly Might's forms. Nothing known: try rod, like the bots did;
#alias {.rewield} {
    #if {$idle_flag} {#return};
    #var rewieldCmd {rod};
    #var rewieldName {};
    #if {&wielded} {#var rewieldName {$wielded}};
    #if {"$rewieldName" == "" || "$rewieldName" == "none"} {
        #if {&wielded_last} {#var rewieldName {$wielded_last}};
    };
    #if {"$rewieldName" != "" && "$rewieldName" != "none"} {
        #list eq_data indexate long;
        #list eq_data find {%*$rewieldName%*} tmpIx;
        #if {$tmpIx > 0} {#var rewieldCmd {$eq_data[$tmpIx][alias]}};
    };
    #if {&my[rewield]} {
        #if {"$my[rewield]" != ""} {#var rewieldCmd {$my[rewield]}};
    };
    wield $rewieldCmd;
};
#action {^%* disarms you!$} {.rewield} {2};


#NOP -- Pol holy torch;
#action {Wisewoman says: You may need this torch. It is said to be very bright.} {light torch;keep torch} {2};

#class eq_general close;