#class zodiacs_items kill;
#class zodiacs_items open;

#NOP -- Inputs are %1 item/keyname %2 category;

#NOP -- Item Tracker Items;


#NOP -- Ring of Spite

#action {^Your ring pulses, sending an overwhelming wave of spiteful energy} {
    .trackItem {Ring of Spite} {Damage Special};
} {2};

#action {^Your amethyst stone flares with a psychic energy, invading %*} {
    .trackItem {Ring of Spite - Amethyst Stone} {Stun + Slow};
} {2};

#action {^A blur of golden light from your ring strikes with feline speed!$} {
    .trackItem {Ring of Spite - Tiger Eye Stone} {Damage Special};
} {2};

#action {^Your ring hums with energy as an extra blow lands!$} {
    .trackItem {Ring of Spite - Tiger Eye Stone} {Damage Special};
} {2};

#action {^Your ring flashes gold as a phantom strike lashes out!$} {
    .trackItem {Ring of Spite - Tiger Eye Stone} {Damage Special};
} {2};

#action {^The tiger's eye blazes as your hands move faster!$} {
    .trackItem {Ring of Spite - Tiger Eye Stone} {Damage Special};
} {2};

#action {^The tiger within the stone lashes out, guiding your strike!$} {
    .trackItem {Ring of Spite - Tiger Eye Stone} {Damage Special};
} {2};

#action {^Your malachite stone releases a cloud of noxious green mist!$} {
    .trackItem {Ring of Spite - Malchite Stone} {Damage Special};
} {2};




#class zodiacs_items close;
