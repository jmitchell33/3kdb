#class {artifacts} {kill};
#class {artifacts} {open};

#NOP -- Artifacts: guild artifacts don't bind, so like worlddrops2 they are grabbed off the floor right away (no bag;
#NOP -- check, no bot pause). The game gives them no aset of their own, they show with the usual item prefix;
#NOP -- (-a-, -o-, -i-) or none, so they are matched by name. Only while 'toggle artifacts' is on;
#NOP -- People leave artifacts on the floor in town (cot, ss, ...), so nothing happens in a Pinnacle room (map area);

#NOP -- Guilds from https://wemudtogether.com/artifacts-and-world-drops/;
#NOP -- One row per artifact: pattern (regex, no leading a/an/the, the regex allows one), guild, and the get word(s);
#NOP -- A get that misses ("There is no <key> here.") tries again with the key's last word;
#var artifactTable {};
#alias {.artifactAdd}
{
    #list artifactTable add {{{pattern} {%1} {guild} {%2} {key} {%3}}};
}
.artifactAdd {tower shield of the Akh'Velahr} {Bladesinger} {tower shield};
.artifactAdd {Circlet of the Coronal} {Bladesinger} {circlet};
.artifactAdd {Talisman of the Runemaster} {Bladesinger} {talisman};
