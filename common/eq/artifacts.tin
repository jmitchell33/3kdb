#NOP -- All the patterns as one regex alternation, for the actions;
#var artifactNames {};
#foreach {*artifactTable[]} {artifactIx}
{
    #if {"$artifactNames" == ""}
    {
        #var artifactNames {$artifactTable[$artifactIx][pattern]};
    };
    #else
    {
        #var artifactNames {$artifactNames|$artifactTable[$artifactIx][pattern]};
    };
};

#NOP -- Map areas that count as town. The cot, ss, bank, smithy and the rest of the streets are all Pinnacle;
#var artifactTownAreas {Pinnacle;New Pinnacle;Pinnacle Morgue;Pinnacle's Residential Complex;Pinnacle Mayor's Office;Pinnacle Sports Bar;The Pinnacle Humidor};

#NOP -- Actions only exist while the toggle is on. The floor line (with or without -a-/-o-/-i- in front) gets it;
#NOP -- and announces it. "<name>: Ok." is the bot's get all picking one up, which only announces (most mob drops;
#NOP -- show up this way, never on the floor). A short desc after the name, like (slimy ball), is allowed;
#alias {.artifacts_watch}
{
    #class {artifacts_watch} {kill};
    #if {"$toggles[artifacts]" == "1"}
    {
        #class {artifacts_watch} {open};
        #line substitute variables {#action {^{(?i)(?:-[a-z!]+-)?((?:(?:a|an|the) )?(?:$artifactNames)(?: [(<\[][^:]*)?)\.$}} {.artifactSeen {%%2} {1}} {2}};
        #line substitute variables {#action {^{(?i)((?:(?:a|an|the) )?(?:$artifactNames)(?: [(<\[][^:]*)?): Ok\.$}} {.artifactSeen {%%2} {0}} {2}};
        #class {artifacts_watch} {close};
    };
}
#delay {artifacts_watch} {.artifacts_watch} {7};

#NOP -- .artifactTownCheck <area>: artifactInTown is 1 when it's a town area;
#alias {.artifactTownCheck}
{
    #var artifactInTown 0;
    #foreach {$artifactTownAreas} {artifactTown}
    {
        #if {"%1" == "$artifactTown"}
        {
            #var artifactInTown 1;
        };
    };
}

#NOP -- .artifactRoomEntered <vnum>: MAP ENTER ROOM calls this. Remembers when the map was last in town;
#NOP -- #map run moves the map to the end of the run before the game's text for those rooms arrives, so the map's;
#NOP -- room alone can't say where a line came from. Running out of town would otherwise look like out of town;
#alias {.artifactRoomEntered}
{
    #if {"$toggles[artifacts]" == "1"}
    {
        #var artifactArea {};
        #map get roomarea artifactArea {%1};
        .artifactTownCheck {$artifactArea};
        #if {$artifactInTown}
        {
            #format artifactTownTime {%T};
        };
    };
}

#NOP -- .artifactInTown: artifactInTown is 1 when the map has the room in a town area, or was in one in the last;
#NOP -- artifactTownWindow seconds. A room the map doesn't know (no area) counts as out of town;
#var artifactTownWindow 5;
#var artifactTownTime 0;
#alias {.artifactInTown}
{
    #var artifactArea {};
    #map get roomarea artifactArea;
    .artifactTownCheck {$artifactArea};
    #local now {};
    #format now {%T};
    #if {$now - $artifactTownTime <= $artifactTownWindow}
    {
        #var artifactInTown 1;
    };
}

#NOP -- .artifactSeen <name> <get>: get is 1 for a floor sighting (pick it up) and 0 when it was already picked up;
#alias {.artifactSeen}
{
    #var artifactName {%1};
    .artifactInTown;
    #if {$artifactInTown}
    {
        #return;
    };
    #var artifactGuild {Unknown};
    #var artifactKey {};
    #foreach {*artifactTable[]} {artifactIx}
    {
        #if {"$artifactKey" == ""}
        {
            #regex {$artifactName} {^{(?i)(?:(?:a|an|the) )?(?:$artifactTable[$artifactIx][pattern])}}
            {
                #var artifactGuild {$artifactTable[$artifactIx][guild]};
                #var artifactKey {$artifactTable[$artifactIx][key]};
            };
        };
    };
    #if {"%2" == "1" && !$idle_flag}
    {
        .artifactGet {$artifactKey};
    };
    #NOP -- Only the first sighting of an artifact sends a notify or Discord post;
    #if {"$artifactLastSeen" == "$artifactName"}
    {
        #return;
    };
    #var artifactLastSeen {$artifactName};
    #delay {artifact_seen}
    {
        #var artifactLastSeen {};
    } {60};
    .notify {<fcb>ARTIFACT<ddd> $artifactName ($artifactGuild) at $roomvnum};
    #echo {<cfb>===========> <ccd>ARTIFACT $artifactName ($artifactGuild)<088>};
    #if {&webhook[url][artifacts] || &webhook[url][general]}
    {
        #if {&webhook[url][artifacts]}
        {
            #var discordChannel $webhook[url][artifacts];
        };
        #else
        {
            #var discordChannel $webhook[url][general];
        };
        #format artifactTime {%t} {%Y-%m-%d %H:%M};
        #var artifactRoom {$room[name]};
        #if {"$artifactRoom" == ""}
        {
            #map get roomname artifactRoom;
        };
        postDiscord [$artifactTime] ARTIFACT ($artifactGuild): $user_cap found $artifactName in $artifactRoom [$roomvnum] ($area);
    };
}

#NOP -- .artifactGet <key>: get it, and if the game doesn't know the key, get the key's last word instead;
#alias {.artifactGet}
{
    #var artifactGetKey {%1};
    #local words {%1};
    #list words explode { };
    #var artifactGetFallback {$words[-1]};
    #class {artifact_get} {kill};
    #if {"$artifactGetFallback" != "$artifactGetKey"}
    {
        #class {artifact_get} {open};
        #line substitute variables {#line oneshot #action {^There is no $artifactGetKey here.$} {get $artifactGetFallback} {1}};
        #class {artifact_get} {close};
        #delay {artifact_get}
        {
            #class {artifact_get} {kill};
        } {3};
    };
    get $artifactGetKey;
}

#class {artifacts} {close};
