#class {item_checker} {kill};
#class {item_checker} {open};


#alias .checkItem {
    #var tmpFoundWorldDrop 0;
    #format tmpName {%p} {%0};
	#var tmpWorldIx 1;
	#loop 1 &items_world_drops[] tmpWorldIx {
		#regex {$tmpName} {$items_world_drops[$tmpWorldIx]} {.notifyWorldDrop $items_world_drops[$tmpWorldIx]};
	};
};


#NOP -- World drops: the game puts world_drop_pref (setup_3kdb sets it to -!!!-) in front of "You have found <item>!".;
#NOP -- The item is in the corpse and binds on pickup, so the corpse get all skips it and it needs its own get. It only;
#NOP -- reaches the floor once the corpse is gone (dirge, decay), so the get tries the corpse first, then the floor;
#action {^-!!!-You have found %*!$} {.notifyWorldDrop {%1}} {2};

#NOP -- The get keyword: the first word below that is in the name (longer words first), else its last word (some drops, like Robe of;
#NOP -- Therlasia, show another name until they are picked up);
#var worldDropKeys {shieldbreaker;buckler;breastplate;gauntlets;boots;helmet;shield;armour;cloak;robes;robe;amulet;skull;staff;blade;flask;kitten;timerender;thundering;device};

#alias .notifyWorldDrop {
    #local name {%1};
    #NOP -- worldDropKey is a #var: a #local set inside a #regex branch is gone when the branch ends;
    #var worldDropKey {};
    #local lname {};
    #format lname {%l} {$name};
    #foreach {$worldDropKeys} {k} {#if {"$worldDropKey" == ""} {#regex {$lname} {%*$k%*} {#var worldDropKey $k}}};
    #if {"$worldDropKey" == ""} {
        #local words {$lname};
        #replace words {%s(%*)} {};
        #replace words {%s<%*>} {};
        #list words explode { };
        #var worldDropKey {$words[-1]};
    };
    #if !$idle_flag {get $worldDropKey from corpse;get $worldDropKey};
    .notify {<fcb>WORLD DROP<ddd> $name at $roomvnum};
    #echo {<cfb>===========> <ccd>WORLD DROP $name<088>};
    #if {"&webhook[url][worlddrops]" == "1"} {
        #var discordChannel $webhook[url][worlddrops];
        postDiscord {WORLD DROP: $user_cap found $name in $room[name] ($area)};
    };
    #if {$toggles[worlddrops] && $bot[active] && !$bot[paused]} {
        #echo {<cfb>===========> <ccd>BOT PAUSED, 'toggle worlddrops' turns this off<088>};
        .pause;
    };
};

#class {item_checker} {close};
