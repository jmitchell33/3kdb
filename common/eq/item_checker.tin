#class {item_checker} {kill};
#class {item_checker} {open};

#NOP -- To be added if below pattern works;
#NOP Amulet of Voraxis|Amulet of Waves|An exploding kitten|Buckler of Eternia|Frosted armour of Aylin|Frosted boots of Aylin|Frosted breastplate of Aylin|Frosted gauntlets of Aylin|Frosted helmet of Aylin|Frosted shield of Aylin|Golden Robes of Intellect|Molok's Titanium Breastplate|QT Amulet|Redoubt Cloak|Robe of Therlasia|Shieldbreaker|Shimmering cloak of Aylin|Skull of the Dracolich, Yaxtan|Staff of Elemental Fury|Thundering|TimeRender|Frosted shield of Aylin;


#alias .notifyWorldDrop {
	#echo {<cfb>===========> <ccd>WORLD DROP %0 <088>};
	#format tmpName {%p} {%0};
	#var tmpName @ansiStrip{$tmpName};
	#if $toggles[worlddrops] {
		#if {$bot[active] == 1} {
			#echo {<cfb>===========> <ccd>BOT PAUSED <088>};
			#echo {<cfb>===========> <ccd> 'toggle worlddrops' to <fbb>off <ccd>to not stop in the future <088>};
			.pause;#delay {1} {.pause}
		};
	};
};

#alias .checkItem {
    #var tmpFoundWorldDrop 0;
    #format tmpName {%p} {%0};
	#var tmpWorldIx 1;
	#loop 1 &items_world_drops[] tmpWorldIx {
		#regex {$tmpName} {$items_world_drops[$tmpWorldIx]} {.notifyWorldDrop $items_world_drops[$tmpWorldIx]};
	};
};

#list items_world_drops add {\e[0;33m%* flask};
#list items_world_drops add {The Soul Drinker Blade};
#list items_world_drops add {a red robe made of a fine fabric};
#list items_world_drops add {Iridescent Incense};
#list items_world_drops add {PICNP Device};
#list items_world_drops add {Amulet of Tanooki};
#list items_world_drops add {Amulet of Voraxis};
#list items_world_drops add {Buckler of Eternia};


#class {item_checker} {close};
