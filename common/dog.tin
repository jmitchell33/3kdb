#class {common_dog} {kill};
#class {common_dog} {open};

#var dogcare[pet_below] 90;
#var dogcare[feed_at] 20;
#var dogcare[heal_below] 30;
#var dogcare[wait] 0;
#var dogcare[backoff] 0;
#var dogcare[healing] 0;
#var dogcare[inciting] 0;
#var dogcare[novet] 0;
#var dogcare[vetcmds] 0;
#var dogcare[gone] 0;
#var dogcare[dug] {};

#action {^%* :: HP:%s%d\/%d%sHappy:%s%d\%%sHungry:%s%d\%} {
    #var my[dog][name] {%1};
    #var my[dog][hp][current] %3;
    #var my[dog][hp][max] %4;
    #var my[dog][happy][current] %7;
    #var my[dog][hungry][current] %10;
    #undelay {dogcare_gone};
    #var dogcare[gone] 0;
    #if {"$toggles[dog_care]" == "1" && "$idle_flag" != "1"} {.dogcare_check};
} {6};

#action {^-M-_$my[dog][name], $user_cap's %*.} {
    #list room[familiars] add {$my[dog][name], $user_cap's %1};
    .dogcare_dig;
} {1};

#action {^$my[dog][name], $user_cap's %* bounds into the room.$} {.dogcare_dig} {4};

#action {^Vet Commands: %d/%d} {
    #var dogcare[vetcmds] %1;
    #if {"$toggles[dog_care]" == "1" && "$idle_flag" != "1" && "$incombat" == "1" && %1 >= %2 && !$dogcare[novet] && !$dogcare[inciting]} {
        #var dogcare[inciting] 1;
        #delay {dogcare_inciting} {#var dogcare[inciting] 0} {4};
        #send {!vet incite};
    };
} {4};

#action {^There is no reason to 'vet' here.$} {#var dogcare[novet] 1} {4};

#alias {.dogcare_check} {
    #if {$dogcare[wait]} {#undelay {dogcare_wait};#var dogcare[wait] 0};
    .dogcare_heal;
    #if {$my[dog][hungry][current] >= $dogcare[feed_at] && !$dogcare[backoff]} {
        #var dogcare[wait] 1;
        #delay {dogcare_wait} {#var dogcare[wait] 0;#var dogcare[backoff] 1;#delay {dogcare_backoff} {#var dogcare[backoff] 0} {300}} {5};
        #send {!unwrap};
        #send {!dog feed};
    } {
        #if {$my[dog][happy][current] < $dogcare[pet_below]} {
            #send {!dog pet};
        };
    };
};

#alias {.dogcare_heal} {
    #if {!$dogcare[novet] && !$dogcare[healing] && $dogcare[vetcmds] > 0} {
        #if {$my[dog][hp][current] * 100 < $my[dog][hp][max] * $dogcare[heal_below]} {
            #var dogcare[healing] 1;
            #delay {dogcare_healing} {#var dogcare[healing] 0} {4};
            #send {!vet heal};
        };
    };
};

#alias {.dogcare_dig} {
    #if {"$toggles[dog_care]" == "1" && "$idle_flag" != "1" && "$roomvnum $room_short" != "$dogcare[dug]"} {
        #var dogcare[dug] {$roomvnum $room_short};
        #send {!dog dig};
    };
};

#ticker {dogcare_hp} {
    #if {"$toggles[dog_care]" == "1" && "$idle_flag" != "1" && !$dogcare[gone]} {
        #send {!dog hp};
        #delay {dogcare_gone} {#var dogcare[gone] 1} {10};
    };
} {300};

#class {common_dog} {close};
