#action {Your celestial insight reveals the creation of a portal to the unknown.} {
        #if {"$toggle_portal_room" == "1"} { 
        .pause;
        #map get roomvnum zodiac_portalVnum;
        #echo {<fff>PORTAL ROOM OPEN!<088>};
        ptell portal room open! roomvnum: $zodiac_portalVnum;
        #var toggle_portal_room 0;
        #delay 5 {
            portal;
            open first chest;
            open second chest;
            open third chest;
            open fourth chest;
            open fifth chest;
            open sixth chest;
        };
        #line oneshot #action {As the chest opens, panic washes over you!} {
            #if {"$guild" == "juggernaut"} {
                checkStrategy {mechwarrior} {support defend};
            };
            kill amalgamation;
        } {1};
    };
} {1};

#action {The stars align and your celestial insight reveals} {
    #if {"$toggle_portal_room" == "1"} { 
        .pause;
        #map get roomvnum zodiac_portalVnum;
        #echo {<fff>PORTAL ROOM OPEN!<088>};
        ptell portal room open! roomvnum: $zodiac_portalVnum;
        #var toggle_portal_room 0;
        #delay 5 {
            portal;
            open first chest;
            open second chest;
            open third chest;
            open fourth chest;
            open fifth chest;
            open sixth chest;
        };
        #line oneshot #action {As the chest opens, panic washes over you!} {
            #if {"$guild" == "juggernaut"} {
                checkStrategy {mechwarrior} {support defend};
            };
            kill amalgamation;
        } {1};
    };
} {1};

#action {As you land the final blow upon the mimic} {
    #delay 10 {
        #if {"$zodiac_portalVnum" != ""} {portal};
        .unpause;.botStep;
    };
} {1};

#action {This chest has already been opened.} {
    #if {"$toggle_portal_room_empty" == "1"} {
        #var toggle_portal_room_empty 0;
        portal;
        .unpause;.botStep;
    };
} {1};

#action {A COLOSSAL MONSTROSITY STOMPS INTO VIEW} {
    .pause;
    #delay 6 {
        .unpause;
    };
} {1};

#action {You are blind.} {
    .pause;
} {1};

#action {Sight returns to your eyes, darkness becomes light again.} {
    .unpause;.botStep;
} {1};

#action {^The warrior deftly disarms you!$} {
    wield rod;
} {1};

#alias .chest_action {
    .pause;
    examine chest;
    search chest;
    #echo {chest found};
    #delay 2 {.unpause;.botStep};
};

#alias .zodiac_check_chest_room {
    #if {$bot[foundmob]} {
        .unpause;
        .determineBotAction;
    } {
        #unact {%1};
        .chest_action;
    };
};

#action {You find some gold coins in the chest!} {get coins;exa chest} {1};

#action {Your vision becomes blurry. While your surroundings are intriguing, your} {.unpause;.botStep} {1};

#action {The Treasury \(w,se\)} {.pause;#delay .3 {.zodiac_check_chest_room {The Treasury \(w,se\)}}} {1};
#action {Chamber of treasure \(s,ne\)} {.pause;#delay .3 {.zodiac_check_chest_room {Chamber of treasure \(s,ne\)}}} {1};
#action {Monk's Dormitory \(w,s,nw,ne\)} {.pause;#delay .3 {.zodiac_check_chest_room {Monk's Dormitory \(w,s,nw,ne\)}}} {1};
#action {Chamber of the chest \(e,sw\)} {.pause;#delay .3 {.zodiac_check_chest_room {Chamber of the chest \(e,sw\)}}} {1};
#action {Explorer's Lounge \(e,sw\)} {.pause;#delay .3 {.zodiac_check_chest_room {Explorer's Lounge \(e,sw\)}}} {1};

#alias {.zodiac_resume_normal} {
    #var bot[zodiac_bt] 0;
    #var bot[zodiac_purge_kill] 0;
    .unpause;
    .botStep;
};

#alias {.zodiac_resume_backtrack} {
    .pause;
    glance;
    #delay 2 {.zodiac_after_glance};
};

#alias {.zodiac_find_level_bounds} {
    #var {zodiac_d_index} {0};
    #var {zodiac_prev_d_index} {0};
    #loop {1} {$bot[step]} {_zbi} {
        #if {"${bot[steps][$_zbi]}" == "d"} {
            #var {zodiac_prev_d_index} {$zodiac_d_index};
            #var {zodiac_d_index} {$_zbi};
        };
    };
    #if {$zodiac_d_index == 0} {
        #var {zodiac_d_index} {$bot[step]};
    };
    #if {$zodiac_prev_d_index == 0} {
        #var {zodiac_level_start} {1};
    } {
        #math {zodiac_level_start} {$zodiac_prev_d_index + 1};
    };
};

#alias {.zodiac_physical_backstep} {
    #if {"$bot[zodiac_bt]" != "1"} {#return};
    #if {$bot[step] <= $zodiac_level_start} {#return};
    #math {_zidx} {$bot[step] - 1};
    #if {$_zidx < $zodiac_level_start} {#return};
    #list {bot[steps]} {get} {$_zidx} {zodiac_tok};
    #format {zodiac_tok} {%p} $zodiac_tok;
    #switch {"$zodiac_tok"} {
        #case {"n"} {#send s};
        #case {"s"} {#send n};
        #case {"e"} {#send w};
        #case {"w"} {#send e};
        #case {"ne"} {#send sw};
        #case {"nw"} {#send se};
        #case {"se"} {#send nw};
        #case {"sw"} {#send ne};
        #case {"u"} {#send d};
        #case {"d"} {#send u};
        #case {"enter"} {#send out};
        #case {"out"} {#send enter};
        #case {"portal"} {#send portal};
        #case {"swim"} {#send swim};
        #case {"light"} {#nop};
        #default {
            #var bot[zodiac_bt] 0;
            .unpause;
            #showme {Zodiac backstep unknown token $zodiac_tok};
            .botStep;
        };
    };
    #if {"$bot[zodiac_bt]" == "1"} {
        #math {bot[step]} {$bot[step] - 1};
        #var {bot[walk]} {0};
    };
};

#alias {.zodiac_after_glance} {
    #if {"$bot[zodiac_bt]" != "1"} {#return};
    #if {$bot[step] <= $zodiac_level_start} {
        .zodiac_resume_normal;
        #return;
    };
    #if {$bot[foundmob]} {
        #if {"$mob[target]" == "soul" || "$mob[target]" == "colossus" || "$mob[target]" == "mimic"} {
            #var bot[zodiac_purge_kill] 1;
            .unpause;
            .determineBotAction;
        } {
            #var bot[zodiac_bt] 0;
            .unpause;
            .determineBotAction;
        };
    } {
        .pause;
        .zodiac_physical_backstep;
        #delay .3 {glance};
        #delay 2 {.zodiac_after_glance};
    };
};

#action {^You cannot leave while there are still celestials present on this level.$} {
    #var bot[zodiac_bt] 1;
    .pause;
    .zodiac_find_level_bounds;
    #math {zodiac_undo_count} {$bot[step] - $zodiac_d_index};
    #if {$zodiac_undo_count < 1} {#var zodiac_undo_count 1};
    #loop {1} {$zodiac_undo_count} {_zu} {#map undo};
    #var bot[step] $zodiac_d_index;
    #var bot[walk] 0;
    #delay .3 {glance};
    #delay 2 {.zodiac_after_glance};
} {1};

#class {bot} {close};
#read common/bot/generic.tin;
