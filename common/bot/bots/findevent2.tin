#class {bot} {open}

#var {bot[path]} {portal;w;w;w;w;w;w;w;w;w;w;w;w;leave;sw;w;w;w;w;s;w;w;s;w;w;s;w;s;w;s;w;n;w;n;w;e;e;e;e;e;n;w;w;w;w;w;w;n;e;e;e;e;e;e;e;e;e;e;n;w;w;w;w;w;w;w;w;w;w;e;n;e;e;e;e;e;e;e;e;e;e;e;e;e;e;n;e;e;e;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;e;n;e;e;e;s;e;e;n;e;e;e;e;e;e;e;e;e;e;e;n;w;w;w;w;w;w;w;w;w;w;w;n;e;e;e;e;e;e;e;e;e;e;e;e;n;e;e;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;n;w;w;w;w;s;e;e;n;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;ne;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;e;n;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;n;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;e;n;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;n;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;e;e;e;e;e;e;e;e;e;e;n;e;e;e;e;e;e;e;e;e;n;w;w;w;w;w;w;w;e;n;e;e;e;e;e;e;e;n;e;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;n;n;s;s;e;e;s;e;e;s;n;e;e;n;w;w;w;w;s;sw;ne;n;n;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;n;e;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;e;e;e;n;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;n;n;e;n;w;s;w;s;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;e;n;e;e;e;e;e;e;e;e;n;w;w;w;w;w;w;w;w;n;e;e;e;e;e;e;e;e;n;e;e;s;n;n;e;e;s;e;w;s;w;n;n;w;w;n;s;s;w;w;w;w;w;w;w;w;e;n;e;e;n;e;s;e;e;e;s;s;s;s;s;s;s;s;s;s;s;s;s;s;s;s;s;w;w;w;w;w;s;s;w;w;s;s;s;s;enter;s;s;s;s;s;s;s;s;s;s;s;s;portal;portal;n;n;n;n;n;n;n;n;n;n;n;n;leave;n;n;n;n;n;n;n;n;e;e;e;e;n;n;n;n;n;n;n;e;e;e;e;n;n;e;e;e;n;n;n;s;s;s;w;w;w;w;w;w;w;w;s;s;e;s;s;s;s;s;s;s;w;w;w;w;s;s;s;s;s;s;s;s;enter;s;s;s;s;s;s;s;s;s;s;s;s;portal};

                 
#act {Interdimensional Portal.} {
       #echo { \n\n<116>EVENT FOUND<088>!!!!!!!!!!!!!\n\n};
       #map get roomvnum vnum_event;
       .stop;
       #NOP -- Kayos loads only after the plunge works, the bot class is gone so these live in their own class;
       #class {findevent} {open};
       #NOP -- Priority 1 so this wins over the maphelper leap action, .kayosLeap keeps the map in step;
       #action {You leap into the unknown!} {
           .kayosLeap;
           #class {findevent} {kill};
           #delay 3 {
               #read common/bot/bots/kayos.tin;
               #var bot[alias] kayos;
               enter;
           };
       } {1};
       #action {^There is no reason to 'plunge' here.$} {
           #class {findevent} {kill};
           #echo {<faa>PLUNGE FAILED - NOT AT THE PORTAL (VNUM $vnum_event), KAYOS NOT LOADED<088>};
       } {1};
       #class {findevent} {close};
       #NOP -- Moves already sent can carry us past the portal, so wait for them to land and walk back;
       #delay 1.5 {
           #map run {$vnum_event};
           plunge;
       };
 } {1};
	
#class {bot} {close}
#read common/bot/generic.tin
