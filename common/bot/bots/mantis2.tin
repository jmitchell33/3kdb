#class {bot} {kill}
#class {bot} {open}

#var bot_message_1 '---- MANTIS SWAMP INTRADIMENSIONAL----';
#var bot_message_2 '---- ALL TARGETS ----';
#show $bot_message_1;#show $bot_message_2;


#var {bot[path]} {s;s;s;n;w;e;n;e;w;n;w;e;n;n;nw;w;s;sw;s;s;sw;se;nw;ne;n;n;ne;n;e;se;e;s;s;n;e;se;s;s;e;w;n;n;nw;w;n;w;s;s};


#list botmobs clear;
#list botmobs add {{{long} {Praying Mantis \(interdimensional\)} {target} {mantis}}};
#list botmobs add {{{long} {Huge Praying Mantis \(interdimensional\)} {target} {mantis}}};
#list botmobs add {{{long} {Flying Praying Mantis \(interdimensional\)} {target} {mantis}}};

#class {bot} {close}

#read common/bot/generic.tin;