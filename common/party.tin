#class common_party kill
#class common_party open

#var cassist[status] 0;

#NOP -- rally other players when they use the soul 'toke' on you;
#action {^%w offers you a toke.$} {
    #if !$idle_flag {
        #format tmp {%l} {%1};
        #if {$toggles[emote_rally]} {
            rally $tmp;
        } {
            #delay tmpResponse {say Sorry, auto-rally is not currently enabled.} {3};
        };
    };
} {2};

#NOP -- Clear your dungeons if they use the soul 'alien' on you;
#action {^%w takes your alien.  You never get over it.  Ever.$} {
    #if !$idle_flag {
        #if {$toggles[emote_dungeon_clear]} {
            dungeons clear all;
        } {
            #delay tmpResponse {say Sorry, dungeon clear is not currently enabled.} {3};
        };
    };
} {2};

#action {^You are already assisting %w.$} {
    #var addItem 1;
    #format temp {%l} {%1};
    #foreach $cassist[member][%*] member {
        #if {"$member[name]" == "%1"} {
            #var addItem 0;
        };
    };
    #if $addItem {
        #var cassist[member][%1][name] %1;
        #var cassist[member][%1][name-lower] $temp;
        #var cassist[member][%1][active] 1;
    } {
        #var cassist[member][%1][active] 1;
    };
};

#action {^You are now assisting %w.$} {
    #var addItem 1;
    #var cassist[status] 1;
    #format temp {%l} {%1};
    #foreach $cassist[member][%*] member {
        #if {"$member[name]" == "%1"} {
            #var addItem 0;
        };
    };
    #if $addItem {
        #var cassist[member][%1][name] %1;
        #var cassist[member][%1][name-lower] $temp;
        #var cassist[member][%1][active] 1;
    } {
        #var cassist[member][%1][active] 1;
    };
};

#action {^Cleared.$} {
    #foreach $cassist[member][%*] member {
        #var cassist[member][%1][active] 0;
        #var cassist[status] 0;
    };
};

#action {^You've declared your dislike for %w...$} {
    #foreach $cassist[member][%*] member {
        #if {"$member[name]" == "%1"} {
            #var cassist[member][%1][active] 0;
        };
    };
};

#NOP -- party[member][Name] holds name, name-lower and kills for each party member.;
#NOP -- Joins, boots and quits update it from the [PARTY] lines, see common/whitelist.tin.;
#NOP -- The members command output rebuilds it in full, so it can always be resynced by hand.;
#var party[member] {};

#NOP -- .party_add {Name}: adds a member, Name is capitalized as the game shows it;
#alias {.party_add} {
    #format party_add_lower {%l} {%1};
    #var party[member][%1][name] {%1};
    #var party[member][%1][name-lower] {$party_add_lower};
    #var party[member][%1][kills] 0;
};

#NOP -- .party_remove {Name}: removes a member who quit or was booted;
#alias {.party_remove} {
    #unvar party[member][%1];
};

#NOP -- members header line, empty the list so anyone no longer in the party drops off;
#action {^ Name%sGuild%s[%s HP/%sMAX] [%s SP/%sMAX]} {
    #var party[member] {};
} {2};

#NOP -- members output, one row per member, the leader's row starts with *;
#action {^{\*| }%w %* [%s%d/%s%d] [%s%d/%s%d]%s%d%s%d%s%d} {
    .party_add {%2};
} {2};

#NOP -- members output when you are not in a party;
#action {^There is no reason to 'members' here.$} {
    #var party[member] {};
} {2};

#NOP -- share bot status;
#alias {3kdb} {
    ptell 3kdb bot status
};

#NOP -- 3kdb reporting stuff;
#act {~\e[%*;%+m[PARTY]%* %w: 3kdb %w corpses} {
    #var partyReportString $corpse_string;
    #replace partyReportString {<088>} {};
    #replace partyReportString {<ceb>} {};
    #replace partyReportString {\\n} {:};
    #replace partyReportString {  } {};
    #if {"%5" == "bot"} {
        #if {!$idle_flag && $bot[active]} {#delay .2 {ptell $partyReportString};};
    };
    #if {"%5" == "$user"} {
        #if {!$idle_flag} {#delay .2 {ptell $partyReportString};};
    };
} {2};

#NOP -- ROOM VNUM REPORTING;
#act {~\e[%*;%+m[PARTY]%* %w: 3kdb %w vnum} {
    #if {"%5" == "$user" && !$idle_flag} {
        #map get roomvnum temp_vnum;
        ptell My current vnum is $temp_vnum;
    };
} {2};

#NOP -- CORPSE SHARING AND REPORTING;
#var gimme_corpses 1;
#NOP -- 3kdb <name|bot> corpses gimme-<coffin|freezer|cooler> [amount], amount defaults to 10;
#NOP -- %7 is the amount with its leading space, or empty when none was given;
#act {~\e[%*;%+m[PARTY]%* %w: 3kdb %w corpses {gimme-[a-z]+}{ [0-9]+|}} {
    #if {"%7" == ""} {
        #var tmpQuant 10;
    } {
        #math tmpQuant {%7};
    };
    #if {"%5" == "$user"} {
        #if {!$idle_flag && $gimme_corpses} { 
            #if {"%6" == "gimme-coffin"} {
                #var gimme_corpses 0;
                ptell Attempting to unwrap $tmpQuant corpses;
                #${tmpQuant} unwrap;
                #delay .1 {i};
                #delay 4 {#var gimme_corpses 1};
            };
            #if {"%6" == "gimme-freezer"} {
                #var gimme_corpses 0;
                ptell Attempting to deslab $tmpQuant corpses;
                #${tmpQuant} deslab;
                #delay .1 {i};
                #delay 4 {#var gimme_corpses 1};
            };
            #if {"%6" == "gimme-cooler"} {
                #var gimme_corpses 0;
                ptell Attempting to uncooler $tmpQuant corpses;
                #${tmpQuant} uncooler corpse;
                #delay .1 {examine cooler};
                #delay 4 {#var gimme_corpses 1};
            };
        };
    };
    #if {"%5" == "bot"} {
        #if {!$idle_flag && $bot[active] && $gimme_corpses} {
            #if {"%6" == "gimme-coffin"} {
                #var gimme_corpses 0;
                ptell Attempting to unwrap $tmpQuant corpses;
                #${tmpQuant} unwrap;
                #delay .1 {i};
                #delay 4 {#var gimme_corpses 1};
            };
            #if {"%6" == "gimme-freezer"} {
                #var gimme_corpses 0;
                ptell Attempting to deslab $tmpQuant corpses;
                #${tmpQuant} deslab;
                #delay .1 {i};
                #delay 4 {#var gimme_corpses 1};
            };
            #if {"%6" == "gimme-cooler"} {
                #var gimme_corpses 0;
                ptell Attempting to uncooler $tmpQuant corpses;
                #${tmpQuant} uncooler corpse;
                #delay .1 {examine cooler};
                #delay 4 {#var gimme_corpses 1};
            };
        };
    };
} {1};

#act {~\e[%*;%+m[PARTY]%* %w: 3kdb bot status} {
    #if {$bot[active] && !$idle_flag} {
        .xp_rate {$bot[stats][xp]} {$bot[start-time]};
        #var xp_rate_str $xp_rate_str ($xp_time_str);
        #if {!$idle_flag && $bot[active]} {
            #var temp_xp $bot[stats][xp];
            ptell Progress: $bot_current_room/$bot_total_rooms ($bot_progress%) Mobs Killed: $bot[stats][mobs]  XP Gained: @thousandsFormatNumber{$temp_xp}  XP Rate/Hr: $xp_rate_str;
        };
    };
} {1};

#action {[PARTY] {%w}: nofollow: %*} {
    #format followInviter {%l} {%1};
    #if {"$following" == "$followInviter"} {%2};
} {1};



#act {~\e[%*;%+m[PARTY]%* %w: 3kdb bot path-find} {
    #if {!$idle_flag && $bot[active]} {
        #if {"$bot[alias]" == "tao"} {
            #NOP -- Tao has no path, its steps are .tao_step so give the chapter instead;
            #delay .2 {ptell Tao has no path to follow, I am on Book $tao_book, Chapter $tao_chapter};
        } {
            #NOP -- bot[step] is the next step to take, so the steps already walked are 1 to bot[step] - 1;
            #math partyReportLast {$bot[step] - 1};
            #if {$partyReportLast < 1} {
                #delay .2 {ptell I am still in the bot start room, vnum $bot[start_vnum]};
            } {
                #var partyReportPath {$bot[steps][1]};
                #if {$partyReportLast > 1} {
                    #loop 2 $partyReportLast partyReportIndex {
                        #cat partyReportPath {;$bot[steps][$partyReportIndex]};
                    };
                };
                #delay .2 {#send {ptell Path to find me from vnum $bot[start_vnum]: ${partyReportPath}}};
            };
        };
    };
} {1};

#NOP -- Tao Te Cheng book and chapter, tao_book and tao_chapter come from common/bot/bots/tao.tin;
#act {~\e[%*;%+m[PARTY]%* %w: 3kdb bot tao} {
    #if {!$idle_flag && $bot[active] && "$bot[alias]" == "tao"} {
        #delay .2 {ptell Tao: Book $tao_book, Chapter $tao_chapter};
    };
} {1};

#act {~\e[%*;%+m[PARTY]%* %w: 3kdb bot help} {
    #if {!$idle_flag && $bot[active]} {
        #delay .2 {
            ptell ---------------------------------------------------;
            ptell -----             3kdb Bot Helpers            -----;
            ptell ----- usage: ptell 3kdb bot <command>         -----;
            ptell ----- status - XP & progress report           -----;
            ptell ----- path-find - directions to find me       -----;
            ptell ----- tao - Tao Te Cheng book & chapter       -----;
            ptell ----- corpses - report corpse count           -----;
            ptell ----- corpses gimme-coffin - give 10 corpses  -----;
            ptell ----- corpses gimme-coffin 25 - give 25       -----;
            ptell ----- gimme-freezer and gimme-cooler too      -----;
            ptell ----- ptell 3kdb <name> vnum - room vnum      -----;
            ptell ----- ptell 3kdb <name> corpses - same as bot -----;
            ptell ---------------------------------------------------;
            #if {"$bot[alias]" == "tao"} {
                ptell Tao: Book $tao_book, Chapter $tao_chapter;
            };
        };
    };
} {1};


#class common_party close