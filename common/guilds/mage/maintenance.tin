#class {guild_maintenance} {kill}
#class {guild_maintenance} {open}

#NOP --- MAINT: pick which defenses the guild heartbeat keeps up. Type maint-help;
#NOP -- heartbeat.tin recasts a spell while defs[<defs>] is 1 and my[prots][<prot>] (hpbar) is 0.;
#NOP -- maint only sets those defs flags from your picks. The shared code is common/maint.tin, picks are;
#NOP -- saved per guild in xmaint[mage] (class global, chars/<you>/vars.tin), so ld and the autosave keep them.;
#NOP -- Contingency fields, for maint setup: cspell = the spell it casts, ctrig = its trigger (empty = none,;
#NOP -- mindblank has no trigger), cval = mage[contingencies] key for the HP value (mantle/sphere), cshow =;
#NOP -- how the trigger reads in the contingency lists (regex alternatives).;
#var maint_spells[mb]     {{name} {Mindblank}            {defs} {MB}     {prot} {MB} {group} {mb} {cspell} {mindblank} {ctrig} {} {cval} {} {cshow} {}};
#var maint_spells[ps]     {{name} {Prismatic Sphere}     {defs} {PS}     {prot} {PS} {group} {ps} {cspell} {prismatic sphere} {ctrig} {prismatic sphere} {cval} {sphere} {cshow} {prismatic sphere}};
#var maint_spells[pa]     {{name} {Prismatic Aura}       {defs} {PA}     {prot} {PA} {group} {pa} {cspell} {prismatic aura} {ctrig} {prismatic aura} {cval} {} {cshow} {prismatic aura|prismatic_aura}};
#var maint_spells[mantle] {{name} {Mantle}               {defs} {M}      {prot} {M} {group} {mantle} {cspell} {mantle} {ctrig} {mantle} {cval} {mantle} {cshow} {mantle}};
#var maint_spells[major]  {{name} {Major Globe}          {defs} {MG}     {prot} {MG} {group} {globe} {cspell} {major globe} {ctrig} {major globe} {cval} {} {cshow} {major globe|major_globe}};
#var maint_spells[minor]  {{name} {Minor Globe}          {defs} {mg}     {prot} {mg} {group} {globe} {cspell} {minor globe} {ctrig} {minor globe} {cval} {} {cshow} {minor globe|minor_globe}};
#var maint_spells[ms]     {{name} {Magnificent Shield}   {defs} {ms}     {prot} {MS} {group} {shield} {cspell} {magnificent shield} {ctrig} {shield} {cval} {} {cshow} {shield}};
#var maint_spells[shield] {{name} {Shield}               {defs} {shield} {prot} {S} {group} {shield} {cspell} {shield} {ctrig} {shield} {cval} {} {cshow} {shield}};
#var maint_spells[armor]  {{name} {Armor}                {defs} {A}      {prot} {A} {group} {armor} {cspell} {armor} {ctrig} {armor} {cval} {} {cshow} {armor}};
#var maint_spells[ss]     {{name} {Stoneskin}            {defs} {SS}     {prot} {SS} {group} {skin} {cspell} {stoneskin} {ctrig} {stoneskin} {cval} {} {cshow} {stoneskin}};
#var maint_spells[rs]     {{name} {Rhino Skin}           {defs} {rs}     {prot} {RS} {group} {skin} {cspell} {rhino skin} {ctrig} {stoneskin} {cval} {} {cshow} {stoneskin}};
#var maint_spells[blink]  {{name} {Blink}                {defs} {blink}  {prot} {B} {group} {blink} {cspell} {blink} {ctrig} {blinking} {cval} {} {cshow} {blinking|blink|blur}};
#var maint_spells[pfe]    {{name} {Protection from Evil} {defs} {pe}     {prot} {PE} {group} {align} {cspell} {protection from evil} {ctrig} {prot_evil} {cval} {} {cshow} {protection from evil|prot_evil}};
#var maint_spells[pfg]    {{name} {Protection from Good} {defs} {pg}     {prot} {PG} {group} {align} {cspell} {protection from good} {ctrig} {prot_good} {cval} {} {cshow} {protection from good|prot_good}};
#list maint_order create {mb;ps;pa;mantle;major;minor;ms;shield;armor;ss;rs;blink;pfe;pfg};
#NOP -- What maint default picks;
#list maint_default create {mb;ps;mantle;major;ms;armor;ss;pfg};

#NOP -- Words you can type for each spell (lower case), mapped to its key above;
#var maint_words {
    {mb} {mb} {mindblank} {mb}
    {ps} {ps} {sphere} {ps}
    {pa} {pa} {aura} {pa}
    {mantle} {mantle} {m} {mantle}
    {major} {major} {majorglobe} {major}
    {minor} {minor} {minorglobe} {minor}
    {ms} {ms} {magnificent} {ms} {mshield} {ms}
    {shield} {shield} {s} {shield}
    {armor} {armor} {a} {armor}
    {ss} {ss} {stoneskin} {ss}
    {rs} {rs} {rhino} {rs} {rhinoskin} {rs}
    {blink} {blink} {b} {blink}
    {pfe} {pfe} {pe} {pfe} {evil} {pfe}
    {pfg} {pfg} {pg} {pfg} {good} {pfg}
};

#NOP -- Spells in the same group conflict in game (one globe, one skin, one shield, evil or good), so picking;
#NOP -- one unpicks the rest of its group and stops recasting them.;
#var maint_cfg {{noun}{spell}{Nouns}{Spells}{start}{0}{resume}{linkdeath}};
#var maint_cmds {{all}{_maint_all}{setup}{maint_setup}{list}{_cont_fetch _maint_list}{check}{_cont_fetch _maint_list}{status}{_cont_fetch _maint_list}};

#action {^You already have %*} {_maint_refused} {8};
#action {^You are already protected by %*} {_maint_refused} {8};
#action {^Another defensive spell is conflicting} {_maint_refused} {8};
#action {^You do not have enough spell points to cast %*} {_maint_nosp {%1}} {8};

#alias {_maint_isup} {
    #if {"$my[prots][$maint_spells[%1][prot]]" == "1"} {#var _mupnow 1} {#var _mupnow 0};
};

#NOP -- Table of every spell: picked, kept up by the heartbeat (defs), and up on the hpbar (my[prots]);
#alias {_maint_list} {
    #echo {};
    #echo {<ccf>  ====================  MAGE MAINT  ====================<088>};
    #echo {<fff>  Type    Spell                 Picked  Kept  Up    Contingency  Variables<088>};
    #echo {<ccf>  ------  --------------------  ------  ----  ----  -----------  -----------------------<088>};
    #foreach {$maint_order[%*]} {_mk} {
        #var _md $maint_spells[$_mk][defs];
        #var _mp $maint_spells[$_mk][prot];
        #if {"$maint_sel[$_mk]" == "1"} {#var _mpick {<afa>on    }} {#var _mpick {<888>off   }};
        #if {"$defs[$_md]" == "1"} {#var _mkept {<afa>yes }} {#var _mkept {<888>no  }};
        #if {"$_mblock[$_mk]" == "1"} {#var _mkept {<faa>stop}};
        #if {"$my[prots][$_mp]" == "1"} {
            #var _mup {<afa>yes }
        } {
            #if {"$defs[$_md]" == "1"} {#var _mup {<faa>no  }} {#var _mup {<888>no  }};
        };
        _mcont_where $_mk;
        #format _mcw {%-11s} {$_mcw};
        #if {"$_mcw" == "-          " && "$maint_sel[$_mk]" == "1"} {#var _mcw {<faa>$_mcw}} {#var _mcw {<ccc>$_mcw}};
        #format _mrow {%-6s  %-20s} {$_mk} {$maint_spells[$_mk][name]};
        #format _mvars {defs[%s] my[prots][%s]} {$_md} {$_mp};
        #echo {  <ffa>$_mrow  $_mpick  $_mkept  $_mup  $_mcw  <888>$_mvars<088>};
    };
    #echo {<ccf>  ------------------------------------------------------<088>};
    #if {$maint_active} {
        #echo {  <fff>Maint is <afa>ON<fff>. A red <faa>no<fff> under Up gets recast on the next heartbeat.<088>};
        #echo {  <fff>A red <faa>stop<fff> means the MUD kept refusing it. Pick it again or type <ffa>maint<fff> to retry.<088>};
    } {
        #echo {  <fff>Maint is <faa>OFF<fff>. Type <ffa>maint<fff> to keep the picked spells up.<088>};
    };
    #echo {  <fff>A red <faa>-<fff> under Contingency: picked but none set, <ffa>maint setup<fff> adds it.<088>};
    #echo {  <fff>hpbar prots right now: <ccc>$hpbar_prots<088>};
    #echo {};
};

#NOP --- MAINT SETUP: contingencies for your picks, then maint on. Lines in gcLine / cLine read;
#NOP -- <spell> should your <trigger> ever ... A line whose spell is one of maint's belongs to maint: kept if;
#NOP -- that spell is picked and on its own trigger, else removed. Anything else (an hp/sp potion) is left alone.;

#NOP -- Sets _mck to the maint key whose spell list line %0 casts (empty if not one of maint's), _mct to its trigger;
#alias {_mcont_key} {
    #var _mck {};
    #var _mcact {};
    #var _mct {};
    #regex {%0} {^{.+?} should your {.+?} ever} {#var _mcact {&1};#var _mct {&2}};
    #foreach {$maint_order[%*]} {_mq} {
        #if {"$_mck" == "" && "$maint_spells[$_mq][cspell]" == "$_mcact"} {#var _mck $_mq};
    };
};

#NOP -- Sets _mcw to greater / normal / - for spell %1 from the last contingency lists, none if it has no trigger;
#alias {_mcont_where} {
    #var _mcw {-};
    #if {"$maint_spells[%1][ctrig]" == ""} {#var _mcw {none}};
    #if {&cLine[] > 0} {#loop 1 &cLine[] _mwi {_mcont_key $cLine[$_mwi];#if {"$_mck" == "%1"} {#var _mcw {normal}}}};
    #if {&gcLine[] > 0} {#loop 1 &gcLine[] _mwi {_mcont_key $gcLine[$_mwi];#if {"$_mck" == "%1"} {#var _mcw {greater}}}};
};

#NOP -- %1 gc or c, %2 the list. Marks maint's lines to keep (_ms_have[key] = kind) or to remove (_ms_rm<kind>);
#alias {_maint_setup_scan} {
    #if {&%2[] > 0} {
        #loop 1 &%2[] _msi {
            _mcont_key $%2[$_msi];
            #if {"$_mck" != ""} {
                #var _msok 0;
                #if {"$maint_sel[$_mck]" == "1" && !&_ms_have[$_mck]} {
                    #regex {$_mct} {^{$maint_spells[$_mck][cshow]}$} {#var _msok 1};
                };
                #if {$_msok} {#var _ms_have[$_mck] %1} {#list _ms_rm%1 add {$_msi}};
            };
        };
    };
};

#alias {maint_setup} {
    #var _mcount 0;
    #foreach {$maint_order[%*]} {_mk} {#if {"$maint_sel[$_mk]" == "1"} {#math _mcount {$_mcount + 1}}};
    #if {$_mcount == 0} {
        #echo {<faa>  Nothing picked yet. Pick spells first, e.g. <ffa>maint default<faa>, see <ffa>maint-help<faa>.<088>};
    } {
        _maint_tidy;
        #echo {<dea>  Checking your contingencies...<088>};
        _cont_fetch _maint_setup_plan;
    };
};

#alias {_maint_setup_plan} {
    #if {!$cKnown} {
        #echo {<faa>  Your contingency lists did not come back, so nothing was changed. Try again.<088>};
    } {
        #NOP -- No greater contingency list = no greater contingency spell yet, normal ones only;
        #if {!$gcKnown} {#var gcMax 0};
        #var _ms_have {};
        #list _ms_rmgc create {};
        #list _ms_rmc create {};
        _maint_setup_scan gc gcLine;
        _maint_setup_scan c cLine;
        #math _ms_gcfree {$gcMax - &gcLine[] + &_ms_rmgc[]};
        #math _ms_cfree {$cMax - &cLine[] + &_ms_rmc[]};
        #echo {};
        #echo {<ccf>  =================  MAINT SETUP  =================<088>};
        #NOP -- Remove from the highest slot down, so the slot numbers left do not move;
        #if {&_ms_rmgc[] > 0} {
            #loop &_ms_rmgc[] 1 _msi {
                _mcont_key $gcLine[$_ms_rmgc[$_msi]];
                cast remove greater contingency as $_ms_rmgc[$_msi];
                #format _msrow {%-9s%-22s%s} {remove} {$maint_spells[$_mck][name]} {greater #$_ms_rmgc[$_msi]};
                #echo {  <faa>$_msrow<088>};
            };
        };
        #if {&_ms_rmc[] > 0} {
            #loop &_ms_rmc[] 1 _msi {
                _mcont_key $cLine[$_ms_rmc[$_msi]];
                cast remove contingency as $_ms_rmc[$_msi];
                #format _msrow {%-9s%-22s%s} {remove} {$maint_spells[$_mck][name]} {normal #$_ms_rmc[$_msi]};
                #echo {  <faa>$_msrow<088>};
            };
        };
        #list _ms_queue create {};
        #foreach {$maint_order[%*]} {_mk} {
            #if {"$maint_sel[$_mk]" == "1"} {
                #if {"$maint_spells[$_mk][ctrig]" == ""} {
                    #format _msrow {%-9s%-22s%s} {none} {$maint_spells[$_mk][name]} {no contingency for it, maint keeps it up};
                    #echo {  <888>$_msrow<088>};
                };
                #elseif {&_ms_have[$_mk]} {
                    #if {"$_ms_have[$_mk]" == "gc"} {#var _mskind {greater}} {#var _mskind {normal}};
                    #format _msrow {%-9s%-22s%s} {keep} {$maint_spells[$_mk][name]} {$_mskind};
                    #echo {  <afa>$_msrow<088>};
                };
                #elseif {$_ms_gcfree > 0} {
                    #math _ms_gcfree {$_ms_gcfree - 1};
                    #list _ms_queue add {gc:$_mk};
                    #format _msrow {%-9s%-22s%s} {add} {$maint_spells[$_mk][name]} {greater};
                    #echo {  <ffa>$_msrow<088>};
                };
                #elseif {$_ms_cfree > 0} {
                    #math _ms_cfree {$_ms_cfree - 1};
                    #list _ms_queue add {c:$_mk};
                    #format _msrow {%-9s%-22s%s} {add} {$maint_spells[$_mk][name]} {normal};
                    #echo {  <ffa>$_msrow<088>};
                };
                #else {
                    #format _msrow {%-9s%-22s%s} {no room} {$maint_spells[$_mk][name]} {all contingency slots in use, maint keeps it up};
                    #echo {  <faa>$_msrow<088>};
                };
            };
        };
        #echo {<ccf>  -------------------------------------------------<088>};
        #if {&_ms_queue[] > 0} {
            #echo {  <ccc>Adding &_ms_queue[], one at a time, waiting for SP when needed.<088>};
        } {
            #echo {  <ccc>Nothing to add.<088>};
        };
        #var _ms_set 0;
        #var _ms_failed {};
        #var _ms_tries 0;
        #if {!$maint_active} {_maint_on} {_maint_apply};
        _maint_setup_next;
    };
};

#NOP -- One contingency at a time: greater needs 2300 SP (2230 each), normal 200, or immersion running.;
#NOP -- 3s after sending, _maint_setup_check looks for the set up as follows line, no line = try again, 5 tries.;
#action {^Your {greater contingency|contingency} is now set up as follows:} {#var _ms_ok 1} {6};
#alias {_maint_setup_next} {
    #if {&_ms_queue[] == 0} {
        #echo {<dea>  maint setup done. Contingencies added: $_ms_set.<088>};
        #if {"$_ms_failed" != ""} {#echo {<faa>  Could not set:$_ms_failed. Try <ffa>maint setup<faa> again later.<088>}};
    } {
        #regex {$_ms_queue[1]} {^{gc|c}:{.+}$} {#var _msk &1;#var _msq &2};
        #if {"$_msk" == "gc"} {#var _msneed 2300} {#var _msneed 200};
        #if {$my[sp][current] > $_msneed || $my[immersion][active]} {
            #var _mstrig $maint_spells[$_msq][ctrig];
            #var _mscv $maint_spells[$_msq][cval];
            #if {"$_mscv" != ""} {#var _msmid {$_mstrig#$mage[contingencies][$_mscv]}} {#var _msmid {$_mstrig}};
            #var _ms_ok 0;
            #if {"$_msk" == "gc"} {
                cast greater contingency as $_msmid#cast $maint_spells[$_msq][cspell];
            } {
                cast contingency as $_msmid#cast $maint_spells[$_msq][cspell];
            };
            #delay {maint_setup} {_maint_setup_check} {3};
        } {
            #delay {maint_setup} {_maint_setup_next} {4};
        };
    };
};

#alias {_maint_setup_check} {
    #if {$_ms_ok} {
        #list _ms_queue delete 1;
        #math _ms_set {$_ms_set + 1};
        #var _ms_tries 0;
        #if {"$_msk" == "gc"} {#var _mskind {greater}} {#var _mskind {normal}};
        #echo {<afa>  Set $_mskind contingency for $maint_spells[$_msq][name] (&_ms_queue[] left).<088>};
    } {
        #math _ms_tries {$_ms_tries + 1};
        #if {$_ms_tries >= 5} {
            #list _ms_queue delete 1;
            #var _ms_tries 0;
            #var _ms_failed {$_ms_failed $maint_spells[$_msq][name]};
        };
    };
    _maint_setup_next;
};

#alias {_maint_all} {
    _maint_tidy;
    #NOP -- One spell per group: keep the one already picked, else the first in maint_order (the;
    #NOP -- stronger one). Evil/good is your choice. Aura and blink clash with something not yet known.;
    #foreach {$maint_order[%*]} {_mk} {
        #var _mtaken 0;
        #foreach {$maint_order[%*]} {_mg} {
            #if {"$maint_spells[$_mg][group]" == "$maint_spells[$_mk][group]" && "$maint_sel[$_mg]" == "1"} {#var _mtaken 1};
        };
        #if {!$_mtaken && "$_mk" != "pfe" && "$_mk" != "pfg" && "$_mk" != "pa" && "$_mk" != "blink"} {_maint_set $_mk 1};
    };
    _maint_changed;
    #echo {  <ccc>One per group: major or minor globe, stoneskin or rhino skin, mag shield or shield.<088>};
    #echo {  <ccc>Not added: evil/good (pick <ffa>maint pfe<ccc> or <ffa>maint pfg<ccc>), aura and blink (they<088>};
    #echo {  <ccc>conflict with other defenses, pick them yourself with <ffa>maint pa<ccc> / <ffa>maint blink<ccc>).<088>};
};

#alias {maint-help} {
    #echo {};
    #echo {<ccf>  ==================  MAGE MAINT HELP  ==================<088>};
    #echo {  <ffa>maint setup           <fff>set contingencies for your picks, then maint on<088>};
    #echo {  <ffa>maint                 <fff>start keeping your picked spells up<088>};
    #echo {  <ffa>maint off             <fff>stop recasting (your picks are kept)<088>};
    #echo {  <ffa>maint <spell> ...     <fff>pick or unpick (toggles), e.g. <ffa>maint ps mb<088>};
    #echo {  <ffa>maint add <spell> ... <fff>pick<088>};
    #echo {  <ffa>maint del <spell> ... <fff>unpick<088>};
    #echo {  <ffa>maint all             <fff>pick one of each (not evil/good, aura or blink)<088>};
    #echo {  <ffa>maint default         <fff>pick the usual set (replaces your picks)<088>};
    #echo {  <ffa>                      <888>Mindblank, Prismatic Sphere, Mantle, Major Globe,<088>};
    #echo {  <ffa>                      <888>Mag Shield, Armor, Stoneskin, Prot Good<088>};
    #echo {  <ffa>maint clear           <fff>unpick everything and stop<088>};
    #echo {  <ffa>maint list            <fff>every spell: picked, kept up, up now, contingency<088>};
    #echo {<ccf>  -------------------------------------------------------<088>};
    #echo {  <fff>Spells:<088>};
    #echo {    <ffa>mb     <ccc>Mindblank             <ffa>ps     <ccc>Prismatic Sphere<088>};
    #echo {    <ffa>pa     <ccc>Prismatic Aura        <ffa>mantle <ccc>Mantle<088>};
    #echo {    <ffa>major  <ccc>Major Globe           <ffa>minor  <ccc>Minor Globe<088>};
    #echo {    <ffa>ms     <ccc>Magnificent Shield    <ffa>shield <ccc>Shield<088>};
    #echo {    <ffa>armor  <ccc>Armor                 <ffa>ss     <ccc>Stoneskin<088>};
    #echo {    <ffa>rs     <ccc>Rhino Skin            <ffa>blink  <ccc>Blink<088>};
    #echo {    <ffa>pfe    <ccc>Protection from Evil  <ffa>pfg    <ccc>Protection from Good<088>};
    #echo {    <888>Only one of each can be up, picking one drops the other:<088>};
    #echo {    <888>major/minor globe, stoneskin/rhino skin, mag shield/shield, evil/good.<088>};
    #echo {<ccf>  -------------------------------------------------------<088>};
    #echo {  <fff>Fresh login, step by step<088>};
    #echo {  <ccc> <ffa>1.<ccc> Pick your spells once: <ffa>maint default<ccc>, or e.g. <ffa>maint ps mb mantle<ccc>.<088>};
    #echo {  <ccc>    Picks save with <ffa>ld<ccc> (and the 10 minute autosave).<088>};
    #echo {  <ccc> <ffa>2.<ccc> Type <ffa>maint setup<ccc>. That is all:<088>};
    #echo {  <ccc>    - it checks the contingencies you already have and keeps them<088>};
    #echo {  <ccc>    - removes ones maint set for spells you no longer pick<088>};
    #echo {  <ccc>    - adds the missing ones, greater first, then normal when the<088>};
    #echo {  <ccc>      greater slots are full (or you do not have greater yet)<088>};
    #echo {  <ccc>    - one at a time, waiting for SP or immersion (2230 SP each)<088>};
    #echo {  <ccc>    - then turns maint on, which casts any spell that is down<088>};
    #echo {  <ccc> After a linkdead maint comes back on by itself. After a relog,<088>};
    #echo {  <ccc> if your contingencies are still on you, just type <ffa>maint<ccc>.<088>};
    #echo {};
    #echo {  <fff>Why contingencies and maint?<088>};
    #echo {  <ccc> A contingency recasts its spell the moment it fails or runs out,<088>};
    #echo {  <ccc> even mid-fight. maint is the backup: every heartbeat it casts one<088>};
    #echo {  <ccc> picked spell that is still missing (no contingency for it, the<088>};
    #echo {  <ccc> contingency did not fire, or you just logged in).<088>};
    #echo {  <ccc> Mindblank has no contingency trigger, maint alone keeps it up.<088>};
    #echo {  <ccc> Contingencies that are not for maint's spells (an hp or sp potion)<088>};
    #echo {  <ccc> are never touched.<088>};
    #echo {};
    #echo {  <fff>Switching evil and good<088>};
    #echo {  <ccc> Use <ffa>gc_pfe<ccc> / <ffa>gc_pfg<ccc> (or <ffa>prots_pfe<ccc> / <ffa>prots_pfg<ccc>, <ffa>c_pfe<ccc> / <ffa>c_pfg<ccc>).<088>};
    #echo {  <ccc> They check both your contingency lists first, whatever slot or<088>};
    #echo {  <ccc> kind (greater or normal) the old side is in, and remove it. Then<088>};
    #echo {  <ccc> they move your maint pick and heartbeat flag over, deplete the<088>};
    #echo {  <ccc> old spell and set up the new side. Takes about 2 seconds.<088>};
    #echo {  <ccc> (<ffa>maint pfe<ccc> / <ffa>maint pfg<ccc> only change the pick, nothing is cast.)<088>};
    #echo {};
    #echo {  <ccc>Needs the mage hpbar (<ffa>setup_3kdb_hpbar<ccc>) so it can see which<088>};
    #echo {  <ccc>prots are up. Nothing is recast while you are idle (deadman).<088>};
    #echo {<ccf>  =======================================================<088>};
    #echo {};
};

#class {guild_maintenance} {close}
#read common/maint.tin
