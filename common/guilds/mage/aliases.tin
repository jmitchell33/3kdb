#class {guild_aliases} {kill}
#class {guild_aliases} {open}

#NOP --- Default GC Settings;
#var mage[contingencies][mantle] 200;
#var mage[contingencies][sphere] 799;

#NOP -- Contingency tracking. cast greater contingency / cast contingency with nothing after print the lists:;
#NOP -- a header, N:You will cast <spell> should your <trigger> ..., then You may cast N ... contingencies.;
#NOP -- gcLine / cLine keep each line in slot order so the evil/good swap can find and remove the old side.;
#NOP -- While _cgag is 1 (only during a swap) these actions also gag the list lines.;
#ACTION {^You have greater contingencies set up on you as follows:} {
     #if {$_cgag} {#line gag};
     #var gcList {};
     #list gcLine create {};
     #var gcKnown 1;
     #var _clist {gc};
} {2}

#NOP -- The MUD really says "You have a contingencies set up on you as follows:";
#ACTION {^You have a contingencies set up on you as follows:} {
     #if {$_cgag} {#line gag};
     #list cLine create {};
     #var cKnown 1;
     #var _clist {c};
} {2}

#ACTION {^You have no greater contingencies set up} {#var gcList {};#if {$_cgag} {#line gag};#list gcLine create {};#var gcKnown 1;#var _clist {}} {2}
#ACTION {^You have no contingencies set up} {#if {$_cgag} {#line gag};#list cLine create {};#var cKnown 1;#var _clist {}} {2}
#NOP -- The closing line also marks the list as seen, in case a header reads differently from the ones above;
#NOP -- It also says how many you can have: You may cast 8 greater ... / You may cast up to 6 contingencies.;
#ACTION {^You may cast %* contingencies} {
     #if {$_cgag} {#line gag};
     #var _cmaxn 0;
     #regex {%1} {{[0-9]+}} {#var _cmaxn &1};
     #regex {%1} {greater} {#var gcKnown 1;#var gcMax $_cmaxn} {#var cKnown 1;#var cMax $_cmaxn};
     #var _clist {};
} {2}

#ACTION {^%d:You will cast %*} {
     #if {$_cgag} {#line gag};
     #if {"$_clist" == "gc"} {
         #list gcLine add {%2};
         #regex {%2} {^{.*?} should your} {#list gcList add {&1}};
     };
     #elseif {"$_clist" == "c"} {
         #list cLine add {%2};
     };
} {2};

#if {&{_cgag} == 0} {#var _cgag 0};
#if {&{gcLine} == 0} {#list gcLine create {}};
#if {&{cLine} == 0} {#list cLine create {}};
#if {&{gcKnown} == 0} {#var gcKnown 0};
#if {&{cKnown} == 0} {#var cKnown 0};
#if {&{gcMax} == 0} {#var gcMax 0};
#if {&{cMax} == 0} {#var cMax 0};
#var _clist {};


#NOP --- Mage Summon Aliases;
#var mscMinSps 1500;
#var mscMinConc 50;
#alias {msc%+1..2d %+1..2d %+1..w %+1..w} {
    #format mscSummonSpell {%d} {%1};
    #format mscSummonNumber {%d} {%2};
    #format mscSummonStrategy {%l} {%3};
    #format mscSummonGroup {%l} {%4};
    #format mscSummonType {%l} {%5};
    #var mscString monster summoning ${mscSummonSpell}#${mscSummonType}#${mscSummonNumber}#${mscMinSps}#${mscMinConc}#${mscSummonStrategy}#${mscSummonGroup};
    cast summon config as $mscString;
    cast summon config activate;
};

#alias {str_party} {
    members;
    #delay 2 {
        #if {&party[member][] > 0} {
            #foreach $party[member][%*] member {
                cast giant strength on $member[name-lower];
                cast strength on $member[name-lower]
            };
        };
    };
};

#NOP --- MAGE DEFENSE ALIASES;
#alias {clear_align} {#var defs[pe] 0;#var defs[pg] 0};
#alias {clear_prots} {#unvar defs};

#alias {check_extension} {
    #if {$my[sp][current] > 500} {
        cast extension 3;
    }
};

#alias gc_ss {cast greater contingency as stoneskin#cast stoneskin};
#alias gc_mg {cast greater contingency as major globe#cast major globe};
#alias gc_shield {cast greater contingency as shield#cast magnificent shield};
#alias gc_armor {cast greater contingency as armor#cast armor};
#NOP -- Ask the MUD for both contingency lists and run alias %1 two seconds later, once they are in. The lists;
#NOP -- are gagged meanwhile: one action fires per line, so the list lines gag themselves (_cgag), and the;
#NOP -- align_gag class catches the wrapped tails, e.g. fail. or below 799. Both are gone before %1 runs.;
#alias {_cont_fetch} {
    #var gcKnown 0;
    #var cKnown 0;
    #var _cgag 1;
    #class {align_gag} {open};
    #action {^%*{fail|below [0-9]+}.$} {#if {"$_clist" != ""} {#line gag}} {9};
    #class {align_gag} {close};
    #var _cont_next {%1};
    cast greater contingency;
    cast contingency;
    #delay {cont_fetch} {_cont_fetched} {2};
};

#alias {_cont_fetched} {
    #var _cgag 0;
    #class {align_gag} {kill};
    $_cont_next;
};

#NOP -- Swap protection from evil and good. %1 = the side you want (good or evil), %2 = gc, c or prots;
#NOP -- (what to set up after). It asks the MUD for both contingency lists, then 2 seconds later removes the;
#NOP -- old side from whichever list has it. That has to happen before the deplete, or the deplete just fires;
#NOP -- that contingency and it casts the old side again. The heartbeat flag and maint pick move over too.;
#alias {_align_swap} {
    #var _anew {%1};
    #var _akind {%2};
    #if {"%1" == "good"} {
        #var _aold {evil};
        #var _aold_def {pe};
        #var _anew_def {pg};
        #var _aold_pick {pfe};
        #var _anew_pick {pfg};
    } {
        #var _aold {good};
        #var _aold_def {pg};
        #var _anew_def {pe};
        #var _aold_pick {pfg};
        #var _anew_pick {pfe};
    };
    #echo {<dea>  Checking your contingencies before switching to protection from $_anew...<088>};
    _cont_fetch _align_swap_now;
};

#NOP -- Sets _afound to the slot in list %1 that casts or watches protection from $_aold, 0 if none;
#alias {_align_find} {
    #var _afound 0;
    #if {&%1[] > 0} {
        #loop 1 &%1[] _ai {
            #if {$_afound == 0} {
                #regex {$%1[$_ai]} {{protection from $_aold|prot_$_aold}} {#var _afound $_ai};
            };
        };
    };
};

#alias {_align_swap_now} {
    #if {!$gcKnown || !$cKnown} {
        #echo {<faa>  Your contingency lists did not come back, so nothing was changed. Try again.<088>};
    } {
        _align_find gcLine;
        #var _aremoved_gc $_afound;
        _align_find cLine;
        #var _aremoved_c $_afound;
        #if {$_aremoved_gc} {
            cast remove greater contingency as $_aremoved_gc;
            #list gcLine delete $_aremoved_gc;
            #echo {<dea>  Removed greater contingency $_aremoved_gc (protection from $_aold).<088>};
        };
        #if {$_aremoved_c} {
            cast remove contingency as $_aremoved_c;
            #list cLine delete $_aremoved_c;
            #echo {<dea>  Removed contingency $_aremoved_c (protection from $_aold).<088>};
        };
        #if {"$defs[$_aold_def]" == "1"} {#var defs[$_anew_def] 1};
        #var defs[$_aold_def] 0;
        #if {"$maint_sel[$_aold_pick]" == "1"} {
            _maint_set $_anew_pick 1;
            _maint_save;
        };
        deplete protection from $_aold;
        #switch {"$_akind"} {
            #case {"gc"} {
                cast greater contingency as prot_$_anew#cast protection from $_anew;
                cast protection from $_anew;
            };
            #case {"c"} {
                cast contingency as prot_$_anew#cast protection from $_anew;
                cast protection from $_anew;
            };
            #case {"prots"} {
                #NOP -- Put back the same kind of cover that was removed, on the new side;
                #if {$_aremoved_gc} {cast greater contingency as prot_$_anew#cast protection from $_anew};
                #if {$_aremoved_c} {cast contingency as prot_$_anew#cast protection from $_anew};
                check_extension;
                cast protection from $_anew;
                clear_align;
                #var defs[$_anew_def] 1;
                echo_prots_$_anew_pick;
            };
        };
    };
};

#alias gc_pfg {_align_swap good gc};
#alias gc_pfe {_align_swap evil gc};
#alias gc_mantle {cast greater contingency as mantle#$mage[contingencies][mantle]#cast mantle};
#alias gc_ps {cast greater contingency as prismatic sphere#$mage[contingencies][sphere]#cast prismatic sphere};

#alias c_rs {cast contingency as stoneskin#cast rhino skin};
#alias c_mg {cast contingency as minor globe#cast minor globe};
#alias c_shield {cast contingency as shield#cast shield};
#alias c_mshield {cast contingency as shield#cast magnificent shield}
#alias c_armor {cast contingency as armor#cast armor};
#alias c_pfg {_align_swap good c};
#alias c_pfe {_align_swap evil c};
#alias c_blur {cast contingency as blinking#cast blur};
#alias c_blink {cast contingency as blinking#cast blink}; 
#alias c_invis {cast contingency as invisibility#cast invisibility};

#NOP -- clear defenses;
#alias {clear_def} {
    #10 {cast remove contingency as 1};
    #10 {cast remove greater contingency as 1};
    clear_prots;
    clear_align;
    #var maint_active 0;
    #unticker {maint_watch};
    _maint_save
};

#alias {prots_mb} {check_extension;cast mindblank;#var defs[MB] 1;echo_prots_mb};
#alias {prots_pa} {check_extension;cast prismatic aura;#var defs[PA] 1;echo_prots_pa};
#alias {prots_ps} {check_extension;cast prismatic sphere;#var defs[PS] 1;echo_prots_ps};
#alias {prots_MG} {check_extension;cast major globe;#var defs[MG] 1;echo_prots_MG};
#alias {prots_mg} {check_extension;cast minor globe;#var defs[mg] 1;echo_prots_mg};
#alias {prots_ms} {check_extension;cast magnificent shield;#var defs[ms] 1;echo_prots_ms};
#alias {prots_pfe} {_align_swap evil prots};
#alias {prots_pfg} {_align_swap good prots};
#alias {prots_rs} {check_extension;cast rhino skin;clear_align;#var defs[rs] 1;echo_prots_rs};
#alias {prots_ss} {check_extension;cast stoneskin;#var defs[SS] 1;echo_prots_ss};
#alias {prots_shield} {check_extension;cast shield;#var defs[shield] 1;echo_prots_shield};
#alias {prots_armor} {check_extension;cast armor;#var defs[A] 1;echo_prots_armor};
#alias {prots_blink} {check_extension;cast blink;#var defs[blink] 1;echo_prots_blink};

#NOP ---THIS SECTION IS FOR FORMATTING FOR SPELL/ETC MAINTENANCE
#alias {echo_divider1} {#echo {========================================================}};
#alias {echo_clear_prots} {#echo {--------------- CLEARING DEFENSE VARIABLES --------------}};
#alias {echo_divider2} {#echo {+++++++++++++++++++++++++++++++++++++++++++++++++++++++++}};
#alias {echo_prots_header} {#echo {+++++++++++++++  ACTIVE DEFENSES INCLUDE:  ++++++++++++++}};
#alias {echo_prots_mb} {#echo {+++++++++++++++  MIND BLANK               ++++++++++++++}};
#alias {echo_prots_pa} {#echo {+++++++++++++++  PRISMATIC AURA           ++++++++++++++}};
#alias {echo_prots_ps} {#echo {+++++++++++++++  PRISMATIC SPHERE         ++++++++++++++}};
#alias {echo_prots_MG} {#echo {+++++++++++++++  MAJOR GLOBE              ++++++++++++++}};
#alias {echo_prots_mg} {#echo {+++++++++++++++  MINOR GLOBE              ++++++++++++++}};
#alias {echo_prots_ms} {#echo {+++++++++++++++  MAGNIFICENT SHIELD       ++++++++++++++}};
#alias {echo_prots_rs} {#echo {+++++++++++++++  RHINO SKIN                ++++++++++++++}};
#alias {echo_prots_ss} {#echo {+++++++++++++++  STONE SKIN                ++++++++++++++}};
#alias {echo_prots_pfe} {#echo {+++++++++++++++  PROTECTION FROM EVIL      ++++++++++++++}};
#alias {echo_prots_pfg} {#echo {+++++++++++++++  PROTECTION FROM GOOD      ++++++++++++++}};
#alias {echo_prots_blink} {#echo {+++++++++++++++  BLINK                     ++++++++++++++}};
#alias {echo_prots_armor} {#echo {+++++++++++++++  ARMOR                      ++++++++++++++}};
#alias {echo_prots_shield} {#echo {+++++++++++++++  SHIELD                      ++++++++++++++}};

#NOP --- MAINT: pick which defenses the guild heartbeat keeps up. Type maint-help;
#NOP -- heartbeat.tin recasts a spell while defs[<defs>] is 1 and my[prots][<prot>] (hpbar) is 0.;
#NOP -- maint only sets those defs flags from your picks. Picks are copied to xmaint_sel in class;
#NOP -- global, which _variable_export writes to chars/<you>/vars.tin, so ld and the autosave keep them.;
#NOP -- Contingency fields, for maint setup: cspell = the spell it casts, ctrig = its trigger (empty = none,;
#NOP -- mindblank has no trigger), cval = mage[contingencies] key for the HP value (mantle/sphere), cshow =;
#NOP -- how the trigger reads in the contingency lists (regex alternatives).;
#var maint_spells[mb]     {{name} {Mindblank}            {defs} {MB}     {prot} {MB} {group} {mb} {cspell} {mindblank} {ctrig} {} {cval} {} {cshow} {}};
#var maint_spells[ps]     {{name} {Prismatic Sphere}     {defs} {PS}     {prot} {PS} {group} {ps} {cspell} {prismatic sphere} {ctrig} {prismatic sphere} {cval} {sphere} {cshow} {prismatic sphere}};
#var maint_spells[pa]     {{name} {Prismatic Aura}       {defs} {PA}     {prot} {PA} {group} {pa} {cspell} {prismatic aura} {ctrig} {prismatic aura} {cval} {} {cshow} {prismatic aura|prismatic_aura}};
#var maint_spells[mantle] {{name} {Mantle}               {defs} {M}      {prot} {M} {group} {mantle} {cspell} {mantle} {ctrig} {mantle} {cval} {mantle} {cshow} {mantle}};
#var maint_spells[major]  {{name} {Major Globe}          {defs} {MG}     {prot} {MG} {group} {globe} {cspell} {major globe} {ctrig} {major globe} {cval} {} {cshow} {major globe|major_globe}};
#var maint_spells[minor]  {{name} {Minor Globe}          {defs} {mg}     {prot} {mg} {group} {globe} {cspell} {minor globe} {ctrig} {minor globe} {cval} {} {cshow} {minor globe|minor_globe}};
#var maint_spells[ms]     {{name} {Magnificent Shield}   {defs} {ms}     {prot} {MS} {group} {shield} {cspell} {magnificent shield} {ctrig} {shield} {cval} {} {cshow} {shield}};
#var maint_spells[shield] {{name} {Shield}               {defs} {shield} {prot} {S} {group} {shield} {cspell} {shield} {ctrig} {shield} {cval} {} {cshow} {shield}};
#var maint_spells[armor]  {{name} {Armor}                {defs} {A}      {prot} {A} {group} {armor} {cspell} {armor} {ctrig} {armor} {cval} {} {cshow} {armor}};
#var maint_spells[ss]     {{name} {Stoneskin}            {defs} {SS}     {prot} {SS} {group} {skin} {cspell} {stoneskin} {ctrig} {stoneskin} {cval} {} {cshow} {stoneskin}};
#var maint_spells[rs]     {{name} {Rhino Skin}           {defs} {rs}     {prot} {RS} {group} {skin} {cspell} {rhino skin} {ctrig} {stoneskin} {cval} {} {cshow} {stoneskin}};
#var maint_spells[blink]  {{name} {Blink}                {defs} {blink}  {prot} {B} {group} {blink} {cspell} {blink} {ctrig} {blinking} {cval} {} {cshow} {blinking|blink|blur}};
#var maint_spells[pfe]    {{name} {Protection from Evil} {defs} {pe}     {prot} {PE} {group} {align} {cspell} {protection from evil} {ctrig} {prot_evil} {cval} {} {cshow} {protection from evil|prot_evil}};
#var maint_spells[pfg]    {{name} {Protection from Good} {defs} {pg}     {prot} {PG} {group} {align} {cspell} {protection from good} {ctrig} {prot_good} {cval} {} {cshow} {protection from good|prot_good}};
#list maint_order create {mb;ps;pa;mantle;major;minor;ms;shield;armor;ss;rs;blink;pfe;pfg};
#NOP -- What maint default picks;
#list maint_default create {mb;ps;mantle;major;ms;armor;ss;pfg};

#NOP -- Words you can type for each spell (lower case), mapped to its key above;
#var maint_words {
    {mb} {mb} {mindblank} {mb}
    {ps} {ps} {sphere} {ps}
    {pa} {pa} {aura} {pa}
    {mantle} {mantle} {m} {mantle}
    {major} {major} {majorglobe} {major}
    {minor} {minor} {minorglobe} {minor}
    {ms} {ms} {magnificent} {ms} {mshield} {ms}
    {shield} {shield} {s} {shield}
    {armor} {armor} {a} {armor}
    {ss} {ss} {stoneskin} {ss}
    {rs} {rs} {rhino} {rs} {rhinoskin} {rs}
    {blink} {blink} {b} {blink}
    {pfe} {pfe} {pe} {pfe} {evil} {pfe}
    {pfg} {pfg} {pg} {pfg} {good} {pfg}
};

#NOP -- Nothing saved yet: start with maint_default;
#if {&{xmaint_sel}} {#var maint_sel $xmaint_sel} {#var maint_sel {};#foreach {$maint_default[%*]} {_mk} {#var maint_sel[$_mk] 1}};
#var maint_active 0;

#alias {_maint_save} {
    #class global open;
    #var xmaint_sel $maint_sel;
    #var xmaint_active $maint_active;
    #class global close;
};

#NOP -- Maint was on when you last saved (ld / autosave), so after a linkdeath return turn it back on once;
#NOP -- the login has settled (postload ends at 12s) and the hpbar has said which spells are up. Not on a;
#NOP -- fresh login: spells are down and setup_defense casts them, maint would cast over it. maint off saves off.;
#alias {_maint_resume} {
    #if {!$maint_active} {
        #echo {<dea>  maint was on before you logged out, turning it back on.<088>};
        _maint_on;
    };
};
#if {"$xmaint_active" == "1" && "$login_linkdeath" == "1"} {#delay {maint_resume} {_maint_resume} {15}};

#NOP -- %1 key, %2 1 or 0. Spells in the same group conflict in game (one globe, one skin, one shield,;
#NOP -- evil or good), so picking one unpicks the rest of its group and stops recasting them.;
#alias {_maint_set} {
    #var maint_sel[%1] %2;
    #var _mblock[%1] 0;
    #if {%2} {
        #foreach {$maint_order[%*]} {_mg} {
            #if {"$_mg" != "%1" && "$maint_spells[$_mg][group]" == "$maint_spells[%1][group]"} {
                #var maint_sel[$_mg] 0;
                #if {$maint_active} {#var defs[$maint_spells[$_mg][defs]] 0};
            };
        };
    };
};

#NOP -- Keep one pick per group (the first in maint_order), e.g. old saved picks with both globes;
#alias {_maint_tidy} {
    #var _mseen {};
    #var _mtidied 0;
    #foreach {$maint_order[%*]} {_mk} {
        #if {"$maint_sel[$_mk]" == "1"} {
            #var _mgrp $maint_spells[$_mk][group];
            #if {&_mseen[$_mgrp]} {
                #var maint_sel[$_mk] 0;
                #var _mtidied 1;
            } {
                #var _mseen[$_mgrp] 1;
            };
        };
    };
    #if {$_mtidied} {_maint_save};
};

#NOP -- Push the picks into defs: picked spells 1, the rest 0;
#alias {_maint_apply} {
    #foreach {$maint_order[%*]} {_mk} {
        #if {"$maint_sel[$_mk]" == "1" && "$_mblock[$_mk]" != "1"} {
            #var defs[$maint_spells[$_mk][defs]] 1;
        } {
            #var defs[$maint_spells[$_mk][defs]] 0;
        };
    };
};

#NOP -- Picked spell names, two per line;
#alias {_maint_grid} {
    #var _mcount 0;
    #var _mrow {};
    #foreach {$maint_order[%*]} {_mk} {
        #if {"$maint_sel[$_mk]" == "1"} {
            #format _mcell {%-24s} {$maint_spells[$_mk][name]};
            #var _mrow {$_mrow$_mcell};
            #math _mcount {$_mcount + 1};
            #if {$_mcount % 2 == 0} {
                #echo {      <afa>$_mrow<088>};
                #var _mrow {};
            };
        };
    };
    #if {"$_mrow" != ""} {#echo {      <afa>$_mrow<088>}};
    #if {$_mcount == 0} {#echo {      <888>nothing picked<088>}};
};

#NOP -- %1 = 1 pick, 0 unpick, t toggle. %2 = spell words;
#alias {_maint_pick} {
    #var _mwords {%2};
    #replace _mwords { } {;};
    #var _mbad {};
    #foreach {$_mwords} {_mw} {
        #if {"$_mw" != ""} {
            #format _mw {%l} {$_mw};
            #if {&maint_words[$_mw]} {
                #var _mk $maint_words[$_mw];
                #if {"%1" == "t"} {
                    #if {"$maint_sel[$_mk]" == "1"} {_maint_set $_mk 0} {_maint_set $_mk 1};
                } {
                    _maint_set $_mk %1;
                };
            } {
                #var _mbad {$_mbad $_mw};
            };
        };
    };
    #if {"$_mbad" != ""} {
        #echo {<faa>  Unknown spell:<fff>$_mbad<faa>. Type <ffa>maint list<faa> for the names.<088>};
    };
    _maint_changed;
};

#alias {_maint_changed} {
    _maint_save;
    #if {$maint_active} {_maint_apply};
    #echo {<dea>---  MAINT PICKS  ---<088>};
    _maint_grid;
    #if {$maint_active} {
        #echo {  <ccc>Maint is on, the heartbeat keeps these up now.<088>};
    } {
        #echo {  <ccc>Type <ffa>maint<ccc> to start keeping these up.<088>};
    };
};

#alias {_maint_on} {
    _maint_tidy;
    #var _mcount 0;
    #foreach {$maint_order[%*]} {_mk} {
        #if {"$maint_sel[$_mk]" == "1"} {#math _mcount {$_mcount + 1}};
    };
    #if {$_mcount == 0} {
        #echo {<faa>  Nothing picked yet. Pick spells with <ffa>maint <spell><faa>, see <ffa>maint-help<faa>.<088>};
    } {
        #var _mblock {};
        #foreach {$maint_order[%*]} {_mk} {#var _mstuck[$_mk] 0};
        #var _mrefused 0;
        _maint_apply;
        #var maint_active 1;
        #echo {<dea>---  MAINTENANCE ON  ---<088>};
        #ticker {maint_watch} {_maint_watch} {2};
        _maint_save;
        _maint_grid;
    };
};

#alias {_maint_off} {
    #foreach {$maint_order[%*]} {_mk} {
        #var defs[$maint_spells[$_mk][defs]] 0;
    };
    #var maint_active 0;
    #unticker {maint_watch};
    _maint_save;
    #echo {<dea>---  MAINTENANCE OFF  ---<088>};
    #if {"%1" == "cleared"} {
        #echo {  <ccc>All picks cleared. Spells stay up until they drop, they are just not recast.<088>};
    } {
        #echo {  <ccc>Spells stay up until they drop, they are just not recast. Picks are kept.<088>};
    };
};

#NOP -- Safety net: while maint is on, maint_watch runs every 2s. A picked spell that stays down for 5 checks;
#NOP -- (about 10s) while the MUD keeps refusing casts (already have / conflicting) is blocked: maint stops;
#NOP -- recasting it and says so. Running out of SP is a different message, so that never blocks anything.;
#action {^You already have %*} {#var _mrefused 1} {8};
#action {^You are already protected by %*} {#var _mrefused 1} {8};
#action {^Another defensive spell is conflicting} {#var _mrefused 1} {8};
#NOP -- Out of SP is not a refusal: the spell it names (or the whole check, if no name matches) is not counted;
#action {^You do not have enough spell points to cast %*} {
    #NOP -- The name ends in . or ! so it matches when it starts with the spell name and is at most 1 longer;
    #format _mnosp_name {%l} {%1};
    #format _mnosp_len {%L} {$_mnosp_name};
    #var _mnosp_hit 0;
    #foreach {$maint_order[%*]} {_mk} {
        #format _mnosp_nm {%l} {$maint_spells[$_mk][name]};
        #format _mnosp_nl {%L} {$_mnosp_nm};
        #if {$_mnosp_len - $_mnosp_nl <= 1} {
            #regex {$_mnosp_name} {^$_mnosp_nm} {#var _mnosp[$_mk] 1;#var _mnosp_hit 1};
        };
    };
    #if {!$_mnosp_hit} {#var _mnosp_all 1};
} {8};
#var _mrefused 0;
#var _mnosp {};
#var _mnosp_all 0;
#var _mblock {};

#NOP -- Sets _mupnow to 1 when spell %1 shows as up;
#alias {_maint_isup} {
    #if {"$my[prots][$maint_spells[%1][prot]]" == "1"} {#var _mupnow 1} {#var _mupnow 0};
};

#alias {_maint_watch} {
    #if {!$maint_active} {
        #unticker {maint_watch};
    } {
        #foreach {$maint_order[%*]} {_mx} {
            _maint_isup $_mx;
            #if {"$maint_sel[$_mx]" == "1" && "$defs[$maint_spells[$_mx][defs]]" == "1" && !$_mupnow} {
                #if {$_mrefused && !$_mnosp_all && "$_mnosp[$_mx]" != "1"} {#math _mstuck[$_mx] {$_mstuck[$_mx] + 1}};
            } {
                #var _mstuck[$_mx] 0;
            };
            #if {$_mstuck[$_mx] >= 5} {
                #var _mstuck[$_mx] 0;
                #var _mblock[$_mx] 1;
                #var defs[$maint_spells[$_mx][defs]] 0;
                #echo {<faa>  maint: stopped recasting <fff>$maint_spells[$_mx][name]<faa>, the MUD keeps refusing it.<088>};
                #echo {<faa>  Another defense conflicts with it, or it is up but not on your hpbar. See <ffa>maint list<faa>.<088>};
            };
        };
        #var _mrefused 0;
        #var _mnosp {};
        #var _mnosp_all 0;
    };
};

#NOP -- Table of every spell: picked, kept up by the heartbeat (defs), and up on the hpbar (my[prots]);
#alias {_maint_list} {
    #echo {};
    #echo {<ccf>  ====================  MAGE MAINT  ====================<088>};
    #echo {<fff>  Type    Spell                 Picked  Kept  Up    Contingency  Variables<088>};
    #echo {<ccf>  ------  --------------------  ------  ----  ----  -----------  -----------------------<088>};
    #foreach {$maint_order[%*]} {_mk} {
        #var _md $maint_spells[$_mk][defs];
        #var _mp $maint_spells[$_mk][prot];
        #if {"$maint_sel[$_mk]" == "1"} {#var _mpick {<afa>on    }} {#var _mpick {<888>off   }};
        #if {"$defs[$_md]" == "1"} {#var _mkept {<afa>yes }} {#var _mkept {<888>no  }};
        #if {"$_mblock[$_mk]" == "1"} {#var _mkept {<faa>stop}};
        #if {"$my[prots][$_mp]" == "1"} {
            #var _mup {<afa>yes }
        } {
            #if {"$defs[$_md]" == "1"} {#var _mup {<faa>no  }} {#var _mup {<888>no  }};
        };
        _mcont_where $_mk;
        #format _mcw {%-11s} {$_mcw};
        #if {"$_mcw" == "-          " && "$maint_sel[$_mk]" == "1"} {#var _mcw {<faa>$_mcw}} {#var _mcw {<ccc>$_mcw}};
        #format _mrow {%-6s  %-20s} {$_mk} {$maint_spells[$_mk][name]};
        #format _mvars {defs[%s] my[prots][%s]} {$_md} {$_mp};
        #echo {  <ffa>$_mrow  $_mpick  $_mkept  $_mup  $_mcw  <888>$_mvars<088>};
    };
    #echo {<ccf>  ------------------------------------------------------<088>};
    #if {$maint_active} {
        #echo {  <fff>Maint is <afa>ON<fff>. A red <faa>no<fff> under Up gets recast on the next heartbeat.<088>};
        #echo {  <fff>A red <faa>stop<fff> means the MUD kept refusing it. Pick it again or type <ffa>maint<fff> to retry.<088>};
    } {
        #echo {  <fff>Maint is <faa>OFF<fff>. Type <ffa>maint<fff> to keep the picked spells up.<088>};
    };
    #echo {  <fff>A red <faa>-<fff> under Contingency: picked but none set, <ffa>maint setup<fff> adds it.<088>};
    #echo {  <fff>hpbar prots right now: <ccc>$hpbar_prots<088>};
    #echo {};
};

#NOP --- MAINT SETUP: contingencies for your picks, then maint on. Lines in gcLine / cLine read;
#NOP -- <spell> should your <trigger> ever ... A line whose spell is one of maint's belongs to maint: kept if;
#NOP -- that spell is picked and on its own trigger, else removed. Anything else (an hp/sp potion) is left alone.;

#NOP -- Sets _mck to the maint key whose spell list line %0 casts (empty if not one of maint's), _mct to its trigger;
#alias {_mcont_key} {
    #var _mck {};
    #var _mcact {};
    #var _mct {};
    #regex {%0} {^{.+?} should your {.+?} ever} {#var _mcact {&1};#var _mct {&2}};
    #foreach {$maint_order[%*]} {_mq} {
        #if {"$_mck" == "" && "$maint_spells[$_mq][cspell]" == "$_mcact"} {#var _mck $_mq};
    };
};

#NOP -- Sets _mcw to greater / normal / - for spell %1 from the last contingency lists, none if it has no trigger;
#alias {_mcont_where} {
    #var _mcw {-};
    #if {"$maint_spells[%1][ctrig]" == ""} {#var _mcw {none}};
    #if {&cLine[] > 0} {#loop 1 &cLine[] _mwi {_mcont_key $cLine[$_mwi];#if {"$_mck" == "%1"} {#var _mcw {normal}}}};
    #if {&gcLine[] > 0} {#loop 1 &gcLine[] _mwi {_mcont_key $gcLine[$_mwi];#if {"$_mck" == "%1"} {#var _mcw {greater}}}};
};

#NOP -- %1 gc or c, %2 the list. Marks maint's lines to keep (_ms_have[key] = kind) or to remove (_ms_rm<kind>);
#alias {_maint_setup_scan} {
    #if {&%2[] > 0} {
        #loop 1 &%2[] _msi {
            _mcont_key $%2[$_msi];
            #if {"$_mck" != ""} {
                #var _msok 0;
                #if {"$maint_sel[$_mck]" == "1" && !&_ms_have[$_mck]} {
                    #regex {$_mct} {^{$maint_spells[$_mck][cshow]}$} {#var _msok 1};
                };
                #if {$_msok} {#var _ms_have[$_mck] %1} {#list _ms_rm%1 add {$_msi}};
            };
        };
    };
};

#alias {maint_setup} {
    #var _mcount 0;
    #foreach {$maint_order[%*]} {_mk} {#if {"$maint_sel[$_mk]" == "1"} {#math _mcount {$_mcount + 1}}};
    #if {$_mcount == 0} {
        #echo {<faa>  Nothing picked yet. Pick spells first, e.g. <ffa>maint default<faa>, see <ffa>maint-help<faa>.<088>};
    } {
        _maint_tidy;
        #echo {<dea>  Checking your contingencies...<088>};
        _cont_fetch _maint_setup_plan;
    };
};

#alias {_maint_setup_plan} {
    #if {!$cKnown} {
        #echo {<faa>  Your contingency lists did not come back, so nothing was changed. Try again.<088>};
    } {
        #NOP -- No greater contingency list = no greater contingency spell yet, normal ones only;
        #if {!$gcKnown} {#var gcMax 0};
        #var _ms_have {};
        #list _ms_rmgc create {};
        #list _ms_rmc create {};
        _maint_setup_scan gc gcLine;
        _maint_setup_scan c cLine;
        #math _ms_gcfree {$gcMax - &gcLine[] + &_ms_rmgc[]};
        #math _ms_cfree {$cMax - &cLine[] + &_ms_rmc[]};
        #echo {};
        #echo {<ccf>  =================  MAINT SETUP  =================<088>};
        #NOP -- Remove from the highest slot down, so the slot numbers left do not move;
        #if {&_ms_rmgc[] > 0} {
            #loop &_ms_rmgc[] 1 _msi {
                _mcont_key $gcLine[$_ms_rmgc[$_msi]];
                cast remove greater contingency as $_ms_rmgc[$_msi];
                #format _msrow {%-9s%-22s%s} {remove} {$maint_spells[$_mck][name]} {greater #$_ms_rmgc[$_msi]};
                #echo {  <faa>$_msrow<088>};
            };
        };
        #if {&_ms_rmc[] > 0} {
            #loop &_ms_rmc[] 1 _msi {
                _mcont_key $cLine[$_ms_rmc[$_msi]];
                cast remove contingency as $_ms_rmc[$_msi];
                #format _msrow {%-9s%-22s%s} {remove} {$maint_spells[$_mck][name]} {normal #$_ms_rmc[$_msi]};
                #echo {  <faa>$_msrow<088>};
            };
        };
        #list _ms_queue create {};
        #foreach {$maint_order[%*]} {_mk} {
            #if {"$maint_sel[$_mk]" == "1"} {
                #if {"$maint_spells[$_mk][ctrig]" == ""} {
                    #format _msrow {%-9s%-22s%s} {none} {$maint_spells[$_mk][name]} {no contingency for it, maint keeps it up};
                    #echo {  <888>$_msrow<088>};
                };
                #elseif {&_ms_have[$_mk]} {
                    #if {"$_ms_have[$_mk]" == "gc"} {#var _mskind {greater}} {#var _mskind {normal}};
                    #format _msrow {%-9s%-22s%s} {keep} {$maint_spells[$_mk][name]} {$_mskind};
                    #echo {  <afa>$_msrow<088>};
                };
                #elseif {$_ms_gcfree > 0} {
                    #math _ms_gcfree {$_ms_gcfree - 1};
                    #list _ms_queue add {gc:$_mk};
                    #format _msrow {%-9s%-22s%s} {add} {$maint_spells[$_mk][name]} {greater};
                    #echo {  <ffa>$_msrow<088>};
                };
                #elseif {$_ms_cfree > 0} {
                    #math _ms_cfree {$_ms_cfree - 1};
                    #list _ms_queue add {c:$_mk};
                    #format _msrow {%-9s%-22s%s} {add} {$maint_spells[$_mk][name]} {normal};
                    #echo {  <ffa>$_msrow<088>};
                };
                #else {
                    #format _msrow {%-9s%-22s%s} {no room} {$maint_spells[$_mk][name]} {all contingency slots in use, maint keeps it up};
                    #echo {  <faa>$_msrow<088>};
                };
            };
        };
        #echo {<ccf>  -------------------------------------------------<088>};
        #if {&_ms_queue[] > 0} {
            #echo {  <ccc>Adding &_ms_queue[], one at a time, waiting for SP when needed.<088>};
        } {
            #echo {  <ccc>Nothing to add.<088>};
        };
        #var _ms_set 0;
        #var _ms_failed {};
        #var _ms_tries 0;
        #if {!$maint_active} {_maint_on} {_maint_apply};
        _maint_setup_next;
    };
};

#NOP -- One contingency at a time: greater needs 2300 SP (2230 each), normal 200, or immersion running.;
#NOP -- 3s after sending, _maint_setup_check looks for the set up as follows line, no line = try again, 5 tries.;
#action {^Your {greater contingency|contingency} is now set up as follows:} {#var _ms_ok 1} {6};
#alias {_maint_setup_next} {
    #if {&_ms_queue[] == 0} {
        #echo {<dea>  maint setup done. Contingencies added: $_ms_set.<088>};
        #if {"$_ms_failed" != ""} {#echo {<faa>  Could not set:$_ms_failed. Try <ffa>maint setup<faa> again later.<088>}};
    } {
        #regex {$_ms_queue[1]} {^{gc|c}:{.+}$} {#var _msk &1;#var _msq &2};
        #if {"$_msk" == "gc"} {#var _msneed 2300} {#var _msneed 200};
        #if {$my[sp][current] > $_msneed || $my[immersion][active]} {
            #var _mstrig $maint_spells[$_msq][ctrig];
            #var _mscv $maint_spells[$_msq][cval];
            #if {"$_mscv" != ""} {#var _msmid {$_mstrig#$mage[contingencies][$_mscv]}} {#var _msmid {$_mstrig}};
            #var _ms_ok 0;
            #if {"$_msk" == "gc"} {
                cast greater contingency as $_msmid#cast $maint_spells[$_msq][cspell];
            } {
                cast contingency as $_msmid#cast $maint_spells[$_msq][cspell];
            };
            #delay {maint_setup} {_maint_setup_check} {3};
        } {
            #delay {maint_setup} {_maint_setup_next} {4};
        };
    };
};

#alias {_maint_setup_check} {
    #if {$_ms_ok} {
        #list _ms_queue delete 1;
        #math _ms_set {$_ms_set + 1};
        #var _ms_tries 0;
        #if {"$_msk" == "gc"} {#var _mskind {greater}} {#var _mskind {normal}};
        #echo {<afa>  Set $_mskind contingency for $maint_spells[$_msq][name] (&_ms_queue[] left).<088>};
    } {
        #math _ms_tries {$_ms_tries + 1};
        #if {$_ms_tries >= 5} {
            #list _ms_queue delete 1;
            #var _ms_tries 0;
            #var _ms_failed {$_ms_failed $maint_spells[$_msq][name]};
        };
    };
    _maint_setup_next;
};

#alias {maint} {
    #format _mcmd {%l} {%1};
    #var _mrest {};
    #regex {%0} {^\S+\s+{.*}$} {#var _mrest {&1}};
    #switch {"$_mcmd"} {
        #case {""} {_maint_on};
        #case {"on"} {_maint_on};
        #case {"off"} {_maint_off};
        #case {"add"} {_maint_pick {1} {$_mrest}};
        #case {"del"} {_maint_pick {0} {$_mrest}};
        #case {"remove"} {_maint_pick {0} {$_mrest}};
        #case {"all"} {
            _maint_tidy;
            #NOP -- One spell per group: keep the one already picked, else the first in maint_order (the;
            #NOP -- stronger one). Evil/good is your choice. Aura and blink clash with something not yet known.;
            #foreach {$maint_order[%*]} {_mk} {
                #var _mtaken 0;
                #foreach {$maint_order[%*]} {_mg} {
                    #if {"$maint_spells[$_mg][group]" == "$maint_spells[$_mk][group]" && "$maint_sel[$_mg]" == "1"} {#var _mtaken 1};
                };
                #if {!$_mtaken && "$_mk" != "pfe" && "$_mk" != "pfg" && "$_mk" != "pa" && "$_mk" != "blink"} {_maint_set $_mk 1};
            };
            _maint_changed;
            #echo {  <ccc>One per group: major or minor globe, stoneskin or rhino skin, mag shield or shield.<088>};
            #echo {  <ccc>Not added: evil/good (pick <ffa>maint pfe<ccc> or <ffa>maint pfg<ccc>), aura and blink (they<088>};
            #echo {  <ccc>conflict with other defenses, pick them yourself with <ffa>maint pa<ccc> / <ffa>maint blink<ccc>).<088>};
        };
        #case {"default"} {
            #NOP -- The usual set: replaces your picks with maint_default;
            #foreach {$maint_order[%*]} {_mk} {_maint_set $_mk 0};
            #foreach {$maint_default[%*]} {_mk} {_maint_set $_mk 1};
            _maint_changed;
        };
        #case {"clear"} {
            #foreach {$maint_order[%*]} {_mk} {_maint_set $_mk 0};
            _maint_save;
            _maint_off cleared;
        };
        #case {"setup"} {maint_setup};
        #case {"list"} {_cont_fetch _maint_list};
        #case {"check"} {_cont_fetch _maint_list};
        #case {"status"} {_cont_fetch _maint_list};
        #case {"help"} {maint-help};
        #default {_maint_pick {t} {%0}};
    };
};

#alias {maint-help} {
    #echo {};
    #echo {<ccf>  ==================  MAGE MAINT HELP  ==================<088>};
    #echo {  <ffa>maint setup           <fff>set contingencies for your picks, then maint on<088>};
    #echo {  <ffa>maint                 <fff>start keeping your picked spells up<088>};
    #echo {  <ffa>maint off             <fff>stop recasting (your picks are kept)<088>};
    #echo {  <ffa>maint <spell> ...     <fff>pick or unpick (toggles), e.g. <ffa>maint ps mb<088>};
    #echo {  <ffa>maint add <spell> ... <fff>pick<088>};
    #echo {  <ffa>maint del <spell> ... <fff>unpick<088>};
    #echo {  <ffa>maint all             <fff>pick one of each (not evil/good, aura or blink)<088>};
    #echo {  <ffa>maint default         <fff>pick the usual set (replaces your picks)<088>};
    #echo {  <ffa>                      <888>Mindblank, Prismatic Sphere, Mantle, Major Globe,<088>};
    #echo {  <ffa>                      <888>Mag Shield, Armor, Stoneskin, Prot Good<088>};
    #echo {  <ffa>maint clear           <fff>unpick everything and stop<088>};
    #echo {  <ffa>maint list            <fff>every spell: picked, kept up, up now, contingency<088>};
    #echo {<ccf>  -------------------------------------------------------<088>};
    #echo {  <fff>Spells:<088>};
    #echo {    <ffa>mb     <ccc>Mindblank             <ffa>ps     <ccc>Prismatic Sphere<088>};
    #echo {    <ffa>pa     <ccc>Prismatic Aura        <ffa>mantle <ccc>Mantle<088>};
    #echo {    <ffa>major  <ccc>Major Globe           <ffa>minor  <ccc>Minor Globe<088>};
    #echo {    <ffa>ms     <ccc>Magnificent Shield    <ffa>shield <ccc>Shield<088>};
    #echo {    <ffa>armor  <ccc>Armor                 <ffa>ss     <ccc>Stoneskin<088>};
    #echo {    <ffa>rs     <ccc>Rhino Skin            <ffa>blink  <ccc>Blink<088>};
    #echo {    <ffa>pfe    <ccc>Protection from Evil  <ffa>pfg    <ccc>Protection from Good<088>};
    #echo {    <888>Only one of each can be up, picking one drops the other:<088>};
    #echo {    <888>major/minor globe, stoneskin/rhino skin, mag shield/shield, evil/good.<088>};
    #echo {<ccf>  -------------------------------------------------------<088>};
    #echo {  <fff>Fresh login, step by step<088>};
    #echo {  <ccc> <ffa>1.<ccc> Pick your spells once: <ffa>maint default<ccc>, or e.g. <ffa>maint ps mb mantle<ccc>.<088>};
    #echo {  <ccc>    Picks save with <ffa>ld<ccc> (and the 10 minute autosave).<088>};
    #echo {  <ccc> <ffa>2.<ccc> Type <ffa>maint setup<ccc>. That is all:<088>};
    #echo {  <ccc>    - it checks the contingencies you already have and keeps them<088>};
    #echo {  <ccc>    - removes ones maint set for spells you no longer pick<088>};
    #echo {  <ccc>    - adds the missing ones, greater first, then normal when the<088>};
    #echo {  <ccc>      greater slots are full (or you do not have greater yet)<088>};
    #echo {  <ccc>    - one at a time, waiting for SP or immersion (2230 SP each)<088>};
    #echo {  <ccc>    - then turns maint on, which casts any spell that is down<088>};
    #echo {  <ccc> After a linkdead maint comes back on by itself. After a relog,<088>};
    #echo {  <ccc> if your contingencies are still on you, just type <ffa>maint<ccc>.<088>};
    #echo {};
    #echo {  <fff>Why contingencies and maint?<088>};
    #echo {  <ccc> A contingency recasts its spell the moment it fails or runs out,<088>};
    #echo {  <ccc> even mid-fight. maint is the backup: every heartbeat it casts one<088>};
    #echo {  <ccc> picked spell that is still missing (no contingency for it, the<088>};
    #echo {  <ccc> contingency did not fire, or you just logged in).<088>};
    #echo {  <ccc> Mindblank has no contingency trigger, maint alone keeps it up.<088>};
    #echo {  <ccc> Contingencies that are not for maint's spells (an hp or sp potion)<088>};
    #echo {  <ccc> are never touched.<088>};
    #echo {};
    #echo {  <fff>Switching evil and good<088>};
    #echo {  <ccc> Use <ffa>gc_pfe<ccc> / <ffa>gc_pfg<ccc> (or <ffa>prots_pfe<ccc> / <ffa>prots_pfg<ccc>, <ffa>c_pfe<ccc> / <ffa>c_pfg<ccc>).<088>};
    #echo {  <ccc> They check both your contingency lists first, whatever slot or<088>};
    #echo {  <ccc> kind (greater or normal) the old side is in, and remove it. Then<088>};
    #echo {  <ccc> they move your maint pick and heartbeat flag over, deplete the<088>};
    #echo {  <ccc> old spell and set up the new side. Takes about 2 seconds.<088>};
    #echo {  <ccc> (<ffa>maint pfe<ccc> / <ffa>maint pfg<ccc> only change the pick, nothing is cast.)<088>};
    #echo {};
    #echo {  <ccc>Needs the mage hpbar (<ffa>setup_3kdb_hpbar<ccc>) so it can see which<088>};
    #echo {  <ccc>prots are up. Nothing is recast while you are idle (deadman).<088>};
    #echo {<ccf>  =======================================================<088>};
    #echo {};
};

#NOP -- setup summon config with golem and summons;
#alias {ms} {
	#switch {"%0"} {
          #case {"golema"} {cast summon config as create golem##1#1500#70#assist#summons#always;cast summon config activate};
          #case {"golemd"} {cast summon config as create golem##1#1500#70#defend#summons#always;cast summon config activate};
          #case {"1a"} {cast summon config as monster summoning 1##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"1d"} {cast summon config as monster summoning 1##2#1500#70#defend#summons#always;cast summon config activate};
          #case {"2a"} {cast summon config as monster summoning 2##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"2d"} {cast summon config as monster summoning 2##2#1500#70#defend#summons#always;cast summon config activate};
          #case {"3a"} {cast summon config as monster summoning 3##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"3d"} {cast summon config as monster summoning 3##2#1500#70#defend#summons#always;cast summon config activate};
          #case {"4a"} {cast summon config as monster summoning 4##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"4d"} {cast summon config as monster summoning 4##2#1500#70#defend#summons#always;cast summon config activate};
          #case {"5a"} {cast summon config as monster summoning 5##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"5d"} {cast summon config as monster summoning 5##2#1500#70#defend#summons#always;cast summon config activate};
          #case {"6a"} {cast summon config as monster summoning 6##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"6d"} {cast summon config as monster summoning 6##2#1500#70#defend#summons#always;cast summon config activate};
          #case {"7a"} {cast summon config as monster summoning 7##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"7d"} {cast summon config as monster summoning 7##2#1500#70#defend#summons#always;cast summon config activate};
          #case {"8a"} {cast summon config as monster summoning 8##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"8d"} {cast summon config as monster summoning 8##2#1500#70#defend#summons#always;cast summon config activate};
          #case {"9a"} {cast summon config as monster summoning 9##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"9d"} {cast summon config as monster summoning 9##2#1500#70#defend#summons#always;cast summon config activate};
          #case {"10a"} {cast summon config as monster summoning 10##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"10d"} {cast summon config as monster summoning 10##2#1500#70#defend#summons#always;cast summon config activate};
          #case {"11a"} {cast summon config as monster summoning 11##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"11d"} {cast summon config as monster summoning 11##2#1500#70#defend#summons#always;cast summon config activate};
          #case {"12a"} {cast summon config as monster summoning 12##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"12d"} {cast summon config as monster summoning 12##2#1500#70#defend#summons#always;cast summon config activate};
          #case {"13a"} {cast summon config as monster summoning 13##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"13d"} {cast summon config as monster summoning 13##2#1500#70#defend#summons#always;cast summon config activate};
          #case {"14a"} {cast summon config as monster summoning 14##2#1500#70#assist#summons#always;cast summon config activate};
          #case {"14d"} {cast summon config as monster summoning 14##2#1500#70#defend#summons#always;cast summon config activate};
          #case {""}   {#echo {<efb>==========<088> <faa>NO CONFIGURATION PROVIDED<088> <efb>==========<088>}};
          #default 	 {cast summon config as monster summoning %0;cast summon config activate};
     };
};

#NOP -- activate summon config;
#alias {activate_sconfig} {
    cast summon config activate
};

#NOP -- clear and deactivate summon config;
#alias {clear_sconfig} {
    #5 {cast remove summon config 1};
    cast summon config deactivate
};

#NOP -- setup perform with a single damage type spell;
#alias {castper} {
    #switch {"%0"} {
        #NOP -- damage types;
        #case {"blunt"} {cast perform as cast implosion;cast activate c};
        #case {"radiation"} {cast perform as cast sunspear;cast activate c};
        #case {"mind"} {cast perform as cast mind warp;cast activate c};
        #case {"energy"} {cast perform as cast disintegrate;cast activate c};
        #case {"poison"} {cast perform as cast venomous spray;cast activate c};
        #case {"acid"} {cast perform as cast acid arrow;cast activate c};
        #case {"noeb"} {cast perform as cast prismatic spray;cast activate c};
        #case {"fire"} {cast perform as cast burning hands;cast activate c};
        #case {"fire2"} {cast perform as cast incinerate;cast activate c};
        #case {"ice"} {cast perform as cast frostbite;cast activate c};
        #NOP -- spell names;
        #case {"implosion"} {cast perform as cast implosion;cast activate c};
        #case {"sunspear"} {cast perform as cast sunspear;cast activate c};
        #case {"mind warp"} {cast perform as cast mind warp;cast activate c};
        #case {"disintegrate"} {cast perform as cast disintegrate;cast activate c};
        #case {"venomous spray"} {cast perform as cast venomous spray;cast activate c};
        #case {"acid arrow"} {cast perform as cast acid arrow;cast activate c};
        #case {"prismatic spray"} {cast perform as cast prismatic spray;cast activate c};
        #case {"burning hands"} {cast perform as cast burning hands;cast activate c};
        #case {"incinerate"} {cast perform as cast incinerate;cast activate c};
        #case {"frostbite"} {cast perform as cast frostbite;cast activate c};
        #NOP -- see available options;
        #case {""} {
            #echo {<cbf>Damage Type          Spell Name<088>};
            #echo {<fff>-------------------------------<088>};
            #echo {<bdc>blunt                implosion<088>};
            #echo {<bdc>radiation            sunspear<088>};
            #echo {<bdc>mind                 mind warp<088>};
            #echo {<bdc>energy               disintegrate<088>};
            #echo {<bdc>poison               venomous spray<088>};
            #echo {<bdc>acid                 acid arrow<088>};
            #echo {<bdc>noeb                 prismatic spray<088>};
            #echo {<bdc>fire                 burning hands<088>};
            #echo {<bdc>fire2                incinerate<088>};
            #echo {<bdc>ice                  frostbite<088>};
        };
    };
};

#NOP -- quick fix for mage summon tanking if room damage causes you to attack them such as boulders from zodiac;
#var summon_shoo_toggle 0;

#alias {.checksummons} {
    #if {"$summon_shoo_toggle" == "1"} {#return};
    #if {"$enemy[name]" == ""} {#return};

    #var temp_enemy_name $enemy[name];
    #replace temp_enemy_name { \[%*\]%*} {};
    #replace temp_enemy_name { \(%*\)%*} {};
    #replace temp_enemy_name { \\x7B%*\\x7D%*} {};
    #replace temp_enemy_name {An } {};
    #replace temp_enemy_name {A } {};
    #replace temp_enemy_name {The } {};
    #format {temp_enemy_name} {%p} {$temp_enemy_name};
    #format {temp_enemy_name} {%l} {$temp_enemy_name};

    #var temp_summon_names {$summonList};
    #list temp_summon_names simplify;
    #replace temp_summon_names {;} {};
    #replace temp_summon_names {:%*%} {;};
    #format {temp_summon_names} {%l} {$temp_summon_names};

    #foreach {$temp_summon_names} {tempsummonname} {
        #format {tempsummonname} {%l} {$tempsummonname};
        #if {"$temp_enemy_name" == "$tempsummonname"} {
            ptell Attacking your summons, shooing them away!;
            shoo;
            #var enemy[name] 0;
            #var summon_shoo_toggle 1;
            #delay {summon_shoo_reset} {#var summon_shoo_toggle 0;} {5};
            #break;
        };
    };
};

#class {guild_aliases} {close}