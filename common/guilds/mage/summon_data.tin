#NOP -- Just the names, used in the damage tracker;
#local tmpItem 1;
#list summon_types_list clear;
#loop 1 &summon_types[] tmpItem
{
    #list summon_types_list add $summon_types[$tmpItem][name];
};

#NOP -- Death line names of the kb_ignore summons, for _kbCheckIgnore in common/corpsetrig.tin;
#list summon_kb_ignore clear;
#foreach $summon_types[%*] tmpSummon
{
    #if {$tmpSummon[kb_ignore] && "$tmpSummon[hit_name]" != ""}
    {
        #regex {$tmpSummon[hit_name]} {^%w %*$}
        {
            #list summon_kb_ignore add {&2};
        };
    };
};

#class summon_data close;
