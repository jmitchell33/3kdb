#class summon_data kill;
#class summon_data open;

#NOP -- The one list of mage summons. Read for every guild by common/index.tin, and by;
#NOP -- common/guilds/mage/data.tin, so non-mages in a group with a mage still use it.;
#NOP -- Add or fix a summon here only. Fields:;
#NOP --   ms, name, key, dtype  the summon_types / summon_select roster (key is what you summon by);
#NOP --   look_name   the name in a room look, with A/An. .summonLookupName in common/guilds/mage/summoner.tin;
#NOP --   say_name    the name said to it (say <say> 2, defend me), from .summonLookupName;
#NOP --   hit_name    the name on its "<hit> hit for N damage!" line, with A/An. The damage tracker;
#NOP --               files that hit under name. modules/dmgtracker/dmgtracker_mage.tin;
#NOP --   kb_ignore   1 to skip the corpse trigger when it dies. common/corpsetrig.tin matches its;
#NOP --               hit_name without the A/An, as death lines have none (Celestial Lion gurgles...).;
#NOP --               Leave 0 on names normal mobs share (Orc, Troll...) or killing those breaks.;
#NOP -- An empty look_name or hit_name is skipped. Names are case sensitive and must match the game.;

#var summon_types {};
#list summon_types add {{
    {ms} {} {name} {Something} {key} {something} {dtype} {}
    {look_name} {} {say_name} {}
    {hit_name} {}
    {kb_ignore} {0}
}};
