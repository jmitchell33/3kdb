#class guild_data kill;
#class guild_data open;


#var haste_icon ⚡;
#var mf_icon 💪;
#var tank_icon !!;

#NOP -- The summon list (summon_types) is in common/guilds/mage/summon_data.tin, read below;

#NOP -- Spells and their costs;
#var spell_costs {};
#list spell_costs add {{{name} {armor} {cost} {15}}};
#list spell_costs add {{{name} {shield} {cost} {15}}};
#list spell_costs add {{{name} {dispel magic} {cost} {50}}};
#list spell_costs add {{{name} {friends} {cost} {25}}};
#list spell_costs add {{{name} {protection from evil} {cost} {45}}};
#list spell_costs add {{{name} {protection from good} {cost} {45}}};
#list spell_costs add {{{name} {blur} {cost} {80}}};
#list spell_costs add {{{name} {minor globe} {cost} {110}}};
#list spell_costs add {{{name} {rhino skin} {cost} {95}}};
#list spell_costs add {{{name} {secure shelter} {cost} {150}}};
#list spell_costs add {{{name} {mindblank} {cost} {275}}};
#list spell_costs add {{{name} {invisibility} {cost} {100}}};
#list spell_costs add {{{name} {magnificent shield} {cost} {110}}};
#list spell_costs add {{{name} {mirror image} {cost} {100}}};
#list spell_costs add {{{name} {blink} {cost} {150}}};
#list spell_costs add {{{name} {stoneskin} {cost} {115}}};
#list spell_costs add {{{name} {major globe} {cost} {160}}};
#list spell_costs add {{{name} {prismatic aura} {cost} {115}}};
#list spell_costs add {{{name} {prismatic sphere} {cost} {155}}};
#list spell_costs add {{{name} {mass invisibility} {cost} {210}}};
#list spell_costs add {{{name} {mantle} {cost} {105}}};



#class guild_data close;

#NOP -- After the close, so the summon list stays in its own class;
#read common/guilds/mage/summon_data.tin;
