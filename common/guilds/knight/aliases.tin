#NOP --- GUILD SPECIFIC ALIASES
#alias battlecry {
    #if {&battlecry[] > 0} {
        #var ix &battlecry[];
        #math randNum 1d${ix};
        #send {!battlecry $battlecry[$randNum]};
    } {
        #send {!battlecry};
    };
};

#alias battlecry+ {
    #echo {  <bfc>Battlecry added: <fff>%0<088>};
    #list battlecry add {%0};
};

#alias battlecry- {
    #format tmpIx {%d} {%1};
    #if {$tmpIx <= &battlecry[]} {
        #echo {  <fcc>Removing battlecry: <fff>$battlecry[$tmpIx]<088>};
        #list battlecry delete $tmpIx;
    } {
        #echo {  <bfc>Battlecry <fcc>$tmpIx <bfc>not found in the index.  There are currently a total of <fcc>&battlecry[] <bfc>battlecries.<088>};
    };
};

