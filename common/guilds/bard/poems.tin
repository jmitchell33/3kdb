#class bard_poems kill;
#class bard_poems open;

#NOP -- Just for fun, these appear on some of the skill tables and other area;

#var bard_haiku {
    {1} {{1} {Hear the final chord} {2} {ring across the shattered realms,} {3} {even Nix applauds.}}
    {2} {{1} {Drums of distant war,} {2} {the bard strides where heroes fear,} {3} {lute and sword - no more.}}
    {3} {{1} {The fates hold their breath,} {2} {the die tumbles through the dark,} {3} {🎲 natural 20! 🎲}}
    {4} {{1} {Y por tu amor?} {2} {Quiero el dinero guero,} {3} {y tu vales peor}}
};



#class bard_poems close;