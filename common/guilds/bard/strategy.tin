#class {guild_strategy} {kill};
#class {guild_strategy} {open};

#list strategyList add {{{guild} {bard} {name} {hammer} {active} {0} {description} {Bard: Hammer Smashed Face}}};
#list strategyList add {{{guild} {bard} {name} {rainbow} {active} {0} {description} {Bard: Rainbow of Death}}};
#list strategyList add {{{guild} {bard} {name} {cloud} {active} {0} {description} {Bard: Noxious Cloud}}};
#list strategyList add {{{guild} {bard} {name} {vortex} {active} {0} {description} {Bard: Lightning Vortex}}};
#list strategyList add {{{guild} {bard} {name} {assault} {active} {0} {description} {Bard: Martial Assault}}};
#list strategyList add {{{guild} {bard} {name} {enrage} {active} {0} {description} {Bard: Enrage}}};
#list strategyList add {{{guild} {bard} {name} {critic} {active} {0} {description} {Bard: Caustic Critic}}};
#list strategyList add {{{guild} {bard} {name} {es} {active} {0} {description} {Bard: Empowered Strikes}}};
#list strategyList add {{{guild} {bard} {name} {heartening} {active} {0} {description} {Bard: Heartening Laugh}}};
#list strategyList add {{{guild} {bard} {name} {dharm} {active} {0} {description} {Bard: Defensive Harmony when HP is low}}};
#list strategyList add {{{guild} {bard} {name} {fi} {active} {0} {description} {Bard: First Impression once a boot (checks stats at login)}}};
#list strategyList add {{{guild} {bard} {name} {ks} {active} {0} {description} {Bard: Karmic Shield}}};
#list strategyList add {{{guild} {bard} {name} {vampire} {active} {0} {description} {Bard: Vampire song in combat}}};
#NOP -- Defenses, kept up by the heartbeat in and out of combat (see bard_prot in heartbeat.tin);
#list strategyList add {{{guild} {bard} {name} {spells} {active} {0} {description} {Bard: Defense spells (blink, prots, mind blank, hardened skin)}}};
#list strategyList add {{{guild} {bard} {name} {songs} {active} {0} {description} {Bard: Defense songs (amazing grace, o muse)}}};
#list strategyList add {{{guild} {bard} {name} {blink} {active} {0} {description} {Bard: Blink}}};
#list strategyList add {{{guild} {bard} {name} {pe} {active} {0} {description} {Bard: Protection from Evil}}};
#list strategyList add {{{guild} {bard} {name} {pg} {active} {0} {description} {Bard: Protection from Good}}};
#list strategyList add {{{guild} {bard} {name} {pn} {active} {0} {description} {Bard: Protection from Neutral}}};
#list strategyList add {{{guild} {bard} {name} {pf} {active} {0} {description} {Bard: Protection from Frost}}};
#list strategyList add {{{guild} {bard} {name} {ph} {active} {0} {description} {Bard: Protection from Heat}}};
#list strategyList add {{{guild} {bard} {name} {mb} {active} {0} {description} {Bard: Mind Blank}}};
#list strategyList add {{{guild} {bard} {name} {hs} {active} {0} {description} {Bard: Hardened Skin}}};
#list strategyList add {{{guild} {bard} {name} {hr} {active} {0} {description} {Bard: Harmonic Regeneration}}};
#list strategyList add {{{guild} {bard} {name} {ag} {active} {0} {description} {Bard: Amazing Grace}}};
#list strategyList add {{{guild} {bard} {name} {om} {active} {0} {description} {Bard: O Muse}}};
#list strategyList indexate name;

#NOP -- Timers of various spells (in seconds);
#var criticDuration 58;

#NOP -- dharm: cast defensive harmony below this HP percent, if karma is at least dharmKarma;
#if {"${dharmHpPerc}" === ""} {#var dharmHpPerc 40};
#if {"${dharmKarma}" === ""} {#var dharmKarma 300};
#NOP -- Whether heartening laugh / defensive harmony are up (actions.tin). Kept through .reload;
#if {"${bard_hl}" === ""} {#var bard_hl 0};
#if {"${bard_dharm}" === ""} {#var bard_dharm 0};
#var hl_override 0;
#var dharm_override 0;

#NOP -- Powers are sent straight (not _bard_cast), with a 6 second wait so they aren't resent before the;
#NOP -- game's message comes back;
#alias {_bard_heartening} {
    #if {$bard_hl || $hl_override || $my[gp1][current] < 400} {#return};
    #var hl_override 1;
    heartening laugh;
    #delay {hl_toggle} {#var hl_override 0} {6};
};

#NOP -- karmic shield is a toggle: sending it while it's up turns it off. So it's only sent when the guild line;
#NOP -- shows no KS, and not again for 6 seconds (restarted when it comes up) so a late MIP update can't toggle it off;
#var ks_override 0;
#alias {_bard_ks} {
    #if {$my[defs][ks] > 0 || $ks_override} {#return};
    #var ks_override 1;
    karmic shield;
    #delay {ks_toggle} {#var ks_override 0} {6};
};
#action {^You have aligned your conciousness with the will of nature.$} {
    #var ks_override 1;
    #delay {ks_toggle} {#var ks_override 0} {6};
};

#NOP -- vampire: sing it in combat when V is missing from the guild line, or renew it when it starts fading;
#NOP -- (_bard_vampire 1, from actions.tin). Not over another song, and needs vampireKarma (the song costs 135);
#if {"${vampireKarma}" === ""} {#var vampireKarma 400};
#var vampire_override 0;
#alias {_bard_vampire} {
    #if {"%1" != "1" && $my[defs][v] > 0} {#return};
    #if {$vampire_override || @bard_singing{} || $my[gp1][current] < $vampireKarma} {#return};
    #if {&my[song][rounds]} {#if {$my[song][rounds] > 0} {#return}};
    #var vampire_override 1;
    perform vampire;
    #delay {vampire_toggle} {#var vampire_override 0} {6};
};

#alias {_bard_dharm} {
    #if {$bard_dharm || $dharm_override || $my[hp][max] <= 0} {#return};
    #math _dharm_perc {100 * $my[hp][current] / $my[hp][max]};
    #if {$_dharm_perc >= $dharmHpPerc || $my[gp1][current] < $dharmKarma} {#return};
    #var dharm_override 1;
    defensive harmony;
    #delay {dharm_toggle} {#var dharm_override 0} {6};
};

#NOP -- First impression lasts until the next reboot. Once a login, check stats for it and cast it if it's;
#NOP -- missing. bard_fi_checked isn't in a class, so .reload and gswap don't repeat the check;
#alias {_bard_fi} {
    #if {"$bard_fi_checked" == "1"} {#return};
    #var bard_fi_checked 1;
    #var bard_fi 0;
    stats;
    #delay {bard_fi_check} {#if {!$bard_fi} {first impression}} {5};
};

#NOP -- Critic counts as on once it's cast, until the acid runs dry or criticDuration passes. Waiting for the;
#NOP -- "acid clings" message instead recast it every heartbeat whenever that message didn't match.;
#NOP -- It's its own alias because checkStrategy fills in variables before running, so bard_cast_sent would be stale;
#alias {_bard_critic} {
    #if $mob[critic] {#return};
    _bard_cast caustic critic;
    #if $bard_cast_sent {
        #var mob[critic] 1;
        #delay criticTimer {#var mob[critic] 0} $criticDuration;
    };
};

#NOP -- Actions to perform at any time in the fight;
#alias {_strategy_guild} {
    checkStrategy {assault} {
        #if {$corpses[total] > 20 && $my[gp1][current] > $karma_heal} {
            martial assault;
            martial assault;
            martial assault;
        };
    };

    checkStrategy {critic} {_bard_critic};
    checkStrategy {es} {_bard_es};
    checkStrategy {heartening} {_bard_heartening};
    checkStrategy {dharm} {_bard_dharm};
    checkStrategy {vampire} {_bard_vampire};
    checkStrategy {enrage} {#if !$mob[enrage] {enrage};};
    checkStrategy {cloud} {#if !$mob[noxious-cloud] {_bard_cast noxious cloud};};
    checkStrategy {vortex} {#if !$mob[lightning-vortex] {_bard_cast lightning vortex};};

    #NOP -- Bard Song-Bot Strategies;
    #if {$mip[round] > 1} {
            
        #NOP --- If we're above the level we should use a corpse, remove the action to use the corpse;
        #if {$my[gp1][current] > $karma_use_corpse_between_songs && $actions_stacked} {remove_action corpse-between-songs;};

        #NOP --- The song bots shouldn't attempt to keep rolling if we're near using a corpse;
        checkStrategy {rainbow} {
            #if {$defs[hr] != 1} {#NOP} {#var defs[hr] 1};
            #if {$my[gp1][current] < $karma_use_corpse_between_songs && $my[song][rounds] > 1} {
                add_action {{{name} {corpse-between-songs} {action} {#var resume_song 0;corpse_select;#delay 2 {perform dirge;perform dirge;#var resume_song 1}}}};
            };

            #if {$my[gp1][current] > $karma_heal} {
                #if {$my[song][rounds] > 1} {#NOP;} {
                    #if {!$actions_stacked} {
                        #if $resume_song {perform rainbow of death};
                    } {
                        do_action;
                    };
                };
                #if !$my[defs][fr] {_bard_cast focus the rainbow};
            };
        };

        checkStrategy {hammer} {
            #if {$defs[hr] != 1} {#NOP} {#var defs[hr] 1};
            #if {$my[gp1][current] < $karma_use_corpse_between_songs && $my[song][rounds] > 1} {
                add_action {{{name} {corpse-between-songs} {action} {#var resume_song 0;corpse_select;#delay 2 {perform dirge;perform dirge;#var resume_song 1}}}};
            };
            #if {$my[gp1][current] > $karma_heal} {
                #if {$my[song][rounds] > 1} {#NOP;} {
                    #if {$my[gp2][current] > 20} {
                        #if {$mip[round] > 10} {
                            #if {!$actions_stacked} {
                                #if {$resume_song} {
                                    perform hammer smashed face;
                                };
                            } {
                                do_action;
                            };
                            
                        } {
                            #if !$my[defs][fr] {_bard_cast focus the rainbow};
                            #if {!$actions_stacked} {
                                #if {$resume_song} {
                                    perform rainbow of death;
                                };
                            } {
                                do_action;
                            };
                        };
                    } {
                        #if !$my[defs][fr] {_bard_cast focus the rainbow};
                        #if {!$actions_stacked} {
                            #if {$resume_song} {
                                perform rainbow of death;
                            };
                        } {
                            do_action;
                        };
                    };
                };
            };
        };
    };
};

#NOP -- Actions to perform the first rounds of combat;
#alias {_strategy_guild_start} {
    #NOP;
};

#class {guild_strategy} {close};