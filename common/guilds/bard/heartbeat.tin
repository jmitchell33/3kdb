#class {guild_heartbeat} {kill}
#class {guild_heartbeat} {open}

#var es_override 0;
#var karma_use_corpse_between_songs 650;
#var resume_song 1;

#NOP -- _bard_cast <spell>: bards get one spell a round, so only the first auto-cast each round goes out (one;
#NOP -- every 1.5 seconds out of combat). The rest aren't queued: whatever wanted them checks again next;
#NOP -- heartbeat, so the order below decides what goes first. bard_cast_sent says whether this one went out;
#NOP -- The same spell isn't resent for 6 seconds: the MIP guild line that says a prot is up arrives a beat;
#NOP -- after the spell lands, so the next heartbeat would otherwise cast it again. A refused cast (already;
#NOP -- cast this round, or singing) clears the wait, see _bard_cast_refused;
#var bard_cast_round 0;
#var bard_cast_time 0;
#var bard_cast_last {};
#alias {_bard_cast} {
	#var bard_cast_sent 0;
	#if {@bard_singing{}} {#return};
	#format bard_cast_now {%U};
	#if {&bard_cast_wait[%0]} {#if {$bard_cast_now < $bard_cast_wait[%0]} {#return}};
	#if {$mip[round] > 0 && $mip[round] == $bard_cast_round} {#return};
	#if {$mip[round] == 0 && $bard_cast_now - $bard_cast_time < 1500000} {#return};
	#var bard_cast_round $mip[round];
	#var bard_cast_time $bard_cast_now;
	#var bard_cast_sent 1;
	#var bard_cast_last {%0};
	#math {bard_cast_wait[%0]} {$bard_cast_now + 6000000};
	cast %0;
};
#alias {_bard_cast_refused} {
	#if {"$bard_cast_last" != ""} {#unvar {bard_cast_wait[$bard_cast_last]}};
	#var bard_cast_last {};
};

#NOP -- Bards can't cast while singing. bard_sing_until (microseconds) is set when a song starts or the game;
#NOP -- refuses a spell for singing, and cleared when the song ends (actions.tin). It runs out after 20 seconds;
#NOP -- in case an end message is missed, so at worst one spell a while is refused instead of one every round;
#var bard_sing_until 0;
#alias {_bard_sing_start} {
	#format bard_sing_until {%U};
	#math bard_sing_until {$bard_sing_until + 20000000};
};
#function {bard_singing} {
	#format result {%U};
	#if {$result < $bard_sing_until} {#return 1} {#return 0};
};

#NOP -- Keep empowered strikes up (175 karma), for the es defense and the es strategy. es_override waits;
#NOP -- 6 seconds after sending so it isn't resent before the prompt shows ES;
#alias {_bard_es} {
	#if {$my[defs][es] > 0} {#return};
	#if {$my[gp1][current] > 400 && !$es_override} {
		#var es_override 1;
		empowered strikes;
		#ticker {es_toggle} {#var es_override 0;#unticker es_toggle} {6};
	};
};

#NOP -- Defenses can be turned on three ways: the old $defs flag, their own strategy (pe, blink, ag...), or;
#NOP -- their group strategy (spells or songs). Strategies are saved between logins, $defs flags aren't;
#function {bard_strategy} {
	#var result 0;
	#if {"%1" == ""} {#return 0};
	#foreach {$strategyActive[%*]} {bard_strategy_item} {
		#if {"$bard_strategy_item[name]" == "%1"} {#var result 1};
	};
};
#function {bard_prot} {
	#if {"$defs[%1]" == "1" || @bard_strategy{%1} || @bard_strategy{%2}} {#return 1} {#return 0};
};
#alias {_bard_strategy_on} {#if {!@bard_strategy{%1}} {strategy %1}};
#alias {_bard_strategy_off} {#if {@bard_strategy{%1}} {strategy %1}};

#alias {_guild_heartbeat} {
	#NOP -- So round 1 of the next fight isn't mistaken for the last fight's round 1;
	#if {$mip[round] == 0} {#var bard_cast_round 0};
	#if !$idle_flag {
		#if {$defs[es]} {_bard_es};
		checkStrategy {fi} {_bard_fi};
		checkStrategy {ks} {_bard_ks};
		#if {$my[defs][blink] > 0} {#NOP} {#if {@bard_prot{blink;spells}} {_bard_cast blink} {#nop}};
		#if {$my[defs][hs] > 0} {#NOP} {#if {@bard_prot{hs;spells}} {_bard_cast hardened skin} {#nop}};
		#if {$my[defs][mb] > 0} {#NOP} {#if {@bard_prot{mb;spells}} {_bard_cast mind blank} {#nop}};
		#if {$my[defs][pe] > 0} {#NOP} {#if {@bard_prot{pe;spells}} {_bard_cast protection from evil} {#nop}};
		#if {$my[defs][pn] > 0} {#NOP} {#if {@bard_prot{pn;spells}} {_bard_cast protection from neutral} {#nop}};
		#if {$my[defs][pg] > 0} {#NOP} {#if {@bard_prot{pg;spells}} {_bard_cast protection from good} {#nop}};
		#if {$my[defs][pf] > 0} {#NOP} {#if {@bard_prot{pf;spells}} {_bard_cast protection from frost} {#nop}};
		#if {$my[defs][ph] > 0} {#NOP} {#if {@bard_prot{ph;spells}} {_bard_cast protection from heat} {#nop}};
		
		#if {$my[defs][ag] > 0} {#NOP} {#if {@bard_prot{ag;songs} && !@bard_singing{}} {perform amazing grace} {#nop}};
		#if {$my[defs][o] > 0}  {#NOP} {#if {@bard_prot{om;songs} && !@bard_singing{}} {perform o muse} {#nop}};

		#NOP -- actions that should only be attempted once per round;
		#if {$action_round < $mip[round] && $mip[round] > 0} {
			#if {$my[song][rounds] > 1} {#NOP;} {#if $actions_stacked {do_action};};
			#if {$my[defs][hr] > 0} {#NOP} {#if {@bard_prot{hr;} && $my[sp][current] > $protCosts[harmonic regeneration][sp]} {_bard_cast harmonic regeneration} {#nop}};
		} {
			#NOP -- If you're not in combat, let er rip;
			#if !$incombat {
				#if $actions_stacked {do_action};
			};
		};
	};	
};

#class {guild_heartbeat} {close}