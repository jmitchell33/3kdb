#class {guild_aliases} {kill}
#class {guild_aliases} {open}


#NOP -- General Bard helper aliases;

#nop -- invigorating tune;
#alias {.itune} {
	perform invigorating tune for %0;
};

#NOP -- This alias is meant for the Angel's Fountain in wayhaven;
#alias {fillwater} {
	go water1;
	#delay 2 {
		#loop 1 20 i {give glass $i to $user;
			give pitcher $i to $user;
			fill glass;
			fill pitcher;
		};
		#5 {drink fountain};
	};
};

#NOP ---THIS SECTION IS FOR SONG ALIASES;
#NOP -- Also turns maint off (and saves that), so it is not resumed after a linkdeath;
#alias {clear_prots} {#var defs 0;#var maint_active 0;#unticker {maint_watch};_maint_save};
#alias {vamp} {perform vampire};
#alias {black} {cease;perform black for %0};
#alias {it %1} {perform invigorating tune for %1};
#alias {pd} {cease;perform dirge};
#alias {ag} {perform amazing grace};
#alias {om} {perform o muse};
#alias {rd} {cast focus the rainbow;perform rainbow of death};
#alias {lotb} {perform leader of the band};
#alias {itf} {perform into the fire;#delay 3 cease;};
#alias {es} {#var defs[es] 1};

#alias {ham_bot} {
	checkStrategy {hammer} {
		strategy hammer;
		#SHOWME <efa>------------------- HAMMER NO LONGER SMASHING FACE -------------------<088>;
		#var defs[hr] 0;
	} {
		strategy hammer;
		#SHOWME <efa>------------------- HAMMER WILL BEGIN SMASHING FACE -------------------<088>;
		#var defs[hr] 1;
	}
};

#alias {rod_bot} {
	checkStrategy {rainbow} {
		strategy rainbow;
		#SHOWME <efa>------------------- RAINBOW OF DEATH DISABLED -------------------<088>;
		#var defs[hr] 0;
		#var defs[fr] 0;
	} {
		strategy rainbow;
		#SHOWME <efa>------------------- RAINBOW OF DEATH ACTIVATED  -------------------<088>;
		#var defs[hr] 1;
		#var defs[fr] 1;
	}
};


#alias {blades} {reflex remove sp >$dmg_spell_sp;reflex add sp >$dmg_spell_sp cast blade dance};
#alias {fires} {reflex remove sp >$dmg_spell_sp;reflex add sp >$dmg_spell_sp cast fire storm};
#alias {critic} {reflex remove sp >$dmg_spell_sp;reflex add sp >$dmg_spell_sp cast caustic critic};
#alias {ebolt} {reflex remove sp >$dmg_spell_sp;reflex add sp >$dmg_spell_sp cast energy bolt};
#alias {rod} {perform rainbow of death;cast focus the rainbow};

#NOP -- QUICK ALIASES FOR SETTING UP DEFENSES;
#alias {prots_spells} {prots_blink;prots_pfe;prots_pfg;prots_pfn;prots_pfc;prots_pfh;prots_mb;prots_hs;};
#alias {prots_songs} {
	#if {$defs[ag] || $defs[om]} {
		#echo {<edb>---  DEFENSIVE SONGS OFF  ---<088>};
		#var defs[ag] 0;#var defs[om] 0;
	} {
		#echo {<dea>---  DEFENSIVE SONGS ON  ---<088>};
		#var defs[ag] 1;#var defs[om] 1;
	};
};

#alias {prots_pfe} {cast protection from evil;#var defs[pe] 1;echo_prots_pfe};
#alias {prots_pfg} {cast protection from good;#var defs[pg] 1;echo_prots_pfg};
#alias {prots_pfn} {cast protection from neutral;#var defs[pn] 1;echo_prots_pfn};
#alias {prots_pfc} {cast protection from frost;#var defs[pf] 1;echo_prots_pfc};
#alias {prots_pfh} {cast protection from heat;#var defs[ph] 1;echo_prots_pfh};
#alias {prots_mb} {cast mind blank;#var defs[mb] 1;echo_prots_mb};
#alias {prots_hs} {cast hardened skin;#var defs[hs] 1;echo_prots_hs};
#alias {prots_blink} {cast blink;#var defs[blink] 1;echo_prots_blink};
#alias {prots_hr} {#var defs[hr] 1;echo_prots_hr};
#alias {prots_grace} {perform amazing grace;#var defs[ag] 1;echo_prots_grace};
#alias {prots_muse} {perform o muse;#var defs[om] 1;echo_prots_muse};

#alias {reflex_clear} {reflex clear;echo_reflex_clear};
#alias {reflex_critic %1} {reflex add sp >%1 cast caustic critic;echo_reflex_critic %1};
#alias {reflex_ow %1} {reflex add gp1 <%1 ow;echo_reflex_ow %1};
#alias {reflex_ma %1} {reflex add gp1 >%1 martial assault;echo_reflex_ma %1};
#alias {reflex_soothe %1} {reflex add sp <%1 soothe;echo_reflex_soothe %1};


#NOP ---THIS SECTION IS FOR FORMATTING FOR SPELL/SONG MAINTENANCE;
#alias {echo_divider1} {#echo {========================================================}};
#alias {echo_clear_prots} {#echo {--------------- CLEARING DEFENSE VARIABLES --------------}};
#alias {echo_divider2} {#echo {+++++++++++++++++++++++++++++++++++++++++++++++++++++++++}};
#alias {echo_prots_header} {#echo {+++++++++++++++  ACTIVE DEFENSES INCLUDE:  ++++++++++++++}};
#alias {echo_prots_pfe} {#echo {+++++++++++++++  PROTECTION FROM EVIL      ++++++++++++++}};
#alias {echo_prots_pfg} {#echo {+++++++++++++++  PROTECTION FROM GOOD      ++++++++++++++}};
#alias {echo_prots_pfn} {#echo {+++++++++++++++  PROTECTION FROM NEUTRAL   ++++++++++++++}};

#alias {echo_prots_pfh} {#echo {+++++++++++++++  PROTECTION FROM HEAT      ++++++++++++++}};
#alias {echo_prots_pfc} {#echo {+++++++++++++++  PROTECTION FROM COLD      ++++++++++++++}};
#alias {echo_prots_mb} {#echo {+++++++++++++++  MIND BLANK                ++++++++++++++}};
#alias {echo_prots_hs}  {#echo {+++++++++++++++  HARDENED SKIN             ++++++++++++++}};

#alias {echo_prots_hr} {#echo {+++++++++++++++  HARMONIC REGENERATION     ++++++++++++++}};
#alias {echo_prots_blink} {#echo {+++++++++++++++  BLINK                     ++++++++++++++}};
#alias {echo_prots_grace} {#echo {+++++++++++++++  AMAZING GRACE             ++++++++++++++}};
#alias {echo_prots_muse} {#echo {+++++++++++++++  O'MUSE                    ++++++++++++++}};


#alias {echo_reflex_clear}     {#echo {---------------  CLEARING REFLEX ACTIONS      --------------}};
#alias {echo_reflex_header}    {#echo {+++++++++++++++  REFLEX ACTIONS INCLUDE:      ++++++++++++++}};
#alias {echo_reflex_critic %1} {#echo {+++++++++++++++  CAUSTIC CRITIC  (>%1 sp)     ++++++++++++++}};
#alias {echo_reflex_ow %1}  {#echo {+++++++++++++++  DIRGE CORPSE    (<%1 karma)  ++++++++++++++}};
#alias {echo_reflex_ma %1}     {#echo {+++++++++++++++  MARTIAL ASSAULT (>%1 karma)  ++++++++++++++}};
#alias {echo_reflex_soothe %1}     {#echo {+++++++++++++++  SOOTHE (<%1 sp)  ++++++++++++++}};

#NOP --- MAINT: pick which defenses the guild heartbeat keeps up. Type maint-help;
#NOP -- heartbeat.tin recasts a spell or song while defs[<defs>] is 1 and my[defs][<prot>] (MIP guild line) is 0.;
#NOP -- maint only sets those defs flags from your picks. Picks are copied to xmaint_sel in class;
#NOP -- global, which _variable_export writes to chars/<you>/vars.tin, so ld and the autosave keep them.;
#NOP -- {bots} 1: hammer/rainbow bots turn this one on and off, so maint never turns it off unless you unpick it.;
#var maint_spells[mb]    {{name} {Mind Blank}              {defs} {mb}    {prot} {mb}    {bots} {0}};
#var maint_spells[hs]    {{name} {Hardened Skin}           {defs} {hs}    {prot} {hs}    {bots} {0}};
#var maint_spells[blink] {{name} {Blink}                   {defs} {blink} {prot} {blink} {bots} {0}};
#var maint_spells[pfe]   {{name} {Protection from Evil}    {defs} {pe}    {prot} {pe}    {bots} {0}};
#var maint_spells[pfg]   {{name} {Protection from Good}    {defs} {pg}    {prot} {pg}    {bots} {0}};
#var maint_spells[pfn]   {{name} {Protection from Neutral} {defs} {pn}    {prot} {pn}    {bots} {0}};
#var maint_spells[pfc]   {{name} {Protection from Frost}   {defs} {pf}    {prot} {pf}    {bots} {0}};
#var maint_spells[pfh]   {{name} {Protection from Heat}    {defs} {ph}    {prot} {ph}    {bots} {0}};
#var maint_spells[es]    {{name} {Empowered Strikes}       {defs} {es}    {prot} {es}    {bots} {0}};
#var maint_spells[ag]    {{name} {Amazing Grace (song)}    {defs} {ag}    {prot} {ag}    {bots} {0}};
#var maint_spells[om]    {{name} {O Muse (song)}           {defs} {om}    {prot} {o}     {bots} {0}};
#var maint_spells[hr]    {{name} {Harmonic Regeneration}   {defs} {hr}    {prot} {hr}    {bots} {1}};
#list maint_order create {mb;hs;blink;pfe;pfg;pfn;pfc;pfh;es;ag;om;hr};
#NOP -- What maint default picks;
#list maint_default create {mb;hs;blink;pfe;pfg;pfn;pfc;pfh;es;ag;om};

#NOP -- Words you can type for each spell (lower case), mapped to its key above;
#var maint_words {
    {mb} {mb} {mindblank} {mb}
    {hs} {hs} {skin} {hs} {hardened} {hs}
    {blink} {blink} {b} {blink}
    {pfe} {pfe} {pe} {pfe} {evil} {pfe}
    {pfg} {pfg} {pg} {pfg} {good} {pfg}
    {pfn} {pfn} {pn} {pfn} {neutral} {pfn}
    {pfc} {pfc} {pf} {pfc} {frost} {pfc} {cold} {pfc}
    {pfh} {pfh} {ph} {pfh} {heat} {pfh}
    {es} {es} {empowered} {es} {strikes} {es}
    {ag} {ag} {grace} {ag}
    {om} {om} {o} {om} {muse} {om}
    {hr} {hr} {harmonic} {hr} {regen} {hr}
};

#NOP -- Nothing saved yet: start with maint_default;
#if {&{xmaint_sel}} {#var maint_sel $xmaint_sel} {#var maint_sel {};#foreach {$maint_default[%*]} {_mk} {#var maint_sel[$_mk] 1}};
#var maint_active 0;

#alias {_maint_save} {
    #class global open;
    #var xmaint_sel $maint_sel;
    #var xmaint_active $maint_active;
    #class global close;
};

#NOP -- Maint was on when you last saved (ld / autosave), so after a linkdeath return turn it back on once;
#NOP -- the login has settled (postload ends at 12s) and the hpbar has said which spells are up. Not on a;
#NOP -- fresh login: spells are down and setup_defense casts them, maint would cast over it. maint off saves off.;
#alias {_maint_resume} {
    #if {!$maint_active} {
        #echo {<dea>  maint was on before you logged out, turning it back on.<088>};
        _maint_on;
    };
};
#if {"$xmaint_active" == "1" && "$login_linkdeath" == "1"} {#delay {maint_resume} {_maint_resume} {15}};

#NOP -- %1 key, %2 1 or 0. Unpicking while maint is on stops that one now;
#alias {_maint_set} {
    #var maint_sel[%1] %2;
    #var _mblock[%1] 0;
    #if {!%2 && $maint_active} {#var defs[$maint_spells[%1][defs]] 0};
};

#NOP -- Push the picks into defs: picked 1, the rest 0 (bots ones are left to the bots);
#alias {_maint_apply} {
    #foreach {$maint_order[%*]} {_mk} {
        #if {"$maint_sel[$_mk]" == "1" && "$_mblock[$_mk]" != "1"} {
            #var defs[$maint_spells[$_mk][defs]] 1;
        } {
            #if {!$maint_spells[$_mk][bots]} {#var defs[$maint_spells[$_mk][defs]] 0};
        };
    };
};

#NOP -- Picked spell names, two per line;
#alias {_maint_grid} {
    #var _mcount 0;
    #var _mrow {};
    #foreach {$maint_order[%*]} {_mk} {
        #if {"$maint_sel[$_mk]" == "1"} {
            #format _mcell {%-26s} {$maint_spells[$_mk][name]};
            #var _mrow {$_mrow$_mcell};
            #math _mcount {$_mcount + 1};
            #if {$_mcount % 2 == 0} {
                #echo {      <afa>$_mrow<088>};
                #var _mrow {};
            };
        };
    };
    #if {"$_mrow" != ""} {#echo {      <afa>$_mrow<088>}};
    #if {$_mcount == 0} {#echo {      <888>nothing picked<088>}};
};

#NOP -- %1 = 1 pick, 0 unpick, t toggle. %2 = spell words;
#alias {_maint_pick} {
    #var _mwords {%2};
    #replace _mwords { } {;};
    #var _mbad {};
    #foreach {$_mwords} {_mw} {
        #if {"$_mw" != ""} {
            #format _mw {%l} {$_mw};
            #if {&maint_words[$_mw]} {
                #var _mk $maint_words[$_mw];
                #if {"%1" == "t"} {
                    #if {"$maint_sel[$_mk]" == "1"} {_maint_set $_mk 0} {_maint_set $_mk 1};
                } {
                    _maint_set $_mk %1;
                };
            } {
                #var _mbad {$_mbad $_mw};
            };
        };
    };
    #if {"$_mbad" != ""} {
        #echo {<faa>  Unknown spell:<fff>$_mbad<faa>. Type <ffa>maint list<faa> for the names.<088>};
    };
    _maint_changed;
};

#alias {_maint_changed} {
    _maint_save;
    #if {$maint_active} {_maint_apply};
    #echo {<dea>---  MAINT PICKS  ---<088>};
    _maint_grid;
    #if {$maint_active} {
        #echo {  <ccc>Maint is on, the heartbeat keeps these up now.<088>};
    } {
        #echo {  <ccc>Type <ffa>maint<ccc> to start keeping these up.<088>};
    };
};

#alias {_maint_on} {
    #var _mcount 0;
    #foreach {$maint_order[%*]} {_mk} {
        #if {"$maint_sel[$_mk]" == "1"} {#math _mcount {$_mcount + 1}};
    };
    #if {$_mcount == 0} {
        #echo {<faa>  Nothing picked yet. Pick spells with <ffa>maint <spell><faa>, see <ffa>maint-help<faa>.<088>};
    } {
        #var _mblock {};
        #foreach {$maint_order[%*]} {_mk} {#var _mstuck[$_mk] 0};
        #var _mrefused 0;
        #var maint_active 1;
        _maint_apply;
        #echo {<dea>---  MAINTENANCE ON  ---<088>};
        #ticker {maint_watch} {_maint_watch} {2};
        _maint_save;
        _maint_grid;
    };
};

#NOP -- Off clears every flag maint manages, a bots one only if it is picked;
#alias {_maint_off} {
    #foreach {$maint_order[%*]} {_mk} {
        #if {!$maint_spells[$_mk][bots] || "$maint_sel[$_mk]" == "1"} {
            #var defs[$maint_spells[$_mk][defs]] 0;
        };
    };
    #var maint_active 0;
    #unticker {maint_watch};
    _maint_save;
    #echo {<dea>---  MAINTENANCE OFF  ---<088>};
    #if {"%1" == "cleared"} {
        #echo {  <ccc>All picks cleared. Spells stay up until they drop, they are just not recast.<088>};
    } {
        #echo {  <ccc>Spells stay up until they drop, they are just not recast. Picks are kept.<088>};
    };
};

#NOP -- Safety net: while maint is on, maint_watch runs every 2s. A picked spell that stays down for 5 checks;
#NOP -- (about 10s) while the MUD keeps refusing casts (already have / conflicting) is blocked: maint stops;
#NOP -- recasting it and says so. Running out of SP is a different message, so that never blocks anything.;
#action {^You already have %*} {#var _mrefused 1} {8};
#action {^You are already protected by %*} {#var _mrefused 1} {8};
#action {^Another defensive spell is conflicting} {#var _mrefused 1} {8};
#NOP -- Out of SP is not a refusal: the spell it names (or the whole check, if no name matches) is not counted;
#action {^You do not have enough spell points to cast %*} {
    #NOP -- The name ends in . or ! so it matches when it starts with the spell name and is at most 1 longer;
    #format _mnosp_name {%l} {%1};
    #format _mnosp_len {%L} {$_mnosp_name};
    #var _mnosp_hit 0;
    #foreach {$maint_order[%*]} {_mk} {
        #format _mnosp_nm {%l} {$maint_spells[$_mk][name]};
        #format _mnosp_nl {%L} {$_mnosp_nm};
        #if {$_mnosp_len - $_mnosp_nl <= 1} {
            #regex {$_mnosp_name} {^$_mnosp_nm} {#var _mnosp[$_mk] 1;#var _mnosp_hit 1};
        };
    };
    #if {!$_mnosp_hit} {#var _mnosp_all 1};
} {8};
#var _mrefused 0;
#var _mnosp {};
#var _mnosp_all 0;
#var _mblock {};

#NOP -- Sets _mupnow to 1 when spell %1 shows as up;
#alias {_maint_isup} {
    #format _mupv {%d} {$my[defs][$maint_spells[%1][prot]]};
    #if {$_mupv > 0} {#var _mupnow 1} {#var _mupnow 0};
};

#alias {_maint_watch} {
    #if {!$maint_active} {
        #unticker {maint_watch};
    } {
        #foreach {$maint_order[%*]} {_mx} {
            _maint_isup $_mx;
            #if {"$maint_sel[$_mx]" == "1" && "$defs[$maint_spells[$_mx][defs]]" == "1" && !$_mupnow} {
                #if {$_mrefused && !$_mnosp_all && "$_mnosp[$_mx]" != "1"} {#math _mstuck[$_mx] {$_mstuck[$_mx] + 1}};
            } {
                #var _mstuck[$_mx] 0;
            };
            #if {$_mstuck[$_mx] >= 5} {
                #var _mstuck[$_mx] 0;
                #var _mblock[$_mx] 1;
                #var defs[$maint_spells[$_mx][defs]] 0;
                #echo {<faa>  maint: stopped recasting <fff>$maint_spells[$_mx][name]<faa>, the MUD keeps refusing it.<088>};
                #echo {<faa>  Another defense conflicts with it, or it is up but not on your hpbar. See <ffa>maint list<faa>.<088>};
            };
        };
        #var _mrefused 0;
        #var _mnosp {};
        #var _mnosp_all 0;
    };
};

#NOP -- Table of every spell: picked, kept up by the heartbeat (defs), and up on the MIP guild line (my[defs]);
#alias {_maint_list} {
    #echo {};
    #echo {<ccf>  ======================  BARD MAINT  ======================<088>};
    #echo {<fff>  Type   Spell                    Picked  Kept  Up    Variables<088>};
    #echo {<ccf>  -----  -----------------------  ------  ----  ----  ---------------------<088>};
    #foreach {$maint_order[%*]} {_mk} {
        #var _md $maint_spells[$_mk][defs];
        #var _mp $maint_spells[$_mk][prot];
        #if {"$maint_sel[$_mk]" == "1"} {#var _mpick {<afa>on    }} {#var _mpick {<888>off   }};
        #if {"$defs[$_md]" == "1"} {#var _mkept {<afa>yes }} {#var _mkept {<888>no  }};
        #if {"$_mblock[$_mk]" == "1"} {#var _mkept {<faa>stop}};
        #format _mv {%d} {$my[defs][$_mp]};
        #if {$_mv > 0} {
            #if {$_mv > 1} {#format _mup {%-4s} {$_mv}} {#var _mup {yes }};
            #var _mup {<afa>$_mup};
        } {
            #if {"$defs[$_md]" == "1"} {#var _mup {<faa>no  }} {#var _mup {<888>no  }};
        };
        #format _mrow {%-5s  %-23s} {$_mk} {$maint_spells[$_mk][name]};
        #format _mvars {defs[%s] my[defs][%s]} {$_md} {$_mp};
        #echo {  <ffa>$_mrow  $_mpick  $_mkept  $_mup  <888>$_mvars<088>};
    };
    #echo {<ccf>  ----------------------------------------------------------<088>};
    #if {$maint_active} {
        #echo {  <fff>Maint is <afa>ON<fff>. A red <faa>no<fff> under Up gets recast on the next heartbeat.<088>};
        #echo {  <fff>A red <faa>stop<fff> means the MUD kept refusing it. Pick it again or type <ffa>maint<fff> to retry.<088>};
    } {
        #echo {  <fff>Maint is <faa>OFF<fff>. Type <ffa>maint<fff> to keep the picked spells up.<088>};
    };
    #echo {  <fff>Up shows the rounds left when the guild line has them.<088>};
    #echo {  <fff>MIP guild line right now: <ccc>$mip[gline][1]<088>};
    #echo {};
};

#alias {maint} {
    #format _mcmd {%l} {%1};
    #var _mrest {};
    #regex {%0} {^\S+\s+{.*}$} {#var _mrest {&1}};
    #switch {"$_mcmd"} {
        #case {""} {_maint_on};
        #case {"on"} {_maint_on};
        #case {"off"} {_maint_off};
        #case {"add"} {_maint_pick {1} {$_mrest}};
        #case {"del"} {_maint_pick {0} {$_mrest}};
        #case {"remove"} {_maint_pick {0} {$_mrest}};
        #case {"all"} {
            #foreach {$maint_order[%*]} {_mk} {_maint_set $_mk 1};
            _maint_changed;
        };
        #case {"default"} {
            #NOP -- The usual set: replaces your picks with maint_default;
            #foreach {$maint_order[%*]} {_mk} {_maint_set $_mk 0};
            #foreach {$maint_default[%*]} {_mk} {_maint_set $_mk 1};
            _maint_changed;
        };
        #case {"clear"} {
            #foreach {$maint_order[%*]} {_mk} {_maint_set $_mk 0};
            _maint_save;
            _maint_off cleared;
        };
        #case {"list"} {_maint_list};
        #case {"check"} {_maint_list};
        #case {"status"} {_maint_list};
        #case {"help"} {maint-help};
        #default {_maint_pick {t} {%0}};
    };
};

#alias {maint-help} {
    #echo {};
    #echo {<ccf>  ===================  BARD MAINT HELP  ===================<088>};
    #echo {  <ffa>maint                 <fff>start keeping your picked spells up<088>};
    #echo {  <ffa>maint off             <fff>stop recasting (your picks are kept)<088>};
    #echo {  <ffa>maint <spell> ...     <fff>pick or unpick (toggles), e.g. <ffa>maint hs mb<088>};
    #echo {  <ffa>maint add <spell> ... <fff>pick<088>};
    #echo {  <ffa>maint del <spell> ... <fff>unpick<088>};
    #echo {  <ffa>maint all             <fff>pick every spell and song<088>};
    #echo {  <ffa>maint default         <fff>pick the usual set (replaces your picks)<088>};
    #echo {  <ffa>                      <888>every spell and song except Harmonic Regeneration<088>};
    #echo {  <ffa>maint clear           <fff>unpick everything and stop<088>};
    #echo {  <ffa>maint list            <fff>every spell: picked, kept up, up now, variables<088>};
    #echo {<ccf>  ---------------------------------------------------------<088>};
    #echo {  <fff>Spells and songs:<088>};
    #echo {    <ffa>mb     <ccc>Mind Blank              <ffa>hs     <ccc>Hardened Skin<088>};
    #echo {    <ffa>blink  <ccc>Blink                   <ffa>es     <ccc>Empowered Strikes<088>};
    #echo {    <ffa>pfe    <ccc>Protection from Evil    <ffa>pfg    <ccc>Protection from Good<088>};
    #echo {    <ffa>pfn    <ccc>Protection from Neutral <ffa>pfc    <ccc>Protection from Frost<088>};
    #echo {    <ffa>pfh    <ccc>Protection from Heat    <ffa>hr     <ccc>Harmonic Regeneration<088>};
    #echo {    <ffa>ag     <ccc>Amazing Grace (song)    <ffa>om     <ccc>O Muse (song)<088>};
    #echo {<ccf>  ---------------------------------------------------------<088>};
    #echo {  <fff>Fresh login, step by step<088>};
    #echo {  <ccc> <ffa>1.<ccc> Pick your spells once, e.g. <ffa>maint hs mb blink pfe ag<ccc>.<088>};
    #echo {  <ccc>    Picks save with <ffa>ld<ccc> (and the 10 minute autosave).<088>};
    #echo {  <ccc> <ffa>2.<ccc> Type <ffa>maint<ccc>. Any picked spell or song that is down gets<088>};
    #echo {  <ccc>    cast on the next heartbeat. You do not need <ffa>prots_*<ccc> first.<088>};
    #echo {  <ccc> After a relog or linkdead: just type <ffa>maint<ccc>.<088>};
    #echo {};
    #echo {  <fff>How it keeps them up<088>};
    #echo {  <ccc> Every heartbeat it recasts any picked one missing from your MIP<088>};
    #echo {  <ccc> guild line, and the fading messages recast most of them just<088>};
    #echo {  <ccc> before they drop. Evil, good and neutral can all be up at once.<088>};
    #echo {};
    #echo {  <ccc>Harmonic Regeneration is cast once a round when you have the SP.<088>};
    #echo {  <ccc>The hammer and rainbow bots turn it on and off themselves, so<088>};
    #echo {  <ccc>maint leaves it alone unless you pick it. Empowered Strikes waits<088>};
    #echo {  <ccc>for 400 karma. Nothing is recast while you are idle (deadman).<088>};
    #echo {<ccf>  =========================================================<088>};
    #echo {};
};

#NOP ---Song Buffs;
#alias {buffup} {
	#math buff_delay_1 {41*2};
	#math buff_delay_2 {79*2};
	#math buff_delay_3 {138*2};
	#math buff_delay_4 {160*2};

	perform son of man for %1;
	#delay $buff_delay_1 {perform memory for %1};
	#delay $buff_delay_2 {perform let it be for %1};
	#delay $buff_delay_3 {perform naked sunday for %1};
	#delay $buff_delay_4 {perform hero for %1};
}

#class {guild_aliases} {close}
