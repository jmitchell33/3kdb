#list repData indexate rep_key


#NOP -- Summary of all reps that moved, split by how the rep was earned.;
#NOP -- Combat Based means the rep landed on a kill.  Non-Combat Based is;
#NOP -- everything else, such as quests, turn-ins and donations.;
#alias {.reps} {
    #var repsGrandChange 0;
    #var repsGrandMoves 0;
    #var repsGrandRows 0;
    #echo {};
    #echo {<eed>  ===================               REPS SUMMARY               ===================};
    .reps_section {combat} {COMBAT BASED (on kill)};
    .reps_section {noncombat} {NON-COMBAT BASED};
    #if {$repsGrandRows == 0} {
        #echo {\n     <fdd>If you feel this is in error, input <efc>.check_reps start <fdd>to seed rep tracking.<088>};
    } {
        .reps_num {$repsGrandChange} {repsChangeStr};
        #if {$repsGrandMoves > 0} {
            #math {repsHundredths} {$repsGrandChange * 100 / $repsGrandMoves};
            .reps_avg {$repsHundredths} {repsAvgStr};
        } {
            #var repsAvgStr {-};
        };
        #echo {};
        #echo {<088>  ================================================================================};
        #format {repsLine} {  %-34s %+7s   %+7s %+8s %+7s %+10s} {GRAND TOTAL} {} {} {$repsChangeStr} {$repsGrandMoves} {$repsAvgStr};
        #echo {<cff>$repsLine<088>};
    };
    #echo {};
    #unvar repsGrandChange;
    #unvar repsGrandMoves;
    #unvar repsGrandRows;
    #unvar repsChangeStr;
    #unvar repsAvgStr;
    #unvar repsHundredths;
    #unvar repsLine;
};

#NOP -- arg 1 is the bucket, either combat or noncombat.  arg 2 is the heading.;
#alias {.reps_section} {
    #var repsBucket {%1};
    #var repsSecChange 0;
    #var repsSecMoves 0;
    #var repsSecRows 0;
    #echo {};
    #echo {<ffa>  -- %2 --<088>};
    #format {repsLine} {  %-34s %+7s   %+7s %+8s %+7s %+10s} {Faction} {Start} {Now} {Change} {Moves} {Per Move};
    #echo {<cff>$repsLine<088>};
    #echo {<088>  --------------------------------------------------------------------------------};
    #loop 1 &repData[] {repsIx} {
        #if {"$repsBucket" == "combat"} {
            #var repsChange $repData[$repsIx][combat_change];
            #var repsMoves $repData[$repsIx][combat_moves];
        } {
            #var repsChange $repData[$repsIx][noncombat_change];
            #var repsMoves $repData[$repsIx][noncombat_moves];
        };
        #if {$repsChange != 0 || $repsMoves > 0} {
            #math {repsSecChange} {$repsSecChange + $repsChange};
            #math {repsSecMoves} {$repsSecMoves + $repsMoves};
            #math {repsSecRows} {$repsSecRows + 1};
            .reps_num {$repsChange} {repsChangeStr};
            #if {$repsMoves > 0} {
                #math {repsHundredths} {$repsChange * 100 / $repsMoves};
                .reps_avg {$repsHundredths} {repsAvgStr};
            } {
                #var repsAvgStr {-};
            };
            #format tmpStartReps {%g} {$repData[$repsIx][start_value]};
            #format tmpNowReps {%g} {$repData[$repsIx][current_value]};
            #format {repsLine} {  %-34s %+7s   %+7s %+8s %+7s %+10s} {$repData[$repsIx][rep_key]} {$tmpStartReps} {$tmpNowReps} {$repsChangeStr} {$repsMoves} {$repsAvgStr};
            #if {$repsChange > 0} {
                #echo {<dfd>$repsLine<088>};
            } {
                #if {$repsChange < 0} {
                    #echo {<fab>$repsLine<088>};
                } {
                    #echo {<ccc>$repsLine<088>};
                };
            };
        };
    };
    #if {$repsSecRows == 0} {
        #echo {                           <fdd>No rep changes recorded.<088>};
    } {
        #echo {<088>  --------------------------------------------------------------------------------};
        .reps_num {$repsSecChange} {repsChangeStr};
        #if {$repsSecMoves > 0} {
            #math {repsHundredths} {$repsSecChange * 100 / $repsSecMoves};
            .reps_avg {$repsHundredths} {repsAvgStr};
        } {
            #var repsAvgStr {-};
        };
        #format {repsLine} {  %-34s %+7s   %+7s %+8s %+7s %+10s} {SUBTOTAL ($repsSecRows factions)} {} {} {$repsChangeStr} {$repsSecMoves} {$repsAvgStr};
        #echo {<cff>$repsLine<088>};
    };
    #math {repsGrandChange} {$repsGrandChange + $repsSecChange};
    #math {repsGrandMoves} {$repsGrandMoves + $repsSecMoves};
    #math {repsGrandRows} {$repsGrandRows + $repsSecRows};
    #unvar repsIx;
    #unvar repsBucket;
    #unvar repsSecChange;
    #unvar repsSecMoves;
    #unvar repsSecRows;
    #unvar repsChange;
    #unvar repsMoves;
    #unvar tmpStartReps;
    #unvar tmpNowReps;
} {2};

#NOP -- Add a plus sign in front of the rep if its a positive change;
#alias {.reps_num} {
    #if {%1 > 0} {
        #format {%2} {%g} {+%1};
    } {
        #format {%2} {%g} {%1};
    };
};

#NOP -- Average Function.  arg 1 is the value scaled by 100, arg 2 is the var name that holds the result;
#alias {.reps_avg} {
    #format {repsAvgRaw} {%d} {%1};
    #if {$repsAvgRaw < 0} {
        #var repsAvgSign {-};
        #math {repsAvgRaw} {0 - $repsAvgRaw};
    } {
        #var repsAvgSign {+};
    };
    #math {repsAvgWhole} {$repsAvgRaw * .01};
    #format {repsAvgWhole} {%d} {$repsAvgWhole};
    #math {repsAvgFrac} {$repsAvgRaw % 100};
    #format {repsAvgFrac} {%d} {$repsAvgFrac};
    #if {$repsAvgFrac < 10} {
        #var {%2} {$repsAvgSign$repsAvgWhole.0$repsAvgFrac};
    } {
        #var {%2} {$repsAvgSign$repsAvgWhole.$repsAvgFrac};
    };
    #unvar repsAvgRaw;
    #unvar repsAvgSign;
    #unvar repsAvgWhole;
    #unvar repsAvgFrac;
};


#class area_reps close;