#class common_config kill;
#class common_config open;

#SESSION {3k - $user} {3k.org} {3000};

#config {packet patch} 1;
#config {color} on;
#config {repeat enter} on;
#config log plain;
#config connect_retry 60;

#info env save;
#info system save;

#var cwd $info[SYSTEM][CWD];
#format user_cap {%n} $user;

#NOP -- Ticker to set incombat variable;
#ticker check_combat {
    #NOP -- No combat round from MIP yet (just logged in, no fight so far) means not in combat;
    #if {&mip[round]} {
        #if {$mip[round] == $incombat_last_round || $mip[round] == 0} {
            #var incombat 0
        } {
            #var incombat 1;
            #var bot[walk] 0;
        };
    } {
        #var incombat 0;
        #var bot[walk] 0;
    };
    #var incombat_last_round $mip[round];
} {4};

#NOP -- In general...if you're idle >4 minutes gxp cuts off;
#NOP -- so this ticker will send a "non-command" to the mud if you're in combat and not deadman;
#ticker {noise} {#if {$incombat && !$idle_flag} {#cr}} {240};

#NOP -- Load variables from last session and reset all the things;
#alias {defaults_on} {
    #echo {<fff> CONNECTED TO 3KDB -- UPDATING SCREEN IN 3 seconds...};
    _variable_import;
    .sessionlog_login;
    .roundlog_login;
    _init_deadman;
	mipon;
    #read common/draw.tin;
    loadmap;
    postload;
	i;
    examine cooler;
    #NOP -- Hidden score fills my[score] (and the guild level for toggle rounds), modules/score;
    #delay {score_login} {.score_quiet} {3};
    touch diamond rune;
    #send {(powers};
    
    .update_gags;
    init_screen;
    draw_all;
    _mob_status_clear;
    reset_trackers;

    #if {"$eternal" == "1"} {_update_eternal_gxp init};
    #NOP -- Gag the few things this checks if it's not there for spam;
    #line oneshot #gag {^That is not here or it is uninteresting. (cooler?)};
    #line oneshot #gag {^You find nothing of interest.};
    #line oneshot #gag {^Perform touch at whom?};
    #line oneshot #gag {^There is no reason to '(powers' here.};
    #line oneshot #gag {^There is no reason to 'spellDmg-clear' here.};
    #line oneshot #gag {^There is no reason to 'summonDmg-clear' here.};

    #NOP -- Set reps starting values;
    .check_reps start;


    #NOP -- Some files don't seem to read in changes always, read these in again just because;
    #read common/themes.tin;
    #read common/3kReport.tin;

    #NOP -- Get boot number;
    _get_boot;
};

#alias {reset_trackers} {
    istats_reset;
    reset_xp;
    #NOP -- Only while the damage tracker is loaded (it sets dmgtracker in its class), or dreset goes to the game;
    #if {&dmgtracker} {dreset};
    #if {"$guild" == "juggernaut"} {
        mountDmg-clear;
        truckDmg-clear;
        supportDmg-clear;
    };
    #if {"$guild" == "mage"} {
        spellDmg-clear;
        summonDmg-clear;
    };
};

#ALIAS {postload}
{
     #map flag static on;
     #map flag vtmap on;
     #map flag unicodegraphics on;
     #map flag terrain on;
     #map flag direction on;
     #delay {1} {hp};
     #delay {6} {_area_speedruns;_area_bots;3kdb_banner};
     #NOP -- The end of the who2 list shows the dblog notice, once per login (common/dblog.tin);
     #var dblog_login_pending 1;
     #delay {10} {_update_players};
     #NOP -- Necromancer: repower a couple of seconds after who2 so the hpbar picks up repower status;
     #delay {12} {#if {"$guild" == "necromancer"} {#send {repower}}};
};

#alias {load_guild} {
    #class guild_%* kill;
    #read common/guilds/${guild}/index.tin;
};

#alias setup_3kdb {
    #echo {Type 'setup_3kdb_hpbar' to configure your guild hpbar.  If this alias exists, it will setup your guild hpbar to provide information to 3kdb.};
        #echo {If it doesn't exist, please contact your local 3kdb dealer.};
    forcehp;
    notify on;
    init_screen;
    #send {aset look_monster_pref -M-_};
    #send {aset look_monster_suff};
	#send {aset look_player -P-_};
	#send {aset room_short_pref -R-_};
	#send {aset room_short_suff -R-_};
	#send {aset room_exits_pref -X-_};
	#send {aset room_exits_suff -X-_};
	#send {aset room_long_pref -D-_};
	#send {aset room_long_suff -D-_};
	#send {aset look_weapon -w-};
	#send {aset look_object -o-};
	#send {aset look_armor -a-};
	#send {aset look_armour -a-};
	#send {aset look_other -i-};
	#send {aset world_drop_pref -!!!-};
    #send {aset say};
    #send {aset say hicyan};
	#send {prompt >$nl$};
    #line oneshot #action {^You will no longer see the HP bar on the main screen.$} {forcehp};
    #line oneshot #action {^Notify off for all.$} {notify on};
    mka-on;
    mka-clear;

    #NOP -- Read some files that need to be read in once for some reason;
    #read common/themes.tin;
    #read common/3kReport.tin;
	#echo {Setup successful!};
};

#NOP -- Welcome banner with info and updates;
#alias 3kdb_banner {
    #unvar db3k[banner];
    #list db3k[banner] add {<dfc>   ---------   WELCOME TO 3kdb   ---------<088>  };
    #list db3k[banner] add {<ddd>      If this is your first time, type <ffd>setup_3kdb<088>};
    #list db3k[banner] add {<ddd>      <ffd>dblib<088> to see a list of aliases <088>};
    #list db3k[banner] add {<ddd>      <ffd>mapgo cot<088> to set your position to Center of Town (cot) <088>};
    #list db3k[banner] add {<ddd>       Be sure to check out <ffd>botlist<ddd>, <ffd>speedruns<ddd>, and <ffd>strategies<088>};
    #draw $theme[chatbox] lalign ralign left right side 2 1 $chat[height]-1 $chat[right] $db3k[banner][1..5];
};

#NOP -- Get online players and monitor as they fall off/on with notify;
#alias _update_players {
    #send {who2};
    #var players {};
    #class tmp open;
    #unvar tmpList;
    #action {^%+1..d%s %*} {
        #cat tmpList {%%3};
        #replace tmpList {A ghostly form} {};
    };
    #class tmp close;
    #line oneshot #action {This list is sorted by level, type: who2 <xp/age>} {
        #list tmpList explode { };
        #list tmpList filter {} {%d};
        #list tmpList filter {} {%w@3s};
        #var players $tmpList;
        #unvar tmpList;
        #class tmp kill;
        #if {&players > 0} {#echo {<ffd>3kdb -- Successfully updated players list with &players[] players added.}};
        dblog_after_who2;
    };
};

#NOP -- Add players to online tracking;
#action {^[%w reconnects]$} {
    #list players add {%1};
} {2};
#action {^[%w enters the game]$} {
    #list players add {%1};
} {2};

#NOP -- Remove players from online tracking;
#action {^[%w disconnects]$} {
    #unvar tmpItem;
    #if {&players[] > 0} {
        #list players find %1 tmpItem;
        #if {$tmpItem} {#list players delete $tmpItem};
    };
} {2};
#action {^[%w leaves the game]$} {
    #unvar tmpItem;
    #if {&players > 0} {
        #list players find %1 tmpItem;
        #if {$tmpItem} {#list players delete $tmpItem};
    };
} {2};


#NOP -- Alias to load common/guilds/character-specific files;
#alias {_load_3kdb_common} {
    #NOP -- Load previous sessions variables;
    #read chars/$user/vars.tin;
    #NOP -- the title screen's unpause exit back on your last Section Z pause (common/areas/sectionz.tin);
    .sz_relink;

    #NOP -- Load Common;
    #read common/bot/bots.tin;
    #read modules/helpers/helpers.tin;
    #read modules/corpsemanager/corpsemanager.tin;

    #NOP -- Load Guilds;
    #read common/guilds/$guild/index.tin;
    #read common/guilds/eternal/eternal.tin;

    #NOP -- Load Character specific;
    #read chars/$user/actions.tin;
    #read chars/$user/aliases.tin;
    #read chars/$user/config.tin;
    #read chars/$user/heartbeat.tin;
    #read chars/$user/miphp.tin;
    #read chars/$user/private.tin;
    #read chars/$user/tickers.tin;

    #NOP -- Load Profession;
    _load_profession;
};

#NOP -- Choose which profession to load;
#alias {_load_profession} {
    #class tmp_profession open;
    #action {Profession #1 : Transmuter%s\(Level%s%d\)%*} {
        #read modules/professions/transmuter.tin;
        #var transmuter[level] %%3;
        #var major_prof transmuter;
    } {1};

    #action {Profession #1 : Reforger%s\(Level%s%d\)%*} {
        #read modules/professions/reforger.tin;
        #var reforger[level] %%3;
        #var major_prof reforger;
    } {1};

    #action {Profession #1 : Golem Master%s\(Level%s%d\)%*} {
        #read modules/professions/golem_master.tin;
        #var golem_master[level] %%3;
        #var major_prof golem_master;
    } {1};

    #action {Profession #1 : Marshal%s\(Level%s%d\)%s\[%*\]} {
        #read modules/professions/marshal.tin;
        #var marshal[level] %%3;
        #var major_prof marshal;
    } {1};

    #action {Profession #1 : Herbologist%s\(Level%s%d\)%s\[%*\]} {
        #read modules/professions/herbologist.tin;
        #var herbologist[level] %%3;
        #var major_prof herbologist;
    } {1};

    #action {Profession #1 : Trapper%s\(Level%s%d\)%*} {
        #read modules/professions/trapper.tin;
        #var trapper[level] %%3;
        #var major_prof trapper;
    } {1};
    #class tmp_profession close;

    #send {profs};
    #delay 3 {#class tmp_profession kill};
};

#NOP -- Auto defaults_on - the primary reason for turning this off is to debug things since the mip;
#NOP -- scripts are so spammy;
#var sessionActive 0;
#action {^3Kingdoms welcomes you!} {
    #var sessionActive 1;
    #if {"$menu_refresh_on" == "1"} {#return};
    #var login_linkdeath 0;
    _load_3kdb_common;
    defaults_on;
    .numbers_login_check;
    #delay 1 {#map goto 6220};
} {1};
#NOP -- login_linkdeath tells guild files (e.g. maint) this is a return from linkdeath, spells still up;
#action {^3Kingdoms welcomes you back from linkdeath.} {
    #var sessionActive 1;
    #if {"$menu_refresh_on" == "1"} {#return};
    #var login_linkdeath 1;
    _load_3kdb_common;
    defaults_on;
    .numbers_login_check;
    look;
    #delay 1 {
        #if {"$room[name]" == "Entrance Building to Pinnacle (jump)"} {
            #map goto 6220;
        };
    };
} {1};

#NOP -- If numbers are detected, read in the damage tracker. With toggle numbers off it stays armed;
#NOP -- but does nothing, so turning the toggle back on picks the perk up on the next hit;
#alias {.numbers_detect_arm}
{
    #act {{^You hit (.*) (\d+) (time|times) for (\d+) damage\.$}} {
        .numbers_detected;
    } {2};
};

#alias {.numbers_detected}
{
    .numbers_auto_on;
    #if {"$toggles[numbers]" == "0"}
    {
        #return;
    };
    #unact {{^You hit (.*) (\d+) (time|times) for (\d+) damage\.$}};
    #var vaf[numbers] 1;
    #var numbersPerk 1;
    #read modules/dmgtracker/dmgtracker.tin;
    #if {"$guild" == "mage"} {
        #read modules/dmgtracker/dmgtracker_mage.tin;
    };
    #if {"$guild" == "juggernaut"} {
        #read modules/dmgtracker/dmgtracker_jugger.tin;
    };
    istats_reset;
};

#NOP -- numbersPerk: 1 has the perk, 0 doesn't, unset not checked yet;
#NOP -- Fresh and linkdeath logins: ask the game with numbers and hide its answer. Only during this check, a numbers;
#NOP -- the player types later always shows. A hit line also finds the perk if the check gets no answer;
#alias {.numbers_login_check}
{
    #unvar numbersPerk;
    #class numbers_check kill;
    #class numbers_check open;
    #action {^You do not have the 'numbers' vaf perk.  See 'vaf list numbers'$}
    {
        #line gag;
        #var numbersPerk 0;
        #var vaf[numbers] 0;
        .numbers_auto_off;
        .numbers_check_done;
    };
    #action {^You have the 'numbers' vaf perk active.  You can turn off totals by$}
    {
        #line gag;
        #var numbersPerk 1;
        .numbers_check_active;
    };
    #action {^typing 'numbers totals' (and rely on your guild object to show you)$}
    {
        #line gag;
    };
    #action {^and you can turn them off all together with 'numbers off'$}
    {
        #line gag;
        .numbers_check_done;
    };
    #class numbers_check close;
    #NOP -- The answer to numbers off sent for toggle numbers off is hidden by the action further down;
    #var numbersChecking 1;
    #delay {numbers_check} {.numbers_check_done} {15};
    #send {numbers};
};

#NOP -- The perk is on in the game. Toggle numbers on: load the trackers now. Off: turn it off in the game;
#alias {.numbers_check_active}
{
    .numbers_auto_on;
    #if {"$toggles[numbers]" == "0"}
    {
        #send {numbers off};
        #return;
    };
    #if {&dmgtracker}
    {
        #return;
    };
    .numbers_detected;
};

#NOP -- numbersAutoOff 1: 3kdb turned toggle numbers off because you don't have the perk (saved in vars.tin);
#NOP -- Once the perk shows up (login check, a damage line or numbers on), it turns itself back on;
#alias {.numbers_auto_off}
{
    #if {"$toggles[numbers]" == "0"}
    {
        #return;
    };
    #var toggles[numbers] 0;
    #var numbersAutoOff 1;
    .kill_dmg_trackers;
    #var enemy[name_numbers] {};
    #echo {<faa>   -----  numbers has been turned off, you don't have the numbers vaf perk  -----<088>};
};

#alias {.numbers_auto_on}
{
    #if {"$numbersAutoOff" != "1"}
    {
        #return;
    };
    #unvar numbersAutoOff;
    #if {"$toggles[numbers]" != "0"}
    {
        #return;
    };
    #var toggles[numbers] 1;
    #echo {<cfb>   -----  numbers has been turned on, the numbers vaf perk was found  -----<088>};
};

#NOP -- The answer is in, or 15 seconds went by: stop hiding numbers lines. Wait a moment for numbers off's answer;
#alias {.numbers_check_done}
{
    #undelay {numbers_check};
    #delay {numbers_check_end}
    {
        #class numbers_check kill;
        #var numbersChecking 0;
    } {3};
};

#NOP -- toggle numbers off: back to how 3kdb runs without the perk, and off in the game too if you have it;
#NOP -- .numbers_off quiet: the game turned it off already (you typed numbers off), don't send it again;
#alias {.numbers_off}
{
    #if {"%1" != "quiet" && ("$numbersPerk" == "1" || "$vaf[numbers]" == "1")}
    {
        #var numbersPerk 1;
        #send {numbers off};
    };
    .kill_dmg_trackers;
    #var vaf[numbers] 0;
    #var enemy[name_numbers] {};
    .numbers_detect_arm;
};

#NOP -- toggle numbers on: on in the game too if you have it and load the trackers. Not checked yet: watch;
#NOP -- for the next hit line. Not while the damage tracker is loaded, it owns that action. quiet: the game did it already;
#alias {.numbers_on}
{
    #if {"$numbersPerk" == "0"}
    {
        #echo {<faa>   -----  You don't have the numbers vaf perk, see 'vaf list numbers'  -----<088>};
        .numbers_auto_off;
        #return;
    };
    #if {"%1" != "quiet" && "$numbersPerk" == "1"}
    {
        #send {numbers on};
    };
    #if {&dmgtracker}
    {
        #return;
    };
    .numbers_detect_arm;
    #if {"$numbersPerk" == "1"}
    {
        .numbers_detected;
    };
};

#NOP -- You typed numbers on/off in the game: toggle numbers follows. Only hidden during the login check;
#var numbersChecking 0;
#action {^Numbers are now off.$}
{
    #if {$numbersChecking}
    {
        #line gag;
    };
    #var numbersPerk 1;
    #unvar numbersAutoOff;
    #if {"$toggles[numbers]" != "0"}
    {
        #var toggles[numbers] 0;
        #echo {<faa>   -----  numbers has been turned off (3kdb follows the game)  -----<088>};
        .numbers_off quiet;
    };
} {5};
#action {^Numbers are now on.$}
{
    #var numbersPerk 1;
    .numbers_auto_on;
    #if {"$toggles[numbers]" == "0"}
    {
        #var toggles[numbers] 1;
        #echo {<cfb>   -----  numbers has been turned on (3kdb follows the game)  -----<088>};
        .numbers_on quiet;
    };
} {5};

#NOP -- numbers-info: what 3kdb knows about the numbers perk right now;
#alias {numbers-info}
{
    #if {"$toggles[numbers]" == "0"}
    {
        #echo {<faa>   toggle numbers: off. 3kdb acts like you don't have the perk<088>};
    };
    #else
    {
        #echo {<cfb>   toggle numbers: on<088>};
    };
    #if {"$numbersPerk" == "0"}
    {
        #echo {<faa>   Perk: you don't have it (checked at login), see 'vaf list numbers'<088>};
    };
    #elseif {"$vaf[numbers]" == "1"}
    {
        #echo {<cfb>   Perk: found, 3kdb aims at mobs by the name in your damage lines<088>};
    };
    #elseif {"$toggles[numbers]" == "0"}
    {
        #echo {<fff>   Perk: not used while the toggle is off<088>};
    };
    #elseif {"$numbersPerk" == "1"}
    {
        #echo {<cfb>   Perk: you have it<088>};
    };
    #else
    {
        #echo {<fff>   Perk: not seen yet. 3kdb finds it from your first 'You hit ... for N damage.' line<088>};
    };
    #if {&dmgtracker}
    {
        #echo {<cfb>   Damage tracker: loaded, see dstats<088>};
    };
    #else
    {
        #echo {<fff>   Damage tracker: not loaded<088>};
    };
    #echo {<cfc>   Type <eaf>toggle numbers<cfc> to turn it on or off. It sends numbers on/off to the game too<088>};
};

.numbers_detect_arm;


#class common_config close;