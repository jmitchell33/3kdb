#class {common_toggles} {kill};
#class {common_toggles} {open};

#NOP -- Generic toggle switch;
#var toggleResetPending 0;
#NOP -- The defaults, before a player changes anything. Login fills in what's missing, toggle-reset goes back to them;
#var toggleDefaults {
    {3kreport} {1}
    {artifacts} {0}
    {capsules} {0}
    {capsules_green} {0}
    {chatlog_says} {1}
    {corpse_echo} {0}
    {cult} {0}
    {discord_post} {0}
    {dog_care} {0}
    {emote_corpse} {1}
    {emote_dungeon_clear} {1}
    {emote_eheal} {1}
    {emote_follow} {1}
    {emote_heal} {1}
    {emote_rally} {1}
    {farsight_ctell} {0}
    {farsight_notify} {0}
    {fracture_ctell} {0}
    {fracture_notify} {0}
    {go_echo} {1}
    {hidemap} {0}
    {map_follow} {1}
    {map_vnum} {0}
    {mission} {0}
    {portal_ctell} {0}
    {portal_notify} {0}
    {teleport} {1}
    {worlddrops} {0}
    {worlddrops2} {0}
    {worlddrops_notify} {1}
};

#NOP -- Same, but only for that guild;
#var toggleDefaultsGuild {
    {necromancer} {
        {circle_tracker} {0}
        {emote_aid} {1}
        {recover_parser_off} {0}
    }
};

#delay 6 {
    #foreach *toggleDefaults[] toggleKey {
        #if {"$toggles[$toggleKey]" == ""} {#var toggles[$toggleKey] $toggleDefaults[$toggleKey]};
    };
    #foreach *toggleDefaultsGuild[$guild][] toggleKey {
        #if {"$toggles[$toggleKey]" == ""} {#var toggles[$toggleKey] $toggleDefaultsGuild[$guild][$toggleKey]};
    };
    #NOP -- bothportals_notify/bothportals_ctell were removed, drop them from saved toggles;
    #unvar toggles[bothportals_notify];
    #unvar toggles[bothportals_ctell];
    #var discordPost $toggles[discord_post];
};


#NOP -- What each toggle does, shown in toggle-list;
#var toggleDesc {
    {artifacts} {Grabs guild artifacts off the floor (not in Pinnacle) and puts them in your chat window and Discord}
    {3kreport} {Eternals: checks (cstats after a kill for the kill report}
    {capsules} {Section Z: swallows another blue or orange capsule when one wears off}
    {capsules_green} {Section Z: swallows another green capsule when one wears off}
    {chatlog_says} {Puts people's says in your chat log}
    {circle_tracker} {Necros: sends gs (hidden) each combat round and adds a Next Circle % line to the hpbar. Details with circle_tracker. Won't work at tier I and above}
    {corpse_echo} {Tells you when a corpse comes out of your bag, coffin or freezer}
    {cult} {Jumps into the next cult game by itself}
    {discord_post} {Sends your chat over to Discord}
    {dog_care} {Looks after your dog: feeds and pets it, digs in each new room. Vets also heal it when it's low and incite it at full vet commands}
    {emote_aid} {Necros: someone clubs you like a baby seal, you aid them}
    {emote_corpse} {Someone says 'Greetings, Comrade!' to you, you hand them corpses}
    {emote_dungeon_clear} {Someone does the alien emote at you, you run dungeons clear all}
    {emote_eheal} {Someone gives you the Anti-Christ pose, you (heal them}
    {emote_follow} {Someone taps your shoulder, you follow and assist them}
    {emote_heal} {Someone gives you the Jesus Christ pose, you hmheal them}
    {emote_rally} {Someone offers you a toke, you rally them}
    {farsight_ctell} {Eternals: farsight_notify, and ctells your clan too}
    {farsight_notify} {Eternals: NOTE in your chat window (and Discord) when a mob you can see resets}
    {fremen} {Fremen hold/stun/enfeeble flags, the bot flips these itself}
    {fracture_ctell} {Zodiacs: fracture_notify, and ctells your clan too}
    {fracture_notify} {Zodiacs: NOTE in your chat window (and Discord) when timecheck shows a fracture (grimoire) hour}
    {go_echo} {Says 'here we go!' when go finds the room}
    {hidemap} {Hides the map to give its space to the side panel. go and bots still work}
    {map_vnum} {Shows the room number in the bottom right corner of the map}
    {map_follow} {While you follow someone, moves your map with you each time they lead you to another room}
    {mission} {Asks for a mission when you find a mission giver}
    {portal_ctell} {Zodiacs: portal_notify, and ctells your clan too}
    {portal_notify} {Zodiacs: NOTE in your chat window (and Discord) when timecheck shows a portal (tome) hour}
    {recover_parser_off} {Necros: recover also sends parser off}
    {sessionlog} {Saves everything you see to a log file, one per day}
    {teleport} {Pulls the rope when someone offers you a teleport}
    {worlddrops} {Pauses the bot when a world drop shows up}
    {worlddrops2} {Grabs world drops right away, even off the floor. Doesn't check your bags or pause the bot}
    {worlddrops_notify} {Puts a NOTE in your chat window when you find a world drop}
};

#NOP -- Fremen also have a toggle guildside, which needs to be able to bypass;
#list {fremenToggleList} {create} {fblock} {audible} {litany} {quasibrief} {showdodge};

#alias {toggle} {
    #format toggle_var {%l} {%0};
    #format toggle_var {%p} {$toggle_var};
    #var fremen_toggle 0;
    #if {"$toggle_var" != ""} {#list {fremenToggleList} {find} {$toggle_var} {fremen_toggle}};
    #if {"$toggle_var" == ""} {
        #echo {<ffe>   -----  No toggle provided.  Use 'toggle-list' to see available options.  -----<088>};
        #if {"$guild" == "fremen"} {
            #echo {  <ffe> Fremen toggles (these are mudside) are below and will bypass the 3kdb commands};
            #send {toggle};
        };
    } {
        #if {!$fremen_toggle} {
            #if {"$toggles[$toggle_var]" == ""} {
                #echo {<ffe>   -----  $toggle_var not found in toggles  -----<088>};
            } {
                #if $toggles[$toggle_var] {
                    #var toggles[$toggle_var] 0;
                    #echo {<faa>   -----  $toggle_var has been turned off -----<088>};
                } {
                    #var toggles[$toggle_var] 1;
                    #echo {<cfb>   -----  $toggle_var has been turned on -----<088>};
                };
                .toggleChanged {$toggle_var};
            };
        } {
            #send {!toggle $toggle_var};
        };
    };
};

#NOP -- .toggleChanged <toggle>: anything that has to happen when this toggle changes;
#alias {.toggleChanged} {
    #if {"%1" == "discord_post"} {#var discordPost $toggles[discord_post]};
    #if {"%1" == "map_vnum"} {init_map};
    #if {"%1" == "hidemap"}
    {
        .map_visibility;
    };
    #if {"%1" == "sessionlog"} {#if $toggles[sessionlog] {.sessionlog_start} {sessionlog off}};
    #if {"%1" == "worlddrops2"} {.worlddrops2_watch};
    #if {"%1" == "artifacts"} {.artifacts_watch};
    #if {"%1" == "circle_tracker" && "$guild" == "necromancer"} {.circle_tracker_toggled};
};

#NOP -- toggle-reset lists what would change and asks first. toggle-reset confirm does it, within 30 seconds;
#alias {toggle-reset} {
    #if {"%1" == "confirm"} {
        #if {!$toggleResetPending} {
            #echo {<faa>   -----  Nothing to confirm. Type toggle-reset first  -----<088>};
            #return;
        };
        #var toggleResetPending 0;
        #undelay {toggleResetTimeout};
        #var toggleResetApply 1;
        .toggleResetWalk;
        #echo {<cfb>   -----  $toggleResetCount toggle(s) set back to default  -----<088>};
        #return;
    };
    #var toggleResetApply 0;
    .toggleResetWalk;
    #if {$toggleResetCount == 0} {
        #var toggleResetPending 0;
        #undelay {toggleResetTimeout};
        #echo {<cfb>   -----  All toggles are already at their defaults  -----<088>};
        #return;
    };
    #var toggleResetPending 1;
    #echo {<ffa>   -----  Type <eaf>toggle-reset confirm<ffa> within 30 seconds to change these $toggleResetCount toggle(s)  -----<088>};
    #delay {toggleResetTimeout} {
        #var toggleResetPending 0;
        #echo {<faa>   -----  toggle-reset cancelled, nothing changed  -----<088>};
    } {30};
};

#NOP -- Goes through every toggle. Another guild's toggles only count if they're there. The fremen flags are;
#NOP -- left alone, the bot flips those. sessionlog's default lives in modules/sessionlog/sessionlog.tin;
#alias {.toggleResetWalk} {
    #var toggleResetCount 0;
    #foreach *toggleDefaults[] toggleKey {
        .toggleResetOne {$toggleKey} {$toggleDefaults[$toggleKey]};
    };
    #foreach *toggleDefaultsGuild[] toggleGuild {
        #foreach *toggleDefaultsGuild[$toggleGuild][] toggleKey {
            #if {"$toggleGuild" == "$guild" || "$toggles[$toggleKey]" != ""} {
                .toggleResetOne {$toggleKey} {$toggleDefaultsGuild[$toggleGuild][$toggleKey]};
            };
        };
    };
    #if {"$toggles[sessionlog]" != ""} {
        .toggleResetOne {sessionlog} {$sessionlog[enabled]};
    };
};

#NOP -- .toggleResetOne <toggle> <default>: toggleResetApply 0 only says what would change;
#alias {.toggleResetOne} {
    #if {"$toggles[%1]" != "%2"} {
        #math toggleResetCount {$toggleResetCount + 1};
        #if {!$toggleResetApply} {
            #if {%2} {
                #echo {<fff>   %1 would turn on<088>};
            } {
                #echo {<fff>   %1 would turn off<088>};
            };
        } {
            #var toggles[%1] %2;
            #if {%2} {
                #echo {<cfb>   -----  %1 has been turned on -----<088>};
            } {
                #echo {<faa>   -----  %1 has been turned off -----<088>};
            };
            .toggleChanged {%1};
        };
    };
};

#NOP -- toggle-list <word>: on or off lists by status, anything else matches part of a name or description;
#alias {toggle-list} {
    #format tmpFilter {%l} {%0};
    #format tmpFilter {%p} {$tmpFilter};
    #var tmpShown 0;
    #echo {<cfb>   ---++---       3kdb Current Toggle Status      ---++---<088>};
    #format tmpLine {        %-21s%-8s%s} {Toggle Alias} {Status} {What it does};
    #echo {<fdc>$tmpLine<088>};
    #NOP -- Descriptions start at column 37 and wrap at the edge of the output area (not under the map), so a long one stays in its column;
    #screen get cols tmpCols;
    #if {&screen[width] && &split[right]} {
        #math tmpCols {$screen[width] - $split[left] - $split[right]};
    };
    #if {"$tmpCols" == ""} {#var tmpCols 80};
    #math tmpDescWidth {$tmpCols - 38};
    #if {$tmpDescWidth < 20} {#var tmpDescWidth 20};
    #format tmpDescPad {%+37s} {};
    #foreach *toggles[] item {
        .toggleListMatch {$item};
        #if {$tmpMatch} {
            #math tmpShown {$tmpShown + 1};
            #if {$toggles[$item]} {
                #format tmpLine {        %-21s%-8s} {$item} {on};
                #var tmpLine {<dfc>$tmpLine};
            } {
                #format tmpLine {        %-21s%-8s} {$item} {off};
                #var tmpLine {<fbb>$tmpLine};
            };
            .toggleListDesc {$toggleDesc[$item]};
        };
    };
    #if {$tmpShown == 0} {
        #echo {<faa>        No toggles match '$tmpFilter'<088>};
    };
    #echo {<cfb>   ---++---        ---++---        ---++---       ---++---<088>};
    #echo {<fff>       Usage: toggle <toggle alias> <088>};
    #echo {<cfc>       Filter: toggle-list <word><088>};
    #echo {<cfc>       Part of a name or description: <eaf>toggle-list notify<cfc>, <eaf>toggle-list necro<088>};
    #echo {<cfc>       By status: <eaf>toggle-list on<cfc>, <eaf>toggle-list off<088>};
    #echo {<cfc>       Back to defaults: <eaf>toggle-reset<cfc> sets every toggle back to how it started (asks first)<088>};
};

#NOP -- .toggleListMatch <toggle>: set tmpMatch to 1 if the toggle passes tmpFilter;
#alias {.toggleListMatch} {
    #var tmpMatch 0;
    #if {"$tmpFilter" == ""} {
        #var tmpMatch 1;
    };
    #elseif {"$tmpFilter" == "on"} {
        #var tmpMatch $toggles[%1];
    };
    #elseif {"$tmpFilter" == "off"} {
        #if {!$toggles[%1]} {
            #var tmpMatch 1;
        };
    };
    #else {
        #format tmpMatchText {%l} {%1 $toggleDesc[%1]};
        #regex {$tmpMatchText} {$tmpFilter} {
            #var tmpMatch 1;
        };
    };
};

#NOP -- .toggleListDesc <text>: echo tmpLine with the text after it, word-wrapped to tmpDescWidth. Wrapped lines start with tmpDescPad;
#alias {.toggleListDesc} {
    #var tmpDescWords {%1};
    #replace tmpDescWords { } {;};
    #var tmpDescOut {};
    #foreach {$tmpDescWords} {tmpWord} {
        #if {"$tmpDescOut" == ""} {
            #var tmpDescOut {$tmpWord};
        } {
            #format tmpDescLen {%L} {$tmpDescOut $tmpWord};
            #if {$tmpDescLen > $tmpDescWidth} {
                #echo {$tmpLine<ddd>$tmpDescOut<088>};
                #var tmpLine {$tmpDescPad};
                #var tmpDescOut {$tmpWord};
            } {
                #var tmpDescOut {$tmpDescOut $tmpWord};
            };
        };
    };
    #echo {$tmpLine<ddd>$tmpDescOut<088>};
};

#class {common_toggles} {close};
