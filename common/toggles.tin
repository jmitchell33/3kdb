#class {common_toggles} {kill};
#class {common_toggles} {open};

#NOP -- Generic toggle switch;
#delay 6 {
    #if {"${toggles[mission]}" == ""} {#var toggles[mission] 0};
    #if {"${toggles[3kreport]}" == ""} {#var toggles[3kreport] 1};
    #if {"${toggles[worlddrops]}" == ""} {#var toggles[worlddrops] 0};
    #if {"${toggles[chatlog_says]}" == ""} {#var toggles[chatlog_says] 1};
    #if {"${toggles[cult]}" == ""} {#var toggles[cult] 0};
    #if {"${toggles[corpse_echo]}" == ""} {#var toggles[corpse_echo] 0};
    #if {"${toggles[emote_follow]}" == ""} {#var toggles[emote_follow] 1};
    #if {"${toggles[emote_heal]}" == ""} {#var toggles[emote_heal] 1};
    #if {"${toggles[emote_eheal]}" == ""} {#var toggles[emote_eheal] 1};
    #if {"${toggles[emote_rally]}" == ""} {#var toggles[emote_rally] 1};
    #if {"${toggles[emote_corpse]}" == ""} {#var toggles[emote_corpse] 1};
    #if {"${toggles[emote_dungeon_clear]}" == ""} {#var toggles[emote_dungeon_clear] 1};
    #if {"${toggles[farsight_notify]}" == ""} {#var toggles[farsight_notify] 0};
    #if {"${toggles[teleport]}" == ""} {#var toggles[teleport] 1};

    #if {"$guild" == "necromancer"} {
        #if {"${toggles[emote_aid]}" == ""} {#var toggles[emote_aid] 1};
    };

    #if {"${toggles[go_echo]}" == ""} {#var toggles[go_echo] 1};
    #if {"${toggles[discord_post]}" == ""} {#var toggles[discord_post] 0};
    #var discordPost $toggles[discord_post];
};


#NOP -- Toggles kept in their own variables by older on/off commands. toggle <name> flips these too,;
#NOP -- toggle-list shows them and _variable_export saves them. Fields: var (holds 0/1), also (another;
#NOP -- variable kept equal), on/off (run after switching), login (run when restored on), nosave (not saved);
#var toggleMap {
    {autocollect} {{var}{collector[items]}}
    {beep} {{var}{beepon}}
    {chatlog_emotes} {{var}{chat[log][emotes]}}
    {corpsetrig} {{var}{corpsetrigStatus}}
    {corpsetrig_kb} {{var}{corpsetrigKB}}
    {mka} {{var}{mkaStatus}{also}{mob_kill_action}}
    {mouse} {{var}{mouseActive}{on}{#config mouse on}{off}{#config mouse off}{login}{#config mouse on}}
    {aoe} {{var}{aoe_enabled}{on}{aoeon}{off}{aoeoff}}
    {playercheck} {{var}{bot[playercheck]}{nosave}{1}{on}{_update_caption_data}{off}{_update_caption_data}}
};

#NOP -- .toggle_set <name> <0|1>: set a mapped toggle's variables;
#alias {.toggle_set} {
    #var {$toggleMap[%1][var]} {%2};
    #if {"$toggleMap[%1][also]" != ""} {#var {$toggleMap[%1][also]} {%2}};
};

#alias {.toggle_mapped} {
    #local toggle_new 1;
    #if {"${$toggleMap[%1][var]}" == "1"} {#local toggle_new 0};
    .toggle_set %1 $toggle_new;
    #if {$toggle_new} {
        #if {"$toggleMap[%1][on]" != ""} {$toggleMap[%1][on]};
        #echo {<cfb>   -----  %1 has been turned on -----<088>};
    } {
        #if {"$toggleMap[%1][off]" != ""} {$toggleMap[%1][off]};
        #echo {<faa>   -----  %1 has been turned off -----<088>};
    };
};

#NOP -- Save the mapped toggles into xtoggleMap (written to vars.tin by _variable_export);
#alias {.toggle_map_save} {
    #local t {};
    #local v {};
    #unvar xtoggleMap;
    #foreach *toggleMap[] t {
        #local v ${$toggleMap[$t][var]};
        #if {"$toggleMap[$t][nosave]" != "1" && ("$v" == "0" || "$v" == "1")} {#var xtoggleMap[$t] $v};
    };
};

#NOP -- Restore them at login (_variable_import) and after .gswap reloads the common files;
#alias {.toggle_map_restore} {
    #local t {};
    #foreach *xtoggleMap[] t {
        #if {&toggleMap[$t][]} {
            .toggle_set $t $xtoggleMap[$t];
            #if {"$xtoggleMap[$t]" == "1" && "$toggleMap[$t][login]" != ""} {$toggleMap[$t][login]};
        };
    };
};

#NOP -- Fremen also have a toggle guildside, which needs to be able to bypass;
#list {fremenToggleList} {create} {fblock} {audible} {litany} {quasibrief} {showdodge};

#alias {toggle} {
    #format toggle_var {%l} {%0};
    #format toggle_var {%p} {$toggle_var};
    #var fremen_toggle 0;
    #if {"$toggle_var" != ""} {#list {fremenToggleList} {find} {$toggle_var} {fremen_toggle}};
    #if {"$toggle_var" == ""} {
        #echo {<ffe>   -----  No toggle provided.  Use 'toggle-list' to see available options.  -----<088>};
        #if {"$guild" == "fremen"} {
            #echo {  <ffe> Fremen toggles (these are mudside) are below and will bypass the 3kdb commands};
            #send {toggle};
        };
    } {
        #if {!$fremen_toggle} {
            #if {&toggleMap[$toggle_var][]} {
                .toggle_mapped $toggle_var;
            } {
            #if {"$toggles[$toggle_var]" == ""} {
                #echo {<ffe>   -----  $toggle_var not found in toggles  -----<088>};
            } {
                #if $toggles[$toggle_var] {
                    #var toggles[$toggle_var] 0;
                    #echo {<faa>   -----  $toggle_var has been turned off -----<088>};
                } {
                    #var toggles[$toggle_var] 1;
                    #echo {<cfb>   -----  $toggle_var has been turned on -----<088>};
                };
                #if {"$toggle_var" == "discord_post"} {#var discordPost $toggles[discord_post]};
            };
            };
        } {
            #send {!toggle $toggle_var};
        };
    };
};

#alias {toggle-list} {
    #echo {<cfb>   ---++---       3kdb Current Toggle Status      ---++---<088>};
    #echo {<fff>       Usage: toggle <toggle alias> <088>};
    #format tmpLine {       %-25s          %+10s} {<fdc>Toggle Alias<088>} {<fdc>Status<088>};
    #echo {$tmpLine};
    #foreach *toggles[] item {
        #if {$toggles[$item]} {
            #format tmpLine {        %-25s         %+8s} {$item} {on};
            #echo {<dfc>$tmpLine<088>};
        } {
            #format tmpLine {        %-25s         %+9s} {$item} { off};
            #echo {<fbb>$tmpLine<088>};
        };
    };
    #foreach *toggleMap[] item {
        #if {"${$toggleMap[$item][var]}" == "1"} {
            #format tmpLine {        %-25s         %+8s} {$item} {on};
            #echo {<dfc>$tmpLine<088>};
        } {
            #format tmpLine {        %-25s         %+9s} {$item} { off};
            #echo {<fbb>$tmpLine<088>};
        };
    };
    #echo {<cfb>   ---++---        ---++---        ---++---       ---++---<088>};
};

#class {common_toggles} {close};
