#class {mapper} {open}

#map read common/map/3k_shared.map;

/* Move Event */
#alias {mapupdate} {
	#map {get} {ROOMVNUM} {roomvnum};
	#map {get} {ROOMAREA} {roomarea};
	#map {get} {ROOMNAME} {roomname};
	#map {get} {ROOMDESC} {roomdesc};
	#format {roomname_len}	{%L} {${roomname}};
	#format {roomvnum_len}	{%L} {${roomvnum}};
	#format {roomarea_len}	{%L} {${roomarea}};
	#format {roomdesc_len}	{%L} {${roomdesc}};
#NOP	#math {name_len} {42-$roomvnum_len-3};
#NOP	#format {name_trunc} {%.${name_len}s} {$roomname};
#NOP	#unvar area_mapped;
#NOP	#map list {} {} {} {$roomarea} {variable} {area_mapped};
#NOP	#var {room_cnt} {&area_mapped[]};
}

#event {MAP UPDATED VTMAP} {
	#delay {0.05} {mapupdate}
};

#event {MAP ENTER ROOM} {
	#if {"$mapping" == "on"} {
		mapupdate;
	}
};

#event {MAP EXIT ROOM} {
	#list nouns clear
};

/* Data Grab Trigger */
#var finding_here off;

#function cartcheck {
	#format cart {%.40s} {%0};
	#if {"$cart" == "                                        " || "${cart}" === ""} {
		#return 1
	} {
		#return 0
	};
};

#NOP Room Short with Exits;
#alias .map_create_exits {
	#replace room[exits] {,} {;};
	#replace room[exits] {~} {;};
	#foreach {$room[exits]} {eachexit} {#map dig $eachexit};
	#map get {roomexit} {rexit};
	#foreach {$rexit} {eachexit} {
		#map at {$eachexit} {
			#map get {roomarea} {eacharea};
			#if {"${eacharea}" === ""} {
				#map set {roomcolor} {<118>};
			};
		};
	};
	#NOP -- This comes from MIP, so set a check that the MIP room name has updated;
	#ticker update_room_name {
		#if $mip_room_name {
			#if {$roomname_len == 0} {
				#map set roomname {$room[name]};
				#var mip_room_name 0;
			};
		};
	} {.5};
	#if {$roomarea_len == 0} {
		#map set roomarea {$area};
		#map set roomcolor;
	};
	#if {$roomdesc_len == 0} {
		#map set roomdesc {$room[long]};
	};
};


#alias {mapWriteRoom} {
	#echo {Area set to $area};
	#echo {Room name is $room[name]};
	#echo {Room long is $room[long]};
	#map set roomarea {$area};
	#map set roomname {$room[name]};
	#map set roomdesc {$room[long]};
};

#NOP Room Short with No Exits, Lowered Priority;
#act {\-R\-_%1%s\-R\-_} {
	#NOP -- This used to #var room %1, which replaced the whole room table (name, exits, long) with a string;
	#if {"$mapping" == "on"} {
		#if {$roomname_len == 0} {
			#echo {calling lower priority room name};
			#map set roomname {%1};
		};
		#if {$roomarea_len == 0} {
			#map set roomarea {$area};
			#map set roomcolor;
		};
		#if {$roomdesc_len == 0} {#var longcap on;};
		#map get {roomvnum} {gonum};
		#map goto $gonum;
	};
} {6}

#act {AREA NAME: %1 [%2]} {
	#var area %1;
	#var room[area] %1;
	#delay {area_banner} {
		.rooms_mapped %1;
		.area_speedruns;
		.area_bots;
	} {2};
} {2};


#NOP -- Count the # of rooms mapped;
#alias {.rooms_mapped} {
	#local tmpItem %0;
	#local area_mapped {};
	#map list {} {} {} {$tmpItem} {variable} {area_mapped};
	#format rooms_mapped {%g} {&area_mapped[]};
	#echo {   <bfc>Rooms Mapped:  $rooms_mapped <088>};
};

#NOP -- Color rooms that have no area set (unexplored);
#alias nacolor {
	#loop 1 20000 {cnt} {
		#map at {$cnt} {
			#map get {roomarea} {cntarea};
			#NOP #if {"$cntarea" == ""} {#map set roomcolor <118>}
		}
	};
	#map get {roomvnum} {gonum};
	#map goto $gonum;
}


#NOP -- findhere: look, then ask the map for rooms matching this room. The description is matched with;
#NOP -- wildcards at both ends because many map descriptions have extra leading/trailing spaces. Each step;
#NOP -- only runs when the previous, stricter one finds nothing;
#alias {findhere} {
	#unvar findroom;
	#var finding_here on;
	#var findauto off;

	rating;
	#send !brief off yes;
	#var find_count 1;

	look;
	#delay {findhere_look} {.findhere_search} {2};
};

#NOP -- The room name and exits come from MIP, which isn't resent for a look, so fall back to the room's;
#NOP -- title line (room_short, e.g. "North of Center (e,w,s,n)", the same form the map stores) and its exits;
#NOP -- Room names end in their exits, e.g. "North of Center (e,w,s,n)", but the map may list them in;
#NOP -- another order ("(n,s,w,e)"), so names are compared without that part and exits are matched separately;
#function {findhere_base} {#var result {%0};#regex {%0} {{^(.*?) *\(([^()]*)\)$}} {#var result {&2}}};
#function {findhere_exits} {#var result {};#regex {%0} {{^(.*?) *\(([^()]*)\)$}} {#var result {&3}}};

#alias {.findhere_name} {
	#var findname {$room[name]};
	#if {"$findname" == ""} {#var findname {$room_short}};
	#NOP -- room_short still has the -R-_ markers around it;
	#replace findname {-R-_} {};
	#format findname {%p} {$findname};
	#var findbase {@findhere_base{$findname}};
	#NOP -- Matches the bare name or the name followed by any (exits);
	#var findpattern {$findbase{| \(.*\)}};
};

#NOP -- @findhere_sig{a;b;c}: just the standard directions in a list of exits, in a fixed order.;
#NOP -- Map rooms often have extra command exits (e.g. nod) the game doesn't list, so exits are compared this way;
#function {findhere_sig} {
	#var result {};
	#local fd {};
	#foreach {n;ne;e;se;s;sw;w;nw;u;d} fd {
		#if {";%0;" == "%*;$fd;%*"} {#var result {$result;$fd}};
	};
};

#NOP -- findsig: this room's standard exits, from the room name's (exits) or else MIP's exit list.;
#NOP -- The name comes first because it's cleared on every move, while room[exits] can be left from the last room;
#alias {.findhere_exitsig} {
	#var findexits {@findhere_exits{$findname}};
	#if {"$findexits" == ""} {#var findexits {$room[exits]}};
	#replace findexits {,} {;};
	#replace findexits {~} {;};
	#var findsig {@findhere_sig{$findexits}};
};

#NOP -- Keep the candidates in findroom[$find_count] whose standard exits match this room's;
#alias {.findhere_exitfilter} {
	#if {"$findsig" == ""} {#return};
	#local fv {};
	#local fd {};
	#var findkeep {};
	#foreach *findroom[$find_count][] fv {
		#map at $fv #map get roomexits findmapexits;
		#var findmaplist {};
		#foreach *findmapexits[] fd {#var findmaplist {$findmaplist;$fd}};
		#if {"@findhere_sig{$findmaplist}" === "$findsig"} {#var findkeep[$fv] {}};
	};
	#var findroom[$find_count] {};
	#foreach *findkeep[] fv {#var findroom[$find_count][$fv] {}};
};

#NOP -- After each search: remember the first rooms found, then keep those whose exits match too.;
#NOP -- Lists are copied one room at a time: a whole list (e.g. the 1049 Sewer Maze rooms in the Chaotic;
#NOP -- Sewers) is too big for one #var and crashes TinTin;
#alias {.findhere_check} {
	#if {&findroom[$find_count][] == 0} {#return};
	#local fv {};
	#if {&findfirst[] == 0} {#foreach *findroom[$find_count][] fv {#var findfirst[$fv] {}}};
	.findhere_exitfilter;
	#if {&findroom[$find_count][] > 0} {#var finddone 1};
};

#NOP -- Search strictest first: area, name and description, then drop the area, then the description.;
#NOP -- If no room's exits match (e.g. a hidden exit), fall back to the first rooms the name search found;
#alias {.findhere_search} {
	#NOP -- #map list finds nothing unless the map is in some room, so park it in one if needed;
	#var findhere_vnum 0;
	#map get roomvnum findhere_vnum;
	#if {"$findhere_vnum" == "" || "$findhere_vnum" == "0"} {#map goto 1};
	.findhere_name;
	#if {"$findname" == ""} {
		#var finding_here off;
		#send !brief on yes;
		#showme <eaa>findhere: no room name was captured, so there's nothing to search for. Try again after moving.<088>;
		#return;
	};
	.findhere_exitsig;
	#var finddone 0;
	#var findfirst {};
	#if {"$room[long]" != ""} {
		#var findroom[$find_count] {};
		#map list {roomarea} {$area} {roomname} {$findpattern} {roomdesc} {%*$room[long]%*} {variable} {findroom[$find_count]};
		.findhere_check;
	};
	#if {!$finddone && "$room[long]" != ""} {
		#var findroom[$find_count] {};
		#map list {roomname} {$findpattern} {roomdesc} {%*$room[long]%*} {variable} {findroom[$find_count]};
		.findhere_check;
	};
	#if {!$finddone} {
		#var findroom[$find_count] {};
		#map list {roomarea} {$area} {roomname} {$findpattern} {variable} {findroom[$find_count]};
		.findhere_check;
	};
	#if {!$finddone} {
		#var findroom[$find_count] {};
		#map list {roomname} {$findpattern} {variable} {findroom[$find_count]};
		.findhere_check;
	};
	#if {!$finddone} {
		#local fv {};
		#foreach *findfirst[] fv {#var findroom[$find_count][$fv] {}};
	};
	.findhere_result;
};

#NOP -- Report the candidates in findroom[$find_count]: go there if there's one, otherwise ask for a direction;
#alias {.findhere_result} {
	#if {&findroom[$find_count][] == 1} {
		#map goto *findroom[$find_count][1..1];
		#var finding_here off;
		#var findauto off;
		#send !brief on yes;
		#showme <dfa>----------------------------------------------------<088>;
		#showme <dfa>              YOU HAVE BEEN FOUND                   <088>;
		#showme <dfa>----------------------------------------------------<088>;
		#return;
	};
	#if {&findroom[$find_count][] == 0} {
		#var finding_here off;
		#var findauto off;
		#send !brief on yes;
		#showme <eaa>----------------------------------------------------<088>;
		#showme <eaa>      Sorry, we were not able to find your room.<088>;
		#showme <eaa>       Start the process again with 'findhere'<088>;
		#showme <eaa>----------------------------------------------------<088>;
		#return;
	};
	#local fv {};
	#foreach *findroom[$find_count][] fv {#map at $fv #map get roomexits findroom[$find_count][$fv][exits]};
	#showme <dfa>Turn $find_count: There are &findroom[$find_count][] possible rooms.<088>;
	#if {"$findauto" == "on"} {
		#delay {findhere_auto} {.findhere_auto_step} {0.5};
	} {
		#showme <dfa>Walk an exit with findhere2 <exit> to narrow it down, e.g. findhere2 e<088>;
	};
};

#NOP -- findhere2 <exit>: walk that exit, then keep the rooms that exit leads to whose name matches where you land;
#alias {findhere2 %1} {
	#if {"%1" != "n" && "%1" != "s" && "%1" != "e" && "%1" != "w" && "%1" != "ne" && "%1" != "nw" && "%1" != "se" && "%1" != "sw" && "%1" != "u" && "%1" != "d"} {
		#showme <eaa>----------------------------------------------------<088>;
		#showme <eaa>   Invalid direction input.  Please enter any of:<088>;
		#showme <eaa>       n, e, w, s, nw, ne, se, sw, u, d<088>;
		#showme <eaa>----------------------------------------------------<088>;
		#return;
	};
	#if {"$finding_here" != "on" || &findroom[$find_count][] < 2} {
		#showme <eaa>Nothing to narrow down. Start with 'findhere'<088>;
		#return;
	};
	#list findpath add {%1};
	#send {%1};
	#NOP -- Where each candidate's exit leads;
	#unvar tempVnums;
	#local fv {};
	#foreach *findroom[$find_count][] fv {
		#if {"$findroom[$find_count][$fv][exits][%1]" != ""} {
			#list tempVnums add {$findroom[$find_count][$fv][exits][%1]};
		};
	};
	#NOP -- Wait for the new room's name to arrive before comparing;
	#delay {findhere_wait} {.findhere_narrow} {1.5};
};

#alias {.findhere_narrow} {
	#NOP -- findhere-auto clears the room name before each step, so still empty means the move didn't happen;
	#if {"$findauto" == "on" && "$room[name]" == "" && "$room_short" == ""} {
		.findhere_auto_stop {the step $findpath[-1] didn't reach a new room};
		#return;
	};
	.findhere_name;
	#math find_count {$find_count + 1};
	#unvar findroom[$find_count];
	#var findroom[$find_count] {};
	#local fv {};
	#local fname {};
	#if {&tempVnums[] == 0} {
		.findhere_result;
		#return;
	};
	#foreach $tempVnums[%*] fv {
		#map at $fv #map get roomname fname;
		#if {"@findhere_base{$fname}" === "$findbase"} {#var findroom[$find_count][$fv] {}};
	};
	#NOP -- If no name matched (e.g. the map has an older name), fall back to where the exits lead;
	#if {&findroom[$find_count][] == 0} {
		#foreach $tempVnums[%*] fv {#var findroom[$find_count][$fv] {}};
	};
	#NOP -- Then keep the ones whose exits match the room you landed in, unless none do (e.g. a hidden exit);
	.findhere_exitsig;
	#var findnamed {};
	#foreach *findroom[$find_count][] fv {#var findnamed[$fv] {}};
	.findhere_exitfilter;
	#if {&findroom[$find_count][] == 0} {
		#foreach *findnamed[] fv {#var findroom[$find_count][$fv] {}};
	};
	.findhere_result;
	#if {&findroom[$find_count][] > 1} {
		#showme <dfa> Current room matches:<088>;
		#foreach *findroom[$find_count][] fv {
			#map at $fv #map get roomname fname;
			#showme <dfa> Name: $fname  Vnum: $fv<088>;
		};
	};
};

#NOP -- findhere-auto [steps]: findhere, then keep walking whichever exit best narrows the rooms down, until;
#NOP -- one is left, none match, a step fails, a fight starts, or it has walked [steps] steps (default 8).;
#NOP -- Run it again to carry on from where it stopped, or findhere-auto stop to stop it;
#var findauto off;
#var findauto_rev {{n}{s}{s}{n}{e}{w}{w}{e}{ne}{sw}{sw}{ne}{nw}{se}{se}{nw}{u}{d}{d}{u}};
#alias {findhere-auto} {
	#if {"%1" == "stop"} {
		.findhere_auto_stop {stopped};
		#return;
	};
	#var findauto_left {%1};
	#if {"$findauto_left" == ""} {#var findauto_left 8};
	#if {"$finding_here" == "on" && &findroom[$find_count][] > 1} {
		#var findauto on;
		.findhere_auto_step;
	} {
		#var findauto_back {};
		findhere;
		#var findauto on;
	};
};

#alias {.findhere_auto_stop} {
	#undelay findhere_auto;
	#var findauto off;
	#showme <eaa>findhere-auto: %1. Narrow it down with findhere2 <exit>, or run findhere-auto again.<088>;
};

#NOP -- Score each exit by the biggest group of rooms that would still look alike after walking it (same name;
#NOP -- and exits where it leads), smallest wins. Going straight back only wins if nothing else is as good;
#alias {.findhere_auto_step} {
	#if {"$findauto" != "on" || &findroom[$find_count][] < 2} {#return};
	#if {"$incombat" == "1"} {
		.findhere_auto_stop {a fight started};
		#return;
	};
	#if {$findauto_left < 1} {
		.findhere_auto_stop {out of steps with &findroom[$find_count][] rooms left};
		#return;
	};
	#local fd {};
	#local fv {};
	#local fx {};
	#var findauto_best {};
	#var findauto_bestscore 0;
	#foreach {$findsig} fd {
		#if {"$fd" == ""} {#continue};
		#var findauto_groups {};
		#var findauto_max 0;
		#foreach *findroom[$find_count][] fv {
			#var findauto_dest {$findroom[$find_count][$fv][exits][$fd]};
			#if {"$findauto_dest" == ""} {
				#var findauto_key none;
			} {
				#map at {$findauto_dest} {#map get roomname findauto_name;#map get roomexits findauto_ex};
				#var findauto_list {};
				#foreach *findauto_ex[] fx {#var findauto_list {$findauto_list;$fx}};
				#format findauto_key {%H} {@findhere_base{$findauto_name}@findhere_sig{$findauto_list}};
			};
			#if {&findauto_groups[$findauto_key] == 0} {#var findauto_groups[$findauto_key] 0};
			#math findauto_groups[$findauto_key] {$findauto_groups[$findauto_key] + 1};
			#if {$findauto_groups[$findauto_key] > $findauto_max} {#var findauto_max $findauto_groups[$findauto_key]};
		};
		#math findauto_score {$findauto_max * 2};
		#if {"$fd" == "$findauto_back"} {#math findauto_score {$findauto_score + 1}};
		#if {"$findauto_best" == "" || $findauto_score < $findauto_bestscore} {
			#var findauto_best $fd;
			#var findauto_bestscore $findauto_score;
		};
	};
	#if {"$findauto_best" == ""} {
		.findhere_auto_stop {this room has no standard exits to walk};
		#return;
	};
	#math findauto_left {$findauto_left - 1};
	#var findauto_back {$findauto_rev[$findauto_best]};
	#showme <dfa>findhere-auto: walking $findauto_best<088>;
	#var room[name] {};
	#var room_short {};
	findhere2 $findauto_best;
};


#alias {mapsearch} {
	#show <129>Name matches:<088>;
	#map list {%i%*%0%*};
	#show \n;
	#show <129>Note matches:<088>;
	#map list {} {} {} {} {%i%*%0%*};
}

#alias {mapon} {
	#send !brief off yes;
	#map flag static off;
	#var mapstatic 1;
	#var mapping on;
}

#alias {.map_restore_static_if_not_mapping} {#if {"$mapping" != "on"} {#map flag static on};};

#alias {mapoff}{
	#send !brief on yes;
	#map flag static on;
	#unvar mapstatic;
	#unvar mapping;
	#unticker {update_room_name} {} {};
}
#map flag static on;
#unvar mapstatic;

#NOP Link rooms with a void insert
#alias voidlink {
	#var dir %1;
	#var dest_num %2;
	#map link $dir $dest_num both;
	#map insert $dir void
}

/* Highmortal Portals Toggles */
#alias hmavoid {
	#map at 148 {#map exitflag {portal road} avoid on};
	#map at 148 {#map exitflag {portal eforest} avoid on};
	#map at 148 {#map exitflag {portal wforest} avoid on};
	#map at 148 {#map exitflag {efor} avoid on};
	#map at 148 {#map exitflag {portal desert} avoid on};
	#map at 148 {#map exitflag {portal ice} avoid on};
}

#alias hmfollow {
	#map at 148 {#map exitflag {portal road} avoid off};
	#map at 148 {#map exitflag {portal eforest} avoid off};
	#map at 148 {#map exitflag {portal wforest} avoid off};
	#map at 148 {#map exitflag {efor} avoid off};
	#map at 148 {#map exitflag {portal desert} avoid off};
	#map at 148 {#map exitflag {portal ice} avoid off};
}

#class {mapper} {close}