#class {map} {open};

#alias {loadmap} {
    #read modules/map/mapper.tin;
    #read modules/map/findhere.tin;
    #read modules/map/maphelper.tin;
	#map goto $curvnum;
    #NOP -- After the goto, so on load it can line the map up with the room you're in;
    #read common/map/rej_rotate.tin;
};


#class {map} {close};