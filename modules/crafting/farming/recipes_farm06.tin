#nop Recipes for farm_land6 (levels 21-35);

#alias farml22habanero {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots happy ed's fertilizer;
        fertilize lots hippie fertilizer;
        fertilize lots hippie fertilizer;
        fertilize lots hippie fertilizer;
        water lots wayhaven water;
        fertilize some wayhaven water;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize lots happy ed's fertilizer;
        fertilize some happy ed's fertilizer;
        water lots wayhaven water;
        aerate some ryogi-pei air;
        fertilize little hippie fertilizer
    }
};

