#nop Recipes for farm_land1 (levels 1-6);

#alias farml1whitepotato {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots hippie fertilizer;
        water lots wayhaven water;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize some hippie fertilizer;
        water some wayhaven water
    }
};

#alias farml1broccoli {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots hippie fertilizer;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] == 2} {
        fertilize lots hippie fertilizer
    }
};

