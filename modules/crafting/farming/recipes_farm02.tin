#nop Recipes for farm_land2 (levels 2-11);

#alias farml2blueberry {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        water lots r'lyeh water;
        fertilize some happy ed's fertilizer;
        fertilize some hippie fertilizer;
        fertilize some smurfy fertilizer;
        aerate little serinth air;
        spray little hunch pesticide;
        sne grow plant
    }
};

#alias farml2greenbean {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots smurfy fertilizer;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize lots smurfy fertilizer;
    }
};

#alias farml2zucchini {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] == 2} {
        fertilize lots hippie fertilizer
    }
};

#alias farml2cauliflower {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots hippie fertilizer;
        water lots mexico water;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize lots hippie fertilizer;
        water some mexico water
    }
};

#alias farml2romatomato {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots smurfy fertilizer;
        fertilize lots hippie fertilizer;
        water lots mexico water;
        fertilize lots happy ed's fertilizer;
        aerate lots genlab air
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize some smurfy fertilizer;
        water some mexico water
    }
};

#alias farml2greenapple {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots smurfy fertilizer; 
        fertilize lots hippie fertilizer;
        water lots mexico water;
        fertilize lots happy ed's fertilizer;
        aerate lots genlab air
    }
};

#alias farml2valencia {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots smurfy fertilizer;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] == 1 || $craft_farming[data][plantround] == 2} {
        fertilize some smurfy fertilizer
    }
};

#alias farml2raspberry {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots hippie fertilizer;
        fertilize lots happy ed's fertilizer;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] % 2 == 1} {
        fertilize lots hippie fertilizer
    };
    #else {
        fertilize lots happy ed's fertilizer
    }
};

