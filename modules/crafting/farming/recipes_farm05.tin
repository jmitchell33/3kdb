#nop Recipes for farm_land5 (levels 17-30);

#alias farml17gooseberry {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots hippie fertilizer;
        fertilize lots hippie fertilizer;
        spray lots mount perplexus pesticide;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize lots happy ed's fertilizer;
        fertilize some happy ed's fertilizer;
        spray lots mount perplexus pesticide;
        spray some mount perplexus pesticide
    }
};

#alias farml18spaghetti {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        water lots r'lyeh water;
        water lots r'lyeh water;
        water lots r'lyeh water;
        water lots r'lyeh water;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots hippie fertilizer;
        fertilize lots hippie fertilizer;
        fertilize lots smurfy fertilizer;
        fertilize lots smurfy fertilizer;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] == 2 || $craft_farming[data][plantround] == 4} {
        water lots r'lyeh water;
        water lots r'lyeh water;
        fertilize lots happy ed's fertilizer;
        fertilize lots hippie fertilizer;
        fertilize lots smurfy fertilizer
    };
    #elseif {$craft_farming[data][plantround] == 3 || $craft_farming[data][plantround] == 5} {
        water lots r'lyeh water;
        water some r'lyeh water;
        fertilize some happy ed's fertilizer;
        fertilize some hippie fertilizer;
        fertilize some smurfy fertilizer
    }
};

#alias farml19asparagus {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize some smurfy fertilizer;
        aerate little genlab air;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        aerate little genlab air;
        fertilize some smurfy fertilizer
    }
};

#alias farml20lychee {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots smurfy fertilizer;
        fertilize lots smurfy fertilizer;
        aerate lots genlab air;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots smurfy fertilizer;
        aerate little genlab air;
        aerate lots ryogi-pei air
    }
};
