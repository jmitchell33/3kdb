#nop Recipes for farm_land7 (levels 28-39);

#alias farml28salmonberry {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        aerate lots serinth air;
        aerate lots serinth air;
        aerate lots genlab air;
        aerate lots genlab air;
        aerate lots genlab air;
        water lots wayhaven water;
        water lots wayhaven water;
        water lots wayhaven water;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots hippie fertilizer;
        fertilize lots hippie fertilizer;
        fertilize lots hippie fertilizer;
        fertilize lots smurfy fertilizer;
        fertilize lots smurfy fertilizer;
        spray lots ant cave pesticide;
        spread lots garou neutralizer;
        spread lots garou neutralizer;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize little happy ed's fertilizer;
        spread some garou neutralizer;
        fertilize lots hippie fertilizer;
        water lots wayhaven water;
        water some wayhaven water;
        aerate some genlab air;
        aerate some serinth air
    }
};

#alias farml28persimmon {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        water lots atlantis water;
        fertilize lots happy ed's fertilizer;
        sne depress oximeter button;
        sne push hygrometer button;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize lots happy ed's fertilizer;
        water lots atlantis water;
        sne depress oximeter button;
        sne push hygrometer button
    }
};

#alias farml30ginger {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots alphabet fertilizer;
        fertilize lots alphabet fertilizer;
        fertilize lots alphabet fertilizer;
        water lots wayhaven water;
        water lots wayhaven water;
        water lots wayhaven water;
        aerate lots genlab air;
        aerate lots genlab air;
        spray lots ant cave pesticide;
        sne grow plant;
        sne depress oximeter button;
        sne push hygrometer button;
        sne feed green;
        sne feed green;
        sne feed green;
        sne feed green;
        sne feed green
    };
    #elseif {$craft_farming[data][plantround] > 0 && $craft_farming[data][plantround] < 3} {
        water lots wayhaven water;
        aerate some genlab air;
        fertilize lots happy ed's fertilizer;
        fertilize some alphabet fertilizer
    };
    #elseif {$craft_farming[data][plantround] == 3 || $craft_farming[data][plantround] == 4} {
        aerate some genlab air;
        aerate some genlab air;
        water some wayhaven water;
        water little atlantis water;
        fertilize lots alphabet fertilizer;
        fertilize little alphabet fertilizer;
        fertilize lots happy ed's fertilizer;
        sne feed green;
        sne feed green
    };
    #else {
        aerate some genlab air;
        aerate some genlab air;
        water some wayhaven water;
        water little atlantis water;
        fertilize some alphabet fertilizer;
        fertilize lots happy ed's fertilizer;
        sne feed green;
        sne feed green
    };
    sne depress oximeter button;
    sne push hygrometer button;
    sne feed green;
    sne feed green;
    sne feed green;
    sne feed green
};

