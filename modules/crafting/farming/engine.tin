#nop STARTUP MESSAGE; 
#nop ============================================;

#alias startup_farm_message {
    #echo {<faa>===================================================<088>};
    #echo {<ffa>        Advanced Farming System Loaded<088>};
    #echo {<faa>===================================================<088>};
    #echo {<feb>Converted and modified by Badger on 2025/11/03<088>};
    #echo {};
    #echo {<ffa>AUTO-FARMING:<088>};
