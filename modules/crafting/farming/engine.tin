#nop ============================================;
#nop BUY SUPPLIES;
#nop ============================================;

#alias buy_supplies {
    #if {"%1" == ""} {
        #echo {<faa>==============================<088>};
        #echo {<ccd>Farm Level: <fff>$craft_farming[data][farming_level]<088>};
        #echo {<ffa>Usage: <ccd>buysupplies <level><088>};
        #echo {<feb>Options:<088>};
        #echo {<fff>  1<feb> = Simple (Levels 10-32)<088>};
        #echo {<fff>  2<feb> = Standard (Levels 33-65)<088>};
        #echo {<fff>  3<feb> = Complex (Levels 66-100)<088>};
        #echo {<fff>  all<feb> = Buys everything you need<088>};
        #echo {<ccd>Note: 'all' Buys appropriate tools based on your level<088>};
        #echo {<ccd> All options include all common supplies<088>};
        #echo {<faa>==============================<088>}
    };
    #elseif {"%1" == "1"} {
        #var craft_farming[data][tool_type] Simple;
        buy A simple type I contristometer;
        buy A simple type II contristometer;
        buy A simple type III contristometer;
        buy A simple type IV contristometer;
        buy A cage holding a tiny blue goblin;
        buy A cage holding a tiny green goblin;
        buy A cage holding a tiny orange goblin;
        buy A cage holding a tiny red goblin;
        buy A Mark I Type I nutriometer;
        buy A Mark I Type II nutriometer;
        buy A Mark I Type III nutriometer;
        buy A Mark I Type IV nutriometer;
        buy A simple oximeter;
        buy A simple hygrometer;
        buy_supplies_common;
        get all
    };
    #elseif {"%1" == "2"} {
        #var craft_farming[data][tool_type] Standard;
        buy A standard type I contristometer;
        buy A standard type II contristometer;
        buy A standard type III contristometer;
        buy A standard type IV contristometer;
        buy A cage holding a medium-sized blue goblin;
        buy A cage holding a medium-sized green goblin;
        buy A cage holding a medium-sized orange goblin;
        buy A cage holding a medium-sized red goblin;
        buy A Mark II Type I nutriometer;
        buy A Mark II Type II nutriometer;
        buy A Mark II Type III nutriometer;
        buy A Mark II Type IV nutriometer;
        buy A standard oximeter;
        buy A standard hygrometer;
        buy_supplies_common;
        get all
    };
    #elseif {"%1" == "3"} {
        #var craft_farming[data][tool_type] Complex;
        buy A complex type I contristometer;
        buy A complex type II contristometer;
        buy A complex type III contristometer;
        buy A complex type IV contristometer;
        buy A cage holding a large blue goblin;
        buy A cage holding a large green goblin;
        buy A cage holding a large orange goblin;
        buy A cage holding a large red goblin;
        buy A Mark III Type I nutriometer;
        buy A Mark III Type II nutriometer;
        buy A Mark III Type III nutriometer;
        buy A Mark III Type IV nutriometer;
        buy A complex oximeter;
        buy A complex hygrometer;
        buy_supplies_common;
        get all
    };
    #elseif {"%1" == "all"} {
        #nop Determine which tools to buy based on level;
        #if {$craft_farming[data][farming_level] >= 10 && $craft_farming[data][farming_level] <= 32} {
            #var craft_farming[data][tool_type] Simple;
            buy A simple type I contristometer;
            buy A simple type II contristometer;
            buy A simple type III contristometer;
            buy A simple type IV contristometer;
            buy A cage holding a tiny blue goblin;
            buy A cage holding a tiny green goblin;
            buy A cage holding a tiny orange goblin;
            buy A cage holding a tiny red goblin;
            buy A Mark I Type I nutriometer;
            buy A Mark I Type II nutriometer;
            buy A Mark I Type III nutriometer;
            buy A Mark I Type IV nutriometer;
            buy A simple oximeter;
            buy A simple hygrometer
        };
        #elseif {$craft_farming[data][farming_level] >= 33 && $craft_farming[data][farming_level] <= 65} {
            #var craft_farming[data][tool_type] Standard;
            buy A standard type I contristometer;
            buy A standard type II contristometer;
            buy A standard type III contristometer;
            buy A standard type IV contristometer;
            buy A cage holding a medium-sized blue goblin;
            buy A cage holding a medium-sized green goblin;
            buy A cage holding a medium-sized orange goblin;
            buy A cage holding a medium-sized red goblin;
            buy A Mark II Type I nutriometer;
            buy A Mark II Type II nutriometer;
            buy A Mark II Type III nutriometer;
            buy A Mark II Type IV nutriometer;
            buy A standard oximeter;
            buy A standard hygrometer
        };
        #elseif {$craft_farming[data][farming_level] >= 66} {
            #var craft_farming[data][tool_type] Complex;
            buy A complex type I contristometer;
            buy A complex type II contristometer;
            buy A complex type III contristometer;
            buy A complex type IV contristometer;
            buy A cage holding a large blue goblin;
            buy A cage holding a large green goblin;
            buy A cage holding a large orange goblin;
            buy A cage holding a large red goblin;
            buy A Mark III Type I nutriometer;
            buy A Mark III Type II nutriometer;
            buy A Mark III Type III nutriometer;
            buy A Mark III Type IV nutriometer;
            buy A complex oximeter;
            buy A complex hygrometer
        };
        #else {
            #echo {<faa>Farming level too low <fff>(need level 10+ to use tools)<088>};
            #var craft_farming[data][tool_type] None
        };
        buy_supplies_common;
        get all
    };
    #else {
        #echo {<faa>Invalid option. Use <fff>1, 2, 3 or all.<088>}
    }
};

#alias buy_supplies_common {
    buy A tank of Detroit air;
    buy A tank of Genlab air;
    buy A tank of Ryogi-Pei air;
    buy A tank of Serinth air;
    buy A bag of Happy Ed's fertilizer;
    buy A bag of alphabet fertilizer;
    buy A bag of hippie fertilizer;
    buy A bag of smurfy fertilizer;
    buy A barrel of Burns brand neutralizer;
    buy A barrel of Cowville neutralizer;
    buy A barrel of Der'thalas neutralizer;
    buy A barrel of Garou neutralizer;
    buy A barrel of Ant Cave pesticide;
    buy A barrel of Hunch pesticide;
    buy A barrel of Mount Perplexus pesticide;
    buy A barrel of Murus Faralain pesticide;
    buy A barrel of Gulf of Mexico water;
    buy A barrel of R'lyeh water;
    buy A barrel of Wayhaven water;
    buy A conch filled with Atlantis water;
    get all
};

#nop ============================================;
#nop AUTO FARMING SYSTEM;
#nop ============================================;

#nop calculate valid farm lands;
#alias calculate_valid_farms {
    #list craft_farming[farm_list] clear;
    
    #loop {1} {15} {tmpfarm} {
        #local min_lvl {$craft_farming[farmland][min][$tmpfarm]};
        #local max_lvl {$craft_farming[farmland][max][$tmpfarm]};
        
        #if {"$craft_farming[data][auto_mode]" == "all"} {
            #if {$craft_farming[data][farming_level] >= $min_lvl && $craft_farming[data][farming_level] <= $max_lvl} {
                #list craft_farming[farm_list] add {$tmpfarm};
                #if {$craft_farming[data][echo] == 1} {
                    #echo {<caf>Valid farm: farm_land$tmpfarm ($min_lvl-$max_lvl)<088>}
                }
            }
        };
        #elseif {"$craft_farming[data][auto_mode]" == "cxp"} {
            #if {$craft_farming[data][farming_level] >= $min_lvl  && $craft_farming[data][farming_level] <= $max_lvl} {
                #list craft_farming[farm_list] add {$tmpfarm};
                #if {$craft_farming[data][echo] == 1} {
                    #echo {<caf>Valid CXP farm: farm_land$tmpfarm ($min_lvl-$max_lvl)<088>}
                };
            };
        };
    };
    
    #list craft_farming[farm_list] size craft_farming[data][max_farms];
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<caf>Found $craft_farming[data][max_farms] valid farm(s)<088>}
    }
};

#alias start_auto_farming {
    #if {$craft_farming[data][auto_active] == 1} {
        #echo {<faa>Auto-farming already active!<088>};
        #return
    };
    
    #if {$craft_farming[data][farming_level] == 0} {
        #echo {<faa>Please set farming level first: <fff>setfarmlevel <level><088>};
        #return
    };
    
    #var craft_farming[data][auto_active] 1;
    #var craft_farming[data][current_farm_num] 0;
    
    calculate_valid_farms;
    
    #if {$craft_farming[data][max_farms] == 0} {
        #echo {<faa>No valid farms found for your level!<088>};
        #var craft_farming[data][auto_active] 0;
        #return
    };
    
    #echo {<caf>Found $craft_farming[data][max_farms] valid farm(s)!<088>};
    #echo {<ffa>┌── STEP 1: GOING TO FARM STORE ───┐<088>};
    
    #if {$craft_farming[data][travel_toggle] == 1} {
        #if {$craft_farming[data][go_toggle] == 0} {
            #var craft_farming[data][go_toggle] 1;
            go farm_store;
            #delay {farm_d_store_go} {
                #var craft_farming[data][go_toggle] 0;
                #echo {<ffa>┌── STEP 2: PURCHASING SUPPLIES ───┐<088>};
                auto_buy_supplies
            } {10}
        }
    };
    #else {
        gofarmstore;
        #delay {farm_d_store_walk} {
            #echo {<ffa>┌── STEP 2: PURCHASING SUPPLIES ───┐<088>};
            auto_buy_supplies
        } {5}
    }
};

#alias auto_buy_supplies {
    #if {$idle_flag} {
        farm_idle_stop;
        #return
    };

    #echo {<ffa>→ Purchasing supplies...<088>};
    buysupplies all;
    
    #delay {farm_d_buy} {
        #if {$idle_flag} {
            farm_idle_stop;
            #return
        };
        
        #echo {<fff>✓ <ffa>Supplies purchased!<088>};
        #echo {<ffa>━━━ STEP 3: HEADING TO FIRST FARM ━━━<088>};
        
        #if {$craft_farming[data][travel_toggle] == 0} {
            homefarmstore;
            #delay {farm_d_first_farm} {farm_next_location} {3}
        };
        #else {
            farm_next_location
        }
    } {5}
};

#alias farm_next_location {
    #if {$idle_flag} {
        farm_idle_stop;
        #return
    };

    #math craft_farming[data][current_farm_num] {$craft_farming[data][current_farm_num] + 1};
    
    #if {$craft_farming[data][current_farm_num] > $craft_farming[data][max_farms]} {
        #echo {<caf>━━━ ALL FARMS COMPLETE! ━━━<088>};
        stop_auto_farming;
        #return
    };
    
    #local next_farm {$craft_farming[farm_list][$craft_farming[data][current_farm_num]]};
    #var craft_farming[data][current_farm_id] {$next_farm};
    #local farm_room {farm_land$next_farm};
    
    #echo {<caf>━━━ FARM $craft_farming[data][current_farm_num] of $craft_farming[data][max_farms] (farm_land$next_farm) ━━━<088>};
    
    #if {$craft_farming[data][travel_toggle] == 1} {
        #if {$craft_farming[data][go_toggle] == 0} {
            #var craft_farming[data][go_toggle] 1;
            go $farm_room;
            #delay {farm_d_farm_go} {
                #var craft_farming[data][go_toggle] 0;
                #path destroy;
                #delay {farm_d_farm_arrive} {
                    #if {$craft_farming[data][echo] == 1} {
                        #echo {<caf>Arrived at farm_land$next_farm<088>}
                    };
                    farm_start_current
                } {2}
            } {10}
        }
    };
    #else {
        gofarm$next_farm;
        #delay {farm_d_farm_walk} {
            #if {$craft_farming[data][echo] == 1} {
                #echo {<caf>Arrived at farm_land$next_farm<088>}
            };
            farm_start_current
        } {7}
    }
};

#alias farm_start_current {
    #if {$idle_flag} {
        farm_idle_stop;
        #return
    };

    #var craft_farming[data][path_index] 0;
    #list craft_farming[path_directions] clear;
    #list craft_farming[path_directions] create {e} {e} {e} {n} {w} {w} {n} {e} {e} {n} {w} {w} {w} {s} {s} {s};
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<afa>Starting first room - checking plant...<088>}
    };
    
    farm_check_plant
};

#alias farm_check_plant {
    #if {$idle_flag} {
        farm_idle_stop;
        #return
    };

    #var craft_farming[data][room_has_plant] 0;
    #var craft_farming[data][plant_owner] {};
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<afa>Checking for plant...<088>}
    };
    
    sne look;
    
    #delay {farm_d_check} {
        #if {$idle_flag} {
            farm_idle_stop;
            #return
        };
        
        #if {$craft_farming[data][room_has_plant] == 0} {
            #if {$craft_farming[data][echo] == 1} {
                #echo {<feb>No plant - moving on<088>}
            };
            #if {$craft_farming[data][auto_active] == 1} {
                farm_walk_next_room
            }
        };
        #else {
            #if {"$craft_farming[data][plant_owner]" != ""} {
                #echo {<faa>Plant owned by $craft_farming[data][plant_owner] - skipping<088>};
                farm_walk_next_room
            };
            #else {
                sne look at plant
            }
        }
    } {2}
};

#alias farm_walk_next_room {
    #if {$idle_flag} {
        farm_idle_stop;
        #return
    };

    #math craft_farming[data][path_index] {$craft_farming[data][path_index] + 1};
    
    #local path_total {&craft_farming[path_directions][]};
    
    #if {$craft_farming[data][path_index] > $path_total} {
        #if {$craft_farming[data][echo] == 1} {
            #echo {<caf>All rooms in farm_land$craft_farming[data][current_farm_id] complete!<088>}
        };
        #if {$craft_farming[data][travel_toggle] == 0} {
            homefarm$craft_farming[data][current_farm_id];
            #delay {farm_d_leave_walk} {farm_next_location} {7}
        };
        #else {
            sne wash hands;
            #delay {farm_d_leave_go} {farm_next_location} {3}
        };
        #return
    };
    
    #local next_dir {$craft_farming[path_directions][$craft_farming[data][path_index]]};
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<feb>Moving: $next_dir (room $craft_farming[data][path_index] of $path_total)<088>}
    };
    
    sne $next_dir;
    
    #delay {farm_d_next_plot} {farm_check_plant} {2}
};

#alias continue_auto_farming {
    #if {$idle_flag} {
        farm_idle_stop;
        #return
    };

    #if {$craft_farming[data][auto_active] == 1} {
        farm_rest_seconds;
        #echo {<feb>Resting <fff>$craft_farming[pace][rest]<feb> seconds before the next plot (<fff>$craft_farming[pace][sent]<feb> commands, target <fff>$craft_farming[pace][apm]<feb> a minute)<088>};
        #delay {farm_rest} {
            #if {$craft_farming[data][auto_active] == 1} {
                farm_walk_next_room
            }
        } {$craft_farming[pace][rest]}
    }
};

#alias stop_auto_farming {
    farm_cancel_delays;
    #var craft_farming[data][auto_active] 0;
    #var craft_farming[data][auto_mode] {manual};
    #var craft_farming[data][current_farm_num] 0;
    #var craft_farming[data][path_index] 0;
    
    #if {$craft_farming[data][travel_toggle] == 1} {
        #if {$craft_farming[data][go_toggle] == 0} {
            #var craft_farming[data][go_toggle] 1;
            go farming;
            #delay {farm_d_stop_return} {
                #var craft_farming[data][go_toggle] 0;
                #echo {<caf>Auto-farming stopped - Returned to farming area<088>}
            } {7}
        }
    };
    #else {
        #echo {<caf>Auto-farming stopped<088>}
    }
};

#alias fr {
    #switch {"%1"} {
        #case {""} {
            #echo {<ffa>Usage: <fff>fr <all|cxp><088>};
            #echo {<feb>  <ccd>fr all<feb> - Farm all available farms<088>};
            #echo {<feb>  <ccd>fr cxp<feb> - Farm CXP farms only<088>}
        };
        #case {"all"} {
            #var craft_farming[data][auto_mode] all;
            start_auto_farming
        };
        #case {"cxp"} {
            #var craft_farming[data][auto_mode] cxp;
            start_auto_farming
        };
        #default {
            #echo {<faa>Invalid option: <fff>%1<088>};
            #echo {<feb>Use: <ccd>fr all<feb> or <ccd>fr cxp<088>}
        }
    }
};

#alias farm {
    #switch {"%1"} {
        #case {""} {
            #echo {<faa>═══════════════════════════════════════════════════════<088>};
            #echo {<ffa>FARM COMMAND USAGE:<088>};
            #echo {<faa>═══════════════════════════════════════════════════════<088>};
            #echo {  <ffc>farm all<feb>     - Farm all available farms based on your skill<088>};
            #echo {  <ffc>farm cxp<feb>     - Farm CXP-giving farms only (advanced)<088>};
            #echo {  <ffc>fr all<feb>       - Quick start: farm all<088>};
            #echo {  <ffc>fr cxp<feb>       - Quick start: farm CXP<088>};
            #echo {<faa>═══════════════════════════════════════════════════════<088>};
            #echo {<feb>Type <ccd>farmhelp autofarming<feb> for detailed help<088>};
            #echo {<faa>═══════════════════════════════════════════════════════<088>}
        };
        #case {"all"} {
            #if {$craft_farming[data][farming_level] == 0} {
                #echo {<ffa>Please set your farming level first: <ccd>setfarmlevel <level><088>}
            };
            #else {
                #var craft_farming[data][auto_mode] all;
                #echo {<ffa>Starting AUTO FARM ALL mode - Farming until complete!<088>};
                start_auto_farming
            }
        };
        #case {"cxp"} {
            #if {$craft_farming[data][farming_level] == 0} {
                #echo {<ffa>Please set your farming level first: <ffc>setfarmlevel <level><088>}
            };
            #else {
                #var craft_farming[data][auto_mode] cxp;
                #echo {<ffa>Starting FARM CXP mode - CXP farms only!<088>};
                start_auto_farming
            }
        };
        #default {
            #echo {<faa>Invalid option: <fff>%1<088>};
            #echo {<feb>Type <ccd>farm<feb> for usage information<088>}
        }
    }
};

#alias setfarmlevel {
    #if {"%1" == ""} {
        #echo {<faa>Current farming level: <fff>$craft_farming[data][farming_level]<088>};
        #echo {<feb>Usage: <ccd>setfarmlevel <level><088>}
    };
    #else {
        #var craft_farming[data][farming_level] {%1};
        #echo {<ffa>Farming level set to: <fff>%1<088>};
        
        #nop Calculate available farms;
        #local farm_count 0;
        #loop {1} {15} {tmpfarm} {
            #if {%1 >= $craft_farming[farmland][min][$tmpfarm] && %1 <= $craft_farming[farmland][max][$tmpfarm]} {
                #math farm_count {$farm_count + 1}
            }
        };
        
        #echo {<feb>Available farms: <fff>$farm_count<feb> farms unlocked<088>}
    }
};

#alias stopauto {
    #if {$craft_farming[data][auto_active] == 1} {
        #echo {<faa>Stopping auto-farming...<088>};
        stop_auto_farming
    };
    #else {
        #echo {<feb>Auto-farming is not currently active<088>}
    }
};

