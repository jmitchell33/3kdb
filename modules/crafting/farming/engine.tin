    };
    
    #echo {<faa>$border<088>};
    #echo {<ccd>Plant: <ffa>$craft_farming[data][plant]  <ccd>Round: <ffa>$craft_farming[data][plantround]  <ccd>Growth: <ffa>$craft_farming[data][ideal_growth]%  <ccd>Size: <ffa>$craft_farming[data][plant_size]<088>};
    #echo {<faa>----------------------------------------------------------------------<088>};
    #echo {<ccd>   DA    GO    WH    YE    H2    BU    WE    MU    OX    HY<088>};
    #echo {<bea>   %-5s %-5s %-5s %-5s %-5s %-5s %-5s %-5s %-5s %-5s<088>} {$craft_farming[data][dark]} {$craft_farming[data][gold]} {$craft_farming[data][white]} {$craft_farming[data][glisten]} {$craft_farming[data][water]} {$craft_farming[data][bugs]} {$craft_farming[data][weeds]} {$craft_farming[data][mushrooms]} {$craft_farming[data][oximeter]} {$craft_farming[data][hygrometer]};
    #echo {<faa>----------------------------------------------------------------------<088>};
    #echo {<ccd>Contrist I-IV: <bea>%-5s %-5s %-5s %-5s  <ccd>Nutri I-IV: <bea>%-5s %-5s %-5s %-5s<088>} {$craft_farming[data][contristometer_1]} {$craft_farming[data][contristometer_2]} {$craft_farming[data][contristometer_3]} {$craft_farming[data][contristometer_4]} {$craft_farming[data][nutriometer_1]} {$craft_farming[data][nutriometer_2]} {$craft_farming[data][nutriometer_3]} {$craft_farming[data][nutriometer_4]};
    #echo {<ccd>Goblins: Green: <bea>%-4s <ccd>Red: <bea>%-4s <ccd>Blue: <bea>%-4s <ccd>Orange: <bea>%-4s<088>} {$craft_farming[data][goblin_green]} {$craft_farming[data][goblin_red]} {$craft_farming[data][goblin_blue]} {$craft_farming[data][goblin_orange]};
    #echo {<faa>$border<088>};
    #echo {<ccd>Tool: <ffa>$craft_farming[data][tool_type]  <ccd>Paused: <ffa>$pause_text  <ccd>Mode: <ffa>$mode_text  <ccd>Level: <ffa>$craft_farming[data][farming_level]  <ccd>Harvests: <ffa>$craft_farming[data][harvest_count]<088>};
    #echo {<faa>$border<088>}
};

#alias randomfarm {
    #if {$craft_farming[data][farming_level] == 0} {
        #echo {<faa>Error:<fff> Farming level not set. Type 'craftstats' first.<088>};
        #return
    };
    
    #if {"$craft_farming[data][plant]" == "None"} {
        #echo {<faa>Error:<fff> No plant identified. Use 'f2' or 'lapt' first.<088>};
        #return
    };
    
    #if {$craft_farming[data][plant_min_skill] > $craft_farming[data][farming_level]} {
        #echo {<faa>Error:<fff> Plant level ($craft_farming[data][plant_min_skill]) is too high for your farming level ($craft_farming[data][farming_level]).<088>};
        #return
    };
    
    #var craft_farming[data][paused] 0;
    #var craft_farming[random][active] 1;
    #list craft_farming[random][log] clear;
    
    #echo {<caf>======================================<088>};
    #echo {<ffa>  Random Farming Activated<088>};
    #echo {<caf>======================================<088>};
    #echo {<feb>Plant: <fff>$craft_farming[data][plant]<088>};
    #echo {<feb>Min Level: <fff>$craft_farming[data][plant_min_skill]<088>};
    #echo {<feb>Your Level: <fff>$craft_farming[data][farming_level]<088>};
    #echo {<caf>======================================<088>};
    
    execute_random_round
};

#alias execute_random_round {
    #local tmp_random_growth {$craft_farming[data][ideal_growth]};
    #local tmp_random_level {$craft_farming[data][farming_level]};
    #local tmp_random_round {$craft_farming[data][plantround]};
    #local tmp_random_plant_level {$craft_farming[data][plant_min_skill]};
    
    #nop Calculate complexity based on plant level;
    #local tmp_random_complexity 1;
    #if {$tmp_random_plant_level >= 60} {
        #math tmp_random_complexity 5
    };
    #elseif {$tmp_random_plant_level >= 40} {
        #math tmp_random_complexity 4
    };
    #elseif {$tmp_random_plant_level >= 20} {
        #math tmp_random_complexity 3
    };
    #elseif {$tmp_random_plant_level >= 10} {
        #math tmp_random_complexity 2
    };
    
    #nop Determine tool availability;
    #local tmp_random_can_use_tools 0;
    #local tmp_random_can_feed_gremlins 0;
    
    #if {$tmp_random_level >= 10} {
        #var tmp_random_can_use_tools 1
    };
    
    #if {$tmp_random_level >= 15} {
        #var tmp_random_can_feed_gremlins 1
    };
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<ccd>DEBUG: Round $tmp_random_round | Growth $tmp_random_growth% | Complexity $tmp_random_complexity<088>}
    };
    
    #nop Round 0 - Initial setup;
    #if {$tmp_random_round == 0} {
        #local tmp_random_log {};
        #format tmp_random_log {Round %-2d: stake claim} {$tmp_random_round};
        #list craft_farming[random][log] add {$tmp_random_log};
        sne stake claim;
        
        #nop Base fertilizers - always available;
        #local tmp_random_amt {};
        #local tmp_random_rnd 0;
        #math tmp_random_rnd {1d3};
        
        #switch {$tmp_random_rnd} {
            #case {1} {#var tmp_random_amt {little}};
            #case {2} {#var tmp_random_amt {some}};
            #case {3} {#var tmp_random_amt {lots}}
        };
        
        #format tmp_random_log {Round %-2d: fertilize %s hippie fertilizer} {$tmp_random_round} {$tmp_random_amt};
        #list craft_farming[random][log] add {$tmp_random_log};
        fertilize $tmp_random_amt hippie fertilizer;
        
        #math tmp_random_rnd {1d3};
        #switch {$tmp_random_rnd} {
            #case {1} {#var tmp_random_amt {little}};
            #case {2} {#var tmp_random_amt {some}};
            #case {3} {#var tmp_random_amt {lots}}
        };
        
        #format tmp_random_log {Round %-2d: water %s wayhaven water} {$tmp_random_round} {$tmp_random_amt};
        #list craft_farming[random][log] add {$tmp_random_log};
        water $tmp_random_amt wayhaven water;
        
        #format tmp_random_log {Round %-2d: grow plant} {$tmp_random_round};
        #list craft_farming[random][log] add {$tmp_random_log};
        sne grow plant;
        #return
    };
    
    #nop Subsequent rounds - scale actions based on complexity;
    #local tmp_random_num_actions 0;
    #math tmp_random_num_actions {$tmp_random_complexity + 1d3};
    
    #nop Build action pool as a table with cmd and item;
    #local tmp_random_pool {};
    #list tmp_random_pool create {};
    #list tmp_random_pool add {{cmd}{fertilize}{item}{alphabet fertilizer}};
    #list tmp_random_pool add {{cmd}{fertilize}{item}{hippie fertilizer}};
    #list tmp_random_pool add {{cmd}{fertilize}{item}{smurfy fertilizer}};
    #list tmp_random_pool add {{cmd}{fertilize}{item}{happy ed's fertilizer}};
    #list tmp_random_pool add {{cmd}{water}{item}{gulf of mexico water}};
    #list tmp_random_pool add {{cmd}{water}{item}{atlantis water}};
    #list tmp_random_pool add {{cmd}{water}{item}{wayhaven water}};
    #list tmp_random_pool add {{cmd}{water}{item}{r'lyeh water}};
    
    #if {$tmp_random_growth < 50} {
        #list tmp_random_pool add {{cmd}{spray}{item}{hunch pesticide}};
        #list tmp_random_pool add {{cmd}{spray}{item}{ant cave pesticide}};
        #list tmp_random_pool add {{cmd}{spray}{item}{murus faralain pesticide}};
        #list tmp_random_pool add {{cmd}{spray}{item}{mount perplexus pesticide}}
    };
    
    #if {$tmp_random_can_use_tools == 1} {
        #list tmp_random_pool add {{cmd}{aerate}{item}{detroit air}};
        #list tmp_random_pool add {{cmd}{aerate}{item}{ryogi-pei air}};
        #list tmp_random_pool add {{cmd}{aerate}{item}{serinth air}};
        #list tmp_random_pool add {{cmd}{aerate}{item}{genlab air}};
        #list tmp_random_pool add {{cmd}{spread}{item}{cowville neutralizer}};
        #list tmp_random_pool add {{cmd}{spread}{item}{der'thalas neutralizer}};
        #list tmp_random_pool add {{cmd}{spread}{item}{garou neutralizer}};
        #list tmp_random_pool add {{cmd}{spread}{item}{burns brand neutralizer}}
    };
    
    #list tmp_random_pool shuffle;
    
    #nop Execute random actions;
    #loop {1} {$tmp_random_num_actions} {tmp_random_idx} {
        #if {$tmp_random_idx <= &tmp_random_pool[]} {
            #local tmp_random_action {$tmp_random_pool[$tmp_random_idx]};
            #local tmp_random_cmd {$tmp_random_action[cmd]};
            #local tmp_random_item {$tmp_random_action[item]};
            #local tmp_random_amt {};
            #local tmp_random_log {};
            
            #local tmp_random_rnd 0;
            #math tmp_random_rnd {1d3};
            #switch {$tmp_random_rnd} {
                #case {1} {#var tmp_random_amt {little}};
                #case {2} {#var tmp_random_amt {some}};
                #case {3} {#var tmp_random_amt {lots}}
            };
            
            #format tmp_random_log {Round %-2d: %s %s %s} {$tmp_random_round} {$tmp_random_cmd} {$tmp_random_amt} {$tmp_random_item};
            #list craft_farming[random][log] add {$tmp_random_log};
            
            $tmp_random_cmd $tmp_random_amt $tmp_random_item
        }
    };
    
    #nop Use tools if available and complexity warrants it;
    #if {$tmp_random_can_use_tools == 1 && $tmp_random_complexity >= 2} {
        #local tmp_random_rnd 0;
        #local tmp_random_log {};
        
        #math tmp_random_rnd {1d2};
        #if {$tmp_random_rnd == 1} {
            #format tmp_random_log {Round %-2d: depress oximeter button} {$tmp_random_round};
            #list craft_farming[random][log] add {$tmp_random_log};
            sne depress oximeter button
        };
        
        #math tmp_random_rnd {1d2};
        #if {$tmp_random_rnd == 1} {
            #format tmp_random_log {Round %-2d: push hygrometer button} {$tmp_random_round};
            #list craft_farming[random][log] add {$tmp_random_log};
            sne push hygrometer button
        }
    };
    
    #nop Feed gremlins if high enough level and complexity;
    #if {$tmp_random_can_feed_gremlins == 1 && $tmp_random_complexity >= 3} {
        #local tmp_random_rnd 0;
        #math tmp_random_rnd {1d4};
        #if {$tmp_random_rnd >= 3} {
            #local tmp_random_gremlin_count 0;
            #math tmp_random_gremlin_count {1d2};
            
            #loop {1} {$tmp_random_gremlin_count} {tmp_random_grem} {
                #local tmp_random_color {};
                #local tmp_random_log {};
                
                #math tmp_random_rnd {1d4};
                
                #switch {$tmp_random_rnd} {
                    #case {1} {#var tmp_random_color {red}};
                    #case {2} {#var tmp_random_color {blue}};
                    #case {3} {#var tmp_random_color {green}};
                    #case {4} {#var tmp_random_color {orange}}
                };
                
                #format tmp_random_log {Round %-2d: feed %s gremlin} {$tmp_random_round} {$tmp_random_color};
                #list craft_farming[random][log] add {$tmp_random_log};
                sne feed $tmp_random_color gremlin
            }
        }
    }
};

