    feed blue;
    feed green;
    feed orange;
    
    #8 sne jab type IV nutriometer;
    feed red;
    feed blue;
    feed green;
    feed orange;
    
    #8 sne cantilever type I contristometer;
    feed red;
    feed blue;
    feed green;
    feed orange;
    
    #8 sne cantilever type II contristometer;
    feed red;
    feed blue;
    feed green;
    feed orange;
    
    #8 sne cantilever type III contristometer;
    feed red;
    feed blue;
    feed green;
    feed orange;
    
    #8 sne cantilever type IV contristometer;
    feed red;
    feed blue;
    feed green;
    feed orange;
    
    farm_look
};

