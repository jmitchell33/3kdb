#nop ============================================;
#nop MESSAGE HANDLING ALIASES;
#nop ============================================;

#alias do_grow_message {
    #if {$craft_farming[data][echo] == 1} {
        #echo {<ffa>Round results: Growth <fff>(msg %1)<088>}
    };
    #math craft_farming[data][plantround] {$craft_farming[data][plantround] + 1};
    
    #if {$craft_farming[data][farm_status] == 1} {
        show_farm_status
    };
    
    #if {$idle_flag} {
        farm_idle_stop
    };
    #else {
        plantaction
    }
};

#alias do_neutral_message {
    #if {$craft_farming[data][echo] == 1} {
        #echo {<feb>Round results: NO Growth <fff>(msg %1)<088>}
    };
    #math craft_farming[data][plantround] {$craft_farming[data][plantround] + 1};
    
    #if {$craft_farming[data][farm_status] == 1} {
        show_farm_status
    };
    
    #if {$idle_flag} {
        farm_idle_stop
    };
    #else {
        plantaction
    }
};

#alias do_shrink_message {
    #if {$craft_farming[data][echo] == 1} {
        #echo {<faa>Round results: Shrinking <fff>(msg %1)<088>}
    };
    #math craft_farming[data][plantround] {$craft_farming[data][plantround] + 1};
    
    #if {$craft_farming[data][farm_status] == 1} {
        show_farm_status
    };
    
    #if {$idle_flag} {
        farm_idle_stop
    };
    #else {
        plantaction
    }
};

#alias do_death_message {
    #if {$idle_flag} {
        farm_idle_stop;
        #var craft_farming[data][paused] 0;
        reset_farm_variables;
        #return
    };

    stop_farming;
    
    #if {$craft_farming[random][active] == 1} {
        #echo {<faa>Random farming failed - plant died.<088>};
        #var craft_farming[random][active] 0;
        #var craft_farming[random][log] {};
        #list craft_farming[random][actions] clear
    };
    
    reset_farm_variables;
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<faa>===========================================<088>};
        #echo {<faa>Round results: Dead <fff>(msg %1)<088>};
        #echo {<fff>Farming stopped and variables reset<088>};
        #echo {<faa>===========================================<088>}
    };
    
    #if {$craft_farming[data][auto_active] == 1} {
        continue_auto_farming
    }
};

#nop ============================================;
#nop MAIN PLANT ACTION ALIAS;
#nop ============================================;

#alias plantaction {
    #if {$craft_farming[data][plantround] == 0} {
        #format {craft_farming[pace][started]} {%T};
        #var craft_farming[pace][sent] 0
    };
    
    #nop Recipes only skip measuring while this is on, typed commands are never skipped;
    #var craft_farming[pace][in_recipe] 1;
    
    #if {$craft_farming[data][paused] == 0} {
        #nop Check if random farming is active;
        #if {$craft_farming[random][active] == 1} {
            execute_random_round;
            #var craft_farming[pace][in_recipe] 0;
            #return
        };
        #switch {"$craft_farming[data][plant]"} {
            #case {"white potato"} {farml1whitepotato};
            #case {"broccoli"} {farml1broccoli};
            #case {"green pepper"} {farml1greenpepper};
            #case {"beefsteak tomato"} {farml1beefsteaktomato};
            #case {"mcintosh apple"} {farml1mcintoshapple};
            #case {"yellow bean"} {farml1yellowbean};
            #case {"blueberry"} {farml2blueberry};
            #case {"green bean"} {farml2greenbean};
            #case {"zucchini"} {farml2zucchini};
            #case {"cauliflower"} {farml2cauliflower};
            #case {"roma tomato"} {farml2romatomato};
            #case {"green apple"} {farml2greenapple};
            #case {"valencia orange"} {farml2valencia};
            #case {"raspberry"} {farml2raspberry};
            #case {"red pepper"} {farml2redpepper};
            #case {"red potato"} {farml2redpotato};
            #case {"tangerine"} {farml3tangerine};
            #case {"peach"} {farml3peach};
            #case {"orange pepper"} {farml3orangepepper};
            #case {"nantes carrot"} {farml3nantescarrot};
            #case {"snap pea"} {farml4snappea};
            #case {"blackberry"} {farml5blackberry};
            #case {"canteloupe"} {farml5canteloupe};
            #case {"navel orange"} {farml5navelorange};
            #case {"new potato"} {farml5newpotato};
            #case {"eggplant"} {farml6eggplant};
            #case {"avocado"} {farml6avocado};
            #case {"blue potato"} {farml6bluepotato};
            #case {"bosc pear"} {farml6boscpear};
            #case {"jalapeno pepper"} {farml6jalapeno};
            #case {"yellow pepper"} {farml7yellowpepper};
            #case {"alfalfa sprout"} {farml8alfalfasprout};
            #case {"red plum"} {farml8redplum};
            #case {"mandarin orange"} {farml8mandarin};
            #case {"boysenberry"} {farml9boysenberry};
            #case {"baby eggplant"} {farml10babyeggplant};
            #case {"english cucumber"} {farml11englishcucumber};
            #case {"banana"} {farml11banana};
            #case {"white plum"} {farml8whiteplum};
            #case {"yukon gold potato"} {farml11yukongold};
            #case {"mottled pepper"} {farml12mottledpepper};
            #case {"brussel sprout"} {farml14brusselsprout};
            #case {"bartlet pear"} {farml14bartletpear};
            #case {"mango"} {farml15mango};
            #case {"russet potato"} {farml16russetpotato};
            #case {"gooseberry"} {farml17gooseberry};
            #case {"spaghetti squash"} {farml18spaghetti};
            #case {"asparagus"} {farml19asparagus};
            #case {"lychee"} {farml20lychee};
