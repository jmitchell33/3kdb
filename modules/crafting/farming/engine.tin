#nop ============================================================================;
#nop    3K FARMING SCRIPT - TINTIN++ VERSION;
#nop    Everything that makes the farmer run. Loaded by farming/index.tin;
#nop    Help is in help.tin. Recipes are in recipes_farmNN.tin, one file per farm;
#nop ============================================================================;

#nop ============================================;
#nop VARIABLE INITIALIZATION;
#nop ============================================;

#nop set this to 0 if your not a 3kdb user or update the speedruns, farm_land1 etc to yours in section 9;
#var craft_farming[data][travel_toggle] 1;

#nop core variables;

#nop plant name;
#var craft_farming[data][plant] None;

#nop plant min and trivial levels;
#var craft_farming[data][plant_min_skill] 0;
#var craft_farming[data][plant_trivial_skill] 0;

#nop current plant round;
#var craft_farming[data][plantround] 0;

#nop echo toggle state (debuging);
#var craft_farming[data][echo] 0;

#nop ideal plant growth percentage;
#var craft_farming[data][ideal_growth] 0;

#nop pause state;
#var craft_farming[data][paused] 0;

#nop tool type;
#var craft_farming[data][tool_type] {};

#nop toggle for farm status (on by default);
#var craft_farming[data][farm_status] 1;

#nop measurements;
#var craft_farming[data][dark] {0};
#var craft_farming[data][gold] {0};
#var craft_farming[data][white] {0};
#var craft_farming[data][glisten] {0};
#var craft_farming[data][water] {0};
#var craft_farming[data][bugs] {0};
#var craft_farming[data][weeds] {0};
#var craft_farming[data][mushrooms] {0};

#nop contristometer 1;
#var craft_farming[data][contristometer_1] {0};

#nop contristometer 2;
#var craft_farming[data][contristometer_2] {0};

#nop contristometer 3;
#var craft_farming[data][contristometer_3] {0};

#nop contristometer 4;
#var craft_farming[data][contristometer_4] {0};

#nop nutriometer 1;
#var craft_farming[data][nutriometer_1] {0};

#nop nutriometer 2;
#var craft_farming[data][nutriometer_2] {0};

#nop nutriometer 3;
#var craft_farming[data][nutriometer_3] {0};

#nop nutriometer 4;
#var craft_farming[data][nutriometer_4] {0};

#nop oximeter;
#var craft_farming[data][oximeter] {0};

#nop hygrometer;
#var craft_farming[data][hygrometer] {0};

#nop goblins;
#var craft_farming[data][goblin_green] {0};
#var craft_farming[data][goblin_red] {0};
#var craft_farming[data][goblin_blue] {0};
#var craft_farming[data][goblin_orange] {0};

#nop Harvest tracking variables;
#var craft_farming[data][harvest_count] 0;
#list craft_farming[harvests] create {};

#nop Auto-Farming System Variables;
#var craft_farming[data][farming_level] 0;
#var craft_farming[data][auto_mode] manual;
#var craft_farming[data][auto_active] 0;
#var craft_farming[data][current_farm_num] 0;
#var craft_farming[data][max_farms] 0;
#var craft_farming[data][current_farm_id] 0;
#var craft_farming[data][path_index] 0;
#var craft_farming[data][room_has_plant] 0;
#var craft_farming[data][plant_owner] {};
#var craft_farming[data][go_toggle] 0;

#nop Farm land level ranges;
#var craft_farming[farmland][min][1] 1;
#var craft_farming[farmland][min][2] 2;
#var craft_farming[farmland][min][3] 4;
#var craft_farming[farmland][min][4] 13;
#var craft_farming[farmland][min][5] 17;
#var craft_farming[farmland][min][6] 21;
#var craft_farming[farmland][min][7] 28;
#var craft_farming[farmland][min][8] 32;
#var craft_farming[farmland][min][9] 37;
#var craft_farming[farmland][min][10] 43;
#var craft_farming[farmland][min][11] 49;
#var craft_farming[farmland][min][12] 60;
#var craft_farming[farmland][min][13] 70;
#var craft_farming[farmland][min][14] 80;
#var craft_farming[farmland][min][15] 90;

#var craft_farming[farmland][max][1] 6;
#var craft_farming[farmland][max][2] 11;
#var craft_farming[farmland][max][3] 13;
#var craft_farming[farmland][max][4] 24;
#var craft_farming[farmland][max][5] 30;
#var craft_farming[farmland][max][6] 35;
#var craft_farming[farmland][max][7] 39;
#var craft_farming[farmland][max][8] 43;
#var craft_farming[farmland][max][9] 50;
#var craft_farming[farmland][max][10] 54;
#var craft_farming[farmland][max][11] 63;
#var craft_farming[farmland][max][12] 74;
#var craft_farming[farmland][max][13] 80;
#var craft_farming[farmland][max][14] 90;
#var craft_farming[farmland][max][15] 100;

#nop CXP-giving farms;
#var craft_farming[farmland][cxp][1] 1;
#var craft_farming[farmland][cxp][2] 1;
#var craft_farming[farmland][cxp][3] 1;
#var craft_farming[farmland][cxp][4] 1;
#var craft_farming[farmland][cxp][5] 1;
#var craft_farming[farmland][cxp][6] 1;
#var craft_farming[farmland][cxp][7] 1;
#var craft_farming[farmland][cxp][8] 1;
#var craft_farming[farmland][cxp][9] 1;
#var craft_farming[farmland][cxp][10] 1;
#var craft_farming[farmland][cxp][11] 1;
#var craft_farming[farmland][cxp][12] 1;
#var craft_farming[farmland][cxp][13] 1;
#var craft_farming[farmland][cxp][14] 1;
#var craft_farming[farmland][cxp][15] 1;

#var craft_farming[farm_path] {e;e;e;n;w;w;n;e;e;n;w;w;w;s;s;s};
#list craft_farming[farm_list] create {};
#list craft_farming[path_directions] create {};

#nop Plant size tracking;
#var craft_farming[data][plant_size] {sproutling};

#nop Size to percentage mapping;
#var craft_farming[sizes][sproutling] 5;
#var craft_farming[sizes][tiny] 15;
#var craft_farming[sizes][puny] 25;
#var craft_farming[sizes][little] 35;
#var craft_farming[sizes][knee-height] 45;
#var craft_farming[sizes][chest-height] 55;
#var craft_farming[sizes][person-sized] 65;
#var craft_farming[sizes][towering] 75;
#var craft_farming[sizes][massive] 85;
#var craft_farming[sizes][GIGANTIC] 95;
#var craft_farming[sizes][harvestable] 100;

#nop Target commands a minute, averaged over a plant and the rest after it. 0 turns rests off;
#var craft_farming[pace][apm] 25;
#var craft_farming[pace][sent] 0;
#var craft_farming[pace][started] 0;
#var craft_farming[pace][rest] 0;
#var craft_farming[pace][in_recipe] 0;

#nop Random plant growing variables;
#var craft_farming[random][active] 0;
#list craft_farming[random][log] create {};
#list craft_farming[random][actions] create {};

#nop ============================================;
#nop TRIGGERS (ACTIONS);
#nop ============================================;

#nop farm level capture using the mud command craftstats;
#action {^  Farming    : %s%d / %s%d \(%s%d\%\) \[%s%*%s\]$} {
    #var craft_farming[data][farming_level] %2;
    setfarmlevel $craft_farming[data][farming_level];
    #if {$craft_farming[data][echo] == 1} {
        #echo {<ffa>Farming level automatically detected:<088> %2}
    }
} {2};

#nop Auto-detect farming level on load;
#delay 1 {
    #if {!$idle_flag} {
        #send craftstats
    }
};

#action {^Type: %1$} {
    #if {$idle_flag} {
        farm_idle_stop
    };
    
    #if {$craft_farming[data][auto_active] == 1} {
        #local plant_name %1;
        save_plant {$plant_name};
        
        #nop Check if we have a recipe by looking in plantaction;
        #local has_recipe 0;
        
        #nop Check against known plants;
        #switch {"$craft_farming[data][plant]"} {
            #case {"white potato"} {#var has_recipe 1};
            #case {"broccoli"} {#var has_recipe 1};
            #case {"green pepper"} {#var has_recipe 1};
            #case {"beefsteak tomato"} {#var has_recipe 1};
            #case {"mcintosh apple"} {#var has_recipe 1};
            #case {"yellow bean"} {#var has_recipe 1};
            #case {"blueberry"} {#var has_recipe 1};
            #case {"green bean"} {#var has_recipe 1};
            #case {"zucchini"} {#var has_recipe 1};
            #case {"cauliflower"} {#var has_recipe 1};
            #case {"roma tomato"} {#var has_recipe 1};
            #case {"green apple"} {#var has_recipe 1};
            #case {"valencia orange"} {#var has_recipe 1};
            #case {"raspberry"} {#var has_recipe 1};
            #case {"red pepper"} {#var has_recipe 1};
            #case {"red potato"} {#var has_recipe 1};
            #case {"tangerine"} {#var has_recipe 1};
            #case {"peach"} {#var has_recipe 1};
            #case {"orange pepper"} {#var has_recipe 1};
            #case {"nantes carrot"} {#var has_recipe 1};
            #case {"snap pea"} {#var has_recipe 1};
            #case {"blackberry"} {#var has_recipe 1};
            #case {"canteloupe"} {#var has_recipe 1};
            #case {"navel orange"} {#var has_recipe 1};
            #case {"new potato"} {#var has_recipe 1};
            #case {"eggplant"} {#var has_recipe 1};
            #case {"avocado"} {#var has_recipe 1};
            #case {"blue potato"} {#var has_recipe 1};
            #case {"bosc pear"} {#var has_recipe 1};
            #case {"jalapeno pepper"} {#var has_recipe 1};
            #case {"yellow pepper"} {#var has_recipe 1};
            #case {"alfalfa sprout"} {#var has_recipe 1};
            #case {"red plum"} {#var has_recipe 1};
            #case {"mandarin orange"} {#var has_recipe 1};
            #case {"boysenberry"} {#var has_recipe 1};
            #case {"baby eggplant"} {#var has_recipe 1};
            #case {"english cucumber"} {#var has_recipe 1};
            #case {"banana"} {#var has_recipe 1};
            #case {"white plum"} {#var has_recipe 1};
            #case {"yukon gold potato"} {#var has_recipe 1};
            #case {"mottled pepper"} {#var has_recipe 1};
            #case {"brussel sprout"} {#var has_recipe 1};
            #case {"bartlet pear"} {#var has_recipe 1};
            #case {"mango"} {#var has_recipe 1};
            #case {"russet potato"} {#var has_recipe 1};
            #case {"gooseberry"} {#var has_recipe 1};
            #case {"spaghetti squash"} {#var has_recipe 1};
            #case {"asparagus"} {#var has_recipe 1};
            #case {"lychee"} {#var has_recipe 1};
            #case {"habanero pepper"} {#var has_recipe 1};
            #case {"lentil"} {#var has_recipe 1};
            #case {"pomegranate"} {#var has_recipe 1};
            #case {"kiwi"} {#var has_recipe 1};
            #case {"salmonberry"} {#var has_recipe 1};
            #case {"persimmon"} {#var has_recipe 1};
            #case {"ginger"} {#var has_recipe 1};
            #case {"honey sugar apple"} {#var has_recipe 1};
            #case {"tomatillo"} {#var has_recipe 1};
            #case {"bamboo shoot"} {#var has_recipe 1};
            #case {"yellow carrot"} {#var has_recipe 1};
            #case {"guava"} {#var has_recipe 1};
            #case {"quince"} {#var has_recipe 1};
            #case {"thimbleberry"} {#var has_recipe 1};
            #case {"chokecherry"} {#var has_recipe 1};
            #case {"coconut"} {#var has_recipe 1};
            #case {"wasabi"} {#var has_recipe 1};
            #case {"luffa"} {#var has_recipe 1};
            #case {"radicchio"} {#var has_recipe 1};
            #case {"white celery"} {#var has_recipe 1};
            #case {"kaffir lime"} {#var has_recipe 1};
            #case {"ceylon spinach"} {#var has_recipe 1};
            #case {"artichoke"} {#var has_recipe 1};
            #case {"taro"} {#var has_recipe 1};
            #case {"loganberry"} {#var has_recipe 1};
            #case {"chickpea"} {#var has_recipe 1};
            #case {"papaya"} {#var has_recipe 1};
            #case {"white gooseberry"} {#var has_recipe 1};
            #case {"fava bean"} {#var has_recipe 1};
            #case {"passion fruit"} {#var has_recipe 1};
            #case {"prickly pear"} {#var has_recipe 1};
            #case {"hubbard squash"} {#var has_recipe 1};
            #case {"fennel"} {#var has_recipe 1};
            #case {"pomelo"} {#var has_recipe 1};
            #case {"buffaloberry"} {#var has_recipe 1};
            #case {"canna"} {#var has_recipe 1};
            #case {"guar"} {#var has_recipe 1};
            #case {"bok choy"} {#var has_recipe 1};
            #case {"cloudberry"} {#var has_recipe 1};
            #case {"chayote"} {#var has_recipe 1};
            #case {"mechanized broccoli"} {#var has_recipe 1};
            #case {"holy onion"} {#var has_recipe 1};
            #case {"soybean"} {#var has_recipe 1};
            #case {"pink grape"} {#var has_recipe 1};
            #case {"pawpaw"} {#var has_recipe 1};
            #case {"date"} {#var has_recipe 1};
            #case {"dragonfruit"} {#var has_recipe 1};
            #case {"vanilla"} {#var has_recipe 1};
            #case {"yam"} {#var has_recipe 1};
            #case {"apricot"} {#var has_recipe 1};
            #case {"shallot"} {#var has_recipe 1};
            #case {"honorable tangelo"} {#var has_recipe 1};
            #case {"cybernetic lettuce"} {#var has_recipe 1};
            #default {#var has_recipe 0}
        };
        
        #if {$has_recipe == 1} {
            #local plant_min {$craft_farming[data][plant_min_skill]};
            
            #if {$craft_farming[data][farming_level] < $plant_min} {
                #echo {<faa>Plant level ($plant_min) too high - skipping<088>};
                farm_walk_next_room
            };
            #else {
                #if {$craft_farming[data][echo] == 1} {
                    #echo {<ffa>Recipe found: $craft_farming[data][plant]<088>}
                };
                start_farming
            }
        };
        #else {
            #echo {<faa>No recipe for: %1 - skipping<088>};
            farm_walk_next_room
        }
    };
    #else {
        #local plant_name %1;
        save_plant {$plant_name};
        #if {$craft_farming[data][echo] == 1} {
            #echo {<ffa>Plant identified:<088> $craft_farming[data][plant]}
        }
    }
} {2};

#action {^Minimum Skill: %d$} {
    #var craft_farming[data][plant_min_skill] %1
} {2};

#action {^Trivial Skill: %d$} {
    #var craft_farming[data][plant_trivial_skill] %1;
    #if {$craft_farming[data][echo] == 1} {
        #echo {<ffc>Plant Skills: <fff>Min:$craft_farming[data][plant_min_skill] <ffc>Triv: <fff>$craft_farming[data][plant_trivial_skill]<088>}
    }
} {2};

#nop plant detection - basic (no owner);
#action {^-i-A sproutling %* plant.$} {
    #var craft_farming[data][room_has_plant] 1;
    
    #nop Capture size and set growth percentage;
    #var craft_farming[data][plant_size] sproutling;
    
    #if {&craft_farming[sizes][%1]} {
        #var craft_farming[data][ideal_growth] {$craft_farming[sizes][%1]}
    };
    #else {
        #var craft_farming[data][ideal_growth] 5
    };
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<afa>Found plant: %1 %2 (Growth: $craft_farming[data][ideal_growth]%%)<088>}
    }
} {2};

#nop plant detection - with owner (captures size and updates growth);
#action {^-i-A {sproutling|tiny|puny|little|knee-height|chest-height|person-sized|towering|massive|GIGANTIC|harvestable} %* plant, owned by %*.$} {
    #var craft_farming[data][room_has_plant] 1;
    #var craft_farming[data][plant_owner] {%3};
    
    #nop Capture size and set growth percentage;
    #var craft_farming[data][plant_size] {%1};
    
    #if {&craft_farming[sizes][%1]} {
        #var craft_farming[data][ideal_growth] {$craft_farming[sizes][%1]}
    };
    #else {
        #var craft_farming[data][ideal_growth] 5
    };
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<afa>Found plant: %1 %2 owned by %3 (Growth: $craft_farming[data][ideal_growth]%%)<088>}
    };
    
    #if {$craft_farming[data][farm_status] == 1} {
        show_farm_status
    }
} {2};

#nop harvest ready;
#action {^The plant shivers, nudges, and moves its leaves into its final position} {
    #if {$idle_flag} {
        farm_idle_stop;
        #return
    };
    
    stop_farming;
    
    #if {$craft_farming[random][active] == 1} {
        save_random_success
    };
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<ffa>Harvested: Ready to harvest!<088>}
    };
    
    #if {$craft_farming[data][auto_active] == 1} {
        continue_auto_farming
    }
} {2};

#action {The spindly leaves of the %* plant come together%*} {
    #if {$idle_flag} {
        farm_idle_stop;
        #return
    };
    
    stop_farming;
    
    #if {$craft_farming[random][active] == 1} {
        save_random_success
    };
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<ffa>Harvested: Ready to harvest!<088>}
    };
    
    #if {$craft_farming[data][auto_active] == 1} {
        continue_auto_farming
    }
} {2};

#action {With the tinkling of a bell,%*} {
    #if {$idle_flag} {
        farm_idle_stop;
        #return
    };
    
    stop_farming;
    
    #if {$craft_farming[random][active] == 1} {
        save_random_success
    };
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<ffa>Harvested: Ready to harvest!<088>}
    };
    
    #if {$craft_farming[data][auto_active] == 1} {
        continue_auto_farming
    }
} {2};

#action {%*the plant is now ready to harvest!} {
    #if {$idle_flag} {
        farm_idle_stop;
        #return
    };
    
    stop_farming;
    
    #if {$craft_farming[random][active] == 1} {
        save_random_success
    };
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<ffa>Harvested: Ready to harvest!<088>}
    };
    
    #if {$craft_farming[data][auto_active] == 1} {
        continue_auto_farming
    }
} {2};

#nop harvest inventory tracking;
#action {^The %w %* tumbles to your feet.$} {
    #local quality {%1};
    #local crop_name {%2};
    #local full_name {$quality $crop_name};
    
    #nop Increment harvest count;
    #math craft_farming[data][harvest_count] {$craft_farming[data][harvest_count] + 1};
    
    #nop Track in harvest inventory;
    #if {&craft_farming[harvests][$full_name]} {
        #math craft_farming[harvests][$full_name] {$craft_farming[harvests][$full_name] + 1}
    };
    #else {
        #var craft_farming[harvests][$full_name] 1
    };
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<ffa>Harvested:<fff> $full_name (Total this session: $craft_farming[data][harvest_count])<088>}
    }
} {2};

#nop Growth Messages;
#action {%* flowers pop and rattle as they are hauled%*} {
    do_grow_message 1
} {2};

#action {With a triumphant scream, the %* plant explodes%*} {
    do_grow_message 2
} {2};

#action {The %* plant screams in delight%*} {
    do_grow_message 3
} {2};

#action {The faint smell of soap and cumin rises to your nose%*} {
    do_grow_message 4
} {2};

#action {The roots of the %* plant plungs into the ground%*} {
    do_grow_message 5
} {2};

#action {With a shift to the left, and a shift to the right,%*} {
    do_grow_message 6
} {2};

#action {The %* plan sighs tremendously, as if it was%*} {
    do_grow_message 7
} {2};

