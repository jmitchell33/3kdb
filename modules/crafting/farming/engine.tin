                #if {$craft_farming[data][echo] == 1} {
                    #echo {<faa>No recipe for: $craft_farming[data][plant]<088>}
                }
            }
        }
    };
    #var craft_farming[pace][in_recipe] 0
};

#nop Seconds to wait so this plant and its rest average out to the target APM;
#alias farm_rest_seconds {
    #local now 0;
    #format {now} {%T};
    #var craft_farming[pace][rest] 0;
    #if {$craft_farming[pace][apm] > 0} {
        #math craft_farming[pace][rest] {$craft_farming[pace][sent] * 60 / $craft_farming[pace][apm] - ($now - $craft_farming[pace][started])}
    };
    #if {$craft_farming[pace][rest] < 2} {
        #var craft_farming[pace][rest] 2
    }
};

#nop Deadman fired: stop auto-farming and stop tending the plant until the player says so;
#alias farm_idle_stop {
    #if {$craft_farming[data][auto_active] == 0 && ($craft_farming[data][plantround] == 0 || $craft_farming[data][paused] == 1)} {
        #return
    };
    
    #var craft_farming[data][auto_active] 0;
    #var craft_farming[data][auto_mode] {manual};
    #var craft_farming[data][current_farm_num] 0;
    #var craft_farming[data][path_index] 0;
    #var craft_farming[data][go_toggle] 0;
    #var craft_farming[data][paused] 1;
    farm_cancel_delays;
    #echo {<faa>Idle: farming stopped.<feb> <ccd>f4<feb> keeps tending this plant, <ccd>f5<feb> harvests and releases it, <ccd>fr all<feb> restarts auto-farming<088>}
};

#nop Cancels every pending farming delay: the rest timer and the farm_d_ walking and travel delays;
#alias farm_cancel_delays
{
    #undelay {farm_%*};
};

#nop Removes what farming creates while it runs, since class kill only removes what was loaded. farmer-off runs it;
#alias farm_clear_runtime
{
    farm_cancel_delays;
    #unaction {The ferryman says: Well, we're here! Good luck with your travels.};
    #unaction {The ferryman says: Well, here you are. I hope that you had a good time};
    #unaction {forms of life, but beyond the tracks, nothing else appears.};
    #unaction {world which has long since been extinct, destroyed, forgotten.};
    #unvar {crop_display};
    #unvar {total_line};
};

#nop Catches deadman during a rest or between rounds. Sends nothing to the game;
#ticker {farm_idle_watch} {
    #if {$idle_flag} {
        farm_idle_stop
    }
} {5};

#alias farmapm {
    #if {"%1" != ""} {
        #var craft_farming[pace][apm] {%1}
    };
    #echo {<ffa>Auto-farming rests between plants to average <fff>$craft_farming[pace][apm]<ffa> commands a minute (0 = no rests)<088>}
};

#nop ============================================;
#nop UTILITY ALIASES;
#nop ============================================;

#alias aerate {
    sne aerate %0
};

#alias fertilize {
    sne fertilize %0
};

#alias spread {
    sne spread %0
};

#alias spray {
    sne spray %0
};

#alias water {
    sne water %0
};

#alias sne {
    #if {$idle_flag} {
        farm_idle_stop;
        #return
    };
    
    #nop Measuring tools and goblins only report conditions and no recipe reads the result;
    #if {$craft_farming[pace][in_recipe] == 1 && "%0" == "{jab|cantilever|feed|push hygrometer|depress oximeter} %*"} {
        #return
    };
    
    #math craft_farming[pace][sent] {$craft_farming[pace][sent] + 1};
    #send {%0};
    #if {$craft_farming[data][echo] == 1} {
        #echo {<ffa>Debug:<088> %0}
    }
};

#alias farm_look {
    sne examine ground;
    sne examine insects;
    sne examine mushrooms;
    sne examine weeds;
    sne glance
};

#alias save_plant {
    #var craft_farming[data][plant] %0;
    #var craft_farming[data][plantround] 0
};

#alias stop_farming {
    #var craft_farming[data][paused] 0;
    #var craft_farming[data][ideal_growth] 0;
    #var craft_farming[data][plantround] 0;
    sne harvest;
    sne get all;
    sne stash all;
    sne releaseclaim
};

#alias togglepause {
    #if {$craft_farming[data][paused] == 0} {
        #if {$craft_farming[data][echo] == 1} {
            #echo {<faa>Pausing Automated Farming.<088>}
        };
        #var craft_farming[data][paused] 1
    };
    #else {
        #if {$craft_farming[data][echo] == 1} {
            #echo {<faa>Resuming Automated Farming.<088>}
        };
        #var craft_farming[data][paused] 0
    }
};

#alias reset_farm_variables {
    #var craft_farming[data][dark] {0};
    #var craft_farming[data][gold] {0};
    #var craft_farming[data][white] {0};
    #var craft_farming[data][glisten] {0};
    #var craft_farming[data][water] {0};
    #var craft_farming[data][bugs] {0};
    #var craft_farming[data][weeds] {0};
    #var craft_farming[data][mushrooms] {0};
    #var craft_farming[data][contristometer_1] {0};
    #var craft_farming[data][contristometer_2] {0};
    #var craft_farming[data][contristometer_3] {0};
    #var craft_farming[data][contristometer_4] {0};
    #var craft_farming[data][nutriometer_1] {0};
    #var craft_farming[data][nutriometer_2] {0};
    #var craft_farming[data][nutriometer_3] {0};
    #var craft_farming[data][nutriometer_4] {0};
    #var craft_farming[data][oximeter] {0};
    #var craft_farming[data][hygrometer] {0};
    #var craft_farming[data][goblin_green] {0};
    #var craft_farming[data][goblin_red] {0};
    #var craft_farming[data][goblin_blue] {0};
    #var craft_farming[data][goblin_orange] {0};
    #var craft_farming[data][ideal_growth] 0;
    #var craft_farming[data][plantround] 0;
    #var craft_farming[data][plant_size] {sproutling};
    
    #if {$craft_farming[data][echo] == 1} {
        #echo {<ffa>Farm variables reset to 0<088>}
    }
};

#alias reset_farm_full {
    reset_farm_variables;
    #var craft_farming[data][harvest_count] 0;
    #list craft_farming[harvests] clear;
    #var craft_farming[data][plant] None;
    #if {$craft_farming[data][echo] == 1} {
        #echo {<ffa>Full farm reset complete - all harvests cleared<088>}
    }
};

#alias start_farming {
    #if {"$craft_farming[data][plant]" != "None"} {
        #if {$craft_farming[data][echo] == 1} {
            #echo {Started automated farming for: $craft_farming[data][plant]}
        };
        #nop Call plantaction to start growing;
        plantaction
    };
    #else {
        #if {$craft_farming[data][echo] == 1} {
            #echo {No plant selected! Identify a plant first.}
        }
    }
};

#alias setgoblinvalue {
    #local tmpColor {%1};
    #local tmpValue {%2};
    
    #if {"$tmpColor" == "red"} {
        #var craft_farming[data][goblin_red] {$tmpValue}
    };
    #elseif {"$tmpColor" == "blue"} {
        #var craft_farming[data][goblin_blue] {$tmpValue}
    };
    #elseif {"$tmpColor" == "green"} {
        #var craft_farming[data][goblin_green] {$tmpValue}
    };
    #elseif {"$tmpColor" == "orange"} {
        #var craft_farming[data][goblin_orange] {$tmpValue}
    }
};

#alias farmgoods {
    #local border {====================================};
    #echo {<faa>$border<088>};
    #echo {<ffa>    Harvested Farm Goods<088>};
    #echo {<faa>$border<088>};
    
    #if {&craft_farming[harvests][] == 0} {
        #echo {<feb>  No harvests recorded this session<088>}
    };
    #else {
        #foreach {*craft_farming[harvests][%*]} {crop} {
            #format crop_display {<ccd>  %-3s <feb>%s} {$craft_farming[harvests][$crop]} {$crop};
            #echo {$crop_display<088>}
        }
    };
    
    #echo {<faa>$border<088>};
    #format total_line {<ccd>  Total Harvests: <fff>%s} {$craft_farming[data][harvest_count]};
    #echo {$total_line<088>};
    #echo {<faa>$border<088>}
};

