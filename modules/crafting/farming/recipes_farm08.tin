#nop Recipes for farm_land8 (levels 32-43);

#alias farml32honeysugarapple {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim
    };
    cleanplot3;
    feedsome;
    spread lots burns brand neutralizer;
    spread lots burns brand neutralizer;
    spread lots burns brand neutralizer;
    spread lots cowville neutralizer;
    spread lots cowville neutralizer;
    spread lots cowville neutralizer;
    addlittle2;
    addlittle2;
    #if {$craft_farming[data][plantround] == 0} {
        sne grow plant
    }
};

#alias farml34tomatillo {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots smurfy fertilizer;
        fertilize lots hippie fertilizer;
        water lots atlantis water;
        spread lots burns brand neutralizer;
        spray some mount perplexus pesticide;
        water lots mexico water;
        water lots mexico water;
        water lots mexico water;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        spray lots ant cave pesticide;
        spray lots ant cave pesticide;
        spray lots ant cave pesticide;
        spray lots ant cave pesticide;
        aerate lots detroit air;
        aerate lots detroit air;
        aerate lots detroit air;
        aerate lots detroit air;
        aerate lots genlab air;
        aerate lots genlab air;
        aerate lots genlab air;
        aerate lots genlab air;
        sne depress oximeter button;
        sne push hygrometer button;
        sne feed green;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize some alphabet fertilizer;
        fertilize little alphabet fertilizer;
        fertilize little hippie fertilizer;
        aerate little ryogi-pei air;
        water lots atlantis water;
        water little wayhaven water;
        spread some burns brand neutralizer;
        sne depress oximeter button;
        sne depress oximeter button;
        sne depress oximeter button;
        sne push hygrometer button;
        sne feed green
    }
};

#alias farml35bambooshoot {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots smurfy fertilizer;
        water lots mexico water;
        water lots mexico water;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        aerate lots genlab air;
        aerate lots genlab air;
        sne feed green;
        sne depress oximeter button;
        sne push hygrometer button;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize some hippie fertilizer;
        fertilize little smurfy fertilizer;
        water little atlantis water;
        water little atlantis water;
        fertilize little happy ed's fertilizer;
        aerate some genlab air
    };
    #elseif {$craft_farming[data][plantround] == 3} {
        sne feed green;
        sne depress oximeter button;
        sne push hygrometer button;
        water little gulf of mexico water
    }
};

