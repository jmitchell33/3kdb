#nop Recipes for farm_land9 (levels 37-50);

#alias farml37pawpaw {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim
    };
    cleanplot3;
    spray lots mount perplexus pesticide;
    spray lots mount perplexus pesticide;
    spray lots mount perplexus pesticide;
    aerate lots genlab air;
    aerate lots genlab air;
    aerate some genlab air;
    spray little murus faralain pesticide;
    spray lots hunch pesticide;
    spray lots hunch pesticide;
    spray lots hunch pesticide;
    water some wayhaven water;
    water lots r'lyeh water;
    water some r'lyeh water;
    spread little burns brand neutralizer;
    water some atlantis water;
    spread lots der'thalas neutralizer;
    spread lots der'thalas neutralizer;
    spray lots ant cave pesticide;
    spray lots ant cave pesticide;
    aerate some ryogi-pei air;
    aerate lots serinth air;
    fertilize lots happy ed's fertilizer;
    fertilize lots happy ed's fertilizer;
    spread some garou neutralizer;
    fertilize some hippie fertilizer;
    fertilize lots alphabet fertilizer;
    fertilize lots alphabet fertilizer;
    spread little cowville neutralizer;
    water lots gulf of mexico water;
    water lots gulf of mexico water;
    water some gulf of mexico water;
    aerate lots detroit air;
    aerate lots detroit air;
    aerate lots detroit air;
    fertilize lots smurfy fertilizer;
    #if {$craft_farming[data][plantround] == 0} {
        sne grow plant
    }
};

