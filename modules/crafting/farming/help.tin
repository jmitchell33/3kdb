#alias farmhelp_autofarming {
    #echo {<faa>=========================================<088>};
    #echo {<ffa>    Auto-Farming Modes<088>};
    #echo {<faa>=========================================<088>};
    #echo {<feb>Two automated farming modes available:<088>};
    #echo {};
    #echo {<ffa>FARM ALL Mode:<088>};
    #echo {<ccd>  fr all<feb> or <ccd>farm all<088>};
    #echo {<feb>  • Farms ALL available farms for your level<088>};
    #echo {<feb>  • Automatically skips plants above your level<088>};
    #echo {<feb>  • Continues until all farms complete<088>};
    #echo {<feb>  • Best for maximum exp gain<088>};
    #echo {};
    #echo {<ffa>FARM CXP Mode:<088>};
    #echo {<ccd>  fr cxp<feb> or <ccd>farm cxp<088>};
    #echo {<feb>  • Farms only CXP-giving farms (farm 4+)<088>};
    #echo {<feb>  • Only does farms within your level range<088>};
    #echo {<feb>  • Best for guild exp farming<088>};
    #echo {};
    #echo {<ffa>How Auto-Farming Works:<088>};
    #echo {<ccd>  1.<feb> Calculates valid farms for your level<088>};
    #echo {<ccd>  2.<feb> Goes to farm store and buys supplies<088>};
    #echo {<ccd>  3.<feb> Visits each farm in sequence<088>};
    #echo {<ccd>  4.<feb> Checks each room for plants<088>};
    #echo {<ccd>  5.<feb> Skips owned/too high level plants<088>};
    #echo {<ccd>  6.<feb> Grows valid plants automatically<088>};
    #echo {<ccd>  7.<feb> Continues to next room after harvest<088>};
    #echo {<ccd>  8.<feb> Returns home when complete<088>};
    #echo {};
    #echo {<fff>Note:<feb> Set your level first with:<088>};
    #echo {<ccd>      setfarmlevel <level><088>};
    #echo {<feb>Auto-farming rests between plants to average 25 commands a minute. Change it with <ccd>farmapm <number><feb>, 0 turns rests off<088>};
    #echo {<feb>Going idle (deadman) stops farming. <ccd>f4<feb> keeps tending the plant, <ccd>f5<feb> harvests it, <ccd>fr all<feb> restarts auto-farming<088>};
    #echo {<faa>=========================================<088>}
};

