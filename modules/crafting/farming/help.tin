};

#alias farmhelp_commands {
    #echo {<faa>=========================================<088>};
    #echo {<ffa>    Farming Commands<088>};
    #echo {<faa>=========================================<088>};
    #echo {<ffa>Auto-Farming:<088>};
    #echo {<ccd>  fr all<feb> or <ccd>farm all<feb> - Auto-farm all farms<088>};
    #echo {<ccd>  fr cxp<feb> or <ccd>farm cxp<feb> - Auto-farm CXP only<088>};
    #echo {<ccd>  setfarmlevel <lvl><feb>           - Set your farming level<088>};
    #echo {<ccd>  stopauto<feb>                     - Stop auto-farming<088>};
    #echo {};
    #echo {<ffa>Basic Commands:<088>};
    #echo {<ccd>  f2 or lapt<feb>                   - Look at plant/ground<088>};
    #echo {<ccd>  f3 or growplants<feb>             - Start growing<088>};
    #echo {<ccd>  f4 or togglepause<feb>            - Pause/resume farming<088>};
    #echo {<ccd>  f5 or stopfarming<feb>            - Stop and harvest<088>};
    #echo {};
    #echo {<ffa>Experiment Commands:<088>};
    #echo {<ccd>  f9 or F9<feb>                     - Experiment F9<088>};
    #echo {<ccd>  f10 or F10<feb>                   - Experiment F10<088>};
    #echo {<ccd>  f11 or F11<feb>                   - Experiment F11<088>};
    #echo {<ccd>  f12 or F12<feb>                   - Experiment F12<088>};
    #echo {};
    #echo {<ffa>Travel Commands:<088>};
    #echo {<ccd>  gofarm#<feb>                      - Go to farm (1-15)<088>};
    #echo {<ccd>  homefarm#<feb>                    - Return home (1-15)<088>};
    #echo {<ccd>  gofarmstore<feb>                  - Go to supply shop<088>};
    #echo {<ccd>  homefarmstore<feb>                - Leave supply shop<088>};
    #echo {};
    #echo {<ffa>Utility Commands:<088>};
    #echo {<ccd>  buysupplies #<feb>                - Buy supplies (1-3 or all)<088>};
    #echo {<ccd>  farmstatus<feb>                   - Display status panel<088>};
    #echo {<ccd>  farmgoods<feb>                    - Display harvest inventory<088>};
    #echo {<ccd>  farmlook<feb>                     - Examine farm conditions<088>};
    #echo {<ccd>  resetfarm<feb>                    - Reset measurements only<088>};
    #echo {<ccd>  resetfarmfull<feb>                - Full reset (inc. harvests)<088>};
    #echo {<ccd>  toggleecho<feb>                   - Toggle debug mode<088>};
    #echo {<ccd>  toggledisplay<feb>                - Toggle auto-display<088>};
    #echo {};
    #echo {<ffa>Random Farming:<088>};
    #echo {<ccd>  randomfarm<feb>             - Attempt random recipe<088>};
    #echo {<faa>=========================================<088>}
};

