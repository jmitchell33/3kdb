#alias farmhelp_f4 {
    #echo {<faa>=========================================<088>};
    #echo {<ffa>    Command: f4 (togglePause)<088>};
    #echo {<faa>=========================================<088>};
    #echo {<feb>Pauses or resumes farming automation.<088>};
    #echo {};
    #echo {<feb>When paused:<088>};
    #echo {<ccd>  •<feb> No automatic actions occur<088>};
    #echo {<ccd>  •<feb> Plant continues to grow naturally<088>};
    #echo {<ccd>  •<feb> You can manually tend the plant<088>};
    #echo {<ccd>  •<feb> Variables are preserved<088>};
    #echo {};
    #echo {<feb>When resumed:<088>};
    #echo {<ccd>  •<feb> Automation continues normally<088>};
    #echo {<ccd>  •<feb> Next round executes as scheduled<088>};
    #echo {};
    #echo {<fff>Note:<feb> Use this if you need to manually<088>};
    #echo {<feb>      adjust something mid-growth<088>};
    #echo {<faa>=========================================<088>}
};

