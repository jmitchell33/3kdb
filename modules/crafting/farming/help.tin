#nop Farmer help. Loaded by farming/index.tin;

#nop ============================================;
#nop HELP SYSTEM;
#nop ============================================;

#alias farmhelp {
    #switch {"%1"} {
        #case {""} {farmhelp_main};
        #case {"help"} {farmhelp_topics};
        #case {"commands"} {farmhelp_commands};
        #case {"cmds"} {farmhelp_commands};
        #case {"autofarming"} {farmhelp_autofarming};
        #case {"auto"} {farmhelp_autofarming};
        #case {"setfarmlevel"} {farmhelp_setfarmlevel};
        #case {"fr"} {farmhelp_fr};
        #case {"stopauto"} {farmhelp_stopauto};
        #case {"f2"} {farmhelp_f2};
        #case {"f3"} {farmhelp_f3};
        #case {"f4"} {farmhelp_f4};
        #case {"f5"} {farmhelp_f5};
        #case {"f9"} {farmhelp_f9};
        #case {"f10"} {farmhelp_f10};
        #case {"f11"} {farmhelp_f11};
        #case {"f12"} {farmhelp_f12};
        #case {"lapt"} {farmhelp_f2};
        #case {"growplants"} {farmhelp_f3};
        #case {"togglepause"} {farmhelp_f4};
        #case {"stopfarming"} {farmhelp_f5};
        #case {"buysupplies"} {farmhelp_buysupplies};
        #case {"travel"} {farmhelp_travel};
        #case {"gofarm"} {farmhelp_gofarm};
        #case {"homefarm"} {farmhelp_homefarm};
        #case {"utilities"} {farmhelp_utilities};
        #case {"cleanplot"} {farmhelp_cleanplot};
        #case {"feed"} {farmhelp_feed};
        #case {"toggleecho"} {farmhelp_toggleecho};
        #case {"toggledisplay"} {farmhelp_toggledisplay};
        #case {"farmstatus"} {farmhelp_farmstatus};
        #case {"resetfarm"} {farmhelp_resetfarm};
        #case {"resetfarmfull"} {farmhelp_resetfarmfull};
        #case {"farmlook"} {farmhelp_farmlook};
        #case {"farmgoods"} {farmhelp_farmgoods};
        #case {"randomfarm"} {farmhelp_randomfarm};
        #default {
            #echo {<faa>====================================<088>};
            #echo {<faa>Unknown help topic: <ccd>%1<088>};
            #echo {<feb>Type <ccd>farmhelp help<feb> for available topics<088>};
            #echo {<faa>====================================<088>}
        }
    }
};

#alias farmhelp_main {
    #echo {<faa>=========================================<088>};
    #echo {<ffa>    Advanced Farming System Help<088>};
    #echo {<faa>=========================================<088>};
    #echo {<fff>Note:<feb> This is an automated farming<088>};
    #echo {<feb>      system for 3k.org<088>};
    #echo {};
    #echo {<feb> Farm Level is Automatically Detected<088>};
    #echo {<fff>Note:<feb> If you need to update your farming level you can do the following:<088>};
    #echo {<ccd>  1.<feb> Type <ccd>craftstats<feb> to auto-detect your level<088>};
    #echo {<ccd>  2.<feb> Or use: <ccd>setfarmlevel <level><088>};
    #echo {};
    #echo {<ffa>AUTO-FARMING Quick Start:<088>};
    #echo {<ccd>  1.<feb> Start farming: <ccd>fr all<feb> or <ccd>fr cxp<088>};
    #echo {<ccd>  2.<feb> System does everything automatically!<088>};
    #echo {<ccd>  3.<feb> Stop anytime: <ccd>stopauto<088>};
    #echo {};
    #echo {<ffa>MANUAL FARMING Quick Start:<088>};
    #echo {<ccd>  1.<feb> Go to shop: <ccd>gofarmstore<088>};
    #echo {<ccd>  2.<feb> Buy supplies: <ccd>buysupplies all<088>};
    #echo {<ccd>  3.<feb> Leave shop: <ccd>homefarmstore<088>};
    #echo {<ccd>  4.<feb> Go to farm: <ccd>gofarm1<feb> to <ccd>gofarm15<088>};
    #echo {<ccd>  5.<feb> Look at plant: <ccd>f2<feb> or <ccd>lapt<088>};
    #echo {<ccd>  6.<feb> Start growing: <ccd>f3<feb> or <ccd>growplants<088>};
    #echo {<ccd>  7.<feb> Wait for harvest message<088>};
    #echo {<ccd>  8.<feb> Stop & collect: <ccd>f5<feb> or <ccd>stopfarming<088>};
    #echo {<ccd>  9.<feb> Return home: <ccd>homefarm1<feb> to <ccd>homefarm15<088>};
    #echo {};
    #echo {<ffa>View Commands:<088>};
    #echo {<ccd>  farmstatus<feb>    - View plant status<088>};
    #echo {<ccd>  farmgoods<feb>     - View harvest inventory<088>};
    #echo {};
    #echo {<feb>Optional Settings:<088>};
    #echo {<ccd>  toggledisplay<feb> - Auto-show status updates<088>};
    #echo {<ccd>  toggleecho<feb>    - Show debug information<088>};
    #echo {};
    #echo {<feb>Type <ccd>farmhelp help<feb> for all topics<088>};
    #echo {<faa>=========================================<088>}
};

