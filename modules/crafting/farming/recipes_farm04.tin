#nop Recipes for farm_land4 (levels 13-24);

#alias farml14bartletpear {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        water lots wayhaven water;
        water lots wayhaven water;
        aerate lots genlab air;
        aerate lots genlab air;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        fertilize lots happy ed's fertilizer;
        water lots happy ed's fertilizer;
        water some happy ed's fertilizer;
        aerate lots genlab air;
        aerate lots genlab air
    }
};

#alias farml14brusselsprout {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots hippie fertilizer;
        water lots wayhaven water;
        water lots wayhaven water;
        aerate lots genlab air;
        aerate lots genlab air;
        aerate little serinth air;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize lots hippie fertilizer;
        aerate lots genlab air
    };
    #elseif {$craft_farming[data][plantround] % 2 == 0} {
        water little wayhaven water
    };
    #else {
        water some wayhaven water
    }
};

#alias farml15mango {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        fertilize lots happy ed's fertilizer;
        water lots r'lyeh water;
        water lots r'lyeh water;
        fertilize lots smurfy fertilizer;
        fertilize lots smurfy fertilizer;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize lots smurfy fertilizer;
        water some r'lyeh water
    }
};

#alias farml16russetpotato {
    #if {$craft_farming[data][plantround] == 0} {
        sne stake claim;
        water lots wayhaven water;
        water lots wayhaven water;
        aerate lots genlab air;
        aerate lots genlab air;
        aerate lots genlab air;
        fertilize lots hippie fertilizer;
        fertilize lots hippie fertilizer;
        sne grow plant
    };
    #elseif {$craft_farming[data][plantround] > 0} {
        fertilize lots hippie fertilizer;
        fertilize lots hippie fertilizer;
        water little wayhaven water;
        aerate lots genlab air;
        aerate lots genlab air
    };
    #elseif {$craft_farming[data][plantround] % 2 == 0} {
        spread lots burns brand neutralizer;
        spread lots burns brand neutralizer;
        spread lots burns brand neutralizer;
        spread lots burns brand neutralizer;
        aerate lots genlab air;
        aerate some genlab air
    }
};
