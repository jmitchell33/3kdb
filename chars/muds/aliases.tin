#class {player_aliases} {kill}
#class {player_aliases} {open}

#alias {_player_deadmanActions} {
    #if $bot[active] {.pause;#echo {paused from deadman}};
};

#alias {cp}{retrieve;put all in chest;deliver};
#alias {cg}{retrieve;get all from chest;deliver};
#alias {sac}{unkeep all;store all;keep all};

#list speedruns add {{{name} {home}            {type} {area} {vnum} {152} {desc} {home}}};

#class {player_aliases} {close}