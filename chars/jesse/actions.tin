#class {player_actions} {kill};
#class {player_actions} {open};

#nop -- xeno gate;
#action {You can not enter with the gate closed.} {clear branches;pull lever} {1};

#nop -- until tier 3 i need to study powers so i will use envision vaf perk until then;
#nop -- protection;
#action {You call forth upon the necromancers of the past to protect you.} {
    #if {!$idle_flag} {
        envision protection;
    };
} {1};

#nop -- dream;
#action {Your maximum dream factor is %* master, invoking that now.} {
    #if {!$idle_flag} {
        envision dream;
    };
} {1};

#nop -- dispell;
#action {pearl to the ground and dispell a magical spell from the room.} {
    #if {!$idle_flag} {
        envision dispell;
    };
} {1};

#nop -- turn undead;
#action {%* cowers away from you in abject fear!} {
    #if {!$idle_flag} {
        envision turn undead;
    };
} {1};

#nop -- soulbind;
#nop -- second line of the cast, because the necro action needs the first one (one action fires per line);
#action {to do your bidding.  Lightning explodes across the sky as the fallen} {
    #if {!$idle_flag} {
        envision soulbind;
    };
} {1};

#nop -- unholy ground;
#nop -- second line of the cast, because the necro action needs the first one (one action fires per line);
#action {the heavens!  The dark forces answer your calling, snaking their way} {
    #if {!$idle_flag} {
        envision unholy ground;
    };
} {1};

#nop -- bloodarc;
#action {You reach towards the dark clouds in the heavens and call forth} {
    #if {!$idle_flag} {
        envision bloodarc;
    };
} {1};

#nop -- the gp1 reflex sends drop pants when NP is low. Absorb up to 5 corpses, unless there are none;
#nop -- qtrance is instant, so the lockout only has to last until the new NP shows;
#action {^You have no pants.$} {
    #if {!$idle_flag && !$corpse_lockout} {
        #math corpse_total {$corpses[coffin] + $corpses[freezer] + $corpses[cooler]};
        #if {$corpse_total > 0} {
            #var corpse_lockout 1;
            #delay {corpse_lockout} {#var corpse_lockout 0} {4};
            .corpse_absorb;
        };
    };
} {1};

#nop -- mask drop;
#action {The mask clatters to the ground.} {
    #if {!$idle_flag} {
        ptell mask dropped!;
    };
} {1};

#NOP -- Kwik-E-Mart Pride (+5 wis);
#action {The last of the oil leaks from your body.} {
    #if {!$idle_flag} {
        #send {get pride from satchel};
        #send {eat pride};
    };
} {1};

#NOP -- tacos;
#action {The melting cheese finally evaporates from Jesse.} {
    #if {!$idle_flag} {
        wield rod;
        wield shard;
    };
} {1};

#nop slippery that none of your armor seems to want to stay on!;
#action {The guacamole coating Jesse finally oozes off.} {
    #if {!$idle_flag} {
        wear all;
    };
} {1};

#NOP -- hurinteons tome;
#action {Hurinteon's tome vibrates and flashes brightly for a moment.} {
    #if {!$idle_flag} {
        ptell Hurinteon's tome has reset;
    };
} {1};

#NOP - beloch bot;
#action {^Beloch storms out to do battle!$} {
	#if {$auto_beloch} {
		challenge_all;
        kill beloch;
        arena_kill_all;
	};
} {1};

#NOP -- hobbit pipe;
#action {%*A small, intricately carved hobbit pipe} {#var pipe 1;};
#action {You think so hard that smoke pours out of your ears.} {#var pipe 0;};

#ticker pipe {#if {$pipe && !$idle_flag} {smoke pipe}} 63;
#ticker pipe2 {#if {$pipe && !$idle_flag} {smoke pipe}} 75;

#NOP -- Touch aegis rune immediately on seeing inductor;
#act {^-M-_A Colossal Inductor} {touch aegis rune} {1};


#class {player_actions} {close};
