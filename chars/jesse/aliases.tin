#class {player_aliases} {kill};
#class {player_aliases} {open};

#nop reflexes;

#alias {setup_reflex} {
    reflex clear;
    reflex add hp <70% dream 20;
    reflex add sp <25% dream 20;
    reflex add gp1 <10000 drop pants;
    reflex add gp2 <124 con;
    reflex combat on;
    reflex combat;
    reflex start;
};

#NOP -- cycle through coffin/freezer/cooler for a corpse;
#alias {.corpse} {
	#if {$corpses[coffin] > 0} {
		#send !unwrap 1;
	}; #elseif {$corpses[freezer] > 0} {
		#send !deslab;
	}; #elseif {$corpses[cooler] > 0} {
		#send !uncooler corpse;
	}; #else {
		#echo {<ccf>----<088> <fff>OUT OF CORPSES<088><faa>!!!!<088> <ccf>----<088>};
	};
	qtrance preserve remains/get preservation/absorb;
};

#NOP -- absorb corpses in batches, from the coffin first, then freezer, then cooler;
#NOP -- qtrance does the whole chain instantly, and >n repeats it n times;
#NOP -- The first batch is corpse_batch corpses. After each batch the NP gained shows what one corpse gave;
#NOP -- since bigger corpses give more. The next batch is only as many as still fit under max NP, up to corpse_batch;
#NOP -- It stops when less than one corpse fits, NP didn't go up, or there are no corpses left;
#var corpse_batch 6;
#alias {.corpse_absorb} {
    #math corpse_total {$corpses[coffin] + $corpses[freezer] + $corpses[cooler]};
    #if {$corpse_total < 1} {
        #var corpse_lockout 0;
        #return;
    };
    #if {$corpse_np_seen > 0} {
        #math corpse_left {($my[gp1][max] - $my[gp1][current]) / $corpse_np_seen};
        #format corpse_left {%d} {$corpse_left};
    } {
        #var corpse_left $corpse_batch;
    };
    #if {$corpse_left > $corpse_batch} {
        #var corpse_left $corpse_batch;
    };
    #if {$corpse_left < 1} {
        #var corpse_lockout 0;
        #return;
    };
    #var corpse_asked $corpse_left;
    #var corpse_np_before $my[gp1][current];
    .corpse_absorb_from {unwrap 1} {coffin};
    .corpse_absorb_from {deslab} {freezer};
    .corpse_absorb_from {uncooler corpse} {cooler};
    #math corpse_took {$corpse_asked - $corpse_left};
    #delay {corpse_absorb} {.corpse_absorb_check} {3};
};

#NOP -- After a batch: work out the NP one corpse gave, then try the next batch;
#alias {.corpse_absorb_check} {
    #math corpse_gain {$my[gp1][current] - $corpse_np_before};
    #if {$corpse_took < 1 || $corpse_gain <= 0} {
        #var corpse_lockout 0;
        #return;
    };
    #math corpse_np_seen {$corpse_gain / $corpse_took};
    .corpse_absorb;
};

#NOP -- %1 command to get a corpse out, %2 where it is. Takes what is there, up to what is still needed;
#alias {.corpse_absorb_from} {
    #local take {0};
    #if {&corpses[%2]} {
        #local take {$corpses[%2]};
    };
    #if {$take > $corpse_left} {
        #local take {$corpse_left};
    };
    #if {$take > 0} {
        qtrance %1/preserve remains/get preservation/absorb>$take;
        #math corpse_left {$corpse_left - $take};
    };
};

