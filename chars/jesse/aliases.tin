#class {player_aliases} {kill};
#class {player_aliases} {open};

#nop reflexes;

#alias {setup_reflex} {
    reflex clear;
    reflex add hp <70% dream 20;
    reflex add sp <25% dream 20;
    reflex add gp1 <10000 qtrance unwrap 1/preserve remains/get preservation/absorb>5;
    reflex add gp2 <124 con;
    reflex combat on;
    reflex combat;
    reflex start;
};

#NOP -- cycle through coffin/freezer/cooler for a corpse;
#alias {.cycle_corpses} {
	#if {$corpses[coffin] > 0} {
		#send !unwrap 1;
	}; #elseif {$corpses[freezer] > 0} {
		#send !deslab;
	}; #elseif {$corpses[cooler] > 0} {
		#send !uncooler corpse;
	}; #else {
		#echo {<ccf>----<088> <fff>OUT OF CORPSES<088><faa>!!!!<088> <ccf>----<088>};
	};
	#send !qtrance preserve remains/get preservation/absorb;
};

#alias {xenostart} {reflex remove sp <25% dream 20};
#alias {xenostop} {reflex add sp <25% dream 20};

#NOP -- reset my brief settings after using inductor stepper;
#alias {mybrief} {
    #send !brief off yes;
};

#nop until tier 3 you lose your globes when you die...;
#alias {reup} {
    envision bloodarc;
    envision dispell;
    envision turn undead;
    envision protection;
    envision soulbind;
    envision unholy ground;
    #3 envision dream;
    envision skull scry;
    envision rope trick;
    envision alarm;
    envision mouth;
};
    
#nop vigilante boosts;
#alias {vigiboost} {
    #switch {"%0"} {
        #case {"str"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint strength;quaff flask}};
        #case {"con"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint constitution;quaff flask}};
        #case {"int"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint intelligence;quaff flask}};
        #case {"wis"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint wisdom;quaff flask}};
        #case {"dex"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint dexterity;quaff flask}};
        #case {"cha"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint charisma;quaff flask}};
        #default {#echo {<fff>buy vigilante boost flasks. Usage: <ccd>vigiboost <str/con/int/wis/dex/cha><088>}};
    };
};

#NOP -- forest of charms;
#alias {charm} {
    #switch {"%0"} {
        #case {"help"} {
            #echo {<fff>Charm Bracelet Steps<088>};
            #echo {<fff>Arguments:<088>};
            #echo {<ada>1 <adb>(search trees)<088>};
            #echo {<ada>2 <adb>(2x search rocks)<088>};
            #echo {<ada>3 <adb>(search tree)<088>};
            #echo {<ada>4 <adb>(search rock)<088>};
            #echo {<ada>5 <adb>(kill guardian)<088>};
            #echo {<ada>6 <adb>(search trees and get charm)<088>};
            #echo {<ada>7 <adb>(kill squirrel)<088>};
            #echo {<ada>8 <adb>(snatch moon)<088>};
            #echo {<ada>key <adb>(search river)<088>};
        };
        #case {"1"} {search trees};
        #case {"2"} {#2 search rocks};
        #case {"3"} {search tree};
        #case {"4"} {search rock};
        #case {"5"} {kill guardian};
        #case {"6"} {search trees;get charm};
        #case {"7"} {kill squirrel};
        #case {"8"} {snatch moon};
        #case {"key"} {search river};
        #case {""} {
            #echo {<faa>No Argument Provided!!<088>};
        };
        #default {
            #echo {<fff>Unknown Argument '%0'. Please use 'charm help' for available options.<088>};
        };
    };
};

#NOP -- set variable for how many bags to cycle thru;
#alias {bagset} {
    #if {"%0" != ""} {
        #var bagcount %0;
        #echo {<ffa>BAG COUNT SET TO %0<088>};
    } {
        #echo {<faa>NO USER INPUT!<088>};
    };
};

#NOP -- cycle bags;
#alias {bag1} {
    #var bagsFull 1;
    #var bag1_active 1;
    #format tmpBagCount {%d} $bagcount;
    #loop $tmpBagCount 1 tmpBag {
        put all in bag $tmpBag;
    };
    #line oneshot #action {You put %* in %*.} {#var bagsFull 0;#var bag1_active 0};
};

#alias {bag2} {
    #format tmpBagCount {%d} $bagcount;
    drop all;
    #loop 1 $tmpBagCount tmpBag {
        get all from bag $tmpBag;drop all;
    };
    #var bagsFull 0;
    #var bag1_active 0;
};

#NOP -- donate all from each bag index down to 1 uses bagset count;
#alias {bag3} {
    #format tmpBagCount {%d} $bagcount;
    #loop $tmpBagCount 1 tmpBag {
        donate all from bag $tmpBag;
    };
    #var bag1_active 0;
};


#nop -- necro preservation;
#alias {pg} {
    qtrance preserve remains>50;
    qtrance get preservation>50;
};

#alias {pg2} {
    qtrance preserve remains>50;
    qtrance get preservation>50;
    unkeep all preservation;
    store all;
};

#alias {pr} {
    qtrance preserve remains>50;
};

#nop -- donate corpses to duncan;
#alias {cdonate1} {
    maskon;
    #send {!trace glyph};
    unkeep all preservation;drop all;
    #if {$corpses[coffin] > 0} {#send {!unwrap all}};
    #if {$corpses[freezer] > 0} {#send {!deslab all}};
    #if {$corpses[cooler] > 0} {#$corpses[cooler] uncooler corpse};
    #delay 10 {#send {!lookup}};
};

#alias {cdonate2} {
    #send {!trace glyph};
    #delay 10 {cdonate3};
};

#alias {cdonate3} {
    maskoff;
    pg;unkeep all preservation;store all;
    pg;unkeep all preservation;store all;
    pg;unkeep all preservation;store all;
    pg;unkeep all preservation;store all;
    pg;unkeep all preservation;store all;
    pg;unkeep all preservation;store all;
    pg;unkeep all preservation;store all;
    pg;unkeep all preservation;store all;
    pg;unkeep all preservation;store all;
    #delay 10 {#send {!lookup}};
};

#nop -- mask aliases;
#alias {maskon} {
    remove helmet;wear mask;
};

#alias {maskoff} {
    remove mask;wear helmet 2;
    keep mask;
};

#NOP -- configure 3kReport;
#alias {set3kreport} {
    3kReport-clear;
    3kReport+ killer;
    3kReport+ rounds;
    3kReport+ class;
    3kReport+ xp;
    3kReport+ xp_ratio;
    3kReport+ coins;
    #nop 3kReport+ dmg_dealt;
    #nop 3kReport+ dmg_received;
};

#alias {3kr} {
    3kReport;
};

#NOP Prevents accidental quitting by overriding the mud's "quit" command. This in turn can be overriden;
#NOP by typing "quit REALLY";
#alias {quit} {
    #if { "%1" == "REALLY"} {
        #NOP -- .quit tells the startup menu it wasn't a linkdeath;
        .quit;
    } {
        #SEND shakeno;
        #SEND {emote pulls out a mirror and looks at himself.};
        #SEND {say YOU are GOOD ENOUGH!};
        #SEND {muah};
    };
};

#nop reforge 12 daggers for pxp;
#alias {refd} {
    #12 {reforge dagger with little from edged to penetrate;dispose dagger};
};

