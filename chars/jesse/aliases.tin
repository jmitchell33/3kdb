#nop vigilante boosts;
#alias {vigiboost} {
    #switch {"%0"} {
        #case {"str"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint strength;quaff flask}};
        #case {"con"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint constitution;quaff flask}};
        #case {"int"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint intelligence;quaff flask}};
        #case {"wis"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint wisdom;quaff flask}};
        #case {"dex"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint dexterity;quaff flask}};
        #case {"cha"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint charisma;quaff flask}};
        #default {#echo {<fff>buy vigilante boost flasks. Usage: <ccd>vigiboost <str/con/int/wis/dex/cha><088>}};
    };
};

#NOP -- forest of charms;
#alias {charm} {
    #switch {"%0"} {
        #case {"help"} {
            #echo {<fff>Charm Bracelet Steps<088>};
            #echo {<fff>Arguments:<088>};
            #echo {<ada>1 <adb>(search trees)<088>};
            #echo {<ada>2 <adb>(2x search rocks)<088>};
            #echo {<ada>3 <adb>(search tree)<088>};
            #echo {<ada>4 <adb>(search rock)<088>};
            #echo {<ada>5 <adb>(kill guardian)<088>};
            #echo {<ada>6 <adb>(search trees and get charm)<088>};
            #echo {<ada>7 <adb>(kill squirrel)<088>};
            #echo {<ada>8 <adb>(snatch moon)<088>};
            #echo {<ada>key <adb>(search river)<088>};
        };
        #case {"1"} {search trees};
        #case {"2"} {#2 search rocks};
        #case {"3"} {search tree};
        #case {"4"} {search rock};
        #case {"5"} {kill guardian};
        #case {"6"} {search trees;get charm};
        #case {"7"} {kill squirrel};
        #case {"8"} {snatch moon};
        #case {"key"} {search river};
        #case {""} {
            #echo {<faa>No Argument Provided!!<088>};
        };
        #default {
            #echo {<fff>Unknown Argument '%0'. Please use 'charm help' for available options.<088>};
        };
    };
};

#NOP -- set variable for how many bags to cycle thru;
#alias {bagset} {
    #if {"%0" != ""} {
        #var bagcount %0;
        #echo {<ffa>BAG COUNT SET TO %0<088>};
    } {
        #echo {<faa>NO USER INPUT!<088>};
    };
};

#NOP -- Items that can't be dropped (the Section Z barrier shield and High Score Button) answer every;
#NOP -- put all in bag with "You can not drop that.", once per item per bag. Hide that line for a few seconds;
#NOP -- while bagging, it still shows any other time;
#alias {.bag_gag} {
    #class {bag_gag} {kill};
    #class {bag_gag} {open};
    #gag {^You can not drop that.$};
    #class {bag_gag} {close};
    #delay {bag_gag} {#class {bag_gag} {kill}} {4};
};

#NOP -- cycle bags;
#alias {bag1} {
    .bag_gag;
    #var bagsFull 1;
    #var bag1_active 1;
    #format tmpBagCount {%d} $bagcount;
    #loop $tmpBagCount 1 tmpBag {
        put all in bag $tmpBag;
    };
    #NOP -- the "You put" line clears bagsFull and bag1_active in gypsyid.tin, one action per line;
};

#alias {bag2} {
    #format tmpBagCount {%d} $bagcount;
    drop all;
    #loop 1 $tmpBagCount tmpBag {
        get all from bag $tmpBag;drop all;
    };
    #var bagsFull 0;
    #var bag1_active 0;
};

#NOP -- donate all from each bag index down to 1 uses bagset count;
#alias {bag3} {
    #format tmpBagCount {%d} $bagcount;
    #loop $tmpBagCount 1 tmpBag {
        donate all from bag $tmpBag;
    };
    #var bag1_active 0;
};

#NOP -- bagget <item>: get <item> out of every bag (bagset count) and keep it, so the bag1 corpsetrig doesn't;
#NOP -- put it back after the next kill. A bag without one just says so. unkeep <item> to let it go again;
#alias {bagget} {
    #if {"%0" == ""} {
        #echo {<faa>Usage: bagget <item>, e.g. bagget silver flask<088>};
        #return;
    };
    #format tmpBagCount {%d} $bagcount;
    #loop 1 $tmpBagCount tmpBag {
        get %0 from bag $tmpBag;
    };
    keep %0;
};


#nop -- necro preservation;
#alias {pg} {
    qtrance preserve remains>50;
    qtrance get preservation>50;
};

#alias {pg2} {
    qtrance preserve remains>50;
    qtrance get preservation>50;
    unkeep all preservation;
    store all;
};

#alias {pr} {
    qtrance preserve remains>50;
};

#nop -- donate corpses to duncan;
#NOP -- cdonate_glyph lets the mask action in actions.tin run cdonate2 once the glyph is done;
#alias {cdonate1} {
    #var cdonate_glyph 1;
    wrap all;
    maskon;
    #send {!trace glyph};
    unkeep all preservation;drop all;
    #if {$corpses[freezer] > 0} {#send {!deslab all}};
    #if {$corpses[cooler] > 0} {#$corpses[cooler] uncooler corpse};
    #delay {cdonate_lookup1} {#send {!lookup}} {10};
};

#alias {cdonate2} {
    #send {!trace glyph};
    #delay {cdonate_next} {cdonate3} {10};
};

#NOP -- each pass splits 25 corpses in two with preserve gemino, picks up the 50 halves (the carry limit);
#NOP -- and stores them. Duncan counts each half as a full corpse. gemino needs remains, since plain gemino;
#NOP -- only tries the first corpse and the halves land at the top. The Duncan actions in actions.tin send;
#NOP -- the next pass only after his reply to the last store, and stop once the floor is empty or after;
#NOP -- cdonate_max passes (20 x 25 = 500 corpses, donated as 1000);
#var cdonate_max 20;

#alias {cdonate3} {
    maskoff;
    #var cdonate_pass 0;
    #var cdonate_storing 1;
    .cdonate_pass;
};

#alias {.cdonate_pass} {
    #math cdonate_pass {$cdonate_pass + 1};
    #var cdonate_nocorpse 0;
    #var cdonate_nopres 0;
    qtrance preserve gemino remains>25;
    qtrance get preservation>50;
    unkeep all preservation;
    store all;
    #NOP -- if Duncan never answers, stop instead of waiting forever;
    #delay {cdonate_watch} {
        .cdonate_done {no reply from Duncan};
    } {10};
};

#NOP -- called by the Duncan ledger action after each store;
#alias {.cdonate_pass_end} {
    #if {$cdonate_nocorpse && $cdonate_nopres} {
        .cdonate_done {floor clear after $cdonate_pass passes};
    };
    #elseif {$cdonate_pass >= $cdonate_max} {
        .cdonate_done {stopped at the $cdonate_max pass limit};
    };
    #else {
        .cdonate_pass;
    };
};

#alias {.cdonate_done} {
    #undelay {cdonate_watch};
    #var cdonate_storing 0;
    #echo {<ceb>cdonate3:<088> %1};
    #NOP -- cdonate_lookup lets the Duncan action in actions.tin ptell the total;
    #var cdonate_lookup 1;
    #send {!lookup};
};

#NOP -- coin trip on/off: while a bot runs, carrying 1M coins or more pauses it to deposit down to 50k at;
#NOP -- the bank and back. The run itself is in heartbeat.tin. Turning it off mid trip stops it there;
#alias {acoinson} {
    #var jdonate[coin_on] 1;
    #var jdonate[coin_last] 0;
    #echo {<ceb>Auto coins:<088> on};
};

#alias {acoinsoff} {
    #var jdonate[coin_on] 0;
    #if {"$jdonate[next]" == "coins" || "$jdonate[state]" == "coin_trip" || "$jdonate[state]" == "coin_done"} {
        #if {"$gid[state]" == "coins"} {
            .gid_abort {turned off};
        };
        #var jdonate[next] {};
        .jdonate_abort {auto coins turned off};
    } {
        #echo {<ceb>Auto coins:<088> off};
    };
};

#NOP -- reagent trip on/off: while a bot runs, a reagent at 0 on the hpbar pauses it for topup at;
#NOP -- necro_reagent and back. The run itself is in heartbeat.tin. Turning it off mid trip stops it there;
#alias {areagon} {
    #var jdonate[reag_on] 1;
    #var jdonate[reag_last] 0;
    #echo {<ceb>Auto reagents:<088> on};
};

#alias {areagoff} {
    #var jdonate[reag_on] 0;
    #if {"$jdonate[next]" == "reagent" || "$jdonate[state]" == "reagent" || "$jdonate[state]" == "reag_buying"} {
        #if {"$gid[state]" == "reagent"} {
            .gid_abort {turned off};
        };
        #var jdonate[next] {};
        .jdonate_abort {auto reagents turned off};
    } {
        #echo {<ceb>Auto reagents:<088> off};
    };
};

#NOP -- bags full trip on/off: while a bot runs, full bags pause it for gypsyid, the necro box and back.;
#NOP -- The run itself is in heartbeat.tin. Turning it off mid trip stops it there, bot still paused;
#alias {agypsyon} {
    #var jdonate[gypsy_on] 1;
    #echo {<ceb>Auto gypsy:<088> on};
};

#alias {agypsyoff} {
    #var jdonate[gypsy_on] 0;
    #var gid[bags_full] 0;
    #if {"$jdonate[next]" == "gypsy" || "$jdonate[state]" == "gypsy"} {
        #if {"$gid[state]" != "idle"} {
            .gid_abort {turned off};
        };
        #unvar gypsyid_return;
        #unvar gypsyid_after;
        #var jdonate[next] {};
        .jdonate_abort {auto gypsy turned off};
    } {
        #echo {<ceb>Auto gypsy:<088> off};
    };
};

#NOP -- auto donate on/off, the run itself is in heartbeat.tin. Turning it off mid run stops it there, bot still paused;
#alias {adonateon} {
    #var jdonate[on] 1;
    #echo {<ceb>Auto donate:<088> on};
};

#alias {adonateoff} {
    #var jdonate[on] 0;
    #if {"$jdonate[state]" != "idle"} {
        .jdonate_abort {turned off};
    } {
        #echo {<ceb>Auto donate:<088> off};
    };
};

#NOP -- stop everything: the donate run, the cdonate delays and the bot. Auto donate stays on;
#alias {adonateabort} {
    #echo {<ceb>Auto donate:<088> <faa>ABORT - stopping the donate run, the cdonate delays and the mask wait, then .stop on the bot.<088>};
    #echo {<ceb>Auto donate:<088> <faa>The mask stays on and corpses already dropped stay on the ground. Auto donate is still on (adonateoff to turn it off).<088>};
    #var jdonate[state] idle;
    #var jdonate[wait] 0;
    #var cdonate_glyph 0;
    #var cdonate_lookup 0;
    #var cdonate_storing 0;
    #undelay {cdonate_lookup1};
    #undelay {cdonate_next};
    #undelay {cdonate_watch};
    .stop;
};

