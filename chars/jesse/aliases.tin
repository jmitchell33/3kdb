#NOP -- clear strategies;
#alias {stclear} {
    strategy-clear
};

#NOP -- corpsetrig cooler step after wrap and slab: those are sent first, so the corpse is only still on the ground;
#NOP -- once the coffin and freezer are full. The coffin max is learned from "The coffin is full!" (modules/corpsemanager);
#NOP -- Only runs if you own a cooler and a freezer, so it never picks up a corpse it can't store;
#alias {.corpse_cooler} {
    #if {"$inventory[cooler]" != "1" || "$inventory[freezer]" != "1"} {
        #return;
    };
    #if {$corpses[coffin] >= $corpses[coffin_max] && $corpses[freezer] >= 50 && $corpses[cooler] < 50} {
        get corpse;
        .cooler_get_all;
        cooler corpse;
    };
};

#NOP -- aliases to setup corpsetrigs;
#alias {mycorpsetrig} {
    .mycorpsetrig_list;
    mystrategy;
};

#NOP -- The mycorpsetrig actions without the strategy. .pre_bot_check (config.tin) uses it when a bot that;
#NOP -- isn't the sewers starts, so the strategy stays as it is;
#alias {.mycorpsetrig_list} {
    #var jesse_trigset normal;
    corpsetrig-clear;
    corpsetrig+ wrap;
    corpsetrig+ slab;
    corpsetrig+ .corpse_cooler;
    corpsetrig+ .corpse_cooler;
    corpsetrig+ preserve2;
    corpsetrig+ divvy;
    corpsetrig+ getAll;
    corpsetrig+ crafting;
    corpsetrig+ conworth;
    corpsetrig+ ted;
    corpsetrig-on;
};

#alias {mycorpsetrig-party} {
    #var jesse_trigset party;
    corpsetrig-clear;
    corpsetrig+ ted;
    mystrategy-party;
};

#NOP -- corpsetrig for donate areas: the mycorpsetrig actions with ted, then bag1 bags the loot for the necro box.;
#NOP -- Strategy call and spark_prime only;
#alias {mycorpsetrig-donates} {
    .mycorpsetrig_list;
    #var jesse_trigset donate;
    corpsetrig+ bag1;
    corpsetrig+ bag1;
    corpsetrig-on;
    #var jesse_strat donate;
    strategy-clear;
    strategy call;
    strategy spark_prime;
};

#NOP -- corpsetrig for sewers: grabs only listed ground loot instead of getAll;
#alias {mycorpsetrig-sewers} {
    #var jesse_trigset sewers;
    corpsetrig-clear;
    corpsetrig+ wrap;
    corpsetrig+ slab;
    corpsetrig+ .corpse_cooler;
    corpsetrig+ .corpse_cooler;
    corpsetrig+ preserve2;
    corpsetrig+ divvy;
    corpsetrig+ glance;
    corpsetrig+ delay;
    corpsetrig+ lootGrab;
    corpsetrig+ crafting;
    corpsetrig+ conworth;
    corpsetrig+ bag1;
    corpsetrig+ bag1;
    corpsetrig-on;
    #var jesse_strat sewers;
    strategy-clear;
    strategy call;
    strategy spark_prime;
};

