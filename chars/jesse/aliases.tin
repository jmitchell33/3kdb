#NOP -- beloch bot: auto_beloch is read by the Beloch action in actions.tin, off until belochboton;
#if {&{auto_beloch} == 0} {#var auto_beloch 0};
#alias {belochboton} {
    #var auto_beloch 1;
};

#alias {belochbotoff} {
    #var auto_beloch 0;
};

#NOP -- amy: steps to get to freeway bear;
#alias {amy1} {s;e;ne;n;n;n};
#alias {amy2} {u;e;n;nw;ne;n;d;d;s};
#alias {amy3} {n;u;n;u;s;s;sw;se;s;w;d;s;s;s;sw;w;n};

#alias {amy4} {
    examine walls;
    examine grate;
    smash grate;
    squeeze through grate;
    examine walls;
    examine crack;
    pry crack;
    crack;
};

#alias {amy5} {crack;u;n;u;n;u;s;s;sw;se;s;w;d;s;s;s;sw;w;n};

#NOP -- jesse's 3kdb aliases;

#alias format_jessesaliases {
    #format {jessealias_name} {%-25s} {%1};
    #format {jessealias_desc} {%-30s} {%2};
    #showme $jessealias_name $jessealias_desc;
};

#NOP -- filter types, listed in the help and matched by the first letters (corp finds corpses);
#list jesse3kdb_types create {corpses;boosts;combat;guild;areas;misc};

#NOP -- jesse3kdb <filter>: a filter, or the start of one, lists that type. Anything else lists aliases starting with it;
#alias {jesse3kdb} {
    #var bdb_total 0;
    #format bdb_arg {%l} {%1};
    #var bdb_mode {name};
    #if {"$bdb_arg" != ""} {
        #foreach {$jesse3kdb_types[%*]} {bdb_type} {
            #regex {$bdb_type} {^$bdb_arg} {#var bdb_mode {type}};
        };
    };
    #echo {<ccf>  -------           <ffa>3kdb           <ccf>-------<088>  };
    #echo {<ccf>  -------    <ffa>JESSE'S ALIASES <fff>(&jesse3kdb[])  <ccf>-------    <088>  };
    #echo {<ccf>  ----------------------------------------   <088>  };
    #echo {<ccf>     Name                 Usage              <088>  };
    #list jesse3kdb index name;
    #list jesse3kdb sort;
    #foreach $jesse3kdb[%*] index {
        #var bdb_hit 0;
        #if {"$bdb_arg" == ""} {
            #var bdb_hit 1;
        };
        #elseif {"$bdb_mode" == "type"} {
            #regex {$index[type]} {^$bdb_arg} {#var bdb_hit 1};
        };
        #else {
            #regex {$index[name]} {^$bdb_arg} {#var bdb_hit 1};
        };
        #if {$bdb_hit} {
            #math bdb_total {$bdb_total + 1};
            format_jessesaliases {     $index[name]} {$index[desc]};
        };
    };
    #if {$bdb_total} {
        #echo {\n<ccf>  Total of $bdb_total aliases returned.<088>};
    } {
        #echo {<ccf>  No matches found for <eed>%1<ccf>.<088>};
    };
    #echo {<ccf>  ----------------------------------------   <088>  };
    #echo {<cfc>  Sort using filters: <eaf>jesse3kdb <filter><088>};
    #echo {    <fff>Filters:  <eaf>corpses boosts combat guild<088>};
    #echo {              <eaf>areas misc<088>};
    #echo {<cfc>  Part of a filter works too: <eaf>jesse3kdb corp<088>};
    #echo {<cfc>  Not a filter? Lists aliases starting with it: <eaf>jesse3kdb my<088>};
    #echo {<ccf>  ----------------------------------------   <088>  };
};

#list jesse3kdb clear;

