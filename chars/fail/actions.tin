#class {player_actions} {kill};
#class {player_actions} {open};

#NOP -- REFLEXES;
#action {You have no pants.} {#if {!$idle_flag} {unwrap 1;fdeener}} {1};

#NOP --- JUGGERNAUT AMMO;
#action {The computer chirps 'Light Lrm 20 ammo supplies exhausted.'} {truck ammo vbuy missile 6 1 40000} {1};

#NOP -- JUGGERNAUT CDEFEND FOR PARTY;
#action {The computer chirps 'Switching to PARTY defense mode.'} {ptell cdefend ON for party} {1};


#class {player_actions} {close};
