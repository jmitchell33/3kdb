#class {player_actions} {kill};
#class {player_actions} {open};

#NOP -- REFLEXES;
#NOP -- only unwrap and fdeener when the coffin has a corpse, say out of corpses once when it is empty;
#var tmp_pants_warned 0;
#action {You have no pants.} {
    #if {!$idle_flag} {
        #if {$corpses[coffin] > 0} {
            #var tmp_pants_warned 0;
            unwrap 1;
            fdeener;
        };
        #elseif {$tmp_pants_warned == 0} {
            #var tmp_pants_warned 1;
            #echo {<ccf>----<088> <fff>OUT OF CORPSES<088><faa>!!!!<088> <ccf>----<088>};
        };
    };
} {1};

#NOP --- JUGGERNAUT AMMO;
#action {The computer chirps 'Light Lrm 20 ammo supplies exhausted.'} {truck ammo vbuy missile 6 1 40000} {1};

#NOP -- JUGGERNAUT CDEFEND FOR PARTY;
#action {The computer chirps 'Switching to PARTY defense mode.'} {ptell cdefend ON for party} {1};


#class {player_actions} {close};
