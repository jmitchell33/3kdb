#class {player_aliases} {kill};
#class {player_aliases} {open};

#NOP -- CURRENT SESSION JUGGERNAUT GXP AND MOUNT STATUS;
#alias {jr} {jugg_report};

#NOP -- QUICK WALKS TO ROOMVNUMS;
#alias {wa} {#map run %1};

#NOP -- TO AND FROM BIGPIG (DUKE NUKEM);
#alias {pig1} {n;e;e;s;e;e;enter;up;n;n;n;w;place head;kick fan;fan;w;n;w;s;w;s;sw;se;up};
#alias {pig2} {down;nw;ne;n;e;n;e;s;e;wimp;e;s;s;s;down;out;w;w;n;w;w;s};

#NOP -- corpsetrig cooler step after wrap and slab: those are sent first, so the corpse is only still on the ground;
#NOP -- once the coffin and freezer are full. The coffin max is learned from "The coffin is full!" (modules/corpsemanager);
#NOP -- Only runs if you own a cooler and a freezer, so it never picks up a corpse it can't store;
#alias {.corpse_cooler} {
    #if {"$inventory[cooler]" != "1" || "$inventory[freezer]" != "1"} {
        #return;
    };
    #if {$corpses[coffin] >= $corpses[coffin_max] && $corpses[freezer] >= 50 && $corpses[cooler] < 50} {
        get corpse;
        get all from corpse;
        cooler corpse;
    };
};

#NOP -- how many bags gypsyid empties and fills;
#alias {bagset} {
    #if {"%0" != ""} {
        #var bagcount %0;
        #echo {<ffa>BAG COUNT SET TO %0<088>};
    } {
        #echo {<faa>NO USER INPUT!<088>};
    };
};

#NOP -- alias to setup corpsetrigs;
#alias {mycorpsetrig} {
    corpsetrig-clear;
    corpsetrig+ wrap;
    corpsetrig+ slab;
    corpsetrig+ .corpse_cooler;
    corpsetrig+ .corpse_cooler;
    corpsetrig+ divvy;
    corpsetrig+ getAll;
    corpsetrig+ crafting;
    corpsetrig-on;
};

#NOP -- corpsetrig for sewers: grabs only listed ground loot instead of getAll;
#alias {mycorpsetrig-sewers} {
    corpsetrig-clear;
    corpsetrig+ wrap;
    corpsetrig+ slab;
    corpsetrig+ .corpse_cooler;
    corpsetrig+ .corpse_cooler;
    corpsetrig+ divvy;
    corpsetrig+ glance;
    corpsetrig+ delay;
    corpsetrig+ lootGrab;
    corpsetrig+ crafting;
    corpsetrig-on;
};

#NOP -- fail's 3kdb aliases;
#NOP -- One alias per line: the name, then its description word wrapped at 70 characters. Lines after the;
#NOP -- first start with spaces so they line up under the description, not at the left edge of the screen;
#alias {format_failsaliases} {
    #format {failalias_name} {%-25s} {<cff>%1<088>};
    #format {failalias_pad} {%-25s} {};
    #var failalias_text {%2};
    #replace {failalias_text} { } {;};
    #list failalias_words create {$failalias_text};
    #var failalias_line {};
    #var failalias_first 1;
    #foreach {$failalias_words[%*]} {failalias_word} {
        #format failalias_len {%L} {$failalias_line $failalias_word};
        #if {"$failalias_line" != "" && $failalias_len > 70} {
            #if {$failalias_first} {
                #showme {$failalias_name <deb>$failalias_line<088>};
                #var failalias_first 0;
            } {
                #showme {$failalias_pad <deb>$failalias_line<088>};
            };
            #var failalias_line {$failalias_word};
        };
        #elseif {"$failalias_line" == ""} {
            #var failalias_line {$failalias_word};
        };
        #else {
            #var failalias_line {$failalias_line $failalias_word};
        };
    };
    #if {$failalias_first} {
        #showme {$failalias_name <deb>$failalias_line<088>};
    } {
        #showme {$failalias_pad <deb>$failalias_line<088>};
    };
};

#NOP -- filter types, listed in the help and matched by the first letters (ar finds areas);
#list fail3kdb_types create {guild;areas;misc};

#NOP -- fail3kdb <filter>: a filter, or the start of one, lists that type. Anything else lists aliases starting with it;
#alias {fail3kdb} {
    #var bdb_total 0;
    #format bdb_arg {%l} {%1};
    #var bdb_mode {name};
    #if {"$bdb_arg" != ""} {
        #foreach {$fail3kdb_types[%*]} {bdb_type} {
            #regex {$bdb_type} {^$bdb_arg} {#var bdb_mode {type}};
        };
    };
    #echo {<ccf>  -------           <ffa>3kdb           <ccf>-------<088>  };
    #echo {<ccf>  -------    <ffa>FAIL'S ALIASES <fff>(&fail3kdb[])  <ccf>-------    <088>  };
    #echo {<ccf>  ----------------------------------------   <088>  };
    #echo {<ccf>     Name                 Usage              <088>  };
    #list fail3kdb index name;
    #list fail3kdb sort;
    #foreach $fail3kdb[%*] index {
        #var bdb_hit 0;
        #if {"$bdb_arg" == ""} {
            #var bdb_hit 1;
        };
        #elseif {"$bdb_mode" == "type"} {
            #regex {$index[type]} {^$bdb_arg} {#var bdb_hit 1};
        };
        #else {
            #regex {$index[name]} {^$bdb_arg} {#var bdb_hit 1};
        };
        #if {$bdb_hit} {
            #math bdb_total {$bdb_total + 1};
            format_failsaliases {     $index[name]} {$index[desc]};
        };
    };
    #if {$bdb_total} {
        #echo {\n<ccf>  Total of $bdb_total aliases returned.<088>};
    } {
        #echo {<ccf>  No matches found for <eed>%1<ccf>.<088>};
    };
    #echo {<ccf>  ----------------------------------------   <088>  };
    #echo {<cfc>  Sort using filters: <eaf>fail3kdb <filter><088>};
    #echo {    <fff>Filters:  <eaf>guild areas misc<088>};
    #echo {<cfc>  Part of a filter works too: <eaf>fail3kdb ar<088>};
    #echo {<cfc>  Not a filter? Lists aliases starting with it: <eaf>fail3kdb pig<088>};
    #echo {<ccf>  ----------------------------------------   <088>  };
};

#list fail3kdb clear;

#NOP -- guild;
#list fail3kdb add {{{name} {jr} {type} {guild} {desc} {Juggernaut session gxp and mount status}}};

#NOP -- areas;
#list fail3kdb add {{{name} {pig1} {type} {areas} {desc} {Walk to Bigpig (Duke Nukem)}}};
#list fail3kdb add {{{name} {pig2} {type} {areas} {desc} {Walk back from Bigpig (Duke Nukem)}}};

#NOP -- misc;
#list fail3kdb add {{{name} {wa} {type} {misc} {desc} {map run to vnum or name}}};
#list fail3kdb add {{{name} {gypsyid} {type} {misc} {desc} {Identify the bags at the town gypsy, keep potions of experience, bag them again}}};
#list fail3kdb add {{{name} {gypsyid-stop} {type} {misc} {desc} {Stop gypsyid}}};
#list fail3kdb add {{{name} {bagcount} {type} {misc} {desc} {Count your bags and bagset the total (drops, gets and keeps the satchel first)}}};
#list fail3kdb add {{{name} {abagson} {type} {misc} {desc} {Bag count at login on}}};
#list fail3kdb add {{{name} {abagsoff} {type} {misc} {desc} {Bag count at login off}}};

.add_speedrun {home} {misc} {13717} {Jesse's house (home 986)};

#NOP -- Items that can't be dropped (the Section Z barrier shield and High Score Button) answer every;
#NOP -- put all in bag with "You can not drop that.", once per item per bag. Hide that line for a few seconds;
#NOP -- while bagging, it still shows any other time;
#alias {.bag_gag} {
    #class {bag_gag} {kill};
    #class {bag_gag} {open};
    #gag {^You can not drop that.$};
    #class {bag_gag} {close};
    #delay {bag_gag} {#class {bag_gag} {kill}} {4};
};

#class {player_aliases} {close};

#NOP -- gypsyid: identify the bags at the town gypsy, see gypsyid.tin;
#read chars/$user/gypsyid.tin;

#NOP -- bagcount: count the bags and bagset, see bagcount.tin;
#read chars/$user/bagcount.tin;
