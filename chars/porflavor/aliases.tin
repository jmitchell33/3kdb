#class {player_aliases} {kill}
#class {player_aliases} {open}

#alias {_player_deadmanActions} {
    #NOP;
};

#alias {baby-bot} {
    bcy clear;
    bcy+ whores;
    bcy+ alphabet;
    bcy+ bombfreaks;
    bcy+ chicken;

    bcy+ chin2;
    bcy+ elven-woods;
    bcy+ encampment;
    bcy+ enchanted-spring;
    bcy+ fire-giants;
    bcy+ hippies;
    bcy+ hyperfunk2;
    bcy+ land2;
    bcy+ larem-cemetery;

    bcy+ catacombs2;
