#class {player_actions} {kill}
#class {player_actions} {open}

#var corpse_delay 0;

#ACTION {^Owie. That hurt!} {
	#if !$corpse_delay {
		#var corpse_delay 1;
		corpse_select;
		#delay {4} {cease;pd;pd;wrap};
		#delay {4} {#var corpse_delay 0};
	}
} {1};

#nop #var autoforge 1;

#nop #action {You adjust your reforger's kit slightly, ready to do more business.} {
    #if {"$autoforge" == "1"} {
        smuggle remove forge;
        get forge;
        drop forge;
        #4 {
            reforge skinning knife with little from edged to critical;
            unkeep skinning knife;
            dispose skinning knife;
        };
        get forge;
        smuggle forge;
    }
} {1};

#NOP -- Immort immediately on seeing inductor since i'm usually idle/iaw;
#act {^-M-_A Colossal Inductor} {(immortality} {1};


#class {player_actions} {close}