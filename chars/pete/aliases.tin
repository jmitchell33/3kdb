#alias {mybrief} {
    #send !brief off yes;
};

#NOP -- vigilant boosts;
#alias {vigiboost} {
    #switch {"%0"} {
        #case {"str"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint strength;quaff flask}};
        #case {"con"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint constitution;quaff flask}};
        #case {"int"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint intelligence;quaff flask}};
        #case {"wis"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint wisdom;quaff flask}};
        #case {"dex"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint dexterity;quaff flask}};
        #case {"cha"} {buy 1;buy 2;buy 3;buy 4;buy 5;buy 6;buy 7;#7 {imprint charisma;quaff flask}};
        #default {#echo {<fff>buy vigilante boost flasks. Usage: <ccd>vigiboost <str/con/int/wis/dex/cha><088>}};
    };
};

