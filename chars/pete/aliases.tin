#NOP -- debug stuff;
#alias {.startlog} {
    #switch {"%0"} {
        #case {"on"} {#event {SENT OUTPUT} {#var _sent_output_dbg %0;#echo {<cfa>out ($_sent_output_dbg)<088>}};#var debug[bot] 1;#debug {actions} {log};#config {log_mode} {plain};#log append botlog};
        #case {"off"} {#UNEVENT {SENT OUTPUT};#unvar debug[bot];#log off};
        #case {"del"} {#log remove botlog};
        #case {""} {#echo {<fff>No user input<088>}};
    };
};

#alias {writelog} {
    #system {echo ROUND COUNT: $total_rounds >> chars/pete/peteslog.log};
};

