#class {player_aliases} {kill};
#class {player_aliases} {open};

#NOP Prevents accidental quitting by overriding the mud's "quit" command. This in turn can be overriden;
#NOP by typing "quit REALLY";
#alias {quit} {
    #if { "%1" == "REALLY"} {
        #SEND quit;
    } {
        #SEND shakeno;
        #SEND {emote pulls out a mirror and looks at himself.};
        #SEND {say YOU are GOOD ENOUGH!};
        #SEND {noob pete};
    };
};

#nop -- speedrun using roomvnums;
#alias {wa} {
    #map run %0;
};

#NOP -- heartening laugh;
#alias {hl} {
    heartening laugh;
};

#NOP -- defensive harmony;
#alias {dh} {
    defensive harmony;
};

#NOP -- configure 3kReport;
#alias {set3kreport} {
    3kReport-clear;
    3kReport+ killer;
    3kReport+ rounds;
    3kReport+ class;
    3kReport+ xp;
    3kReport+ xp_ratio;
    3kReport+ coins;
};


#alias {3kr} {
    3kReport;
};

#NOP -- evaluate mobs to check vital imformation about their strengths and weakness's;
#alias {eva} {
    cast thought wave on %0;
};

#NOP -- set variable for how many bags to cycle thru;
#alias {bagset} {
    #if {"%0" != ""} {
        #var bagcount %0;
        #echo {<ffa>BAG COUNT SET TO %0<088>};
    } {
        #echo {<faa>NO USER INPUT!<088>};
    };
};

#NOP -- cycle bags;
#alias {bag1} {
    #var bagsFull 1;
    #var bag1_active 1;
    #format tmpBagCount {%d} $bagcount;
    #loop $tmpBagCount 1 tmpBag {
        put all in bag $tmpBag;
    };
    #line oneshot #action {You put %* in %*.} {#var bagsFull 0;#var bag1_active 0};
};

#alias {bag2} {
    #format tmpBagCount {%d} $bagcount;
    drop all;
    #loop 1 $tmpBagCount tmpBag {
        get all from bag $tmpBag;drop all;
    };
    #var bagsFull 0;
    #var bag1_active 0;
};

#NOP -- forest of charms;
#alias {charm} {
    #switch {"%0"} {
        #case {"help"} {
            #echo {<fff>Charm Bracelet Steps<088>};
            #echo {<fff>Arguments:<088>};
            #echo {<ada>1 <adb>(search trees)<088>};
            #echo {<ada>2 <adb>(2x search rocks)<088>};
            #echo {<ada>3 <adb>(search tree)<088>};
            #echo {<ada>4 <adb>(search rock)<088>};
            #echo {<ada>5 <adb>(kill guardian)<088>};
            #echo {<ada>6 <adb>(search trees and get charm)<088>};
            #echo {<ada>7 <adb>(kill squirrel)<088>};
            #echo {<ada>8 <adb>(snatch moon)<088>};
            #echo {<ada>key <adb>(search river)<088>};
        };
        #case {"1"} {search trees};
        #case {"2"} {#2 search rocks};
        #case {"3"} {search tree};
        #case {"4"} {search rock};
        #case {"5"} {kill guardian};
        #case {"6"} {search trees;get charm};
        #case {"7"} {kill squirrel};
        #case {"8"} {snatch moon};
        #case {"key"} {search river};
        #case {""} {
            #echo {<faa>No Argument Provided!!<088>};
        };
        #default {
            #echo {<fff>Unknown Argument '%0'. Please use 'charm help' for available options.<088>};
        };
    };
};

#NOP -- clear defense;
#alias {clear_defense} {
    clear_prots;
};

#NOP -- setup defense;
#alias {setup_defense} {
    #NOP spells;
    prots_hs;
    prots_pfe;
    prots_pfg;
    prots_pfn;
    prots_mb;
    prots_pfc;
    prots_pfh;
    prots_blink;
    #NOP prots_hr;
    #NOP songs;
    prots_muse;
    prots_grace;
    #NOP powers;
    es;
};

#NOP -- cycle through coffin/freezer/cooler for a corpse;
#alias {.cycle_corpses} {
	#if {$corpses[coffin] > 0} {
		#send !unwrap 1;
	}; #elseif {$corpses[freezer] > 0} {
		#send !deslab;
	}; #elseif {$corpses[cooler] > 0} {
		#send !uncooler corpse;
	}; #else {
		#echo {<ccf>----<088> <fff>OUT OF CORPSES<088><faa>!!!!<088> <ccf>----<088>};
	};
    #send {!cease;perform dirge};
};

#NOP -- heal stim with corpse;
#alias {b} {
    cease;
    perform dirge;
};

#alias {setup_reflex} {
    reflex clear;
    reflex add hp <50% cast healing hands;
    reflex add hp <10% hmheal;
    #nop reflex add sp >200 cast blade dance;
    #nop reflex add sp >150 cast caustic critic;
    reflex combat on;
    reflex start;
};

#NOP -- turn gags on;
#alias {gagson} {
    gag+ hpbar;
};

#NOP -- turn gags off;
#alias {gagsoff} {
    gag-clear;
};

#NOP -- manually defend a player;
#alias {def} {
    defend %0;
};

#NOP -- numpad off & on;
#alias {numoff} {
    #class numpad kill;
};

#alias {numon} {
    #read chars/$user/numpad.tin;
};

