#alias {badgers_corpsegrab} {
    #loop 1 &badgers_lootgrab_list[] _badger_cl_i {
        #var _badger_lpat {$badgers_lootgrab_list[$_badger_cl_i][long]};
        #replace {_badger_lpat} {%*} {.*};
        #list _badger_cg_hits create;
        #grep {$_badger_lpat} {_badger_cg_hits} {_badger_cg_cnt};
        #if {&_badger_cg_hits[] > 0} {
            #send {get $badgers_lootgrab_list[$_badger_cl_i][target]};
        };
    };
};

#NOP -- pete's 3kdb aliases;

#alias {format_petesaliases} {
    #format {petealias_name} {%-25s} {<cff>%1<088>};
    #format {petealias_desc} {%-30s} {<deb>%2<088>};
    #showme $petealias_name $petealias_desc;
};

#alias {pete3kdb} {
    #var tempflag 0;
    #var number &pete3kdb[];
	#echo {<ccf>  -------           <ffa>3kdb           <ccf>-------<088>  };
    #echo {<ccf>  -------    <ffa>PETE'S ALIASES <fff>($number)  <ccf>-------    <088>  };
    #echo {    Filters:  <eaf>corpses boosts combat misc<088>       };
    #echo {                  <eaf>guild spells<088>                 };
    #echo {<ccf>  ----------------------------------------   <088>  };
    #echo {<ccf>     Name                 Usage              <088>  };
    #list pete3kdb index name;
    #list pete3kdb sort;
    #foreach $pete3kdb[%*] index {
        #regexp {"%1"} {"$index[type]"} {
            #var tempflag 1;
            format_petesaliases {     $index[name]} {$index[desc]};
        };
    };
    #if !$tempflag {
        #foreach $pete3kdb[%*] index {
            format_petesaliases {     $index[name]} {$index[desc]};
        };
    };
};

