#class {player_heartbeat} {kill}
#class {player_heartbeat} {open}

#var update_method 1;

#alias {_player_heartbeat} {
    #if {!$idle_flag && $action_round < $mip[round]} {
        #NOP -- Make sure you're never in Standard method because you don't earn gxp;
        
        #if {"$my[knight][method]" == "Standard"} {
            #if $update_method {
                #var update_method 0;
                method focus;
                #delay 10 {#var update_method 1};
            };
        };
    };
};

#class {player_heartbeat} {close}