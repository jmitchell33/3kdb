#class {player_aliases} {kill}
#class {player_aliases} {open}

#NOP -- Player specific aliases;

#NOP -- From the old .tt elemental file;
#NOP -- wear also keeps your equipment so it can't be dropped or sold by accident;
#alias {wear %1} {#send {wear %1};#send {keep all equip}};
#NOP -- cmb <n>: combine n times, then put the gem in the vortex;
#alias {cmb %1} {#%1 combine;put gem in vortex};
#NOP -- gsg/psg <n>: get or put n soul gems from/in the vortex;
#alias {gsg %1} {get %1 soul gem from vortex};
#alias {psg %1} {put %1 soul gem in vortex};

#class {player_aliases} {close}