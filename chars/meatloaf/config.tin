#class {player_config} {kill}
#class {player_config} {open}

#NOP -- Bot Config;
#alias {.pre_fight_check} {#nop};
#alias {.pre_bot_check} {#NOP};
#alias {.check_death} {#NOP};

#class {player_config} {close}

#NOP -- Guild-specific extras go in chars/<name>/guilds/<guild>.tin (e.g. chars/<name>/guilds/priest.tin).;
#NOP -- This runs after the guild scripts at login and on gswap, so it can override guild defaults;
#class {player_guild} {kill};
#script {player_guild_file} {test -f chars/$user/guilds/$guild.tin && echo yes};
#if {"$player_guild_file[1]" == "yes"} {#read chars/$user/guilds/$guild.tin};
