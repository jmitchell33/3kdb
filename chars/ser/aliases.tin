#class {player_aliases} {kill}
#class {player_aliases} {open}

#var pickle_farming 0;
#var aoe_immo 0;


#alias {_player_deadmanActions} {
    .pause;
};

#alias k {
    kill %1;
}

#NOP ---MISC;
#alias {unbag_all} {#loop 1 %1 i {get all from bag $i;put all in box};get all from disc;put all in box;get all from buckler;put all in box};
#alias {bag_all %1} {get all from disc;#loop 1 %1 i {put all in bag $i}};


#NOP -- After-kill extras for the corpsetrig manager (common/corpsetrig.tin). Add it;
#NOP -- once with corpsetrig+ ser_corpse (enter it twice, it's a custom action).;
#NOP -- Coins and wrapping are left to the in-game ktrig;
#alias ser_corpse {
    #if {"$area" == "Section Z"} {
        get all from corpse;
    };
    #if {"$area" == "Westersea Thugs" || "$area" == "Westersea Sewer"} {
      get lockbox from corpse;
      sm lockbox;
    };
    #if {$pickle_farming} {
      smr jug;drink jug;sm jug;
      #if {"$area" == "sewer" || "$area" == "icyblue"} {
        get ring from corpse;
        get bag from corpse;
      };
    };
    #if {$aoe_immo} {
      immolate all;
    };
};

#alias {refill_apump} {
  fold reality;d;n;e;e;e;ne;e;deposit all;withdraw 50000;
  w;sw;w;w;w;w;w;w;refill;
  e;e;e;e;e;e;ne;e;deposit all;withdraw 25000;
  fold reality;
};

#alias {boostup} {
        psychofeedback wis for str;
        #delay {2} {improved vigor};
        #delay {4} {displacement};
        #delay {6} {improved biofeedback};
        #delay {8} {energy barrier};
        #delay {10} {psychofeedback off};
        #delay {12} {psychofeedback wis for con};
        #delay {14} {greater valor};
        #delay {16} {inertial barrier};
        #delay {18} {ablating};
        #delay {20} {psychofeedback off}
        };

#class {player_aliases} {close}
