#class {player_actions} {kill};
#class {player_actions} {open};

#NOP -- Kwik-E-Mart Pride (+5 wis);
#action {The last of the oil leaks from your body.} {
    #if {!$idle_flag} {
        #send {get pride from satchel};
        #send {eat pride};
    };
} {1};

#NOP -- tacos;
#action {The melting cheese finally evaporates from Badger.} {
    #if {!$idle_flag} {
        wield rod;
        wield shard;
    };
} {1};

#nop slippery that none of your armor seems to want to stay on!;
#action {The guacamole coating Badger finally oozes off.} {
    #if {!$idle_flag} {
        wear all;
    };
} {1};

#NOP -- Immort immediately on seeing inductor since i'm usually idle/iaw;
#nop #act {^-M-_A Colossal Inductor} {(immortality} {1};

#NOP -- hurinteons tome;
#action {Hurinteon's tome vibrates and flashes brightly for a moment.} {
    #if {!$idle_flag} {
        ptell Hurinteon's tome has reset;
    };
};

#NOP -- reflexes;
#variable {tmp_explosive_release} {0};
#variable {tmp_unwrap} {0};

#action {You have no pants.} {
    #if {!$idle_flag} {
        #if {$my[super][current] == 0} {
            #if {$tmp_unwrap == 0} {
                #var tmp_unwrap 1;
                unwrap 1;
                #delay {2} {#var tmp_unwrap 0};
            };
            cast corpse blast;
        };
        #else {
            #if {$tmp_explosive_release == 0} {
                #var tmp_explosive_release 1;
                cast explosive release;
                #delay {5} {#var tmp_explosive_release 0};
            };
        };
    };
} {1};

#NOP -- hobbit pipe;
#action {%*A small, intricately carved hobbit pipe} {#var pipe 1;};
#action {You think so hard that smoke pours out of your ears.} {#var pipe 0;};

#ticker pipe {#if {$pipe && !$idle_flag} {smoke pipe}} 63;
#ticker pipe2 {#if {$pipe && !$idle_flag} {smoke pipe}} 75;

#nop tao bot;

#alias {tao_on} {#var tao_toggle 1;repeat nocombat/bow};
#alias {tao_off} {#unvar tao_toggle;repeat off};

#action {A voice whispers in your mind.  You may proceed.} {
    #if {!$idle_flag && "$tao_toggle" == "1" && "$area" == "Tao Te Cheng"} {
        #send {!continue};
    };
} {1};

#action {You bow deeply in respect to the ancients.} {
    #if {!$idle_flag && "$tao_toggle" == "1" && "$area" == "Tao Te Cheng"} {
        #send {!cast fireball};
    };
} {1};

#class {player_actions} {close};
