            #echo {<ccd>spite-ring - auction spite ring and all 8 stones<088>};
            #echo {<bea>-------------------------------------------------<088>};
        };
    };
};

#NOP announce where event is on hm line;
#var go_event_back 0;
#alias {eventlocation} {
    #if {$go_event_back} {
        #echo {<faa>Event location already captured. Use 'announce_event' to share.<088>};
    };
    #else {
        #map get roomvnum go_back;
        #var go_event_back 1;
        go magic;
        #delay 6 {
            go_back;
            #delay 6 {
                #path save forward event_location;
                #echo {<ffa>Event location captured!<088>};
                #delay {1} {announce_event};
            };
        };
    };
};

#alias {announce_event} {
    #if {!&event_location} {
        #echo {<faa>Error: No event location saved yet. Run 'eventlocation' first.<088>};
        #return;
    };
    
    #local event_tmp_current_dir {};
    #local event_tmp_count 0;
    #local event_tmp_output_parts {};
    #list event_tmp_output_parts create {};
    
    #nop Parse through each direction in event_location;
    #foreach {$event_location} {event_tmp_dir} {
        #nop Skip portal since it's always there;
        #if {"$event_tmp_dir" == "portal"} {
            #continue;
        };
        
        #nop Check if this direction is the same as the previous one;
        #if {"$event_tmp_dir" == "$event_tmp_current_dir"} {
            #math event_tmp_count {$event_tmp_count + 1};
        };
        #else {
            #nop Save the previous direction group if it exists;
            #if {$event_tmp_count > 0} {
                #if {$event_tmp_count == 1} {
                    #list event_tmp_output_parts add {$event_tmp_current_dir};
                };
                #else {
                    #local event_tmp_formatted {};
                    #format event_tmp_formatted {%d%s} {$event_tmp_count} {$event_tmp_current_dir};
                    #list event_tmp_output_parts add {$event_tmp_formatted};
                };
            };
            
            #nop Start new direction;
            #var event_tmp_current_dir {$event_tmp_dir};
            #var event_tmp_count 1;
        };
    };
    
    #nop Don't forget to add the last direction group;
    #if {$event_tmp_count > 0} {
        #if {$event_tmp_count == 1} {
            #list event_tmp_output_parts add {$event_tmp_current_dir};
        };
        #else {
            #local event_tmp_formatted {};
            #format event_tmp_formatted {%d%s} {$event_tmp_count} {$event_tmp_current_dir};
            #list event_tmp_output_parts add {$event_tmp_formatted};
        };
    };
    
    #nop Join all parts with / separator;
    #local event_tmp_final_output {};
    #local event_tmp_first 1;
    #foreach {*event_tmp_output_parts[%*]} {event_tmp_idx} {
        #if {$event_tmp_first == 1} {
            #var event_tmp_final_output {$event_tmp_output_parts[$event_tmp_idx]};
            #var event_tmp_first 0;
        };
        #else {
            #var event_tmp_final_output {$event_tmp_final_output/$event_tmp_output_parts[$event_tmp_idx]};
        };
    };
    
    #nop Send to hmline;
    #var go_event_back 0;
    hm event, $event_tmp_final_output;
};

