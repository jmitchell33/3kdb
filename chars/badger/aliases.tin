#NOP -- killmode: set up the summons. Shoo the summons and the golem, clear the summon configs and reset the;
#NOP -- strategies with mystrategy, set castper mind, then make the configs (spell 11). The golem always assists.;
#NOP -- killmode = 4 summons assisting, killmode 2 = 2 assisting and 2 defending, killmode 3 = 4 defending;
#alias {killmode}
{
    #switch {"%0"}
    {
        #case {"help"}
        {
            #echo {<fff>Killmodes (the golem always assists):<088>};
            #echo {<eaf>killmode   <bec>4 summons assisting<088>};
            #echo {<eaf>killmode 2 <bec>2 summons assisting, 2 defending<088>};
            #echo {<eaf>killmode 3 <bec>4 summons defending<088>};
        };
        #case {""}
        {
            .killmode_reset;
            ms 11##4#1500#70#assist#summons#always;
            ms golema;
            #echo {<ffa>Killmode: 4 summons assisting, golem assisting.<088>};
        };
        #case {"2"}
        {
            .killmode_reset;
            ms 11##2#1500#70#assist#summons#always;
            ms 11##2#1500#70#defend#summons#always;
            ms golema;
            #echo {<ffa>Killmode 2: 2 summons assisting, 2 defending, golem assisting.<088>};
        };
        #case {"3"}
        {
            .killmode_reset;
            ms 11##4#1500#70#defend#summons#always;
            ms golema;
            #echo {<ffa>Killmode 3: 4 summons defending, golem assisting.<088>};
        };
        #default
        {
            #echo {<fff>Unknown killmode '%0'. Use 'killmode help' to see the modes.<088>};
        };
    };
};

#NOP -- what every killmode does first. castper mind sets the perform spell to mind warp;
#alias {.killmode_reset}
{
    clear_sconfig;
    shoo;
    shoo golem;
    mystrategy;
    castper mind;
};

