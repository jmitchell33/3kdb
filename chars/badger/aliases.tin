#NOP -- set variable for how many bags to cycle thru;
#alias {bagset} {
    #if {"%0" != ""} {
        #var bagcount %0;
        #echo {<ffa>BAG COUNT SET TO %0<088>};
    } {
        #echo {<faa>NO USER INPUT!<088>};
    };
};

#NOP -- cycle bags;
#alias {bag1} {
    #var bagsFull 1;
    #var bag1_active 1;
    #format tmpBagCount {%d} $bagcount;
    #loop $tmpBagCount 1 tmpBag {
        put all in bag $tmpBag;
    };
    #line oneshot #action {You put %* in %*.} {#var bagsFull 0;#var bag1_active 0};
};

#alias {bag2} {
    #format tmpBagCount {%d} $bagcount;
    drop all;
    #loop 1 $tmpBagCount tmpBag {
        get all from bag $tmpBag;drop all;
    };
    #var bagsFull 0;
    #var bag1_active 0;
};

#NOP -- forest of charms;
#alias {charm} {
    #switch {"%0"} {
        #case {"help"} {
            #echo {<fff>Charm Bracelet Steps<088>};
            #echo {<fff>Arguments:<088>};
            #echo {<ada>1 <adb>(search trees)<088>};
            #echo {<ada>2 <adb>(2x search rocks)<088>};
            #echo {<ada>3 <adb>(search tree)<088>};
            #echo {<ada>4 <adb>(search rock)<088>};
            #echo {<ada>5 <adb>(kill guardian)<088>};
            #echo {<ada>6 <adb>(search trees and get charm)<088>};
            #echo {<ada>7 <adb>(kill squirrel)<088>};
            #echo {<ada>8 <adb>(snatch moon)<088>};
            #echo {<ada>key <adb>(search river)<088>};
        };
        #case {"1"} {search trees};
        #case {"2"} {#2 search rocks};
        #case {"3"} {search tree};
        #case {"4"} {search rock};
        #case {"5"} {kill guardian};
        #case {"6"} {search trees;get charm};
        #case {"7"} {kill squirrel};
        #case {"8"} {snatch moon};
        #case {"key"} {search river};
        #case {""} {
            #echo {<faa>No Argument Provided!!<088>};
        };
        #default {
            #echo {<fff>Unknown Argument '%0'. Please use 'charm help' for available options.<088>};
        };
    };
};

