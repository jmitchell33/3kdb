#NOP -- aliases for setting up summon config & strategies;
#alias {killmode} {
    #switch {"%0"} {
        #NOP -- view available options;
        #case {"help"} {
            #echo {<fff>Available killmodes:<088>};
            #echo {<eaf>No argument <bec>(4 summons assisting & golem assisting)<088>};
            #echo {<eaf>2 <bec>(2 summons defending & 2 summons assisting & golem assisting)<088>};
            #echo {<eaf>3 <bec>(4 summons defending & golem assisting)<088>};
            #echo {<eaf>4 <bec>(3 summons assisting & 1 summon defending & golem assisting)<088>};
            #echo {<eaf>5 <bec>(1 summon defending & 3 summons assisting & golem defending)<088>};
        };
        #NOP -- 2 summons defending and 2 summons assisting;
        #case {"2"} {
            clear_sconfig;
            shoo;
            shoo golem;
            mystrategy;
            ms 11##2#1500#70#defend#summons#always;
            ms 11##2#1500#70#assist#summons#always;
            ms golema;
            castper mind;
        };
        #NOP -- 4 summons defending;
        #case {"3"} {
            clear_sconfig;
            shoo;
            shoo golem;
            mystrategy;
            ms 11##4#1500#70#defend#summons#always;
            ms golema;
        };
        #NOP -- 3 summons assisting and 1 summon defending;
        #case {"4"} {
            clear_sconfig;
            shoo;
            shoo golem;
            mystrategy;
            ms 11##3#1500#70#assist#summons#always;
            ms 11##1#1500#70#defend#summons#always;
            ms golema;
        };
        #NOP -- 1 summon defending and 3 summons assisting and golem defending;
        #case {"5"} {
            clear_sconfig;
            shoo;
            shoo golem;
            mystrategy-golem;
            strategy shoosummons;
            ms 11##1#1500#70#defend#summons#always;
            ms 11##3#1500#70#assist#summons#always;
            ms golemd;
        };
        #NOP -- default for summoner 2 summons defending and 2 summons assisting;
        #case {""} {
            #echo {<ffa>No argument provided - running default killmode<088>};
            clear_sconfig;
            shoo;
            shoo golem;
            mystrategy;
            ms 11##4#1500#70#assist#summons#always;
            ms golema;
        };
        #default {
            #echo {<fff>Unknown killmode '%0'. Use 'killmode help' to see available modes.<088>};
        };
    };
};

#NOP -- setup summon configs with custom summons;
#NOP -- defending summons;
#alias {summd %1 %2 %3} {
    cast summon config as monster summoning %1#%2#%3#1500#70#defend#summons#always;
    cast summon config activate;
};

#NOP -- assisting summons;
#alias {summa %1 %2 %3} {
    cast summon config as monster summoning %1#%2#%3#1500#70#assist#summons#always;
    cast summon config activate;
};

#NOP -- clear defense;
#alias {clear_defense} {
    clear_def;
    deplete prismatic aura;
    deplete prismatic sphere;
    deplete major globe;
    deplete minor globe;
    deplete magnificent shield;
    deplete shield;
    deplete armor;
    deplete protection from evil;
    deplete protection from good;
    deplete rhino skin;
    deplete stoneskin;
    deplete blink;
    deplete mantle;
};

#NOP -- setup defense;
#alias {setup_defense} {
    clear_gc;
    clear_c;
    setup_gc;
    #NOP setup_c;
    #delay 2 {prots_armor};
    #delay 4 {prots_ms};
    #delay 6 {prots_MG};
    #delay 8 {prots_ss};
    #delay 10 {prots_mb};
    #NOP -- prots_pfg checks the contingency lists first and casts 2s later (14s), so the rest stay 2s apart;
    #NOP -- or the MUD says You may not cast another defensive spell so quickly. maint picks up mantle (defs[M]).;
    #delay 12 {prots_pfg};
    #delay 16 {prots_ps};
    #delay 18 {cast mantle};
    #delay 20 {maint};
};

#NOP -- setup contingency with defenses;
#alias {setup_c} {
    cast contingency as protection from evil#cast protection from evil;
};

#NOP -- clear contingency;
#alias {clear_c} {
    #10 {cast remove contingency as 1};
};

#NOP -- greater contingency;
#alias {setup_gc} {
    cast greater contingency as mantle#$mage[contingencies][mantle]#cast mantle;
    cast greater contingency as prismatic sphere#$mage[contingencies][sphere]#cast prismatic sphere;
    cast greater contingency as major globe#cast major globe;
    cast greater contingency as stoneskin#cast stoneskin;
    cast greater contingency as shield#cast magnificent shield;
    cast greater contingency as armor#cast armor;
    #delay {setup_gc_good} {_setup_gc_good} {22};
};

#NOP -- The 7th GC in a row runs out of SP (2230 each). The hpbar SP is stale right after the other GCs, so the;
#NOP -- good one starts at 22s (after setup_defense's casts), then waits until there is SP or immersion.;
#alias {_setup_gc_good} {
    #if {$my[sp][current] > 2300 || $my[immersion][active]} {
        #var _gcgood_try 1;
        cast greater contingency as protection from good#cast protection from good;
    } {
        #delay {setup_gc_good} {_setup_gc_good} {4};
    };
};

#NOP -- If the MUD still says no SP, try again in 4s. Stops once the good GC is set up.;
#action {^You do not have enough spell points to cast greater contingency!} {
    #if {$_gcgood_try} {#delay {setup_gc_good} {_setup_gc_good} {4}};
};
#action {^You will cast protection from good should your protection from good ever} {#var _gcgood_try 0};
#var _gcgood_try 0;

#NOP -- clear greater contingency;
#alias {clear_gc} {
    #10 {cast remove greater contingency as 1};
};

