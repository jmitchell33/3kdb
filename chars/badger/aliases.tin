#NOP -- set variable for how many bags to cycle thru;
#alias {bagset} {
    #if {"%0" != ""} {
        #var bagcount %0;
        #echo {<ffa>BAG COUNT SET TO %0<088>};
    } {
        #echo {<faa>NO USER INPUT!<088>};
    };
};

#NOP -- cycle bags;
#NOP -- Items that can't be dropped (the Section Z barrier shield and High Score Button) answer every;
#NOP -- put all in bag with "You can not drop that.", once per item per bag. Hide that line for a few seconds;
#NOP -- while bagging, it still shows any other time;
#alias {.bag_gag} {
    #class {bag_gag} {kill};
    #class {bag_gag} {open};
    #gag {^You can not drop that.$};
    #class {bag_gag} {close};
    #delay {bag_gag} {#class {bag_gag} {kill}} {4};
};

#alias {bag1} {
    .bag_gag;
    #var bagsFull 1;
    #var bag1_active 1;
    #format tmpBagCount {%d} $bagcount;
    #loop $tmpBagCount 1 tmpBag {
        put all in bag $tmpBag;
    };
    #NOP -- the "You put" line clears bagsFull and bag1_active in gypsyid.tin, one action per line;
};

#alias {bag2} {
    #format tmpBagCount {%d} $bagcount;
    drop all;
    #loop 1 $tmpBagCount tmpBag {
        get all from bag $tmpBag;drop all;
    };
    #var bagsFull 0;
    #var bag1_active 0;
};

#NOP -- mage box trip, see heartbeat.tin. aboxon and aboxoff turn the bot trip on and off;
#alias {aboxon}
{
    #var bbox[on] 1;
    #echo {<ceb>Mage box:<088> on, full bags during a bot go to the mage box.};
};

#alias {aboxoff}
{
    #var bbox[on] 0;
    #echo {<ceb>Mage box:<088> off.};
};

#NOP -- magebox: donate the bags now. With a bot walking it is the bot trip (pause, donate, back, resume),;
#NOP -- otherwise it walks there, donates and stays;
#alias {magebox}
{
    #if {"$bbox[state]" != "idle"}
    {
        #echo {<ceb>Mage box:<088> already running ($bbox[state]).};
        #return;
    };
    #if {"$gid[state]" != "idle"}
    {
        #echo {<ceb>Mage box:<088> <faa>gypsyid is running, try again after.<088>};
        #return;
    };
    #if {"$bagcount" == "" || "$bagcount" == "0" || "$bagcount" == "\$bagcount"}
    {
        #echo {<ceb>Mage box:<088> <faa>set your bag count first with bagset <number>.<088>};
        #return;
    };
    #if {"$bot[active]" == "1" && "$bot[paused]" != "1"}
    {
        #var bbox[manual] 0;
        .bbox_start;
        #return;
    };
    #if {"$incombat" == "1"}
    {
        #echo {<ceb>Mage box:<088> <faa>finish the fight first.<088>};
        #return;
    };
    #var bbox[manual] 1;
    .bbox_go;
};

#alias {magebox-stop}
{
    #if {"$bbox[state]" == "idle"}
    {
        #echo {<ceb>Mage box:<088> not running.};
        #return;
    };
    .bbox_abort {stopped by you};
};

