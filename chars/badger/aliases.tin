#NOP -- cycle through coffin/freezer/cooler for a corpse;
#alias {.corpse} {
	#if {$corpses[coffin] > 0} {
		#send !unwrap 1;
	}; #elseif {$corpses[freezer] > 0} {
		#send !deslab;
	}; #elseif {$corpses[cooler] > 0} {
		#send !uncooler corpse;
	}; #else {
		#echo {<ccf>----<088> <fff>OUT OF CORPSES<088><faa>!!!!<088> <ccf>----<088>};
	};
	cast corpse blast;
};

#NOP -- corpsetrig cooler step after wrap and slab: those are sent first, so the corpse is only still on the ground;
#NOP -- once the coffin and freezer are full. The coffin max is learned from "The coffin is full!" (modules/corpsemanager);
#NOP -- Only runs if you own a cooler and a freezer, so it never picks up a corpse it can't store;
#alias {.corpse_cooler} {
    #if {"$inventory[cooler]" != "1" || "$inventory[freezer]" != "1"} {
        #return;
    };
    #if {$corpses[coffin] >= $corpses[coffin_max] && $corpses[freezer] >= 50 && $corpses[cooler] < 50} {
        get corpse;
        #NOP -- .cooler_get_all (modules/corpsemanager) skips this in the Chaos Sewers, a corpse there can hold the black stone;
        .cooler_get_all;
        cooler corpse;
    };
};

#alias {setup_reflex} {
    reflex clear;
    reflex add sp <10% eternal heal badger;
    reflex add sp <20% cast mystic immersion;
    #NOP -- sat over 100 can kill, explosive release brings it down;
    reflex add gp1 >84% cast explosive release;
    reflex add gp2 >40% cast focus mind;
    reflex add gp2 >90% shoo summons;
    reflex combat on;
    reflex combat;
    reflex start;
};

#NOP -- turn gags on;
#alias {gagson} {
    gag+ hpbar;
    #gag {  --> %*};
    #gag {%*-hp-};
};

#NOP -- turn gags off;
#alias {gagsoff} {
    gag-clear;
    #ungag {  --> %*};
    #ungag {%*-hp-};
};

