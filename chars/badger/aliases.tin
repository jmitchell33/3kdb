#NOP -- debug stuff;
#alias {.startlog} {
    #switch {"%0"} {
        #case {"on"} {#event {SENT OUTPUT} {#var _sent_output_dbg %0;#echo {<cfa>out ($_sent_output_dbg)<088>}};#var debug[bot] 1;#debug {actions} {log};#config {log_mode} {plain};#log append botlog};
        #case {"off"} {#UNEVENT {SENT OUTPUT};#unvar debug[bot];#log off};
        #case {"del"} {#log remove botlog};
        #case {""} {#echo {<fff>No user input<088>}};
    };
};

#alias {writelog} {
    #system {echo ROUND COUNT: $total_rounds >> chars/badger/badgerslog.log};
};

#NOP -- badgers 3kdb aliases;
#NOP -- One alias per line: the name, then its description word wrapped at 70 characters. Lines after the;
#NOP -- first start with spaces so they line up under the description, not at the left edge of the screen;
#alias {format_badgersaliases} {
    #format {badgeralias_name} {%-25s} {<cff>%1<088>};
    #format {badgeralias_pad} {%-25s} {};
    #var badgeralias_text {%2};
    #replace {badgeralias_text} { } {;};
    #list badgeralias_words create {$badgeralias_text};
    #var badgeralias_line {};
    #var badgeralias_first 1;
    #foreach {$badgeralias_words[%*]} {badgeralias_word} {
        #format badgeralias_len {%L} {$badgeralias_line $badgeralias_word};
        #if {"$badgeralias_line" != "" && $badgeralias_len > 70} {
            #if {$badgeralias_first} {
                #showme {$badgeralias_name <deb>$badgeralias_line<088>};
                #var badgeralias_first 0;
            } {
                #showme {$badgeralias_pad <deb>$badgeralias_line<088>};
            };
            #var badgeralias_line {$badgeralias_word};
        };
        #elseif {"$badgeralias_line" == ""} {
            #var badgeralias_line {$badgeralias_word};
        };
        #else {
            #var badgeralias_line {$badgeralias_line $badgeralias_word};
        };
    };
    #if {$badgeralias_first} {
        #showme {$badgeralias_name <deb>$badgeralias_line<088>};
    } {
        #showme {$badgeralias_pad <deb>$badgeralias_line<088>};
    };
};

#NOP -- filter types, listed in the help and matched by the first letters (corp finds corpses);
#list badger3kdb_types create {corpses;boosts;combat;guild;spells;areas;misc};

#NOP -- badger3kdb <filter>: a filter, or the start of one, lists that type. Anything else lists aliases starting with it;
#alias {badger3kdb} {
    #var bdb_total 0;
    #format bdb_arg {%l} {%1};
    #var bdb_mode {name};
    #if {"$bdb_arg" != ""} {
        #foreach {$badger3kdb_types[%*]} {bdb_type} {
            #regex {$bdb_type} {^$bdb_arg} {#var bdb_mode {type}};
        };
    };
    #echo {<ccf>  -------           <ffa>3kdb           <ccf>-------<088>  };
    #echo {<ccf>  -------    <ffa>BADGERS ALIASES <fff>(&badger3kdb[])  <ccf>-------    <088>  };
    #echo {<ccf>  ----------------------------------------   <088>  };
    #echo {<ccf>     Name                 Usage              <088>  };
    #list badger3kdb index name;
    #list badger3kdb sort;
    #foreach $badger3kdb[%*] index {
        #var bdb_hit 0;
        #if {"$bdb_arg" == ""} {
            #var bdb_hit 1;
        };
        #elseif {"$bdb_mode" == "type"} {
            #regex {$index[type]} {^$bdb_arg} {#var bdb_hit 1};
        };
        #else {
            #regex {$index[name]} {^$bdb_arg} {#var bdb_hit 1};
        };
        #if {$bdb_hit} {
            #math bdb_total {$bdb_total + 1};
            format_badgersaliases {     $index[name]} {$index[desc]};
        };
    };
    #if {$bdb_total} {
        #echo {\n<ccf>  Total of $bdb_total aliases returned.<088>};
    } {
        #echo {<ccf>  No matches found for <eed>%1<ccf>.<088>};
    };
    #echo {<ccf>  ----------------------------------------   <088>  };
    #echo {<cfc>  Sort using filters: <eaf>badger3kdb <filter><088>};
    #echo {    <fff>Filters:  <eaf>corpses boosts combat guild<088>};
    #echo {              <eaf>spells areas misc<088>};
    #echo {<cfc>  Part of a filter works too: <eaf>badger3kdb corp<088>};
    #echo {<cfc>  Not a filter? Lists aliases starting with it: <eaf>badger3kdb my<088>};
    #echo {<ccf>  ----------------------------------------   <088>  };
};

#list badger3kdb clear;

