.add_speedrun {home} {misc} {13717} {Jesse's house (home 986)};

#class {player_aliases} {close};

#NOP -- gypsyid: identify the bags at the town gypsy, see gypsyid.tin;
#read chars/$user/gypsyid.tin;

#NOP -- bagcount: count the bags and bagset, see bagcount.tin;
#read chars/$user/bagcount.tin;

#NOP -- mantle focus learner, see mfocus.tin;
#read chars/$user/mfocus.tin;

#NOP -- mantle focus lives in my[], which vars.tin saves (xmy), so it matches the GC on the server after a relog;
#if {!&{my[mfocus]}}
{
    #var my[mfocus] blunt;
};
