#NOP -- cycle through coffin/freezer/cooler for a corpse;
#alias {.corpse} {
	#if {$corpses[coffin] > 0} {
		#send !unwrap 1;
	}; #elseif {$corpses[freezer] > 0} {
		#send !deslab;
	}; #elseif {$corpses[cooler] > 0} {
		#send !uncooler corpse;
	}; #else {
		#echo {<ccf>----<088> <fff>OUT OF CORPSES<088><faa>!!!!<088> <ccf>----<088>};
	};
	cast corpse blast;
};

#NOP -- corpsetrig cooler step after wrap and slab: those are sent first, so the corpse is only still on the ground;
#NOP -- once the coffin and freezer are full. The coffin max is learned from "The coffin is full!" (modules/corpsemanager);
#alias {.corpse_cooler} {
    #if {$corpses[coffin] >= $corpses[coffin_max] && $corpses[freezer] >= 50 && $corpses[cooler] < 50} {
        get corpse;
        cooler corpse;
    };
};

