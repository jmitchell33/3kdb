#NOP Prevents accidental quitting by overriding the mud's "quit" command. This in turn can be overriden;
#NOP by typing "quit REALLY";
#alias {quit} {
    #if { "%1" == "REALLY"} {
        #send {quit};
    } {
        #SEND shakeno;
        #SEND {emote pulls out a mirror and looks at himself.};
        #SEND {say YOU are GOOD ENOUGH!};
        #SEND {badger};
    };
};

