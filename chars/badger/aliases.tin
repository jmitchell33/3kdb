#NOP -- Mantle focus: cast mantle as focus blunt or edged puts the mantle on one damage type. A mob that hits;
#NOP -- that way leaks through it about half as often. my[mfocus] is blunt, edged or none. The GC keeps;
#NOP -- the text it was made with, so mfocus swaps the mantle GC (one GC cast). Plain cast mantle from the;
#NOP -- guild heartbeat is turned into the focused one by the alias below;
#alias {_mantle_cmd}
{
    #if {"$my[mfocus]" == "none"}
    {
        #var mantle_cmd {cast mantle};
    };
    #else
    {
        #var mantle_cmd {cast mantle as focus $my[mfocus]};
    };
};

#NOP -- set mantle_cmd now, so maint setup (also run at login) makes the focused mantle GC;
_mantle_cmd;

#alias {^cast mantle$}
{
    _mantle_cmd;
    #send {$mantle_cmd};
}
{4};

#alias {mfocus}
{
    #switch {"%1"}
    {
        #case {"blunt"} {#var mfocus_want blunt};
        #case {"edged"} {#var mfocus_want edged};
        #case {"none"} {#var mfocus_want none};
        #default
        {
            #echo {<ffa>Mantle focus is $my[mfocus]. mfocus blunt, edged or none swaps the mantle GC.<088>};
            #var mfocus_want {};
        };
    };
    #if {"$mfocus_want" != ""}
    {
        _cont_fetch _mfocus_swap;
    };
};

#NOP -- runs once the contingency lists are in (_cont_fetch, common/guilds/mage/aliases.tin);
#alias {_mfocus_swap}
{
    #NOP -- No list back = slots unknown. Adding then would leave the old mantle GC too (2 mantle GCs, a slot lost);
    #if {!$gcKnown}
    {
        #echo {<faa>Mantle focus not changed, the greater contingency list did not come back. Try mfocus $mfocus_want again.<088>};
    };
    #else
    {
        #NOP -- Remove every mantle GC, highest slot first so the lower slot numbers do not move;
        #if {&gcLine[] > 0}
        {
            #loop &gcLine[] 1 mfocus_i
            {
                #var mfocus_hit 0;
                #regex {$gcLine[$mfocus_i]} {should your mantle} {#var mfocus_hit 1};
                #if {$mfocus_hit}
                {
                    cast remove greater contingency as $mfocus_i;
                    #list gcLine delete $mfocus_i;
                };
            };
        };
        #var my[mfocus] $mfocus_want;
        _mantle_cmd;
        cast greater contingency as mantle#$mage[contingencies][mantle]#$mantle_cmd;
        #echo {<afa>Mantle focus now $my[mfocus].<088>};
    };
};

#NOP -- greater contingency;
#alias {setup_gc} {
    _mantle_cmd;
    cast greater contingency as mantle#$mage[contingencies][mantle]#$mantle_cmd;
    cast greater contingency as prismatic sphere#$mage[contingencies][sphere]#cast prismatic sphere;
    cast greater contingency as major globe#cast major globe;
    cast greater contingency as stoneskin#cast stoneskin;
    cast greater contingency as shield#cast magnificent shield;
    cast greater contingency as armor#cast armor;
    #delay {setup_gc_good} {_setup_gc_good} {22};
};

#NOP -- The 7th GC in a row runs out of SP (2230 each). The hpbar SP is stale right after the other GCs, so the;
#NOP -- good one starts at 22s, then waits until there is SP or immersion.;
#alias {_setup_gc_good} {
    #if {$my[sp][current] > 2300 || $my[immersion][active]} {
        #var _gcgood_try 1;
        cast greater contingency as protection from good#cast protection from good;
    } {
        #delay {setup_gc_good} {_setup_gc_good} {4};
    };
};

#NOP -- If the MUD still says no SP, try again in 4s. Stops once the good GC is set up.;
#action {^You do not have enough spell points to cast greater contingency!} {
    #if {$_gcgood_try} {#delay {setup_gc_good} {_setup_gc_good} {4}};
};
#action {^You will cast protection from good should your protection from good ever} {#var _gcgood_try 0};
#var _gcgood_try 0;

#NOP -- clear greater contingency;
#alias {clear_gc} {
    #10 {cast remove greater contingency as 1};
};

